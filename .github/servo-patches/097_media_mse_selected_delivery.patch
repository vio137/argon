+    fn disabled_delivery_never_configures_or_submits_and_releases_queue_quota() {
+        struct NoNative;
+        impl CodecInput for NoNative {
+            fn configure(&mut self, _: &DecoderConfig) -> Result<(), ()> {
+                panic!("disabled track configured")
+            }
+            fn submit(&mut self, _: u32, _: &[u8], _: i64) -> Result<bool, ()> {
