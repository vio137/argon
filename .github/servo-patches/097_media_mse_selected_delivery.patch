+    #[test]
+    fn disabled_delivery_keeps_coded_frames_for_reenabled_seek_replay() {
+        struct Count(usize);
+        impl CodecInput for Count {
+            fn configure(&mut self, _: &super::super::bridge::DecoderConfig) -> Result<(), ()> {
+                Ok(())
+            }
+            fn submit(&mut self, _: u32, _: &[u8], _: i64) -> Result<bool, ()> {
+                self.0 += 1;
+                Ok(true)
+            }
+        }
+        let mut s = AppendSession::new(1 << 20, 64);
+        s.append(include_bytes!(
+            "../hosttest/tests/fixtures/synthetic-fmp4.mp4"
+        ))
+        .unwrap();
+        let before = s.ranges(1);
+        let pts = s.highest_presentation_timestamp();
+        let mut sink = Count(0);
+        while s.pump_input_selected(&mut sink, |_| false).unwrap() {}
+        assert_eq!(sink.0, 0);
+        assert_eq!(s.ranges(1), before);
+        assert_eq!(s.highest_presentation_timestamp(), pts);
+        s.prepare_seek(0).unwrap();
+        while s.pump_input_selected(&mut sink, |_| true).unwrap() {}
+        assert_eq!(sink.0, 2);
+        assert_eq!(s.ranges(1), before);
+    }
