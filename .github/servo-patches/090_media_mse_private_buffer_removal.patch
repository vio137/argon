+#[test]
+fn removing_one_buffer_drops_its_native_epoch_and_replays_only_surviving_coverage() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.add_buffer(2).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.append(
+        2,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4"),
+    )
+    .unwrap();
+    let before = p.buffer_ranges();
+    assert!(p.remove_buffer(99).is_err());
+    assert_eq!(p.buffer_ranges(), before);
+    p.remove_buffer(1).unwrap();
+    assert!(!p.sessions.contains_key(&1));
+    assert!(p.sessions.contains_key(&2));
+    assert!(p.decoders.video.is_none());
+    assert!(p.decoders.audio.is_none());
+    assert_eq!(p.seek_target, Some(0));
+    assert!(!p.take_seek_ready());
+    assert_eq!(p.buffer_ranges().len(), 1);
+    assert_eq!(p.buffer_ranges()[0].0, 2);
+}
+#[test]
+fn removing_last_buffer_cancels_wait_and_frees_store_without_fabricating_seek_completion() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.seek_or_wait_for_coverage(2_000_000).unwrap();
+    p.remove_buffer(1).unwrap();
+    assert!(p.sessions.is_empty());
+    assert!(p.buffered().is_empty());
+    assert_eq!(p.removed_target, None);
+    assert_eq!(p.seek_target, None);
+    assert!(!p.take_seek_ready());
+    assert!(!p.pump().unwrap().finished);
