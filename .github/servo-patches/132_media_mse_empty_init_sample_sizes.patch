+#[cfg(test)]
+mod init_sample_size_tests {
+ use super::*;
+ #[test]
+ fn hostile_variable_counts_and_truncated_size_headers_fail_preflight() {
+  let mut body=vec![0,0,0,20,b's',b't',b's',b'z'];body.extend_from_slice(&[0;8]);body.extend_from_slice(&u32::MAX.to_be_bytes());
+  assert_eq!(validate_init_children(&body,*b"stbl",0,&mut 4096,&mut 0),Err(Error::InvalidBox));
+  body.truncate(16);body[..4].copy_from_slice(&16u32.to_be_bytes());
+  assert_eq!(validate_init_children(&body,*b"stbl",0,&mut 4096,&mut 0),Err(Error::Truncated));
+  let mut trailing=vec![0,0,0,21,b's',b't',b's',b'z'];trailing.extend_from_slice(&[0;13]);
+  assert_eq!(validate_init_children(&trailing,*b"stbl",0,&mut 4096,&mut 0),Err(Error::InvalidBox));
+ }
