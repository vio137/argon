+#[test] fn session_abort_discards_partial_bytes_but_preserves_accepted_frames_and_delivery() {
+    use servo_media_android_hosttest::mse_demux::{session::AppendSession,delivery::CodecInput,bridge::DecoderConfig};
+    struct Sink {pts:Vec<i64>,configs:usize}
+    impl CodecInput for Sink {
+        fn configure(&mut self,_:&DecoderConfig)->Result<(),()>{self.configs+=1;Ok(())}
+        fn submit(&mut self,_:u32,_:&[u8],pts:i64)->Result<bool,()>{self.pts.push(pts);Ok(true)}
+    }
+    let bs=boxes();let mut session=AppendSession::new(1<<20,128);
+    session.set_append_options(1_000_000,0..1_500_000).unwrap();
+    let mut first_end=0;
+    for (i,b) in bs.iter().enumerate() {session.append(b).unwrap();if &b[4..8]==b"mdat" {first_end=i+1;break;}}
+    assert_eq!(session.buffered(),[1_000_000..1_500_000]);
+    session.append(&[0,0,0]).unwrap();session.abort_append().unwrap();
+    assert_eq!(session.buffered(),[1_000_000..1_500_000]);
+    for b in &bs[first_end..]{session.append(b).unwrap();}
+    session.end_of_stream().unwrap();
+    let mut sink=Sink{pts:vec![],configs:0};while session.pump_input(&mut sink).unwrap(){}
+    // Offset remains 1s; abort resets the old end-window so the second frame
+    // at 1.5s is accepted. Accepted first packet/config was not dropped.
+    assert_eq!(sink.pts,[1_000_000,1_500_000]);assert_eq!(sink.configs,1);
+    assert_eq!(session.buffered(),[1_000_000..2_000_000]);
+    assert!(session.abort_append().is_err());
+}
+#[test] fn session_abort_cannot_resurrect_a_failed_parser() {
+    use servo_media_android_hosttest::mse_demux::session::{AppendSession,SessionError};
+    let mut session=AppendSession::new(1024,32);
+    assert!(session.append(&[0,0,0,7,b'f',b'r',b'e',b'e']).is_err());
+    assert_eq!(session.abort_append(),Err(SessionError::Failed));
+    assert!(session.append(include_bytes!("fixtures/synthetic-fmp4.mp4")).is_err());
+}
