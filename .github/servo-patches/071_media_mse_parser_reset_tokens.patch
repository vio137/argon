+    /// Reset an unfinished append without deleting already accepted frames or
+    /// packets. A decoder failure is not repaired by a parser reset. This is
+    /// the worker-side operation only, not the DOM abort/event handshake.
+    pub fn abort_append(&mut self) -> Result<(), SessionError> {
+        if self.failed || self.ended {
+            return Err(SessionError::Failed);
+        }
