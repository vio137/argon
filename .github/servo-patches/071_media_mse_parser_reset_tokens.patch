+#[test]
+fn parser_abort_keeps_playback_usable_but_cannot_reopen_ended_input() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut playback = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    playback.add_buffer(1).unwrap();
+    assert!(playback.abort_append(2).is_err());
+    playback.append(1, &[0, 0, 0]).unwrap();
+    playback.abort_append(1).unwrap();
+    playback
+        .append(
+            1,
+            include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+        )
+        .unwrap();
+    assert_eq!(playback.pump().unwrap().buffered, [0..1_000_000]);
+    playback.end_input().unwrap();
+    assert!(playback.abort_append(1).is_err());
+}
