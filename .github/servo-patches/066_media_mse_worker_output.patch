+use super::*;
+use std::cell::RefCell;
+#[derive(Default)]
+struct Mock {
+    dequeues: usize,
+    releases: Vec<bool>,
+    inputs: usize,
+    eos: usize,
+    flags: u32,
+    size: i32,
+    pts: i64,
+}
+thread_local! { static MOCK: RefCell<Mock> = RefCell::new(Mock::default()); }
+fn codec() -> MseCodecInput {
+    MOCK.with(|m| {
+        *m.borrow_mut() = Mock {
+            size: 4,
+            pts: 100_000,
+            ..Mock::default()
+        }
+    });
+    let mut c = MseCodecInput::new(None);
+    c.codec = ptr::dangling_mut();
+    c.video = true;
+    c
+}
+#[test]
+fn video_holds_one_native_buffer_until_playing_and_due() {
+    let mut c = codec();
+    assert!(matches!(c.poll_output_at(0, true), Ok(MseOutput::Retry)));
+    assert!(matches!(
+        c.poll_output_at(100_000, false),
+        Ok(MseOutput::Retry)
+    ));
+    assert!(matches!(
+        c.poll_output_at(90_000, true),
+        Ok(MseOutput::SurfaceReleased {
+            pts_us: 100_000,
+            ..
+        })
+    ));
+    MOCK.with(|m| {
+        let m = m.borrow();
+        assert_eq!(m.dequeues, 1);
+        assert_eq!(m.releases, [true]);
+    });
+}
+#[test]
+fn teardown_releases_a_held_frame_without_rendering() {
+    let mut c = codec();
+    c.poll_output_at(0, false).unwrap();
+    drop(c);
+    MOCK.with(|m| assert_eq!(m.borrow().releases, [false]));
+}
+#[test]
+fn late_frame_is_discarded_not_surface_queued() {
+    let mut c = codec();
+    assert!(matches!(
+        c.poll_output_at(500_001, true),
+        Ok(MseOutput::Retry)
+    ));
+    MOCK.with(|m| assert_eq!(m.borrow().releases, [false]));
+}
+#[test]
+fn empty_eos_does_not_require_play_or_surface_render() {
+    let mut c = codec();
+    MOCK.with(|m| {
+        m.borrow_mut().flags = 4;
+        m.borrow_mut().size = 0;
+    });
+    assert!(matches!(
+        c.poll_output_at(0, false),
+        Ok(MseOutput::EndOfStream)
+    ));
+    MOCK.with(|m| assert_eq!(m.borrow().releases, [false]));
+}
+#[test]
+fn eos_input_is_queued_only_once() {
+    let mut c = codec();
+    assert_eq!(c.queue_eos(), Ok(true));
+    assert_eq!(c.queue_eos(), Ok(true));
+    MOCK.with(|m| {
+        assert_eq!(m.borrow().inputs, 1);
+        assert_eq!(m.borrow().eos, 1);
+    });
+}
+#[unsafe(no_mangle)]
+unsafe extern "C" fn AMediaCodec_dequeueOutputBuffer(
+    _: *mut sys::AMediaCodec,
+    info: *mut sys::AMediaCodecBufferInfo,
+    _: i64,
+) -> isize {
+    MOCK.with(|m| {
+        let mut m = m.borrow_mut();
+        m.dequeues += 1;
+        unsafe {
+            *info = sys::AMediaCodecBufferInfo {
+                offset: 0,
+                size: m.size,
+                presentation_time_us: m.pts,
+                flags: m.flags,
+            };
+        }
+    });
+    0
+}
+#[unsafe(no_mangle)]
+unsafe extern "C" fn AMediaCodec_releaseOutputBuffer(
+    _: *mut sys::AMediaCodec,
+    _: usize,
+    render: bool,
+) -> i32 {
+    MOCK.with(|m| m.borrow_mut().releases.push(render));
+    0
+}
+#[unsafe(no_mangle)]
+unsafe extern "C" fn AMediaCodec_stop(_: *mut sys::AMediaCodec) -> i32 {
+    0
+}
+#[unsafe(no_mangle)]
+unsafe extern "C" fn AMediaCodec_delete(_: *mut sys::AMediaCodec) -> i32 {
+    0
+}
+#[unsafe(no_mangle)]
+unsafe extern "C" fn AMediaCodec_dequeueInputBuffer(_: *mut sys::AMediaCodec, _: i64) -> isize {
+    MOCK.with(|m| m.borrow_mut().inputs += 1);
+    0
+}
+#[unsafe(no_mangle)]
+unsafe extern "C" fn AMediaCodec_queueInputBuffer(
+    _: *mut sys::AMediaCodec,
+    _: usize,
+    _: i64,
+    _: usize,
+    _: u64,
+    flags: u32,
+) -> i32 {
