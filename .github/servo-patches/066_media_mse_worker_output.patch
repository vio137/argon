+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+//! Bounded adaptive worker controller. Construction happens on the caller;
+//! every native codec, reader and AAudio handle is made/destroyed on the worker.
+//! This is not a DOM attachment and does not change capability reporting.
+use super::mse_playback::{AppendPlayback, PumpStatus};
+use servo_media_player::video::VideoFrameRenderer;
+use std::{
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+        mpsc::{self, SyncSender, TrySendError},
+    },
+    thread::{self, JoinHandle},
+    time::{Duration, Instant},
+};
+
+pub enum Command {
+    AddBuffer(u32),
+    Append { buffer_id: u32, bytes: Vec<u8> },
+    EndInput,
+    Playing(bool),
+    Volume { volume: f32, muted: bool },
+}
+pub enum SendError {
+    TooLarge(Command),
+    Full(Command),
+    Disconnected(Command),
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Applied {
+    BufferAdded(u32),
+    Appended(u32),
+    InputEnded,
+    Playing,
+    Volume,
+}
+pub enum Event {
+    /// Identifies command acceptance/processing, not audible or visible output.
+    CommandApplied(Applied),
+    Status(PumpStatus),
+    Error,
+}
+pub struct Worker {
+    tx: Option<SyncSender<Command>>,
+    cancel: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+impl Worker {
+    pub fn spawn(
+        renderer: Arc<Mutex<dyn VideoFrameRenderer>>,
+        event: Box<dyn Fn(Event) + Send>,
+    ) -> Result<Self, ()> {
+        // At most32MiB of append bytes waiting in this channel, in addition to
+        // the session's independent32MiB quota. The caller retains a rejected
+        // command and decides when to retry; no append is silently discarded.
+        let (tx, rx) = mpsc::sync_channel(8);
+        let cancel = Arc::new(AtomicBool::new(false));
+        let cancelled = cancel.clone();
+        let thread = thread::Builder::new()
+            .name("android-mse-output".to_owned())
+            .spawn(move || {
+                let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    let mut playback = AppendPlayback::new(renderer);
+                    let mut previous_frames = 0;
+                    let mut previous_size = None;
+                    let mut previous_audio = false;
+                    let mut previous_playing = false;
+                    let mut last_status = Instant::now();
+                    loop {
+                        if cancelled.load(Ordering::Acquire) {
+                            break;
+                        }
+                        match rx.recv_timeout(Duration::from_millis(5)) {
+                            Ok(command) => {
+                                let ack = match &command {
+                                    Command::AddBuffer(id) => Applied::BufferAdded(*id),
+                                    Command::Append { buffer_id, .. } => {
+                                        Applied::Appended(*buffer_id)
+                                    }
+                                    Command::EndInput => Applied::InputEnded,
+                                    Command::Playing(_) => Applied::Playing,
+                                    Command::Volume { .. } => Applied::Volume,
+                                };
+                                let applied = match command {
+                                    Command::AddBuffer(id) => playback.add_buffer(id),
+                                    Command::Append { buffer_id, bytes } => {
+                                        playback.append(buffer_id, &bytes)
+                                    }
+                                    Command::EndInput => playback.end_input(),
+                                    Command::Playing(playing) => playback.set_playing(playing),
+                                    Command::Volume { volume, muted } => {
+                                        playback.set_volume(volume, muted)
+                                    }
+                                };
+                                if applied.is_err() {
+                                    event(Event::Error);
+                                    break;
+                                }
+                                event(Event::CommandApplied(ack));
+                            }
+                            Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                            Err(mpsc::RecvTimeoutError::Timeout) => (),
+                        }
+                        if cancelled.load(Ordering::Acquire) {
+                            break;
+                        }
+                        let status = match playback.pump() {
+                            Ok(s) => s,
+                            Err(()) => {
+                                event(Event::Error);
+                                break;
+                            }
+                        };
+                        if status.rendered_frames != previous_frames
+                            || status.video_size != previous_size
+                            || status.has_audio != previous_audio
+                            || status.playing != previous_playing
+                            || status.finished
+                            || (status.playing
+                                && last_status.elapsed() >= Duration::from_millis(250))
+                        {
+                            event(Event::Status(status));
+                            previous_frames = status.rendered_frames;
+                            previous_size = status.video_size;
+                            previous_audio = status.has_audio;
+                            previous_playing = status.playing;
+                            last_status = Instant::now();
+                        }
+                        if status.finished {
+                            playback.set_playing(false)?;
+                            break;
+                        }
+                    }
+                    Ok::<(), ()>(())
+                }));
+                if !matches!(result, Ok(Ok(()))) {
+                    event(Event::Error);
+                }
+            })
+            .map_err(|_| ())?;
+        Ok(Self {
+            tx: Some(tx),
+            cancel,
+            thread: Some(thread),
+        })
+    }
+    pub fn try_command(&self, command: Command) -> Result<(), SendError> {
+        if let Command::Append { bytes, .. } = &command {
+            if bytes.len() > 4 * 1024 * 1024 {
+                return Err(SendError::TooLarge(command));
+            }
+        }
+        match &self.tx {
+            Some(tx) => tx.try_send(command).map_err(|e| match e {
+                TrySendError::Full(command) => SendError::Full(command),
+                TrySendError::Disconnected(command) => SendError::Disconnected(command),
+            }),
+            None => Err(SendError::Disconnected(command)),
+        }
+    }
+}
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.cancel.store(true, Ordering::Release);
+        self.tx.take();
+        if let Some(thread) = self.thread.take() {
+            if thread.thread().id() != std::thread::current().id() {
+                let _ = thread.join();
+            }
+        }
+    }
+}
+
+#[cfg(all(test, not(target_os = "android")))]
+mod tests {
+    use super::*;
+    use servo_media_player::video::VideoFrame;
+    struct Renderer;
+    impl VideoFrameRenderer for Renderer {
+        fn render(&mut self, _: VideoFrame) {}
+    }
+    #[test]
+    fn command_processing_and_shutdown_do_not_require_native_handles_to_cross_threads() {
+        let (tx, rx) = mpsc::channel();
+        let worker = Worker::spawn(
+            Arc::new(Mutex::new(Renderer)),
+            Box::new(move |event| {
+                let _ = tx.send(matches!(event, Event::CommandApplied(_)));
+            }),
+        )
+        .unwrap();
+        assert!(worker.try_command(Command::Playing(false)).is_ok());
+        assert!(rx.recv_timeout(Duration::from_secs(2)).unwrap());
+        drop(worker);
+    }
+    #[test]
+    fn queue_pressure_returns_original_append_for_retry() {
+        let (tx, _rx) = mpsc::sync_channel(1);
+        let worker = Worker {
+            tx: Some(tx),
+            cancel: Arc::new(AtomicBool::new(false)),
+            thread: None,
+        };
+        assert!(worker.try_command(Command::Playing(false)).is_ok());
+        match worker.try_command(Command::Append {
+            buffer_id: 1,
+            bytes: vec![1, 2, 3],
+        }) {
+            Err(SendError::Full(Command::Append { bytes, .. })) => assert_eq!(bytes, [1, 2, 3]),
+            _ => panic!("append was lost"),
+        }
+        match worker.try_command(Command::Append {
+            buffer_id: 1,
+            bytes: vec![7; 4 * 1024 * 1024 + 1],
+        }) {
+            Err(SendError::TooLarge(Command::Append { bytes, .. })) => {
+                assert_eq!(bytes.len(), 4 * 1024 * 1024 + 1)
+            }
+            _ => panic!("oversized append accepted"),
+        }
+    }
+}
