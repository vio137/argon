+#[test]
+fn image_arrival_retries_then_crops_and_converts_real_yuv() {
+    READY.with(|r| r.set(false));
+    DELETED.with(|r| r.set(0));
+    let surface = VideoSurface::new(8, 4).unwrap();
+    assert!(surface.acquire(None, None).unwrap().is_none());
+    READY.with(|r| r.set(true));
+    let frame = surface.acquire(None, None).unwrap().unwrap();
+    assert_eq!((frame.get_width(), frame.get_height()), (4, 2));
