+/// A caller-driven worker core, not yet the Player/DOM attachment. Native
+/// handles never cross threads. An error poisons all subsequent operations.
+#[derive(Clone, Copy, Debug)]
+pub struct PumpStatus {
+    pub finished: bool,
+    pub playing: bool,
+    pub position_us: i64,
+    pub rendered_frames: u64,
+    pub video_size: Option<(u16, u16)>,
+    pub has_audio: bool,
+}
+
+pub struct AppendPlayback {
+    sessions: BTreeMap<u32, AppendSession>,
+    input_ended: bool,
+    decoders: Decoders,
+    renderer: Arc<Mutex<dyn VideoFrameRenderer>>,
+    audio: AudioOutput,
+    clock: MasterClock,
+    playing: bool,
+    page_playing: bool,
+    volume: f32,
+    muted: bool,
+    focus: FocusTracker,
+    focus_counted: bool,
+    failed: bool,
+    video_pending: Option<Instant>,
+    video_color: (Option<i32>, Option<i32>),
+    drain_wait: Option<(Instant, i64)>,
+    clock_started: bool,
+    rendered_frames: u64,
+    video_done: bool,
+    audio_done: bool,
+}
+impl AppendPlayback {
+    pub fn new(renderer: Arc<Mutex<dyn VideoFrameRenderer>>) -> Self {
+        Self {
+            sessions: BTreeMap::new(),
+            input_ended: false,
+            decoders: Decoders {
+                track_ids: BTreeMap::new(),
+                next_track: 1,
+                configs: BTreeMap::new(),
+                first_pts: None,
+                surface: None,
+                video_size: None,
+                video: None,
+                audio: None,
+            },
+            renderer,
+            audio: AudioOutput::new(),
+            clock: MasterClock::new(),
+            playing: false,
+            page_playing: false,
+            volume: 1.0,
+            muted: false,
+            focus: FocusTracker::new(focus::noisy_epoch()),
+            focus_counted: false,
+            failed: false,
+            video_pending: None,
+            video_color: (None, None),
+            drain_wait: None,
+            clock_started: false,
+            rendered_frames: 0,
+            video_done: false,
+            audio_done: false,
+        }
+    }
+    fn checked<T>(&mut self, result: Result<T, ()>) -> Result<T, ()> {
+        if result.is_err() {
+            self.failed = true;
+            self.audio.close();
+            focus::set_counted(&mut self.focus_counted, false);
+        }
+        result
+    }
+    pub fn add_buffer(&mut self, id: u32) -> Result<(), ()> {
+        if self.failed
+            || self.input_ended
+            || self.sessions.len() >= 2
+            || self.sessions.contains_key(&id)
+        {
+            return Err(());
+        }
+        self.sessions
+            .insert(id, AppendSession::new(16 * 1024 * 1024, 8192));
+        Ok(())
+    }
+    fn input_exhausted(&self) -> bool {
+        self.input_ended && self.sessions.values().all(AppendSession::input_exhausted)
+    }
+    pub fn append(&mut self, id: u32, bytes: &[u8]) -> Result<(), ()> {
+        if self.failed {
+            return Err(());
+        }
+        let r = self
+            .sessions
+            .get_mut(&id)
+            .ok_or(())?
+            .append(bytes)
+            .map_err(|_| ());
+        self.checked(r)
+    }
+    pub fn end_input(&mut self) -> Result<(), ()> {
+        if self.failed {
+            return Err(());
+        }
+        if self.input_ended {
+            return Err(());
+        }
+        let result = self
+            .sessions
+            .values_mut()
+            .try_for_each(|s| s.end_of_stream().map_err(|_| ()));
+        self.checked(result)?;
+        self.input_ended = true;
+        Ok(())
+    }
+    pub fn set_playing(&mut self, playing: bool) -> Result<(), ()> {
+        if self.failed {
+            return Err(());
+        }
+        self.page_playing = playing;
+        self.focus.page_command();
+        let result = self.focus_tick();
+        self.checked(result)
+    }
+    pub fn set_volume(&mut self, volume: f32, muted: bool) -> Result<(), ()> {
+        if self.failed || !volume.is_finite() || !(0.0..=1.0).contains(&volume) {
+            return Err(());
+        }
+        self.volume = volume;
+        self.muted = muted;
+        let result = self.focus_tick();
+        self.checked(result)
+    }
+    fn focus_tick(&mut self) -> Result<(), ()> {
+        let has_audio = self.decoders.audio.is_some();
+        let silent = self.muted || self.volume == 0.0;
+        let effective = if has_audio && !silent {
+            focus::focus()
+        } else {
+            focus::FOCUS_GRANTED
+        };
+        self.focus
+            .step(!self.page_playing, effective, focus::noisy_epoch());
+        focus::set_counted(
+            &mut self.focus_counted,
+            self.focus
+                .wants_focus(!self.page_playing, silent, has_audio),
+        );
+        let playing = self.page_playing && self.focus.hold == Hold::None;
+        if playing != self.playing {
+            self.audio.set_running(playing)?;
+            self.playing = playing;
+            if playing {
+                self.clock.resume();
+                self.audio.last_progress = Instant::now();
+                if self.video_pending.is_some() {
+                    self.video_pending = Some(Instant::now());
+                }
+            } else {
+                self.clock.pause();
+            }
+        }
+        Ok(())
+    }
+    /// true only after both decoders drain, the final image is handed to the
+    /// browser renderer, and the audio endpoint consumes all submitted frames.
+    pub fn pump(&mut self) -> Result<PumpStatus, ()> {
+        if self.failed {
+            return Err(());
+        }
+        let result = self.pump_inner();
+        let finished = self.checked(result)?;
+        Ok(PumpStatus {
+            finished,
+            playing: self.playing,
+            position_us: self.clock.now_us(),
+            rendered_frames: self.rendered_frames,
+            video_size: self.decoders.video_size,
+            has_audio: self.decoders.audio.is_some(),
+        })
+    }
+    fn pump_inner(&mut self) -> Result<bool, ()> {
+        // Fair packet-level pumping keeps a blocked video decoder from
+        // starving an independently appended audio SourceBuffer.
+        for _ in 0..4 {
+            let mut progress = false;
+            for (id, session) in &mut self.sessions {
+                let mut sink = ScopedDecoder {
+                    buffer_id: *id,
+                    decoders: &mut self.decoders,
+                };
+                progress |= session.pump_input(&mut sink).map_err(|_| ())?;
+            }
+            if !progress {
+                break;
+            }
+        }
+        if !self.clock_started {
+            if let Some(pts) = self.decoders.first_pts {
+                self.clock.rebase(pts);
+                self.clock_started = true;
+                if !self.playing {
+                    self.clock.pause();
+                }
+            }
+        }
+        if self.input_exhausted() {
+            if let Some((_, c)) = &mut self.decoders.audio {
+                c.queue_eos()?;
+            }
+            if let Some((_, c)) = &mut self.decoders.video {
+                c.queue_eos()?;
+            }
+        }
+        self.focus_tick()?;
+        self.audio.write(
+            self.playing,
+            if self.muted {
+                0.0
+            } else {
+                self.volume * focus::gain()
+            },
+            &mut self.clock,
+        )?;
+        if self.audio.pending.is_none() && !self.audio_done {
+            if let Some((_, codec)) = &mut self.decoders.audio {
+                match codec.poll_output_at(self.clock.now_us(), self.playing)? {
+                    MseOutput::FormatChanged {
+                        sample_rate,
+                        channels,
+                        pcm_encoding,
+                        ..
+                    } => {
+                        if pcm_encoding != 2 {
+                            return Err(());
+                        }
+                        self.audio.configure(
+                            sample_rate,
+                            channels,
+                            self.playing,
+                            &mut self.clock,
+                        )?;
+                    }
+                    MseOutput::Pcm {
+                        samples,
+                        pts_us,
+                        eos,
+                    } => {
+                        self.audio.pending = Some(
+                            AudioQueue::new(samples, self.audio.channels as usize, pts_us)
+                                .ok_or(())?,
+                        );
+                        self.audio_done = eos;
+                    }
+                    MseOutput::EndOfStream => self.audio_done = true,
+                    MseOutput::Retry | MseOutput::CodecConfig => (),
+                    _ => return Err(()),
+                }
+            }
+        }
+        if let Some(started) = self.video_pending {
+            if self.playing {
+                if let Some(frame) = self
+                    .decoders
+                    .surface
+                    .as_ref()
+                    .ok_or(())?
+                    .acquire(self.video_color.0, self.video_color.1)?
+                {
+                    self.decoders.video_size =
+                        Some((frame.get_width() as u16, frame.get_height() as u16));
+                    self.renderer.lock().map_err(|_| ())?.render(frame);
+                    self.rendered_frames = self.rendered_frames.saturating_add(1);
+                    self.video_pending = None;
+                } else if started.elapsed() > Duration::from_secs(2) {
+                    return Err(());
+                }
+            }
+        }
+        if self.video_pending.is_none() && !self.video_done {
+            if let Some((_, codec)) = &mut self.decoders.video {
+                match codec.poll_output_at(self.clock.now_us(), self.playing)? {
+                    MseOutput::SurfaceReleased { eos, .. } => {
+                        self.video_pending = Some(Instant::now());
+                        self.video_done = eos;
+                    }
+                    MseOutput::EndOfStream => self.video_done = true,
+                    MseOutput::FormatChanged {
+                        color_standard,
+                        color_range,
+                        ..
+                    } => {
+                        self.video_color = (color_standard, color_range);
+                    }
+                    MseOutput::Retry | MseOutput::CodecConfig => (),
+                    _ => return Err(()),
+                }
+            }
+        }
+        let decoder_done = self.input_exhausted()
+            && (self.decoders.video.is_none() || self.video_done)
+            && (self.decoders.audio.is_none() || self.audio_done)
+            && self.video_pending.is_none()
+            && self.audio.pending.is_none();
+        if self.playing && decoder_done && !self.clock.audio_drained() {
+            let position = self.clock.now_us();
+            match self.drain_wait {
+                Some((started, last)) if last == position => {
+                    if started.elapsed() > Duration::from_secs(2) {
+                        return Err(());
+                    }
+                }
+                _ => self.drain_wait = Some((Instant::now(), position)),
+            }
+        } else {
+            self.drain_wait = None;
+        }
+        Ok(self.playing && decoder_done && self.clock.audio_drained())
+    }
+}
+
+impl Drop for AppendPlayback {
+    fn drop(&mut self) {
+        focus::set_counted(&mut self.focus_counted, false);
+    }
+}
+
+struct AudioOutput {
+    stream: *mut sys::AAudioStream,
+    rate: i32,
+    channels: i32,
+    pending: Option<AudioQueue>,
+    last_progress: Instant,
+}
+impl AudioOutput {
+    fn new() -> Self {
+        Self {
+            stream: ptr::null_mut(),
+            rate: 0,
+            channels: 0,
+            pending: None,
+            last_progress: Instant::now(),
+        }
+    }
+    fn configure(
+        &mut self,
+        rate: i32,
+        channels: i32,
+        playing: bool,
+        clock: &mut MasterClock,
+    ) -> Result<(), ()> {
+        if rate <= 0 || rate > 192000 || channels <= 0 || channels > 8 {
+            return Err(());
+        }
+        if !self.stream.is_null() {
+            return if (rate, channels) == (self.rate, self.channels) {
+                Ok(())
+            } else {
+                Err(())
+            };
+        }
+        let mut builder = ptr::null_mut();
+        unsafe {
+            if sys::AAudio_createStreamBuilder(&mut builder) != sys::AAUDIO_OK || builder.is_null()
+            {
+                return Err(());
+            }
+            sys::AAudioStreamBuilder_setDirection(builder, sys::AAUDIO_DIRECTION_OUTPUT);
+            sys::AAudioStreamBuilder_setSampleRate(builder, rate);
+            sys::AAudioStreamBuilder_setChannelCount(builder, channels);
+            sys::AAudioStreamBuilder_setFormat(builder, sys::AAUDIO_FORMAT_PCM_I16);
+            sys::AAudioStreamBuilder_setSharingMode(builder, sys::AAUDIO_SHARING_MODE_SHARED);
+            sys::AAudioStreamBuilder_setUsage(builder, sys::AAUDIO_USAGE_MEDIA);
+            sys::AAudioStreamBuilder_setBufferCapacityInFrames(builder, rate / 10);
+            let result = sys::AAudioStreamBuilder_openStream(builder, &mut self.stream);
+            sys::AAudioStreamBuilder_delete(builder);
+            if result != sys::AAUDIO_OK || self.stream.is_null() {
+                return Err(());
+            }
+            if sys::AAudioStream_getSampleRate(self.stream) != rate
+                || sys::AAudioStream_getChannelCount(self.stream) != channels
+                || sys::AAudioStream_getFormat(self.stream) != sys::AAUDIO_FORMAT_PCM_I16
+            {
+                return Err(());
+            }
+            clock.has_audio = true;
+            clock.audio_sample_rate = i64::from(rate);
+            clock.reset_audio_epoch(sys::AAudioStream_getFramesRead(self.stream));
+        }
+        self.rate = rate;
+        self.channels = channels;
+        self.set_running(playing)
+    }
+    fn set_running(&mut self, running: bool) -> Result<(), ()> {
+        if self.stream.is_null() {
+            return Ok(());
+        }
+        let mut transition = Transition {
+            stream: self.stream,
+            deadline: Instant::now() + Duration::from_millis(300),
+        };
+        if running {
+            crate::audio_state::start(&mut transition)
+        } else {
+            crate::audio_state::pause(&mut transition)
+        }
+    }
+    fn write(&mut self, playing: bool, gain: f32, clock: &mut MasterClock) -> Result<(), ()> {
+        if !playing || self.stream.is_null() {
+            return Ok(());
+        }
+        clock.observe_audio_consumed(unsafe { sys::AAudioStream_getFramesRead(self.stream) });
+        let Some(q) = &mut self.pending else {
+            self.last_progress = Instant::now();
+            return Ok(());
+        };
+        if clock.audio_frames_written == 0 {
+            clock.reset_audio_epoch(unsafe { sys::AAudioStream_getFramesRead(self.stream) });
+            clock.anchor_audio_start(q.pts_us);
+        }
+        let adjusted;
+        let samples = if (gain - 1.0).abs() > f32::EPSILON {
+            adjusted = q
+                .remaining()
+                .iter()
+                .map(|v| {
+                    (f32::from(*v) * gain)
+                        .round()
+                        .clamp(i16::MIN as f32, i16::MAX as f32) as i16
+                })
+                .collect::<Vec<_>>();
+            &adjusted[..]
+        } else {
+            q.remaining()
+        };
+        let result = unsafe {
+            sys::AAudioStream_write(
+                self.stream,
+                samples.as_ptr().cast(),
+                q.frames().min(i32::MAX as usize) as i32,
+                0,
+            )
+        };
+        let written = q.accept(result)?;
+        if written > 0 {
+            self.last_progress = Instant::now();
+            clock.audio_frames_written = clock.audio_frames_written.saturating_add(written as u64);
+        } else if self.last_progress.elapsed() > Duration::from_secs(2) {
+            return Err(());
+        }
+        if q.frames() == 0 {
+            self.pending = None;
+        }
+        Ok(())
+    }
+}
+impl AudioOutput {
+    fn close(&mut self) {
+        if !self.stream.is_null() {
+            unsafe {
+                sys::AAudioStream_requestStop(self.stream);
+                sys::AAudioStream_close(self.stream);
+            }
+            self.stream = ptr::null_mut();
+        }
+    }
+}
+impl Drop for AudioOutput {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+struct Transition {
+    stream: *mut sys::AAudioStream,
+    deadline: Instant,
+}
+impl crate::audio_state::Stream for Transition {
+    fn state(&mut self) -> Result<i32, ()> {
+        let mut state = 1;
+        if unsafe { sys::AAudioStream_waitForStateChange(self.stream, 1, &mut state, 0) }
+            == sys::AAUDIO_OK
+        {
+            Ok(state)
+        } else {
+            Err(())
+        }
+    }
+    fn request(&mut self, request: crate::audio_state::Request) -> Result<(), ()> {
+        let result = unsafe {
+            match request {
+                crate::audio_state::Request::Pause => sys::AAudioStream_requestPause(self.stream),
+                crate::audio_state::Request::Flush => sys::AAudioStream_requestFlush(self.stream),
+                crate::audio_state::Request::Start => sys::AAudioStream_requestStart(self.stream),
+            }
+        };
+        if result == sys::AAUDIO_OK {
+            Ok(())
+        } else {
+            Err(())
+        }
+    }
+    fn wait(&mut self, transient: i32) -> Result<i32, ()> {
+        let left = self
+            .deadline
+            .checked_duration_since(Instant::now())
+            .ok_or(())?;
+        let mut state = transient;
+        if unsafe {
+            sys::AAudioStream_waitForStateChange(
+                self.stream,
+                transient,
+                &mut state,
+                left.as_nanos() as i64,
+            )
+        } == sys::AAUDIO_OK
+        {
+            Ok(state)
+        } else {
+            Err(())
+        }
+    }
+}
