+
+//! Worker-owned adaptive output bridge. No DOM exposure. The caller owns the
+//! shared surface owner so every codec stops before reader destruction.
+//! pump() does bounded work and must be called between commands.
+use super::{
+    mse_codec::{CodecSurface, MseCodecInput, MseOutput},
+    sys,
+};
+use crate::{
+    audio_queue::AudioQueue,
+    clock::MasterClock,
+    color::{self, Matrix as ColorMatrix, Range as ColorRange},
+    focus::{self, FocusTracker, Hold},
+    mse_demux::{bridge::DecoderConfig, delivery::CodecInput, session::AppendSession},
+    yuv_pack::{Planes, crop_i420, pack_i420},
+};
+use servo_media_player::video::{Buffer, VideoFrame, VideoFrameData, VideoFrameRenderer};
+use std::{
+    collections::BTreeMap,
+    ptr,
+    rc::Rc,
+    sync::{Arc, Mutex},
+    time::{Duration, Instant},
+};
+use yuv::{YuvPlanarImage, YuvRange, YuvStandardMatrix, yuv420_to_bgra};
+
+pub struct VideoSurface {
+    reader: *mut sys::AImageReader,
+    window: *mut sys::ANativeWindow,
+}
+impl VideoSurface {
+    pub fn new(width: i32, height: i32) -> Result<Self, ()> {
+        if width <= 0 || height <= 0 || width > 4096 || height > 4096 {
+            return Err(());
+        }
+        let mut s = Self {
+            reader: ptr::null_mut(),
+            window: ptr::null_mut(),
+        };
+        unsafe {
+            if sys::AImageReader_new(
+                width,
+                height,
+                sys::AIMAGE_FORMAT_YUV_420_888,
+                4,
+                &mut s.reader,
+            ) != sys::AMEDIA_OK
+                || s.reader.is_null()
+            {
+                return Err(());
+            }
+            if sys::AImageReader_getWindow(s.reader, &mut s.window) != sys::AMEDIA_OK
+                || s.window.is_null()
+            {
+                return Err(());
+            }
+        }
+        Ok(s)
+    }
+    /// Acquisition is retried on later worker ticks, not assumed synchronous
+    /// with releaseOutputBuffer. Exactly one surface frame is outstanding.
+    fn acquire(&self, standard: Option<i32>, range: Option<i32>) -> Result<Option<VideoFrame>, ()> {
+        let mut image = ptr::null_mut();
+        let status = unsafe { sys::AImageReader_acquireLatestImage(self.reader, &mut image) };
+        if status == sys::AMEDIA_IMGREADER_NO_BUFFER_AVAILABLE {
+            return Ok(None);
+        }
+        if status != sys::AMEDIA_OK || image.is_null() {
+            return Err(());
+        }
+        struct Image(*mut sys::AImage);
+        impl Drop for Image {
+            fn drop(&mut self) {
+                unsafe {
+                    sys::AImage_delete(self.0);
+                }
+            }
+        }
+        let image = Image(image);
+        let mut width = 0;
+        let mut height = 0;
+        unsafe {
+            if sys::AImage_getWidth(image.0, &mut width) != sys::AMEDIA_OK
+                || sys::AImage_getHeight(image.0, &mut height) != sys::AMEDIA_OK
+            {
+                return Err(());
+            }
+        }
+        if width <= 0
+            || height <= 0
+            || width > 4096
+            || height > 4096
+            || width % 2 != 0
+            || height % 2 != 0
+        {
+            return Err(());
+        }
+        let mut data = [ptr::null_mut(); 3];
+        let mut len = [0; 3];
+        let mut row = [0; 3];
+        let mut pixel = [0; 3];
+        for p in 0..3 {
+            unsafe {
+                if sys::AImage_getPlaneData(image.0, p as i32, &mut data[p], &mut len[p])
+                    != sys::AMEDIA_OK
+                    || sys::AImage_getPlaneRowStride(image.0, p as i32, &mut row[p])
+                        != sys::AMEDIA_OK
+                    || sys::AImage_getPlanePixelStride(image.0, p as i32, &mut pixel[p])
+                        != sys::AMEDIA_OK
+                {
+                    return Err(());
+                }
+            }
+            if data[p].is_null()
+                || len[p] <= 0
+                || len[p] > 64 * 1024 * 1024
+                || row[p] <= 0
+                || row[p] > 1024 * 1024
+                || pixel[p] <= 0
+                || pixel[p] > 16
+            {
+                return Err(());
+            }
+        }
+        if pixel[0] != 1 {
+            return Err(());
+        }
+        let (w, h) = (width as usize, height as usize);
+        let packed = unsafe {
+            pack_i420(&Planes {
+                width: w,
+                height: h,
+                y: std::slice::from_raw_parts(data[0], len[0] as usize),
+                y_row_stride: row[0] as usize,
+                u: std::slice::from_raw_parts(data[1], len[1] as usize),
+                u_row_stride: row[1] as usize,
+                u_pixel_stride: pixel[1] as usize,
+                v: std::slice::from_raw_parts(data[2], len[2] as usize),
+                v_row_stride: row[2] as usize,
+                v_pixel_stride: pixel[2] as usize,
+            })
+        }
+        .ok_or(())?;
+        let mut crop = sys::AImageCropRect::default();
+        if unsafe { sys::AImage_getCropRect(image.0, &mut crop) } != sys::AMEDIA_OK
+            || crop.left < 0
+            || crop.top < 0
+            || crop.right < 0
+            || crop.bottom < 0
+        {
+            return Err(());
+        }
+        let packed = crop_i420(
+            &packed,
+            w,
+            h,
+            [
+                crop.left as usize,
+                crop.top as usize,
+                crop.right as usize,
+                crop.bottom as usize,
+            ],
+        )
+        .ok_or(())?;
+        let (width, height) = (crop.right - crop.left, crop.bottom - crop.top);
+        let (w, h) = (width as usize, height as usize);
+        let (cw, ch) = (w / 2, h / 2);
+        let planar = YuvPlanarImage {
+            width: width as u32,
+            height: height as u32,
+            y_stride: width as u32,
+            u_stride: cw as u32,
+            v_stride: cw as u32,
+            y_plane: &packed[..w * h],
+            u_plane: &packed[w * h..w * h + cw * ch],
+            v_plane: &packed[w * h + cw * ch..],
+        };
+        let mut bgra = vec![0; w * h * 4];
+        let (matrix, range) = color::select(height, standard, range);
+        yuv420_to_bgra(
+            &planar,
+            &mut bgra,
+            width as u32 * 4,
+            match range {
+                ColorRange::Full => YuvRange::Full,
+                ColorRange::Limited => YuvRange::Limited,
+            },
+            match matrix {
+                ColorMatrix::Bt601 => YuvStandardMatrix::Bt601,
+                ColorMatrix::Bt709 => YuvStandardMatrix::Bt709,
+            },
+        )
+        .map_err(|_| ())?;
+        VideoFrame::new(width, height, Arc::new(RawFrame(Arc::new(bgra))))
+            .ok_or(())
+            .map(Some)
+    }
+}
