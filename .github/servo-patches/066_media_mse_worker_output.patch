+/// Copy an even-aligned visible rectangle out of packed I420. Odd chroma phase
+/// is deliberately rejected instead of silently shifting color samples.
+pub fn crop_i420(data: &[u8], width: usize, height: usize, rect: [usize; 4]) -> Option<Vec<u8>> {
+    let [left, top, right, bottom] = rect;
+    if width == 0
+        || height == 0
+        || width % 2 != 0
+        || height % 2 != 0
+        || left >= right
+        || top >= bottom
+        || right > width
+        || bottom > height
+        || rect.iter().any(|v| v % 2 != 0)
+    {
+        return None;
+    }
+    let area = width.checked_mul(height)?;
+    let total = area.checked_add(area / 2)?;
+    if data.len() != total {
+        return None;
+    }
+    let (w, h) = (right - left, bottom - top);
+    let out_area = w.checked_mul(h)?;
+    let mut out = Vec::with_capacity(out_area.checked_add(out_area / 2)?);
+    for (base, stride, l, t, r, b) in [
+        (0, width, left, top, right, bottom),
+        (area, width / 2, left / 2, top / 2, right / 2, bottom / 2),
+        (
+            area + area / 4,
+            width / 2,
+            left / 2,
+            top / 2,
+            right / 2,
+            bottom / 2,
+        ),
+    ] {
+        for row in t..b {
+            out.extend_from_slice(data.get(base + row * stride + l..base + row * stride + r)?);
+        }
+    }
+    Some(out)
+}
+#[cfg(test)]
+mod crop_tests {
+    use super::*;
+    #[test]
+    fn visible_rectangle_crops_all_three_planes() {
+        let mut src: Vec<u8> = (0..32).collect();
+        src.extend(100..108);
+        src.extend(200..208);
+        assert_eq!(
+            crop_i420(&src, 8, 4, [2, 2, 6, 4]).unwrap(),
+            [18, 19, 20, 21, 26, 27, 28, 29, 105, 106, 205, 206]
+        );
+    }
+    #[test]
+    fn invalid_or_unaligned_crop_is_rejected() {
+        for rect in [
+            [1, 0, 4, 4],
+            [0, 0, 6, 4],
+            [0, 0, 4, 6],
+            [0, 0, 0, 4],
+            [2, 2, 0, 0],
+        ] {
+            assert!(crop_i420(&[0; 24], 4, 4, rect).is_none());
+        }
+        assert!(crop_i420(&[0; 23], 4, 4, [0, 0, 4, 4]).is_none());
+        assert!(crop_i420(&[], usize::MAX - 1, usize::MAX - 1, [0, 0, 2, 2]).is_none());
+    }
+}
