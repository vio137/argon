+use super::*;
+use std::cell::Cell;
+thread_local! { static READY: Cell<bool> = const { Cell::new(false) }; static DELETED: Cell<u32> = const { Cell::new(0) }; }
+static Y: [u8; 32] = [41; 32];
+static U: [u8; 8] = [240; 8];
