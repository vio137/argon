+struct Decoders {
+    track_ids: BTreeMap<(u32, u32), u32>,
+    next_track: u32,
+    configs: BTreeMap<u32, DecoderConfig>,
+    surface: Option<Rc<VideoSurface>>,
+    video_size: Option<(u16, u16)>,
+    video: Option<(u32, MseCodecInput)>,
+    audio: Option<(u32, MseCodecInput)>,
+    first_pts: Option<i64>,
+}
+impl CodecInput for Decoders {
+    fn configure(&mut self, config: &DecoderConfig) -> Result<(), ()> {
+        if let Some(old) = self.configs.get(&config.track_id) {
+            return if old.mime == config.mime
+                && old.width == config.width
+                && old.height == config.height
+                && old.sample_rate == config.sample_rate
+                && old.channels == config.channels
+                && old.csd0 == config.csd0
+                && old.csd1 == config.csd1
+            {
+                Ok(())
+            } else {
+                Err(())
+            };
+        }
+        if self
+            .video
+            .as_ref()
+            .is_some_and(|(id, _)| *id == config.track_id)
+            || self
+                .audio
+                .as_ref()
+                .is_some_and(|(id, _)| *id == config.track_id)
+        {
+            return Err(());
+        }
+        let slot = if config.mime == "video/avc" {
+            &mut self.video
+        } else if config.mime == "audio/mp4a-latm" {
+            &mut self.audio
+        } else {
+            return Err(());
+        };
+        if slot.is_some() {
+            return Err(());
+        }
+        let mut codec = MseCodecInput::new(if config.mime == "video/avc" {
+            let surface = Rc::new(VideoSurface::new(
+                i32::from(config.width),
+                i32::from(config.height),
+            )?);
+            self.surface = Some(surface.clone());
+            self.video_size = Some((config.width, config.height));
+            Some(surface)
+        } else {
+            None
+        });
+        codec.configure(config)?;
+        *slot = Some((config.track_id, codec));
+        self.configs.insert(config.track_id, config.clone());
+        Ok(())
+    }
+    fn submit(&mut self, track_id: u32, bytes: &[u8], pts_us: i64) -> Result<bool, ()> {
+        if self.first_pts.is_none() {
+            self.first_pts = Some(pts_us);
+        }
+        if let Some((id, c)) = &mut self.video {
+            if *id == track_id {
+                return c.submit(track_id, bytes, pts_us);
+            }
+        }
+        if let Some((id, c)) = &mut self.audio {
+            if *id == track_id {
+                return c.submit(track_id, bytes, pts_us);
+            }
+        }
+        Err(())
+    }
+}
+
+/// Independent initialization segments often both number their only track1.
+/// Namespace those IDs before they reach the shared audio/video decoder set.
+struct ScopedDecoder<'a> {
+    buffer_id: u32,
+    decoders: &'a mut Decoders,
+}
+impl CodecInput for ScopedDecoder<'_> {
+    fn configure(&mut self, config: &DecoderConfig) -> Result<(), ()> {
+        let key = (self.buffer_id, config.track_id);
+        let mapped = if let Some(id) = self.decoders.track_ids.get(&key) {
+            *id
+        } else {
+            self.decoders.next_track
+        };
+        let mut config = config.clone();
+        config.track_id = mapped;
+        self.decoders.configure(&config)?;
+        if !self.decoders.track_ids.contains_key(&key) {
+            self.decoders.track_ids.insert(key, mapped);
+            self.decoders.next_track = self.decoders.next_track.checked_add(1).ok_or(())?;
+        }
+        Ok(())
+    }
+    fn submit(&mut self, track_id: u32, bytes: &[u8], pts_us: i64) -> Result<bool, ()> {
+        let mapped = *self
+            .decoders
+            .track_ids
+            .get(&(self.buffer_id, track_id))
+            .ok_or(())?;
+        self.decoders.submit(mapped, bytes, pts_us)
+    }
+}
