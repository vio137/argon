+//! Bounded coded-frame storage foundation. Not a complete MSE SourceBuffer.
+use super::AccessUnit;
+use std::collections::{BTreeMap, BTreeSet};
+#[derive(Debug, PartialEq, Eq)]
+pub enum StoreError {
+    Quota,
+    Timestamp,
+    Window,
+}
+pub struct FrameStore {
+    tracks: BTreeMap<u32, Vec<AccessUnit>>,
+    need_random_access: BTreeSet<u32>,
+    bytes: usize,
+    limit: usize,
+}
+impl FrameStore {
+    pub fn new(limit: usize) -> Self {
+        Self {
+            tracks: BTreeMap::new(),
+            need_random_access: BTreeSet::new(),
+            bytes: 0,
+            limit,
+        }
+    }
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+    pub fn frames(&self, track: u32) -> &[AccessUnit] {
+        self.tracks.get(&track).map(Vec::as_slice).unwrap_or(&[])
+    }
+    pub fn discontinuity(&mut self) {
+        self.need_random_access.extend(self.tracks.keys().copied());
+    }
+    pub fn append(
+        &mut self,
+        mut input: Vec<AccessUnit>,
+        offset_us: i64,
+        window: std::ops::Range<i64>,
+    ) -> Result<(), StoreError> {
+        if window.start < 0 || window.end <= window.start {
+            return Err(StoreError::Window);
+        }
+        let mut bytes = 0usize;
+        // Validate transaction before changing existing buffered frames.
+        for f in &mut input {
+            if f.duration_us <= 0 {
+                return Err(StoreError::Timestamp);
+            }
+            f.pts_us = f
+                .pts_us
+                .checked_add(offset_us)
+                .ok_or(StoreError::Timestamp)?;
+            f.dts_us = f
+                .dts_us
+                .checked_add(offset_us)
+                .ok_or(StoreError::Timestamp)?;
+            f.pts_us
+                .checked_add(f.duration_us)
+                .ok_or(StoreError::Timestamp)?;
+            bytes = bytes.checked_add(f.data.len()).ok_or(StoreError::Quota)?;
+        }
+        if self.bytes.checked_add(bytes).ok_or(StoreError::Quota)? > self.limit {
+            return Err(StoreError::Quota);
+        }
+        for frame in input {
+            let track = frame.track_id;
+            let end = frame.pts_us + frame.duration_us;
+            if !self.tracks.contains_key(&track) {
+                self.need_random_access.insert(track);
+            }
+            if frame.pts_us < window.start || end > window.end {
+                self.need_random_access.insert(track);
+                continue;
+            }
+            if self.need_random_access.contains(&track) && !frame.keyframe {
+                continue;
+            }
+            self.need_random_access.remove(&track);
+            let frames = self.tracks.entry(track).or_default();
+            // Overlapping coded frames and dependent successors up to the next
+            // random-access frame are removed together; never keep a decoder
+            // dependency chain whose predecessor was replaced.
+            let first = frames
+                .iter()
+                .position(|f| f.pts_us < end && f.pts_us + f.duration_us > frame.pts_us);
+            if let Some(first) = first {
+                let last_overlap = frames
+                    .iter()
+                    .rposition(|f| f.pts_us < end && f.pts_us + f.duration_us > frame.pts_us)
+                    .unwrap();
+                let stop = (last_overlap + 1..frames.len())
+                    .find(|&i| frames[i].keyframe)
+                    .unwrap_or(frames.len());
+                for old in frames.drain(first..stop) {
+                    self.bytes -= old.data.len();
+                }
+            }
+            self.bytes += frame.data.len();
+            frames.push(frame);
+            frames.sort_by_key(|f| f.dts_us);
+        }
+        Ok(())
+    }
+    pub fn remove(&mut self, start: i64, end: i64) -> Result<(), StoreError> {
+        if start < 0 || end <= start {
+            return Err(StoreError::Window);
+        }
+        for (&id, frames) in &mut self.tracks {
+            let first = frames
+                .iter()
+                .position(|f| f.pts_us >= start && f.pts_us < end);
+            if let Some(first) = first {
+                let last = frames
+                    .iter()
+                    .rposition(|f| f.pts_us >= start && f.pts_us < end)
+                    .unwrap();
+                let stop = (last + 1..frames.len())
+                    .find(|&i| frames[i].keyframe)
+                    .unwrap_or(frames.len());
+                for old in frames.drain(first..stop) {
+                    self.bytes -= old.data.len();
+                }
+                self.need_random_access.insert(id);
+            }
+        }
+        Ok(())
+    }
+    pub fn ranges(&self, track: u32) -> Vec<std::ops::Range<i64>> {
+        let mut spans: Vec<_> = self
+            .frames(track)
+            .iter()
+            .map(|f| f.pts_us..f.pts_us + f.duration_us)
+            .collect();
+        spans.sort_by_key(|x| x.start);
+        let mut output: Vec<std::ops::Range<i64>> = vec![];
+        for span in spans {
+            if let Some(last) = output.last_mut() {
+                if span.start <= last.end {
+                    last.end = last.end.max(span.end);
+                    continue;
+                }
+            }
+            output.push(span);
+        }
+        output
+    }
+}
