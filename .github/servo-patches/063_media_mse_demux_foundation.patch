+            [0, 0, 0, 0, b'm', b'd', b'a', b't'],
+        ] {
+            let mut f = BoxFramer::new(64);
+            f.append(&d).unwrap();
+            assert!(f.pop_box().is_err());
+        }
+        let mut f = BoxFramer::new(8);
+        assert_eq!(f.append(&[0; 9]), Err(Error::Quota));
+        assert_eq!(f.finish(), Ok(()));
+    }
+    #[test]
+    fn extended_size_and_truncation() {
+        let mut f = BoxFramer::new(32);
