@@ -0,0 +1,127 @@
+//! AVC CSD and length-prefixed access-unit conversion for Android codec input.
+//! Format construction/codec invocation are separate, not implemented here.
+use shiguredo_mp4::boxes::SampleEntry;
+#[derive(Debug, PartialEq, Eq)]
+pub enum AvcError {
+    Unsupported,
+    Invalid,
+    Quota,
+}
+pub struct AvcConfig {
+    pub width: u16,
+    pub height: u16,
+    pub length_bytes: usize,
+    pub csd0: Vec<u8>,
+    pub csd1: Vec<u8>,
+}
+fn parameters(list: &[Vec<u8>], nal_type: u8, limit: usize) -> Result<Vec<u8>, AvcError> {
+    if list.is_empty() {
+        return Err(AvcError::Invalid);
+    }
+    let mut out = vec![];
+    for nal in list {
+        if nal.is_empty() || nal[0] & 31 != nal_type {
+            return Err(AvcError::Invalid);
+        }
+        if out
+            .len()
+            .checked_add(nal.len() + 4)
+            .ok_or(AvcError::Quota)?
+            > limit
+        {
+            return Err(AvcError::Quota);
+        }
+        out.extend_from_slice(&[0, 0, 0, 1]);
+        out.extend(nal);
+    }
+    Ok(out)
+}
+impl AvcConfig {
+    pub fn from_entry(entry: &SampleEntry, limit: usize) -> Result<Self, AvcError> {
+        let SampleEntry::Avc1(avc) = entry else {
+            return Err(AvcError::Unsupported);
+        };
+        let length_bytes = usize::from(avc.avcc_box.length_size_minus_one.get()) + 1;
+        if avc.visual.width == 0 || avc.visual.height == 0 || length_bytes == 3 {
+            return Err(AvcError::Invalid);
+        }
+        Ok(Self {
+            width: avc.visual.width,
+            height: avc.visual.height,
+            length_bytes,
+            csd0: parameters(&avc.avcc_box.sps_list, 7, limit)?,
+            csd1: parameters(&avc.avcc_box.pps_list, 8, limit)?,
+        })
+    }
+    pub fn annex_b(&self, sample: &[u8], limit: usize) -> Result<Vec<u8>, AvcError> {
+        convert(sample, self.length_bytes, limit)
+    }
+}
+fn convert(sample: &[u8], length_bytes: usize, limit: usize) -> Result<Vec<u8>, AvcError> {
+    if ![1, 2, 4].contains(&length_bytes) {
+        return Err(AvcError::Invalid);
+    }
+    let mut pos = 0usize;
+    let mut out = vec![];
+    while pos < sample.len() {
+        let h = sample
+            .get(pos..pos.checked_add(length_bytes).ok_or(AvcError::Invalid)?)
+            .ok_or(AvcError::Invalid)?;
+        let mut n = 0usize;
+        for &b in h {
+            n = (n << 8) | usize::from(b);
+        }
+        pos += length_bytes;
+        if n == 0 {
+            return Err(AvcError::Invalid);
+        }
+        let end = pos.checked_add(n).ok_or(AvcError::Invalid)?;
+        let nal = sample.get(pos..end).ok_or(AvcError::Invalid)?;
+        if out.len().checked_add(n + 4).ok_or(AvcError::Quota)? > limit {
+            return Err(AvcError::Quota);
+        }
+        out.extend_from_slice(&[0, 0, 0, 1]);
+        out.extend(nal);
+        pos = end;
+    }
+    if out.is_empty() {
+        return Err(AvcError::Invalid);
+    }
+    Ok(out)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn multiple_nals_and_length_fields() {
+        for width in [1, 2, 4] {
+            let mut bytes = vec![0; width];
+            bytes[width - 1] = 2;
+            bytes.extend([0x65, 0xaa]);
+            bytes.extend(vec![0; width]);
+            let p = bytes.len() - 1;
+            bytes[p] = 1;
+            bytes.push(0x61);
+            assert_eq!(
+                convert(&bytes, width, 64),
+                Ok(vec![0, 0, 0, 1, 0x65, 0xaa, 0, 0, 0, 1, 0x61])
+            );
+        }
+    }
+    #[test]
+    fn malformed_nal_lengths_and_quota() {
+        assert_eq!(convert(&[0, 0, 0, 9, 1], 4, 64), Err(AvcError::Invalid));
+        assert_eq!(convert(&[0], 4, 64), Err(AvcError::Invalid));
+        assert_eq!(convert(&[0, 0, 0, 0], 4, 64), Err(AvcError::Invalid));
+        assert_eq!(convert(&[1, 0x65], 1, 4), Err(AvcError::Quota));
+    }
+    #[test]
+    fn csd_validates_parameter_type() {
+        assert_eq!(
+            parameters(&[vec![0x67, 1]], 7, 16),
+            Ok(vec![0, 0, 0, 1, 0x67, 1])
+        );
+        assert_eq!(parameters(&[vec![0x68]], 7, 16), Err(AvcError::Invalid));
+        assert_eq!(parameters(&[], 7, 16), Err(AvcError::Invalid));
+    }
+}
