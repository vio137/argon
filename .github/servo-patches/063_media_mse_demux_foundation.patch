+            .unwrap();
+        assert_eq!(f.pop_box(), Ok(None));
+        assert_eq!(f.finish(), Err(Error::Truncated));
+        f.append(&[1]).unwrap();
+        assert_eq!(f.pop_box().unwrap().unwrap().len(), 17);
