+            0..100,
+        )
+        .unwrap();
+        s.remove(10, 11).unwrap();
+        assert_eq!(s.ranges(1), vec![0..10, 30..40]);
+        assert_eq!(s.bytes(), 8);
+    }
+    #[test]
+    fn timestamp_overflow_does_not_change_store() {
+        let mut s = FrameStore::new(128);
+        assert_eq!(
+            s.append(vec![f(i64::MAX, true)], 1, 0..i64::MAX),
+            Err(StoreError::Timestamp)
+        );
+        assert_eq!(s.bytes(), 0);
+    }
+    #[test]
+    fn discontinuity_requires_a_new_random_access_point() {
+        let mut s = FrameStore::new(128);
+        s.append(vec![f(0, true)], 0, 0..100).unwrap();
+        s.discontinuity();
+        s.append(vec![f(10, false), f(20, true)], 0, 0..100)
+            .unwrap();
+        assert_eq!(s.ranges(1), vec![0..10, 20..30]);
+    }
+}
