@@ -0,0 +1,379 @@
+//! Private, unintegrated fMP4 adapter prototype. Not advertised as MSE support.
+use shiguredo_mp4::{boxes::SampleEntry, demux::Fmp4SegmentDemuxer};
+use std::ops::Range;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum Error {
+    Quota,
+    InvalidBox,
+    Truncated,
+    UnsupportedLayout,
+    Demux,
+    InvalidSample,
+    Timestamp,
+}
+pub struct BoxFramer {
+    pending: Vec<u8>,
+    limit: usize,
+}
+impl BoxFramer {
+    pub fn new(limit: usize) -> Self {
+        Self {
+            pending: vec![],
+            limit,
+        }
+    }
+    pub fn append(&mut self, data: &[u8]) -> Result<(), Error> {
+        if self
+            .pending
+            .len()
+            .checked_add(data.len())
+            .ok_or(Error::Quota)?
+            > self.limit
+        {
+            return Err(Error::Quota);
+        }
+        self.pending.extend_from_slice(data);
+        Ok(())
+    }
+    pub fn pop_box(&mut self) -> Result<Option<Vec<u8>>, Error> {
+        let Some(size) = box_len(&self.pending)? else {
+            return Ok(None);
+        };
+        if size > self.limit {
+            return Err(Error::Quota);
+        }
+        if size > self.pending.len() {
+            return Ok(None);
+        }
+        Ok(Some(self.pending.drain(..size).collect()))
+    }
+    pub fn finish(&self) -> Result<(), Error> {
+        if self.pending.is_empty() {
+            Ok(())
+        } else {
+            Err(Error::Truncated)
+        }
+    }
+    pub fn reset(&mut self) {
+        self.pending.clear();
+    }
+}
+fn box_len(data: &[u8]) -> Result<Option<usize>, Error> {
+    if data.len() < 8 {
+        return Ok(None);
+    }
+    let small = u32::from_be_bytes(data[..4].try_into().unwrap());
+    let size = match small {
+        0 => return Err(Error::UnsupportedLayout), // EOF-sized box needs a different live-stream contract.
+        1 => {
+            if data.len() < 16 {
+                return Ok(None);
+            }
+            u64::from_be_bytes(data[8..16].try_into().unwrap())
+        },
+        n => n as u64,
+    };
+    let min = if small == 1 { 16 } else { 8 };
+    if size < min {
+        return Err(Error::InvalidBox);
+    }
+    Ok(Some(usize::try_from(size).map_err(|_| Error::Quota)?))
+}
+fn top_boxes(data: &[u8]) -> Result<Vec<([u8; 4], Range<usize>, Range<usize>)>, Error> {
+    let mut out = vec![];
+    let mut pos = 0usize;
+    while pos < data.len() {
+        let len = box_len(&data[pos..])?.ok_or(Error::Truncated)?;
+        let end = pos.checked_add(len).ok_or(Error::Quota)?;
+        if end > data.len() {
+            return Err(Error::Truncated);
+        }
+        let header = if data[pos..pos + 4] == [0, 0, 0, 1] {
+            16
+        } else {
+            8
+        };
+        out.push((
+            data[pos + 4..pos + 8].try_into().unwrap(),
+            pos..end,
+            pos + header..end,
+        ));
+        pos = end;
+    }
+    Ok(out)
+}
+fn validate_init(data: &[u8]) -> Result<(), Error> {
+    if data.len() > 2 * 1024 * 1024 {
+        return Err(Error::Quota);
+    }
+    let boxes = top_boxes(data)?;
+    if boxes.iter().filter(|x| x.0 == *b"ftyp").count() != 1
+        || boxes.iter().filter(|x| x.0 == *b"moov").count() != 1
+    {
+        return Err(Error::InvalidBox);
+    }
+    let f = boxes.iter().find(|x| x.0 == *b"ftyp").unwrap();
+    let m = boxes.iter().find(|x| x.0 == *b"moov").unwrap();
+    if f.1.start > m.1.start {
+        return Err(Error::InvalidBox);
+    }
+    let mut budget = 4096usize;
+    let mut tracks = 0usize;
+    validate_init_children(&data[m.2.clone()], 0, &mut budget, &mut tracks)?;
+    if tracks == 0 || tracks > 16 {
+        return Err(Error::Quota);
+    }
+    if !top_boxes(&data[m.2.clone()])?
+        .iter()
+        .any(|x| x.0 == *b"mvex")
+    {
+        return Err(Error::InvalidBox);
+    }
+    Ok(())
+}
+fn validate_init_children(
+    data: &[u8],
+    depth: usize,
+    budget: &mut usize,
+    tracks: &mut usize,
+) -> Result<(), Error> {
+    if depth > 8 {
+        return Err(Error::Quota);
+    }
+    for (kind, _, payload) in top_boxes(data)? {
+        *budget = budget.checked_sub(1).ok_or(Error::Quota)?;
+        if kind == *b"trak" {
+            *tracks += 1;
+            if *tracks > 16 {
+                return Err(Error::Quota);
+            }
+        }
+        if [*b"stts", *b"stsc", *b"stco", *b"co64"].contains(&kind) {
+            let bytes = &data[payload.clone()];
+            if bytes.len() < 8 {
+                return Err(Error::Truncated);
+            }
+            if bytes[4..8] != [0, 0, 0, 0] {
+                return Err(Error::InvalidBox);
+            }
+        }
+        // Edits/encryption need explicit timestamp/decryption handling, not
+        // silent ignore. DRM and nontrivial edit support are not implemented.
+        if [*b"edts", *b"pssh", *b"senc"].contains(&kind) {
+            return Err(Error::UnsupportedLayout);
+        }
+        if [*b"trak", *b"mdia", *b"minf", *b"stbl", *b"mvex"].contains(&kind) {
+            validate_init_children(&data[payload], depth + 1, budget, tracks)?;
+        }
+    }
+    Ok(())
+}
+// Inspect untrusted counts BEFORE the library materializes trun sample vectors.
+// Its16M zero-width sample cap is too large for the app memory budget.
+fn preflight_moof(data: &[u8], sample_limit: usize) -> Result<(), Error> {
+    let top = top_boxes(data)?;
+    let moof = top
+        .iter()
+        .find(|x| x.0 == *b"moof")
+        .ok_or(Error::InvalidBox)?;
+    let children = top_boxes(&data[moof.2.clone()])?;
+    let trafs: Vec<_> = children.iter().filter(|x| x.0 == *b"traf").collect();
+    if trafs.is_empty() || trafs.len() > 16 {
+        return Err(Error::InvalidBox);
+    }
+    let mut count = 0usize;
+    for traf in &trafs {
+        let body = &data[moof.2.start + traf.2.start..moof.2.start + traf.2.end];
+        let fields = top_boxes(body)?;
+        if fields.iter().filter(|x| x.0 == *b"tfdt").count() != 1 {
+            return Err(Error::InvalidBox);
+        }
+        let tfhd = fields
+            .iter()
+            .find(|x| x.0 == *b"tfhd")
+            .ok_or(Error::InvalidBox)?;
+        let h = body.get(tfhd.2.clone()).ok_or(Error::InvalidBox)?;
+        if h.len() < 8 {
+            return Err(Error::Truncated);
+        }
+        let flags = u32::from_be_bytes(h[..4].try_into().unwrap()) & 0x00ff_ffff;
+        if flags & 1 != 0 || (trafs.len() > 1 && flags & 0x020000 == 0) {
+            return Err(Error::UnsupportedLayout);
+        }
+        let mut first = true;
+        for trun in fields.iter().filter(|x| x.0 == *b"trun") {
+            let p = &body[trun.2.clone()];
+            if p.len() < 8 {
+                return Err(Error::Truncated);
+            }
+            let flags = u32::from_be_bytes(p[..4].try_into().unwrap()) & 0x00ff_ffff;
+            if first && flags & 1 == 0 {
+                return Err(Error::UnsupportedLayout);
+            }
+            first = false;
+            let samples = u32::from_be_bytes(p[4..8].try_into().unwrap()) as usize;
+            count = count.checked_add(samples).ok_or(Error::Quota)?;
+            if count > sample_limit {
+                return Err(Error::Quota);
+            }
+        }
+        if first {
+            return Err(Error::InvalidBox);
+        }
+    }
+    Ok(())
+}
+#[derive(Debug)]
+pub struct AccessUnit {
+    pub track_id: u32,
+    pub dts_us: i64,
+    pub pts_us: i64,
+    pub duration_us: i64,
+    pub keyframe: bool,
+    pub codec_config: Option<SampleEntry>,
+    pub data: Vec<u8>,
+}
+pub struct Demux {
+    inner: Fmp4SegmentDemuxer,
+    max_bytes: usize,
+    max_samples: usize,
+}
+impl Demux {
+    pub fn new(max_bytes: usize, max_samples: usize) -> Self {
+        Self {
+            inner: Fmp4SegmentDemuxer::new(),
+            max_bytes,
+            max_samples,
+        }
+    }
+    pub fn init(&mut self, data: &[u8]) -> Result<(), Error> {
+        if data.len() > self.max_bytes {
+            return Err(Error::Quota);
+        }
+        validate_init(data)?;
+        // New init can update codec configuration. Swap only after successful parse.
+        let mut next = Fmp4SegmentDemuxer::new();
+        next.handle_init_segment(data).map_err(|_| Error::Demux)?;
+        self.inner = next;
+        Ok(())
+    }
+    pub fn media(&mut self, data: &[u8]) -> Result<Vec<AccessUnit>, Error> {
+        if data.len() > self.max_bytes {
+            return Err(Error::Quota);
+        }
+        let boxes = top_boxes(data)?;
+        let mdats: Vec<_> = boxes.iter().filter(|x| x.0 == *b"mdat").collect();
+        if mdats.is_empty() || boxes.iter().filter(|x| x.0 == *b"moof").count() != 1 {
+            return Err(Error::UnsupportedLayout);
+        }
+        preflight_moof(data, self.max_samples)?;
+        let moof = boxes.iter().find(|x| x.0 == *b"moof").unwrap();
+        if mdats.iter().any(|x| x.1.start < moof.1.end) {
+            return Err(Error::InvalidBox);
+        }
+        // Dependency2026.5.0 expects one mdat directly after moof. Create a
+        // byte-position-preserving parser envelope over the original tail.
+        // Every real mdat payload remains at EXACTLY its original offset.
+        // Validate each returned sample against ORIGINAL payload ranges below,
+        // never the widened envelope that includes headers and ignored boxes.
+        let envelope_start = moof.1.end;
+        let envelope_len = data
+            .len()
+            .checked_sub(envelope_start)
+            .ok_or(Error::InvalidBox)?;
+        if envelope_len < 8 || envelope_len > u32::MAX as usize {
+            return Err(Error::UnsupportedLayout);
+        }
+        let mut envelope = data.to_vec();
+        envelope[envelope_start..envelope_start + 4]
+            .copy_from_slice(&(envelope_len as u32).to_be_bytes());
+        envelope[envelope_start + 4..envelope_start + 8].copy_from_slice(b"mdat");
+        // Transactional: invalid samples must not mutate sample-entry state.
+        let mut next = self.inner.clone();
+        let samples = next
+            .handle_media_segment(&envelope)
+            .map_err(|_| Error::Demux)?;
+        if samples.len() > self.max_samples {
+            return Err(Error::Quota);
+        }
+        let mut output = Vec::with_capacity(samples.len());
+        for s in samples {
+            let start = usize::try_from(s.data_offset).map_err(|_| Error::InvalidSample)?;
+            let end = start.checked_add(s.data_size).ok_or(Error::InvalidSample)?;
+            // Library's upper-bound check alone is insufficient: never copy box
+            // headers/metadata or data from outside mdat as compressed samples.
+            if !mdats.iter().any(|m| start >= m.2.start && end <= m.2.end) {
+                return Err(Error::InvalidSample);
+            }
+            let scale = s.track.timescale.get();
+            let dts = i128::from(s.timestamp);
+            let pts = dts + i128::from(s.composition_time_offset.unwrap_or(0));
+            output.push(AccessUnit {
+                track_id: s.track.track_id,
+                dts_us: micros(dts, scale)?,
+                pts_us: micros(pts, scale)?,
+                duration_us: micros(i128::from(s.duration), scale)?,
+                keyframe: s.keyframe,
+                codec_config: s.sample_entry.cloned(),
+                data: data[start..end].to_vec(),
+            });
+        }
+        self.inner = next;
+        Ok(output)
+    }
+}
+fn micros(value: i128, scale: u32) -> Result<i64, Error> {
+    i64::try_from(value.checked_mul(1_000_000).ok_or(Error::Timestamp)? / i128::from(scale))
+        .map_err(|_| Error::Timestamp)
+}
