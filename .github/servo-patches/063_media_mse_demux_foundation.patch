+use servo_media_android_hosttest::mse_demux::{BoxFramer, Demux};
+fn boxes() -> Vec<Vec<u8>> {
+    let bytes = include_bytes!("fixtures/synthetic-fmp4.mp4");
+    let mut f = BoxFramer::new(1 << 20);
+    let mut out = vec![];
+    for chunk in bytes.chunks(7) {
+        f.append(chunk).unwrap();
+        while let Some(b) = f.pop_box().unwrap() {
+            out.push(b);
+        }
+    }
+    f.finish().unwrap();
+    out
+}
+#[test]
+fn extract_real_muxed_avc_fragments_in_seven_byte_appends() {
+    let mut init = vec![];
+    let mut demux = Demux::new(1 << 20, 64);
+    let mut pending = vec![];
+    let mut units = vec![];
+    let mut initialized = false;
+    for b in boxes() {
+        match &b[4..8] {
+            b"ftyp" | b"moov" => {
+                init.extend(b);
+            }
+            b"moof" => {
+                if !initialized {
+                    demux.init(&init).unwrap();
+                    initialized = true;
+                }
+                pending = b;
+            }
+            b"mdat" => {
+                pending.extend(b);
+                units.extend(demux.media(&pending).unwrap());
+                pending.clear();
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(units.len(), 2);
+    assert_eq!(units[0].dts_us, 0);
+    assert_eq!(units[1].dts_us, 500_000);
+    assert_eq!(units[0].duration_us, 500_000);
+    assert!(units.iter().all(|s| s.keyframe && !s.data.is_empty()));
+    assert!(units[0].codec_config.is_some());
+}
+#[test]
+fn quota_and_missing_init_fail_without_output() {
+    let mut d = Demux::new(8, 1);
+    assert!(d.init(&[0; 9]).is_err());
+    let mut d = Demux::new(1 << 20, 64);
+    for pair in boxes().windows(2) {
+        if &pair[0][4..8] == b"moof" && &pair[1][4..8] == b"mdat" {
+            let mut media = pair[0].clone();
+            media.extend_from_slice(&pair[1]);
+            assert!(d.media(&media).is_err());
+            break;
+        }
+    }
+}
+#[test]
+fn hostile_trun_count_is_rejected_before_demux_allocation() {
+    let bs = boxes();
+    let mut init = vec![];
+    for b in &bs {
+        if [&b"ftyp"[..], &b"moov"[..]].contains(&&b[4..8]) {
+            init.extend(b);
+        }
+    }
+    let mut d = Demux::new(1 << 20, 64);
+    d.init(&init).unwrap();
+    for pair in bs.windows(2) {
+        if &pair[0][4..8] == b"moof" && &pair[1][4..8] == b"mdat" {
+            let mut media = pair[0].clone();
+            media.extend_from_slice(&pair[1]);
+            let p = media.windows(4).position(|x| x == b"trun").unwrap();
+            media[p + 8..p + 12].copy_from_slice(&u32::MAX.to_be_bytes());
+            assert!(matches!(
+                d.media(&media),
+                Err(servo_media_android_hosttest::mse_demux::Error::Quota)
+            ));
+            break;
+        }
+    }
+}
+#[test]
+fn sample_in_second_mdat_with_ignored_boxes_preserves_offsets() {
+    let bs = boxes();
+    let mut init = vec![];
+    for b in &bs {
+        if [&b"ftyp"[..], &b"moov"[..]].contains(&&b[4..8]) {
+            init.extend(b);
+        }
+    }
+    let pair = bs
+        .windows(2)
+        .find(|p| &p[0][4..8] == b"moof" && &p[1][4..8] == b"mdat")
+        .unwrap();
+    let mut original = pair[0].clone();
+    original.extend_from_slice(&pair[1]);
+    let mut d = Demux::new(1 << 20, 64);
+    d.init(&init).unwrap();
+    let expected = d.media(&original).unwrap();
+    let mut media = pair[0].clone();
+    let p = media.windows(4).position(|x| x == b"trun").unwrap();
+    let offset = i32::from_be_bytes(media[p + 12..p + 16].try_into().unwrap());
+    media[p + 12..p + 16].copy_from_slice(&(offset + 16).to_be_bytes());
+    // free box between moof and mdat, followed by empty mdat, then real payload.
+    media.extend_from_slice(&[0, 0, 0, 8, b'f', b'r', b'e', b'e']);
+    media.extend_from_slice(&[0, 0, 0, 8, b'm', b'd', b'a', b't']);
+    media.extend_from_slice(&pair[1]);
+    media.extend_from_slice(&[0, 0, 0, 8, b'f', b'r', b'e', b'e']);
+    let mut d = Demux::new(1 << 20, 64);
+    d.init(&init).unwrap();
+    let got = d.media(&media).unwrap();
+    assert_eq!(got.len(), expected.len());
+    assert_eq!(got[0].data, expected[0].data);
+    assert_eq!(got[0].pts_us, expected[0].pts_us);
+}
+#[test]
+fn sample_pointer_into_box_header_is_rejected() {
+    let bs = boxes();
+    let mut init = vec![];
+    for b in &bs {
+        if [&b"ftyp"[..], &b"moov"[..]].contains(&&b[4..8]) {
+            init.extend(b);
+        }
+    }
+    let pair = bs
+        .windows(2)
+        .find(|p| &p[0][4..8] == b"moof" && &p[1][4..8] == b"mdat")
+        .unwrap();
+    let mut media = pair[0].clone();
+    media.extend_from_slice(&pair[1]);
+    let p = media.windows(4).position(|x| x == b"trun").unwrap();
+    media[p + 12..p + 16].copy_from_slice(&(pair[0].len() as i32).to_be_bytes());
+    let mut d = Demux::new(1 << 20, 64);
+    d.init(&init).unwrap();
+    assert!(d.media(&media).is_err());
+}
