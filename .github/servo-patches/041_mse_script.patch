+
+    pub(crate) fn new_with_proto(
+        cx: &mut JSContext,
+        global: &GlobalScope,
+        proto: Option<HandleObject>,
+    ) -> Fallible<DomRoot<Self>> {
+        let this = Self::new_inherited().ok_or(Error::NotSupported(Some(
+            "MSE backend not available".to_owned(),
+        )))?;
+        Ok(reflect_dom_object_with_proto(cx, Box::new(this), global, proto))
+    }
