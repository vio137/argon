+//! Internal append-to-codec coordinator, not a DOM MediaSource. All methods
+//! belong to one worker thread. Failure poisons until explicit reset/recreate.
+use super::{
+    append::AppendStream,
+    bridge::DecoderBridge,
+    delivery::{CodecInput, Delivery},
+};
+#[derive(Debug, PartialEq, Eq)]
+pub enum SessionError {
+    Append,
+    Configuration,
+    Delivery,
+    Failed,
+}
+pub struct AppendSession {
+    stream: AppendStream,
+    bridge: DecoderBridge,
+    delivery: Delivery,
+    failed: bool,
+    ended: bool,
+}
+impl AppendSession {
+    pub fn new(limit: usize, max_samples: usize) -> Self {
+        Self {
+            stream: AppendStream::new(limit, max_samples),
+            bridge: DecoderBridge::new(limit),
+            delivery: Delivery::new(limit),
+            failed: false,
+            ended: false,
+        }
+    }
+    pub fn append(&mut self, data: &[u8]) -> Result<(), SessionError> {
+        if self.failed || self.ended {
+            return Err(SessionError::Failed);
+        }
+        let units = match self.stream.append(data) {
+            Ok(u) => u,
+            Err(_) => {
+                self.failed = true;
+                return Err(SessionError::Append);
+            },
+        };
+        self.queue(units)
+    }
+    pub fn end_of_stream(&mut self) -> Result<(), SessionError> {
+        if self.failed || self.ended {
+            return Err(SessionError::Failed);
+        }
+        let units = match self.stream.end_of_stream() {
+            Ok(u) => u,
+            Err(_) => {
+                self.failed = true;
+                return Err(SessionError::Append);
+            },
+        };
+        self.queue(units)?;
+        self.ended = true;
+        Ok(())
+    }
+    fn queue(&mut self, units: Vec<super::AccessUnit>) -> Result<(), SessionError> {
+        for unit in units {
+            let packet = match self.bridge.prepare(unit) {
+                Ok(p) => p,
+                Err(_) => {
+                    self.failed = true;
+                    return Err(SessionError::Configuration);
+                },
+            };
+            if self.delivery.push(packet).is_err() {
+                self.failed = true;
+                return Err(SessionError::Delivery);
+            }
+        }
+        Ok(())
+    }
+    pub fn pump_input(&mut self, sink: &mut impl CodecInput) -> Result<bool, SessionError> {
+        if self.failed {
+            return Err(SessionError::Failed);
+        }
+        self.delivery.pump(sink).map_err(|_| {
+            self.failed = true;
+            SessionError::Delivery
+        })
+    }
+    /// Input is exhausted, not decoder-output or audible/displayed completion.
+    pub fn input_exhausted(&self) -> bool {
+        !self.failed && self.ended && self.delivery.is_empty()
+    }
+}
