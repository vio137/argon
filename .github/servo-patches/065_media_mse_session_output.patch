+#[derive(Debug)]
+pub enum MseOutput {
+    Retry,
+    FormatChanged {
+        sample_rate: i32,
+        channels: i32,
+        pcm_encoding: i32,
+        width: i32,
+        height: i32,
+    },
+    SurfaceReleased {
+        pts_us: i64,
+        eos: bool,
+    },
+    Pcm {
+        samples: Vec<i16>,
+        pts_us: i64,
+        eos: bool,
+    },
+    EndOfStream,
+    CodecConfig,
+}
+struct OutputLease {
+    codec: *mut sys::AMediaCodec,
+    index: usize,
+    released: bool,
+}
+impl OutputLease {
+    fn release(&mut self, render: bool) -> Result<(), ()> {
+        let result =
+            unsafe { sys::AMediaCodec_releaseOutputBuffer(self.codec, self.index, render) };
+        // Do not retry a failed release on Drop: ownership after an error is
+        // unspecified. Caller must poison/drop the codec.
+        self.released = true;
+        if result == sys::AMEDIA_OK {
+            Ok(())
+        } else {
+            Err(())
+        }
+    }
+}
+impl Drop for OutputLease {
+    fn drop(&mut self) {
+        if !self.released {
+            unsafe {
+                sys::AMediaCodec_releaseOutputBuffer(self.codec, self.index, false);
+            }
+        }
+    }
+}
+impl MseCodecInput<'_> {
+    pub fn poll_output(&mut self) -> Result<MseOutput, ()> {
+        if self.codec.is_null() {
+            return Err(());
+        }
+        let mut info = sys::AMediaCodecBufferInfo::default();
+        let idx = unsafe { sys::AMediaCodec_dequeueOutputBuffer(self.codec, &mut info, 0) };
+        if idx == sys::AMEDIACODEC_INFO_TRY_AGAIN_LATER
+            || idx == sys::AMEDIACODEC_INFO_OUTPUT_BUFFERS_CHANGED
+        {
+            return Ok(MseOutput::Retry);
+        }
+        if idx == sys::AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED {
+            let format = unsafe { sys::AMediaCodec_getOutputFormat(self.codec) };
+            if format.is_null() {
+                return Err(());
+            }
+            let get = |name: &std::ffi::CStr, default: i32| {
+                let mut value = default;
+                unsafe { sys::AMediaFormat_getInt32(format, name.as_ptr(), &mut value) };
+                value
+            };
+            let rate = get(c"sample-rate", 0);
+            let channels = get(c"channel-count", 0);
+            let encoding = get(c"pcm-encoding", 2);
+            let width = get(c"width", 0);
+            let height = get(c"height", 0);
+            unsafe { sys::AMediaFormat_delete(format) };
+            self.output_channels = channels;
+            self.output_pcm_encoding = encoding;
+            return Ok(MseOutput::FormatChanged {
+                sample_rate: rate,
+                channels,
+                pcm_encoding: encoding,
+                width,
+                height,
+            });
+        }
+        if idx < 0 {
+            return Err(());
+        }
+        let mut lease = OutputLease {
+            codec: self.codec,
+            index: idx as usize,
+            released: false,
+        };
+        let eos = info.flags & sys::AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM != 0;
+        if info.flags & 2 != 0 {
+            lease.release(false)?;
+            return Ok(MseOutput::CodecConfig);
+        }
+        if eos && info.size == 0 {
+            lease.release(false)?;
+            return Ok(MseOutput::EndOfStream);
+        }
+        if self.video {
+            // Surface release only queues rendering. This is not a displayed
+            // frame acknowledgment. Caller must acquire/render AImage separately.
+            lease.release(true)?;
+            return Ok(MseOutput::SurfaceReleased {
+                pts_us: info.presentation_time_us,
+                eos,
+            });
+        }
+        if info.size < 0
+            || info.size > 8 * 1024 * 1024
+            || self.output_channels <= 0
+            || self.output_channels > 8
+        {
+            return Err(());
+        }
+        if self.output_pcm_encoding != 2 {
+            return Err(());
+        }
+        let mut capacity = 0usize;
+        let src =
+            unsafe { sys::AMediaCodec_getOutputBuffer(self.codec, idx as usize, &mut capacity) };
+        if src.is_null() {
+            return Err(());
+        }
+        let range = crate::pcm::pcm16_range(capacity, info.offset, info.size, self.output_channels)
+            .ok_or(())?;
+        let bytes = unsafe { std::slice::from_raw_parts(src.add(range.start), range.len()) };
+        let samples = crate::pcm::copy_native_pcm16(bytes).ok_or(())?;
+        lease.release(false)?;
+        Ok(MseOutput::Pcm {
+            samples,
+            pts_us: info.presentation_time_us,
+            eos,
+        })
+    }
+}
