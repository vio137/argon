+#[test]
+fn append_session_drives_codec_boundary_without_claiming_output_completion() {
+    use servo_media_android_hosttest::mse_demux::{
+        bridge::DecoderConfig, delivery::CodecInput, session::AppendSession,
+    };
+    struct Sink {
+        configured: usize,
+        packets: usize,
+        ready: bool,
+    }
+    impl CodecInput for Sink {
+        fn configure(&mut self, c: &DecoderConfig) -> Result<(), ()> {
+            assert_eq!(c.mime, "video/avc");
+            assert_eq!((c.width, c.height), (32, 32));
+            self.configured += 1;
+            Ok(())
+        }
+        fn submit(&mut self, id: u32, bytes: &[u8], pts: i64) -> Result<bool, ()> {
+            assert!(id > 0);
+            assert!(bytes.starts_with(&[0, 0, 0, 1]));
+            assert_eq!(pts, self.packets as i64 * 500000);
+            if self.ready {
+                self.packets += 1;
+            }
+            Ok(self.ready)
+        }
+    }
+    let mut session = AppendSession::new(1 << 20, 128);
+    let bytes = include_bytes!("fixtures/synthetic-fmp4.mp4");
+    for chunk in bytes.chunks(7) {
+        session.append(chunk).unwrap();
+    }
+    session.end_of_stream().unwrap();
+    assert!(!session.input_exhausted());
+    let mut sink = Sink {
+        configured: 0,
+        packets: 0,
+        ready: false,
+    };
+    assert!(!session.pump_input(&mut sink).unwrap());
+    assert!(!session.input_exhausted());
+    sink.ready = true;
+    while session.pump_input(&mut sink).unwrap() {}
+    assert!(session.input_exhausted());
+    assert_eq!((sink.configured, sink.packets), (1, 2));
+    assert!(session.append(&[]).is_err());
+}
+#[test]
+fn append_session_does_not_deliver_queued_packets_after_append_failure() {
+    use servo_media_android_hosttest::mse_demux::{
+        bridge::DecoderConfig, delivery::CodecInput, session::AppendSession,
+    };
+    struct Sink;
+    impl CodecInput for Sink {
+        fn configure(&mut self, _: &DecoderConfig) -> Result<(), ()> {
+            panic!("must not configure failed session")
+        }
+        fn submit(&mut self, _: u32, _: &[u8], _: i64) -> Result<bool, ()> {
+            panic!("must not submit failed session")
+        }
+    }
+    let mut s = AppendSession::new(1024, 32);
+    assert!(s.append(&[0, 0, 0, 7, b'f', b'r', b'e', b'e']).is_err());
+    assert!(s.pump_input(&mut Sink).is_err());
+    assert!(!s.input_exhausted());
+}
