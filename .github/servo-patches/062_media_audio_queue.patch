diff --git a/components/media/backends/android/audio_queue.rs b/components/media/backends/android/audio_queue.rs
new file mode 100644
index 000000000..7af75c41b
--- /dev/null
+++ b/components/media/backends/android/audio_queue.rs
@@ -0,0 +1,68 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! One retained decoded PCM buffer. Partial/zero writes preserve samples so
+//! the pipeline can service commands between nonblocking write attempts.
+pub struct AudioQueue {
+    samples: Vec<i16>,
+    channels: usize,
+    offset_frames: usize,
+    pub pts_us: i64,
+}
+impl AudioQueue {
+    pub fn new(samples: Vec<i16>, channels: usize, pts_us: i64) -> Option<Self> {
+        if channels == 0 || samples.len() % channels != 0 {
+            return None;
+        }
+        Some(Self {
+            samples,
+            channels,
+            offset_frames: 0,
+            pts_us,
+        })
+    }
+    pub fn remaining(&self) -> &[i16] {
+        &self.samples[self.offset_frames * self.channels..]
+    }
+    pub fn frames(&self) -> usize {
+        self.remaining().len() / self.channels
+    }
+    pub fn accept(&mut self, result: i32) -> Result<usize, ()> {
+        let written = usize::try_from(result).map_err(|_| ())?;
+        if written > self.frames() {
+            return Err(());
+        }
+        self.offset_frames += written;
+        Ok(written)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn partial_and_zero_writes_preserve_exact_remaining_samples() {
+        let mut q = AudioQueue::new(vec![1, 2, 3, 4, 5, 6], 2, 900).unwrap();
+        assert_eq!(q.accept(1), Ok(1));
+        assert_eq!(q.remaining(), &[3, 4, 5, 6]);
+        assert_eq!(q.accept(0), Ok(0));
+        assert_eq!(q.remaining(), &[3, 4, 5, 6]);
+        assert_eq!(q.accept(2), Ok(2));
+        assert_eq!(q.frames(), 0);
+        assert_eq!(q.pts_us, 900);
+    }
+    #[test]
+    fn invalid_results_do_not_advance() {
+        let mut q = AudioQueue::new(vec![1, 2], 2, 0).unwrap();
+        assert_eq!(q.accept(-1), Err(()));
+        assert_eq!(q.accept(2), Err(()));
+        assert_eq!(q.frames(), 1);
+    }
+    #[test]
+    fn invalid_geometry_rejected_and_empty_queue_allowed() {
+        assert!(AudioQueue::new(vec![1], 2, 0).is_none());
+        assert!(AudioQueue::new(vec![], 0, 0).is_none());
+        assert_eq!(AudioQueue::new(vec![], 2, 0).unwrap().frames(), 0);
+    }
+}
