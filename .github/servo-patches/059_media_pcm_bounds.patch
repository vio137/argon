+
+//! Validate signed MediaCodec metadata before pointer arithmetic. PCM samples
+//! use native byte order, copied from bytes without assuming i16 alignment.
+use std::ops::Range;
+
+pub fn pcm16_range(capacity: usize, offset: i32, size: i32, channels: i32) -> Option<Range<usize>> {
+    if capacity > isize::MAX as usize || channels <= 0 {
+        return None;
+    }
+    let start = usize::try_from(offset).ok()?;
+    let len = usize::try_from(size).ok()?;
+    let frame_bytes = usize::try_from(channels).ok()?.checked_mul(2)?;
+    let end = start.checked_add(len)?;
+    if end > capacity || len % frame_bytes != 0 {
+        return None;
+    }
+    Some(start..end)
+}
+
+pub fn copy_native_pcm16(bytes: &[u8]) -> Option<Vec<i16>> {
+    if bytes.len() % 2 != 0 {
+        return None;
+    }
+    Some(
+        bytes
+            .chunks_exact(2)
+            .map(|s| i16::from_ne_bytes([s[0], s[1]]))
+            .collect(),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn signed_and_out_of_bounds_metadata_is_rejected() {
+        for (capacity, offset, size, channels) in [
+            (8, -1, 4, 1),
+            (8, 0, -1, 1),
+            (8, 7, 2, 1),
+            (8, 9, 0, 1),
+            (8, 0, 4, 0),
+            (8, 0, 4, -1),
+            (8, 0, 3, 1),
+            (8, 0, 6, 2),
+            (usize::MAX, 0, 4, 1),
+        ] {
+            assert_eq!(pcm16_range(capacity, offset, size, channels), None);
+        }
+    }
+    #[test]
+    fn whole_frames_and_empty_eos_payloads_are_valid() {
+        assert_eq!(pcm16_range(16, 4, 8, 2), Some(4..12));
+        assert_eq!(pcm16_range(16, 16, 0, 2), Some(16..16));
+        assert_eq!(pcm16_range(0, 0, 0, 1), Some(0..0));
+    }
+    #[test]
+    fn unaligned_data_is_copied_in_native_order() {
+        let samples = [i16::MIN, -1, 0, 1, i16::MAX];
+        let mut storage = vec![123u8];
+        for s in samples {
+            storage.extend_from_slice(&s.to_ne_bytes());
+        }
+        assert_eq!(copy_native_pcm16(&storage[1..]), Some(samples.to_vec()));
+        assert_eq!(copy_native_pcm16(&[1]), None);
+    }
+}
