+/// Parse a fonts.xml <font index="N"> attribute into a FreeType face index.
+/// Rejects malformed, negative, and overflowing values instead of wrapping or
+/// truncating: anything that is not a valid u16 falls back to face 0, matching
+/// the previous behavior for fonts.xml files without the attribute.
+fn parse_face_index(attr: Option<String>) -> u16 {
+    let Some(value) = attr else {
+        return 0;
+    };
+    match value.parse::<u16>() {
+        Ok(index) => index,
+        Err(_) => {
+            warn!("ignoring malformed or out-of-range font index attribute: {value:?}");
+            0
+        },
+    }
+}
+
 struct Font {
     filename: String,
+    index: u16,
     weight: Option<i32>,
     style: Option<String>,
 }
