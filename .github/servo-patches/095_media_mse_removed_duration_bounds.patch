+    #[test]
+    fn accepted_buffer_removal_recalculates_duration_bounds_before_worker_status() {
+        let p = AndroidAppendPlayer::new(
+            99,
+            GenericCallback::new(|_| {}).unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let p = p.lock().unwrap();
+        drop(p.worker.lock().unwrap().take());
+        let (worker, rx) = Worker::saturated_for_test();
+        *p.worker.lock().unwrap() = Some(worker);
+        rx.recv().unwrap();
+        {
+            let mut s = p.state.lock().unwrap();
+            for id in [1, 2] {
+                s.buffers.insert(
+                    id,
+                    BufferState {
+                        ready: true,
+                        updating: false,
+                        removing: false,
+                        operation: 0,
+                        callback: Arc::new(|_| {}),
+                    },
+                );
+            }
+            s.buffer_duration_bounds
+                .insert(1, (Some(9_000_000), 10_000_000));
+            s.buffer_duration_bounds
+                .insert(2, (Some(500_000), 1_000_000));
+            s.highest_pts = Some(9_000_000);
+            s.highest_end = 10_000_000;
+            s.duration_seconds = 10.0;
+        }
+        assert_eq!(p.append_set_duration(1.0), Err(PlayerError::SeekOutOfRange));
+        p.append_remove_buffer(1).unwrap();
+        {
+            let s = p.state.lock().unwrap();
+            assert_eq!(s.highest_pts, Some(500_000));
+            assert_eq!(s.highest_end, 1_000_000);
+            assert_eq!(s.removal_generation, 1);
+        }
+        rx.recv().unwrap();
+        assert_eq!(p.append_set_duration(0.5), Ok((1.0, 1)));
+    }
 }
