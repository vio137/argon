+// Known fragment layouts must account for every byte. Unknown flag bits can
+// add fields the dependency would otherwise ignore. Count caps precede any
+// sample-vector allocation and apply even to zero-width sample records.
+fn validate_fragment_layout(kind: [u8;4], p: &[u8], sample_limit: usize) -> Result<(),Error> {
+    if ![*b"mfhd",*b"tfhd",*b"tfdt",*b"trun"].contains(&kind) {return Ok(());}
+    validate_fragment_version(kind,p)?;
+    let flags=u32::from_be_bytes(p[..4].try_into().unwrap())&0x00ff_ffff;
+    let allowed=match &kind {b"tfhd"=>0x03003b,b"trun"=>0x000f05,_=>0};
+    if flags&!allowed!=0 {return Err(Error::UnsupportedLayout);}
+    let expected=match &kind {
+        b"mfhd"=>8,
+        b"tfdt"=>if p[0]==1 {12} else {8},
+        b"tfhd"=>8+if flags&1!=0 {8} else {0}+4*(flags&0x3a).count_ones() as usize,
+        b"trun"=>{
+            if p.len()<8 {return Err(Error::Truncated);}
+            let count=u32::from_be_bytes(p[4..8].try_into().unwrap()) as usize;
+            if count>sample_limit {return Err(Error::Quota);}
+            let width=4*(flags&0x0f00).count_ones() as usize;
+            8usize.checked_add(4*(flags&5).count_ones() as usize)
+                .and_then(|n|count.checked_mul(width).and_then(|v|n.checked_add(v))).ok_or(Error::Quota)?
+        },
+        _=>unreachable!(),
+    };
+    if p.len()<expected {Err(Error::Truncated)} else if p.len()!=expected {Err(Error::InvalidBox)} else {Ok(())}
+}
