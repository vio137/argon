+#[cfg(test)]
+mod fragment_layout_tests {
+ use super::*;
+ fn payload(version:u8,flags:u32,count:u32,len:usize)->Vec<u8>{
+  let mut p=vec![0;len];p[..4].copy_from_slice(&((u32::from(version)<<24)|flags).to_be_bytes());
+  if len>=8 {p[4..8].copy_from_slice(&count.to_be_bytes());}p
+ }
+ #[test]
+ fn fixed_headers_and_each_optional_tfhd_field_have_exact_sizes() {
+  for(kind,version,len)in[(*b"mfhd",0,8),(*b"tfdt",0,8),(*b"tfdt",1,12)]{
+   assert_eq!(validate_fragment_layout(kind,&payload(version,0,0,len),64),Ok(()));
+   assert_eq!(validate_fragment_layout(kind,&payload(version,0,0,len+1),64),Err(Error::InvalidBox));
+   assert_eq!(validate_fragment_layout(kind,&payload(version,0,0,len-1),64),Err(Error::Truncated));
+  }
+  for bits in 0u32..32 {
+   let mut flags=0;let mut len=8;
+   for(i,bit)in[1,2,8,16,32].into_iter().enumerate(){if bits&(1<<i)!=0{flags|=bit;len+=if bit==1{8}else{4};}}
+   for modifier in[0,0x010000,0x020000,0x030000] {
+    assert_eq!(validate_fragment_layout(*b"tfhd",&payload(0,flags|modifier,1,len),64),Ok(()));
+    assert_eq!(validate_fragment_layout(*b"tfhd",&payload(0,flags|modifier,1,len+1),64),Err(Error::InvalidBox));
+    assert_eq!(validate_fragment_layout(*b"tfhd",&payload(0,flags|modifier,1,len-1),64),Err(Error::Truncated));
+   }
+  }
+ }
+ #[test]
+ fn all_trun_widths_and_optional_fields_are_bounded_before_decode() {
+  for bits in 0u32..64 {let mut flags=0;let mut fixed=8;let mut width=0;
+   for(i,bit)in[1,4,0x100,0x200,0x400,0x800].into_iter().enumerate(){if bits&(1<<i)!=0{flags|=bit;if i<2{fixed+=4}else{width+=4};}}
+   for count in[0,1,3] {for version in[0,1]{let len=fixed+width*count;
+    assert_eq!(validate_fragment_layout(*b"trun",&payload(version,flags,count as u32,len),64),Ok(()));
+    assert_eq!(validate_fragment_layout(*b"trun",&payload(version,flags,count as u32,len+1),64),Err(Error::InvalidBox));
+    assert_eq!(validate_fragment_layout(*b"trun",&payload(version,flags,count as u32,len-1),64),Err(Error::Truncated));
+   }}
+  }
+  assert_eq!(validate_fragment_layout(*b"trun",&payload(0,0,u32::MAX,8),64),Err(Error::Quota));
+ }
