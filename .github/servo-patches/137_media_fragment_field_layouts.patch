+#[test]
+fn reserved_fragment_flags_reject_without_consuming_first_config() {
+ use servo_media_android_hosttest::mse_demux::Error;
+ let bs=boxes();let init:Vec<u8>=bs.iter().filter(|b|&b[4..8]==b"ftyp"||&b[4..8]==b"moov").flatten().copied().collect();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();let mut media=pair[0].clone();media.extend_from_slice(&pair[1]);
+ for kind in [*b"mfhd",*b"tfhd",*b"tfdt",*b"trun"] {
+  let mut bad=media.clone();let pos=bad.windows(4).position(|b|b==kind).unwrap()+5;bad[pos]|=0x80;
+  let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();assert_eq!(d.media_complete(&bad),Err(Error::UnsupportedLayout));assert!(matches!(d.media(&bad),Err(Error::UnsupportedLayout)));
+  let good=d.media(&media).unwrap();assert!(!good.is_empty());assert!(good[0].codec_config.is_some());assert_eq!(good[0].pts_us,0);
+ }
