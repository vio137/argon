+#[test]
+fn fragment_field_padding_is_not_silently_swallowed() {
+ use servo_media_android_hosttest::mse_demux::Error;
+ fn pad_box(b:&[u8],kind:&[u8;4])->Vec<u8>{
+  let mut out=b[..8].to_vec();
+  if &b[4..8]==b"moof" || &b[4..8]==b"traf" {
+   let mut pos=8;while pos<b.len(){let len=u32::from_be_bytes(b[pos..pos+4].try_into().unwrap())as usize;out.extend(pad_box(&b[pos..pos+len],kind));pos+=len;}
+  }else{out.extend_from_slice(&b[8..]);if &b[4..8]==kind{out.push(0);}}
+  let len=out.len()as u32;out[..4].copy_from_slice(&len.to_be_bytes());out
+ }
+ let bs=boxes();let init:Vec<u8>=bs.iter().filter(|b|&b[4..8]==b"ftyp"||&b[4..8]==b"moov").flatten().copied().collect();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();
+ let mut media=pair[0].clone();media.extend_from_slice(&pair[1]);
+ for kind in [*b"mfhd",*b"tfhd",*b"tfdt",*b"trun"] {
+  let mut bad=pad_box(&pair[0],&kind);assert_eq!(bad.len(),pair[0].len()+1);
+  // Keep the referenced mdat sample correct; only the extra field byte is bad.
+  let trun=bad.windows(4).position(|b|b==b"trun").unwrap();let pos=trun+12;
+  let offset=i32::from_be_bytes(bad[pos..pos+4].try_into().unwrap());bad[pos..pos+4].copy_from_slice(&(offset+1).to_be_bytes());bad.extend_from_slice(&pair[1]);
+  let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();assert_eq!(d.media_complete(&bad),Err(Error::InvalidBox));assert!(matches!(d.media(&bad),Err(Error::InvalidBox)));
+  let good=d.media(&media).unwrap();assert!(!good.is_empty());assert!(good[0].codec_config.is_some());
+ }
