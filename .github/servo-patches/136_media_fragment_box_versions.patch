+// Reject unknown field widths/signedness before the dependency's fallback
+// version-zero interpretation. This is fragment-scoped, not a claim of full
+// ISO BMFF conformance.
+fn validate_fragment_version(kind: [u8;4], payload: &[u8]) -> Result<(),Error> {
+    if [*b"mfhd",*b"tfhd",*b"tfdt",*b"trun"].contains(&kind) {
+        if payload.len()<4 {return Err(Error::Truncated);}
+        let maximum=if kind==*b"tfdt" || kind==*b"trun" {1} else {0};
+        if payload[0]>maximum {return Err(Error::UnsupportedLayout);}
+    }
+    Ok(())
