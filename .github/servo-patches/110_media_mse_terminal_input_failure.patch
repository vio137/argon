+    /// Terminal network/decode failure, not a clean EOS. Do not drain or
+    /// shorten duration to the final buffered frame. The DOM owns error kind.
+    pub fn fail_input(&self) -> Result<(), SourceError> {
+        let (player, epoch) = {
+            let s = self.0.state.lock().unwrap();
+            if s.state != SourceState::Open || s.buffers.values().any(|b| b.updating) {
+                return Err(SourceError::InvalidState);
+            }
+            (s.player.clone().ok_or(SourceError::InvalidState)?, s.epoch)
+        };
+        player.lock().unwrap().stop().map_err(|_| SourceError::Backend)?;
+        self.0.state.lock().unwrap().commit_end_input(epoch)?;
+        (self.0.callback)(SourceEvent::Ended);
+        Ok(())
+    }
