+/// Argon: detect the HTTP/2 PROTOCOL_ERROR stream reset that some front ends
+/// (Google properties, upstream servo#39785) return to hyper's h2 client.
+/// Matches the Debug representation to avoid a direct h2 dependency: a false
+/// positive costs one redundant HTTP/1.1 retry of a safe (bodiless GET/HEAD)
+/// request; a false negative preserves the status quo.
+fn is_h2_protocol_reset(error: &hyper_util::client::legacy::Error) -> bool {
+    let debug = format!("{error:?}");
+    debug.contains("Http2") && debug.contains("Reset") && debug.contains("PROTOCOL_ERROR")
