+    /// Reconcile active membership in sourceBuffers order, not click order.
+    /// Reordering surviving entries alone does not fabricate membership events.
+    pub(crate) fn reconcile(&self,desired:&[DomRoot<SourceBuffer>]) {
+        let previous=self.buffers();
+        let removed=previous.iter().any(|old|!desired.iter().any(|new|&**new==&**old));
+        let added=desired.iter().any(|new|!previous.iter().any(|old|&**new==&**old));
+        *self.buffers.borrow_mut()=desired.iter().map(|buffer|Dom::from_ref(&**buffer)).collect();
+        if removed{self.queue_change(Atom::from("removesourcebuffer"));}
+        if added{self.queue_change(Atom::from("addsourcebuffer"));}
+    }
     pub(crate) fn clear(&self) {
