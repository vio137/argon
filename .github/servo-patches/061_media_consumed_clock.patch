diff --git a/components/media/backends/android/clock.rs b/components/media/backends/android/clock.rs
index ef663ab14..111ff604e 100644
--- a/components/media/backends/android/clock.rs
+++ b/components/media/backends/android/clock.rs
@@ -2,8 +2,8 @@
  * License, v. 2.0. If a copy of the MPL was not distributed with this
