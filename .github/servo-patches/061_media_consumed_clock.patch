@@ -802,8 +802,10 @@ impl Pipeline {
 
             let mut did_work = false;
             did_work |= self.feed_inputs();
+            self.update_audio_clock();
             did_work |= self.pump_video();
             did_work |= self.pump_audio();
+            self.update_audio_clock();
             if !did_work {
                 std::thread::sleep(Duration::from_millis(4));
             }
@@ -884,6 +886,13 @@ impl Pipeline {
         true
     }
 
+    fn update_audio_clock(&mut self) {
+        if !self.aaudio.is_null() {
+            let counter = unsafe { sys::AAudioStream_getFramesRead(self.aaudio) };
+            self.clock.observe_audio_consumed(counter);
