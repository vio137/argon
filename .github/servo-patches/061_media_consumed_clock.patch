+
     fn audio_transition_failed(&mut self) {
         if !self.aaudio.is_null() {
             unsafe { sys::AAudioStream_close(self.aaudio) };
@@ -947,6 +956,9 @@ impl Pipeline {
             )
         };
         self.clock.rebase(target_us);
+        if !self.aaudio.is_null() {
+            self.clock.reset_audio_epoch(unsafe { sys::AAudioStream_getFramesRead(self.aaudio) });
+        }
         let held = self.focus.hold != Hold::None;
         if self.shared.get().paused || held {
             // rebase restarts the wall clock; freeze it again while paused.
@@ -1382,7 +1394,7 @@ impl Pipeline {
                 self.aaudio = stream;
                 self.clock.has_audio = true;
                 self.clock.audio_sample_rate = rate as i64;
-                self.clock.audio_frames_written = 0;
+                self.clock.reset_audio_epoch(sys::AAudioStream_getFramesRead(stream));
                 if !self.shared.get().paused && self.focus.hold == Hold::None {
                     self.set_audio_running(true);
                 }
@@ -1422,7 +1434,8 @@ impl Pipeline {
                 return;
             }
             let written = written as usize;
-            self.clock.audio_frames_written += written as u64;
+            self.clock.audio_frames_written = self.clock.audio_frames_written.saturating_add(written as u64);
+            self.update_audio_clock();
             offset_frames += written;
             frames_left -= written;
             if written == 0 {
diff --git a/components/media/backends/android/android_impl/sys.rs b/components/media/backends/android/android_impl/sys.rs
index ea1ce4dde..f6dbf6b42 100644
--- a/components/media/backends/android/android_impl/sys.rs
+++ b/components/media/backends/android/android_impl/sys.rs
@@ -198,6 +198,7 @@ unsafe extern "C" {
         builder: *mut *mut AAudioStreamBuilder,
     ) -> aaudio_result_t;
     pub fn AAudioStream_getFramesWritten(stream: *mut AAudioStream) -> i64;
+    pub fn AAudioStream_getFramesRead(stream: *mut AAudioStream) -> i64;
     pub fn AAudioStreamBuilder_delete(builder: *mut AAudioStreamBuilder) -> aaudio_result_t;
     pub fn AAudioStreamBuilder_setDirection(builder: *mut AAudioStreamBuilder, direction: i32);
