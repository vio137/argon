+#[cfg(test)] mod rejection_tests {
+    use crate::{append_source::*, append::AppendEvent, generic_channel::GenericCallback,mse_player::AndroidAppendPlayer};
+    use std::{sync::{Arc,mpsc},time::Duration};
+    #[test] fn controller_rejected_append_rolls_back_updating_without_fabricated_events() {
+        let player=AndroidAppendPlayer::new(10,GenericCallback::new(|_|{}).unwrap(),None,Box::new(||{})).unwrap();
+        let(tx,rx)=mpsc::channel();let source=AppendSource::new(Arc::new(move|e|{let _=tx.send(e);}));
+        source.attach(player).unwrap();let buffer=source.add_buffer("video/mp4").unwrap();
+        loop {if rx.recv_timeout(Duration::from_secs(2)).unwrap()==SourceEvent::BufferEvent(buffer.id(),AppendEvent::Ready){break;}}
+        // BufferAdded may be queued after Ready on the worker: drain only the
+        // structural event, never mistake it for an append lifecycle event.
+        for event in rx.try_iter(){assert_eq!(event,SourceEvent::BufferAdded(buffer.id()));}
+        assert_eq!(buffer.append(vec![0;4*1024*1024+1]),Err(SourceError::Quota));
+        assert!(!buffer.updating());assert!(rx.try_recv().is_err());
+        buffer.append(vec![]).unwrap();
+        for expected in [AppendEvent::UpdateStart,AppendEvent::Update,AppendEvent::UpdateEnd] {assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(buffer.id(),expected));}
+        assert!(!buffer.updating());source.detach();
+    }
+}
