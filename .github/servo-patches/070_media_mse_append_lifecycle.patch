+#[test] fn abort_of_partial_replacement_init_preserves_last_valid_configuration() {
+    use servo_media_android_hosttest::mse_demux::append::AppendStream;
+    let bs=boxes();let mut stream=AppendStream::new(1<<20,128);
+    for b in bs.iter().filter(|b| &b[4..8]==b"ftyp" || &b[4..8]==b"moov") {stream.append(b).unwrap();}
+    let descriptions=stream.descriptions().to_vec();assert!(!descriptions.is_empty());
+    let ftyp=bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap();
+    stream.append(ftyp).unwrap();stream.append(&[0,0,0]).unwrap();
+    assert_eq!(stream.descriptions(),descriptions);stream.abort();
+    let mut units=vec![];
+    for b in bs.iter().skip_while(|b| &b[4..8]!=b"moof") {units.extend(stream.append(b).unwrap());}
+    units.extend(stream.end_of_stream().unwrap());assert_eq!(units.len(),2);
+}
+#[test] fn pending_replacement_init_cannot_accept_media_using_stale_configuration() {
+    use servo_media_android_hosttest::mse_demux::append::AppendStream;
+    let bs=boxes();let mut stream=AppendStream::new(1<<20,128);
+    for b in bs.iter().filter(|b|&b[4..8]==b"ftyp" || &b[4..8]==b"moov") {stream.append(b).unwrap();}
+    stream.append(bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap()).unwrap();
+    assert!(stream.append(bs.iter().find(|b|&b[4..8]==b"moof").unwrap()).is_err());
+    stream.abort();
+    assert!(!stream.descriptions().is_empty());
+}
