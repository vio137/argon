diff --git a/components/media/backends/android/clock.rs b/components/media/backends/android/clock.rs
new file mode 100644
index 000000000..539d18823
--- /dev/null
+++ b/components/media/backends/android/clock.rs
@@ -0,0 +1,135 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Master playback clock. Audio-driven when an audio track is being written
+//! to AAudio; wall-clock otherwise. Pure logic: hosttest/ runs these tests on
+//! the host against the exact file the Android build compiles.
+
+use std::time::{Duration, Instant};
+
+pub struct MasterClock {
+    anchor_pts_us: i64,
+    pub(crate) has_audio: bool,
+    pub(crate) audio_frames_written: u64,
+    pub(crate) audio_sample_rate: i64,
+    wall_started: Option<Instant>,
+    wall_accumulated: Duration,
+}
+
+impl MasterClock {
+    pub fn new() -> Self {
+        MasterClock {
+            anchor_pts_us: 0,
+            has_audio: false,
+            audio_frames_written: 0,
+            audio_sample_rate: 0,
+            wall_started: None,
+            wall_accumulated: Duration::ZERO,
+        }
+    }
+
+    pub fn rebase(&mut self, anchor_pts_us: i64) {
+        self.anchor_pts_us = anchor_pts_us;
+        self.audio_frames_written = 0;
+        self.wall_started = Some(Instant::now());
+        self.wall_accumulated = Duration::ZERO;
+    }
+
+    pub fn pause(&mut self) {
+        if let Some(started) = self.wall_started.take() {
+            self.wall_accumulated += started.elapsed();
+        }
+    }
+
+    pub fn resume(&mut self) {
+        if self.wall_started.is_none() {
+            self.wall_started = Some(Instant::now());
+        }
+    }
+
+    pub fn now_us(&self) -> i64 {
+        if self.has_audio && self.audio_sample_rate > 0 {
+            self.anchor_pts_us +
+                (self.audio_frames_written as i64) * 1_000_000 / self.audio_sample_rate
+        } else {
+            let running = self
+                .wall_started
+                .map(|s| s.elapsed())
+                .unwrap_or(Duration::ZERO);
+            self.anchor_pts_us + (self.wall_accumulated + running).as_micros() as i64
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::thread::sleep;
+
+    #[test]
+    fn audio_frames_drive_the_clock_when_audio_is_active() {
+        let mut clock = MasterClock::new();
+        clock.rebase(2_000_000);
+        clock.has_audio = true;
+        clock.audio_sample_rate = 48_000;
+        assert_eq!(clock.now_us(), 2_000_000);
+        clock.audio_frames_written = 48_000; // one second of samples
+        assert_eq!(clock.now_us(), 3_000_000);
+        clock.audio_frames_written = 24_000; // half a second
+        assert_eq!(clock.now_us(), 2_500_000);
+    }
+
+    #[test]
+    fn audio_clock_ignores_wall_time() {
+        let mut clock = MasterClock::new();
+        clock.rebase(0);
+        clock.has_audio = true;
+        clock.audio_sample_rate = 48_000;
+        clock.audio_frames_written = 48_000;
+        sleep(Duration::from_millis(5));
+        // Wall time must not leak into an audio-driven clock.
+        assert_eq!(clock.now_us(), 1_000_000);
+    }
+
+    #[test]
+    fn wall_clock_advances_only_while_running() {
+        let mut clock = MasterClock::new();
+        clock.rebase(100_000);
+        sleep(Duration::from_millis(2));
+        let running = clock.now_us();
+        assert!(running >= 100_000);
+        clock.pause();
+        let frozen = clock.now_us();
+        sleep(Duration::from_millis(2));
+        // Paused: repeated reads return the same instant.
+        assert_eq!(clock.now_us(), frozen);
+        clock.resume();
+        sleep(Duration::from_millis(2));
+        // Resumed clock continues from the frozen instant, never rewinds.
+        assert!(clock.now_us() >= frozen);
+    }
+
+    #[test]
+    fn rebase_resets_anchor_and_audio_progress() {
+        let mut clock = MasterClock::new();
+        clock.rebase(5_000_000);
+        clock.has_audio = true;
+        clock.audio_sample_rate = 48_000;
+        clock.audio_frames_written = 48_000;
+        assert_eq!(clock.now_us(), 6_000_000);
+        clock.rebase(500_000);
+        assert_eq!(clock.now_us(), 500_000);
+    }
+
+    #[test]
+    fn zero_sample_rate_falls_back_to_wall_clock() {
+        let mut clock = MasterClock::new();
+        clock.rebase(0);
+        clock.has_audio = true;
+        clock.audio_sample_rate = 0;
+        clock.audio_frames_written = 999_999;
+        // Degenerate audio state must not divide by zero or freeze the clock.
+        let _ = clock.now_us();
+    }
+}
