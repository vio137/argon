+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! YUV color matrix/range selection for decoded video frames. Pure logic:
+//! hosttest/ runs these tests on the host against the exact file the Android
+//! build compiles.
+//!
+//! NDK values (media/NdkMediaFormat.h): AMEDIAFORMAT_KEY_COLOR_STANDARD is
+//! "color-standard" with 0=unspecified, 1=BT709, 2=BT601_PAL, 4=BT601_NTSC,
+//! 6=BT2020; AMEDIAFORMAT_KEY_COLOR_RANGE is "color-range" with
+//! 0=unspecified, 1=full, 2=limited.
+
+/// Subset of yuv crate's YuvStandardMatrix this backend can convert with;
+/// mapped to the crate enum at the call site.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Matrix {
+    Bt601,
+    Bt709,
+}
+
+/// Subset of yuv crate's YuvRange; mapped at the call site.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Range {
+    Limited,
+    Full,
+}
+
+/// Pick the conversion matrix and range for a frame. Explicit format keys
+/// win; BT2020 maps to BT709 (the closest the converter supports); the
+/// unspecified fallback is the resolution heuristic (HD => BT.709, SD =>
+/// BT.601), matching the previous fixed behaviour.
+pub fn select(frame_height: i32, standard: Option<i32>, range: Option<i32>) -> (Matrix, Range) {
+    let matrix = match standard {
+        Some(1) => Matrix::Bt709,
+        Some(2) | Some(4) => Matrix::Bt601,
+        Some(6) => Matrix::Bt709, // BT2020: nearest supported matrix
+        _ => {
+            if frame_height >= 720 {
+                Matrix::Bt709
+            } else {
+                Matrix::Bt601
+            }
+        },
+    };
+    let range = match range {
+        Some(1) => Range::Full,
+        _ => Range::Limited,
+    };
+    (matrix, range)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn explicit_standard_overrides_resolution_heuristic() {
+        // SD clip flagged BT709 must not fall back to BT601.
+        assert_eq!(select(360, Some(1), None).0, Matrix::Bt709);
+        // HD clip flagged BT601 must not be promoted to BT709.
+        assert_eq!(select(1080, Some(2), None).0, Matrix::Bt601);
+        assert_eq!(select(1080, Some(4), None).0, Matrix::Bt601);
+    }
+
+    #[test]
+    fn bt2020_uses_nearest_supported_matrix() {
+        assert_eq!(select(2160, Some(6), None).0, Matrix::Bt709);
+    }
+
+    #[test]
+    fn unspecified_standard_uses_resolution_heuristic() {
+        assert_eq!(select(719, None, None).0, Matrix::Bt601);
+        assert_eq!(select(720, None, None).0, Matrix::Bt709);
+        assert_eq!(select(480, Some(0), None).0, Matrix::Bt601);
+        assert_eq!(select(1080, Some(0), None).0, Matrix::Bt709);
+        // Unknown future values fall back, never guess a matrix.
+        assert_eq!(select(480, Some(99), None).0, Matrix::Bt601);
+    }
+
+    #[test]
+    fn explicit_full_range_is_honored() {
+        assert_eq!(select(720, None, Some(1)).1, Range::Full);
+        assert_eq!(select(720, None, Some(2)).1, Range::Limited);
+        assert_eq!(select(720, None, Some(0)).1, Range::Limited);
+        assert_eq!(select(720, None, None).1, Range::Limited);
+    }
+}
