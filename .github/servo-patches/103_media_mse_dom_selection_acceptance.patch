+    /// Append-backed selection must be accepted by the bounded worker queue
+    /// before the DOM list changes. Preserve existing progressive behavior.
+    pub(crate) fn set_audio_track(&self,idx:usize,enabled:bool)->bool {
+        let result=self.player.borrow().as_ref().map(|player|player.lock().unwrap().set_audio_track(idx as i32,enabled));
+        if let Some(Err(error))=result {warn!("Could not set audio track {error:?}");return self.attached_append_source.get().is_none();}
+        true
+    }
+    pub(crate) fn set_video_track(&self,idx:usize,enabled:bool)->bool {
+        let result=self.player.borrow().as_ref().map(|player|player.lock().unwrap().set_video_track(idx as i32,enabled));
+        if let Some(Err(error))=result {warn!("Could not set video track {error:?}");return self.attached_append_source.get().is_none();}
+        true
     }
 
