+    /// Called only after the backend has accepted removal of this buffer.
+    /// Queued append notifications are separately rejected by controller identity.
+    pub(crate) fn removed(&self) {
+        if self.updating.replace(false) {
+            let this = Trusted::new(self);
+            self.global()
+                .task_manager()
+                .media_element_task_source()
+                .queue(task!(removed_source_buffer_abort: move |cx| {
+                    this.root().upcast::<EventTarget>().fire_event(cx, atom!("abort"));
+                }));
+            let this = Trusted::new(self);
+            self.global()
+                .task_manager()
+                .media_element_task_source()
+                .queue(task!(removed_source_buffer_updateend: move |cx| {
+                    this.root().upcast::<EventTarget>().fire_event(cx, atom!("updateend"));
+                }));
+        }
+        self.removing.set(false);
+        if let Some(list) = self.audio_tracks.get() {
+            let tracks: Vec<_> = (0..list.len()).filter_map(|i| list.item(i)).collect();
+            for track in tracks {
+                track.set_source_buffer(None);
+                list.remove(&track);
+                if let Some(owner) = self.media.existing_audio_tracks() {
+                    owner.remove(&track);
+                }
+            }
+        }
+        if let Some(list) = self.video_tracks.get() {
+            let tracks: Vec<_> = (0..list.len()).filter_map(|i| list.item(i)).collect();
+            for track in tracks {
+                track.set_source_buffer(None);
+                list.remove(&track);
+                if let Some(owner) = self.media.existing_video_tracks() {
+                    owner.remove(&track);
+                }
+            }
+        }
+        self.tracks_synced.set(false);
+    }
     pub(crate) fn detached(&self) {
+        if let Some(list) = self.audio_tracks.get() {
+            for index in 0..list.len() {
+                if let Some(track) = list.item(index) {
+                    track.set_source_buffer(None);
+                }
+            }
+            list.clear();
+        }
+        if let Some(list) = self.video_tracks.get() {
+            for index in 0..list.len() {
+                if let Some(track) = list.item(index) {
+                    track.set_source_buffer(None);
+                }
+            }
+            list.clear();
+        }
+        self.tracks_synced.set(false);
         self.updating.set(false);
         self.removing.set(false);
     }
