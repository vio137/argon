+#[cfg(test)]
+mod end_input_epoch_tests {
+    use super::*;
+    #[test]
+    fn accepted_eos_cannot_resurrect_detached_source() {
+        let source = AppendSource::new(Arc::new(|_| {}));
+        let mut state = source.0.state.lock().unwrap();
+        state.epoch = 3;
+        state.state = SourceState::Closed;
+        assert_eq!(state.commit_end_input(3), Err(SourceError::InvalidState));
+        assert_eq!(state.state, SourceState::Closed);
+    }
+    #[test]
+    fn accepted_eos_from_old_attachment_cannot_end_replacement() {
+        let source = AppendSource::new(Arc::new(|_| {}));
+        let mut state = source.0.state.lock().unwrap();
+        state.epoch = 4;
+        state.state = SourceState::Open;
+        assert_eq!(state.commit_end_input(3), Err(SourceError::InvalidState));
+        assert_eq!(state.state, SourceState::Open);
+        assert_eq!(state.commit_end_input(4), Ok(()));
+        assert_eq!(state.state, SourceState::Ended);
+        assert_eq!(state.commit_end_input(4), Err(SourceError::InvalidState));
+    }
+}
