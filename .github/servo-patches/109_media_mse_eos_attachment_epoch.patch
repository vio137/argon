+impl State {
+    // Backend acceptance is outside this mutex. Detach/reattach may have
+    // replaced the source while it was pending; never resurrect that source.
+    fn commit_end_input(&mut self, epoch: u64) -> Result<(), SourceError> {
+        if self.epoch != epoch || self.state != SourceState::Open {
+            return Err(SourceError::InvalidState);
+        }
+        self.state = SourceState::Ended;
+        Ok(())
+    }
 }
 struct Inner {
     state: Mutex<State>,
@@ -302,19 +313,19 @@
         Ok(())
     }
     pub fn end_input(&self) -> Result<(), SourceError> {
-        let player = {
+        let (player, epoch) = {
             let s = self.0.state.lock().unwrap();
             if s.state != SourceState::Open || s.buffers.values().any(|b| b.updating || !b.ready) {
                 return Err(SourceError::InvalidState);
             }
-            s.player.clone().ok_or(SourceError::InvalidState)?
+            (s.player.clone().ok_or(SourceError::InvalidState)?, s.epoch)
         };
         player
             .lock()
             .unwrap()
             .end_of_stream()
             .map_err(|_| SourceError::Backend)?;
-        self.0.state.lock().unwrap().state = SourceState::Ended;
+        self.0.state.lock().unwrap().commit_end_input(epoch)?;
         (self.0.callback)(SourceEvent::Ended);
         Ok(())
     }
