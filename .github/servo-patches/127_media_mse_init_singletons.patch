+#[cfg(test)]
+mod init_singleton_tests {
+ use super::*;
+ fn boxed(kind:[u8;4],payload:&[u8])->Vec<u8> {
+  let mut out=((payload.len()+8)as u32).to_be_bytes().to_vec();out.extend(kind);out.extend(payload);out
+ }
+ fn check(parent:[u8;4],data:&[u8])->Result<(),Error> {
+  validate_init_children(data,parent,0,&mut 4096,&mut 0)
+ }
+ #[test]
+ fn every_known_singleton_rejects_duplicates_but_repeated_tracks_defaults_and_free_are_allowed() {
+  for (parent,kinds) in [
+   (*b"moov",&[*b"mvhd",*b"mvex"][..]),
+   (*b"trak",&[*b"tkhd",*b"mdia"][..]),
+   (*b"mdia",&[*b"mdhd",*b"hdlr",*b"minf"][..]),
+   (*b"minf",&[*b"vmhd",*b"smhd",*b"dinf",*b"stbl"][..]),
+   (*b"dinf",&[*b"dref"][..]),
+   (*b"stbl",&[*b"stsd",*b"stts",*b"ctts",*b"stsc",*b"stsz",*b"stco",*b"co64",*b"stss"][..]),
+   (*b"mvex",&[*b"mehd"][..]),
+  ] {
+   for &kind in kinds {let mut body=boxed(kind,&[]);body.extend(body.clone());assert_eq!(check(parent,&body),Err(Error::InvalidBox),"parent={parent:?} kind={kind:?}");}
+  }
+  for (parent,kind) in [(*b"moov",*b"trak"),(*b"mvex",*b"trex"),(*b"moov",*b"free")] {
+   let mut body=boxed(kind,&[]);body.extend(body.clone());assert_eq!(check(parent,&body),Ok(()));
+  }
+ }
+ #[test]
+ fn alternate_chunk_offset_tables_must_not_coexist() {
+  for order in [[*b"stco",*b"co64"],[*b"co64",*b"stco"]] {
+   let mut body=boxed(order[0],&[0;8]);body.extend(boxed(order[1],&[0;8]));
+   assert_eq!(check(*b"stbl",&body),Err(Error::InvalidBox));
+   assert_eq!(check(*b"stbl",&boxed(order[0],&[0;8])),Ok(()));
+  }
+ }
