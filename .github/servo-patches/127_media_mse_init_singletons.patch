+#[test]
+fn duplicate_init_singletons_fail_without_replacing_valid_configuration() {
+ use servo_media_android_hosttest::mse_demux::Error;
+ fn duplicate(data:&[u8],path:&[[u8;4]])->Vec<u8> {
+  let mut result=vec![];let mut offset=0;
+  while offset<data.len() {
+   let len=u32::from_be_bytes(data[offset..offset+4].try_into().unwrap())as usize;
+   let b=&data[offset..offset+len];
+   if b[4..8]==path[0] {
+    if path.len()==1 {result.extend_from_slice(b);result.extend_from_slice(b);}
+    else {let payload=duplicate(&b[8..],&path[1..]);let size=(payload.len()+8)as u32;result.extend_from_slice(&size.to_be_bytes());result.extend_from_slice(&b[4..8]);result.extend(payload);}
+   }else{result.extend_from_slice(b);}
+   offset+=len;
+  }
+  result
+ }
+ let paths:Vec<Vec<[u8;4]>>=vec![
+  vec![*b"moov",*b"mvhd"],vec![*b"moov",*b"mvex"],
+  vec![*b"moov",*b"trak",*b"tkhd"],vec![*b"moov",*b"trak",*b"mdia"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"mdhd"],vec![*b"moov",*b"trak",*b"mdia",*b"hdlr"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"dinf"],vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"stbl"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"stbl",*b"stsd"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"stbl",*b"stts"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"stbl",*b"stsc"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"stbl",*b"stsz"],
+  vec![*b"moov",*b"trak",*b"mdia",*b"minf",*b"stbl",*b"stco"],
+ ];
+ for fixture in [include_bytes!("fixtures/synthetic-fmp4.mp4").as_slice(),include_bytes!("fixtures/synthetic-aac.mp4").as_slice()] {
+  let mut framer=BoxFramer::new(1<<20);framer.append(fixture).unwrap();let mut bs=vec![];
+  while let Some(b)=framer.pop_box().unwrap(){bs.push(b);}
+  let mut init=bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap().clone();init.extend_from_slice(bs.iter().find(|b|&b[4..8]==b"moov").unwrap());
+  for path in &paths {
+   let bad=duplicate(&init,path);assert!(bad.len()>init.len(),"fixture path {path:?}");
+   let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();assert_eq!(d.init(&bad),Err(Error::InvalidBox),"path={path:?}");
+   let mut baseline=Demux::new(1<<20,64);baseline.init(&init).unwrap();
+   for pair in bs.windows(2) {if &pair[0][4..8]==b"moof"&&&pair[1][4..8]==b"mdat" {
+    let mut segment=pair[0].clone();segment.extend_from_slice(&pair[1]);
+    let got=d.media(&segment).unwrap();let expected=baseline.media(&segment).unwrap();
+    assert_eq!(got.len(),expected.len());for(a,b)in got.iter().zip(expected.iter()){assert_eq!(a.data,b.data);assert_eq!((a.track_id,a.pts_us,a.duration_us),(b.track_id,b.pts_us,b.duration_us));}
+   }}
+  }
+ }
+}
