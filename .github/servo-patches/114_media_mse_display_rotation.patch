+#[test]
+fn rotation_only_decoder_change_requires_old_output_drain_and_updates_size() {
+    let frames=Arc::new(Mutex::new(vec![]));
+    let mut p=AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    let config=DecoderConfig {rotation_degrees:0,track_id:1,mime:"video/avc",width:8,height:4,
+        sample_rate:0,channels:0,csd0:vec![1],csd1:vec![2]};
+    p.decoders.configure(&config).unwrap();
+    let next=DecoderConfig {rotation_degrees:90,..config.clone()};
+    assert!(!same_configuration(&config,&next));
+    assert_eq!(p.decoders.prepare_configuration(&next),Ok(false));
+    assert_eq!(p.decoders.video_size,Some((8,4)));
+    p.decoders.output_drained.insert(1);
+    assert_eq!(p.decoders.prepare_configuration(&next),Ok(true));
+    assert_eq!(p.decoders.video_size,Some((4,8)));
+    assert_eq!(p.decoders.configs[&1].rotation_degrees,90);
+}
