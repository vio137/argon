+++ b/components/media/backends/android/rotate.rs
@@ -9,6 +9,27 @@
 //!
 //! Input/output are tightly packed I420 (Y plane w*h, then U and V planes at
 //! half resolution), which is exactly what yuv_pack::pack_i420 produces.
+
+/// Extract a normalized clockwise right-angle transform from an ISO BMFF
+/// row-vector display matrix. Translation only positions the transformed
+/// bounding box and is removed when producing a standalone video frame.
+/// Scaling, reflection and perspective require a different rendering path.
+pub fn mp4_rotation(matrix: [i32; 9]) -> Option<i32> {
+    if matrix[2] != 0 || matrix[5] != 0 || matrix[8] != 0x40000000 {
+        return None;
