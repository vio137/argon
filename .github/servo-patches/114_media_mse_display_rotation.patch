+#[test]
+fn cropped_surface_rotation_matches_clockwise_pixels_before_renderer_handoff() {
+    PATTERN.with(|p|p.set(true));
+    let surface=VideoSurface::new(8,4).unwrap();
+    READY.with(|p|p.set(true));
+    let original=surface.acquire(None,None,0).unwrap().unwrap();
+    let src=original.get_data();
+    for angle in [0,90,180,270] {
+        READY.with(|p|p.set(true));
+        let frame=surface.acquire(None,None,angle).unwrap().unwrap();
+        let (w,h)=crate::rotate::display_size(4,2,angle);
+        assert_eq!((frame.get_width(),frame.get_height()),(w as i32,h as i32));
+        let actual=frame.get_data();
+        for y in 0..2usize {for x in 0..4usize {
+            let (ox,oy)=match angle {0=>(x,y),90=>(1-y,x),180=>(3-x,1-y),_ =>(y,3-x)};
+            assert_eq!(&actual[(oy*w as usize+ox)*4..(oy*w as usize+ox+1)*4],&src[(y*4+x)*4..(y*4+x+1)*4]);
+        }}
+        let mut ppm=format!("P6\n{w} {h}\n255\n").into_bytes();
+        for p in actual.chunks_exact(4) {ppm.extend_from_slice(&[p[2],p[1],p[0]]);}
+        std::fs::write(format!("/tmp/mse114-rotation-{angle}.ppm"),ppm).unwrap();
+    }
+    PATTERN.with(|p|p.set(false));
+}
