         }
     }
 
+    /// MSE endOfStream(network/decode) follows the same pre/post-metadata
+    /// failure steps as the resource fetch algorithm. The controller already
+    /// stopped native output without synthesizing a successful EOS.
+    pub(crate) fn append_input_failed(&self, cx: &mut JSContext, network: bool) {
+        if self.attached_append_source.get().is_none() || self.in_error_state() {
+            return;
+        }
+        if self.ready_state.get() == ReadyState::HaveNothing {
+            self.media_data_processing_failure_steps(cx);
+        } else {
+            self.media_data_processing_fatal_steps(cx,
+                if network { MEDIA_ERR_NETWORK } else { MEDIA_ERR_DECODE });
+        }
+    }
+
     fn playback_error(&self, cx: &mut JSContext, error: &str) {
         error!("Player error: {:?}", error);
 
