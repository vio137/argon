+
+#[cfg(test)]
+mod codec_token_tests {
+    use super::*;
+    #[test]
+    fn known_family_prefix_is_not_enough_for_unknown_codec_names() {
+        for token in [
+            "avc1garbage",
+            "avc3evil.42E01E",
+            "mp4audio",
+            "opusfake",
+            "vp09extra.00",
+            "mp3evil",
+        ] {
+            assert_eq!(
+                can_play_type(&format!("video/mp4; codecs=\"{token}\"")),
+                Support::No,
+                "{token}"
+            );
+        }
+    }
+    #[test]
+    fn qualified_tokens_require_nonempty_alphanumeric_components() {
+        for token in [
+            "avc1.",
+            "avc1..42E01E",
+            "avc1.42E01E.",
+            "mp4a.40..2",
+            "vp09.00_10",
+            "opus.-x",
+        ] {
+            assert_eq!(
+                can_play_type(&format!("video/mp4; codecs=\"{token}\"")),
+                Support::No,
+                "{token}"
+            );
+        }
+    }
+    #[test]
+    fn recognized_family_and_profile_tokens_keep_the_maybe_ceiling() {
+        for token in [
+            "avc1",
+            "avc1.42E01E",
+            "avc3.640028",
+            "mp4a.40.2",
+            "vp09.00.10.08",
+            "av01.0.04M.08",
+            "opus",
+            "mp3",
+        ] {
+            assert_eq!(
+                can_play_type(&format!("video/mp4; codecs=\"{token}\"")),
+                Support::Maybe,
+                "{token}"
+            );
+        }
+        assert_eq!(
+            can_play_type("video/mp4; codecs=\"avc1.42E01E,mp4audio\""),
+            Support::No
+        );
+    }
+}
