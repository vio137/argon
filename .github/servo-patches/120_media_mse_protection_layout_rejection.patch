+#[test]
+fn fragment_protection_metadata_is_rejected_before_samples_are_returned() {
+ use shiguredo_mp4::{Decode,Encode,boxes::MoofBox};
+ use servo_media_android_hosttest::mse_demux::{Error,append::AppendStream};
+ let bs=boxes();let init:Vec<u8>=bs.iter().filter(|b|&b[4..8]==b"ftyp"||&b[4..8]==b"moov").flatten().copied().collect();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();
+ for kind in [*b"senc",*b"saiz",*b"saio",*b"pssh",*b"sgpd",*b"sbgp"] {
+  let(mut moof,_)=MoofBox::decode(&pair[0]).unwrap();
+  // Insert a structurally bounded auxiliary box at the end of traf, then
+  // preserve the real clear sample offset. Its presence cannot be ignored.
+  let mut payload=vec![0;8];
+  if kind==*b"sgpd"||kind==*b"sbgp" {payload[4..8].copy_from_slice(b"seig");}
+  let extra=[vec![0,0,0,16],kind.to_vec(),payload].concat();
+  let old=moof.encode_to_vec().unwrap();let t=old.windows(4).position(|w|w==b"traf").unwrap()-4;
+  for run in &mut moof.traf_boxes[0].trun_boxes {run.data_offset=run.data_offset.map(|o|o+extra.len()as i32);}
+  let mut encoded=moof.encode_to_vec().unwrap();
+  let n=u32::from_be_bytes(encoded[t..t+4].try_into().unwrap())as usize;
+  encoded.splice(t+n..t+n,extra.clone());
+  encoded[t..t+4].copy_from_slice(&((n+extra.len())as u32).to_be_bytes());
+  let n=encoded.len()as u32;encoded[..4].copy_from_slice(&n.to_be_bytes());
+  encoded.extend_from_slice(&pair[1]);
+  let mut demux=Demux::new(1<<20,64);demux.init(&init).unwrap();
+  assert_eq!(demux.media_complete(&encoded),Err(Error::UnsupportedLayout));
+  assert!(matches!(demux.media(&encoded),Err(Error::UnsupportedLayout)));
+  let mut clear=pair[0].clone();clear.extend_from_slice(&pair[1]);
+  assert_eq!(demux.media(&clear).unwrap().len(),1,"rejection must not corrupt prior init");
+  if kind==*b"sgpd"||kind==*b"sbgp" {
+   let marker=encoded.windows(4).position(|b|b==b"seig").unwrap();
+   encoded[marker..marker+4].copy_from_slice(b"roll");
+   assert_eq!(demux.media_complete(&encoded),Ok(true),"unrelated groups are not encryption evidence");
+   assert_eq!(demux.media(&encoded).unwrap().len(),1);
+  }
+ }
+ let pssh=[vec![0,0,0,16],b"pssh".to_vec(),vec![0;8]].concat();
+ let mut stream=AppendStream::new(1<<20,64);stream.append(&init).unwrap();
+ assert!(matches!(stream.append(&pssh),Err(Error::UnsupportedLayout)));
+ let mut protected_init=init.clone();protected_init.extend_from_slice(&pssh);
+ assert_eq!(Demux::new(1<<20,64).init(&protected_init),Err(Error::UnsupportedLayout));
+}
