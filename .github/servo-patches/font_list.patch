+
+    // Compare family names ignoring case, spaces and punctuation, so that
+    // "Noto Sans Bengali" matches the synthetic "NotoSansBengali".
+    fn normalized_eq(a: &str, b: &str) -> bool {
+        a.chars()
+            .filter(|c| c.is_ascii_alphanumeric())
+            .map(|c| c.to_ascii_lowercase())
+            .eq(b
+                .chars()
+                .filter(|c| c.is_ascii_alphanumeric())
+                .map(|c| c.to_ascii_lowercase()))
+    }
+
+    // Derive a family name from a postScriptName such as
+    // "NotoSansBengali-Regular" -> "NotoSansBengali".
+    fn family_name_from_postscript_name(ps_name: String) -> Option<String> {
+        let name = ps_name.trim();
+        if name.is_empty() {
+            return None;
+        }
+        // Strip a trailing style suffix ("-Regular", "-UI-Bold", ...).
+        let base = name.rsplit_once('-').map(|(base, _)| base).unwrap_or(name);
+        let base = base.trim();
+        if base.is_empty() {
+            None
+        } else {
+            Some(base.to_owned())
+        }
     }
 
