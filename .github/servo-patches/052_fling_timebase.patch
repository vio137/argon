index 000000000..5d69e80e1
--- /dev/null
+++ b/components/paint/fling_math.rs
@@ -0,0 +1,145 @@
+// Time-normalized fling/velocity math for the compositor touch handler.
+// All timestamps are opaque nanoseconds in ONE app-defined monotonic basis
+// (Android uptime clock, converted at the JNI boundary); only deltas are used.
+// Constants reproduce the pin's 60 Hz per-frame behavior exactly
+// (0.95/frame, min 3 px/frame, max 4000 px/frame) and generalize it to any
+// refresh rate.
+
+pub const DECAY_PER_SEC: f32 = 0.046069798986951946; // 0.95^60, reproduces the pin's 60 Hz per-frame decay
+pub const MIN_VEL_PX_PER_SEC: f32 = 3.0 * 60.0;
+pub const MAX_VEL_PX_PER_SEC: f32 = 4000.0 * 60.0;
+pub const LAUNCH_BOOST: f32 = 2.0;
+/// Samples with dt outside this window do not contribute to the estimate.
+pub const MIN_SAMPLE_DT_SECS: f32 = 0.001;
+pub const MAX_SAMPLE_DT_SECS: f32 = 0.1;
+/// A move gap larger than this means the finger paused: reset the estimate.
+pub const PAUSE_GAP_SECS: f32 = 0.1;
+/// Per-frame advance uses at most this much elapsed time (stall guard).
+pub const MAX_FRAME_DT_SECS: f32 = 0.1;
+
+#[derive(Default, Clone, Copy, Debug, PartialEq)]
+pub struct VelocityEstimator {
+    pub vx: f32,
+    pub vy: f32,
+    last_time_nanos: Option<u64>,
+    has_sample: bool,
+}
+
+impl VelocityEstimator {
+    pub fn new() -> Self { Self::default() }
+
+    /// Record a delivered move sample. delta_* is the distance since the
+    /// previous DELIVERED move (coalescing-safe). Returns nothing; out-of-range
+    /// samples are ignored, long gaps reset the estimate to a paused finger.
+    pub fn add_move(&mut self, dx: f32, dy: f32, event_time_nanos: u64) {
+        // Unknown timestamps (0) use a nominal-dt sample: exactly the pin's
+        // per-move estimator at 60 Hz equivalence, and never a baseline mix.
+        if event_time_nanos == 0 {
+            if self.has_sample {
+                self.vx = (self.vx + dx / NOMINAL_FRAME_DT_SECS) * 0.5;
+                self.vy = (self.vy + dy / NOMINAL_FRAME_DT_SECS) * 0.5;
+            } else {
+                self.vx = dx / NOMINAL_FRAME_DT_SECS;
+                self.vy = dy / NOMINAL_FRAME_DT_SECS;
+            }
+            self.has_sample = true;
+            self.last_time_nanos = None;
+            return;
+        }
+        let Some(prev) = self.last_time_nanos else {
+            // First timestamped sample: baseline plus a nominal-dt seed so a
+            // pan that starts and lifts quickly still has the pin's one-sample
+            // velocity.
+            self.last_time_nanos = Some(event_time_nanos);
+            self.vx = dx / NOMINAL_FRAME_DT_SECS;
+            self.vy = dy / NOMINAL_FRAME_DT_SECS;
+            self.has_sample = true;
+            return;
+        };
+        let dt = (event_time_nanos.saturating_sub(prev)) as f32 * 1e-9;
+        self.last_time_nanos = Some(event_time_nanos);
+        if dt > PAUSE_GAP_SECS {
+            self.vx = 0.0;
+            self.vy = 0.0;
+            return;
+        }
+        if dt < MIN_SAMPLE_DT_SECS {
+            return; // zero/tiny dt: skip, keep estimate
+        }
+        // dt is now within (MIN_SAMPLE_DT, MAX_SAMPLE_DT]
+        self.vx = (self.vx + dx / dt) * 0.5;
+        self.vy = (self.vy + dy / dt) * 0.5;
+    }
+
+    pub fn reset(&mut self) { *self = Self::default(); }
+
+    /// Launch velocity: boosted and clamped, matching the pin's *2.0 + max.
+    pub fn launch_velocity(&self) -> (f32, f32) {
+        let mut vx = self.vx * LAUNCH_BOOST;
+        let mut vy = self.vy * LAUNCH_BOOST;
+        let len = (vx * vx + vy * vy).sqrt();
+        if len > MAX_VEL_PX_PER_SEC {
+            let s = MAX_VEL_PX_PER_SEC / len;
+            vx *= s;
+            vy *= s;
+        }
+        (vx, vy)
+    }
+}
+
+/// Nominal frame interval used when no host frame timestamps are available
+/// (timer-driven embedders): reproduces the pin's per-frame behavior at 60 Hz.
+pub const NOMINAL_FRAME_DT_SECS: f32 = 1.0 / 60.0;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Fling {
+    pub vx: f32,
+    pub vy: f32,
+    /// Last frame time in the embedder's basis; None until the first
+    /// timestamped frame (never mixed with event timestamps).
+    last_frame_nanos: Option<u64>,
+}
+
+impl Fling {
+    /// `start_time_nanos`: Some(t) seeds the frame baseline (e.g. the touch-up
+    /// event time, same basis); None leaves the first frame as baseline.
+    pub fn new(vx: f32, vy: f32, start_time_nanos: Option<u64>) -> Self {
+        Self { vx, vy, last_frame_nanos: start_time_nanos }
+    }
+
+    pub fn speed(&self) -> f32 { (self.vx * self.vx + self.vy * self.vy).sqrt() }
+
+    pub fn is_stopped(&self) -> bool { self.speed() < MIN_VEL_PX_PER_SEC }
+
+    /// Advance one frame. Returns the scroll delta for this frame, or None if
+    /// the fling has decayed below the minimum velocity. Zero/negative dt is a
+    /// no-op; oversized dt is clamped so a stall cannot teleport the page.
+    /// `host_frame_time_nanos`: None falls back to a nominal 60 Hz tick.
+    pub fn advance(&mut self, host_frame_time_nanos: Option<u64>) -> Option<(f32, f32)> {
+        let dt = match host_frame_time_nanos {
+            Some(t) => {
+                let Some(prev) = self.last_frame_nanos else {
+                    // First timestamped frame: set baseline, no movement.
+                    self.last_frame_nanos = Some(t);
+                    return Some((0.0, 0.0));
+                };
+                self.last_frame_nanos = Some(t);
+                let dt = (t.saturating_sub(prev)) as f32 * 1e-9;
+                if dt <= 0.0 {
+                    return Some((0.0, 0.0));
+                }
+                dt.min(MAX_FRAME_DT_SECS)
+            },
+            None => NOMINAL_FRAME_DT_SECS,
+        };
+        let dx = self.vx * dt;
+        let dy = self.vy * dt;
+        let decay = DECAY_PER_SEC.powf(dt);
+        self.vx *= decay;
+        self.vy *= decay;
+        if self.is_stopped() {
+            return None;
+        }
+        Some((dx, dy))
+    }
+}
