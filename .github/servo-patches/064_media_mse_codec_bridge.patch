index 000000000..15781babe
--- /dev/null
+++ b/components/media/backends/android/android_impl/mse_codec.rs
@@ -0,0 +1,158 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Dormant NDK input adapter. No DOM/pipeline call site yet. Caller must pump
+//! decoder output and preserve the borrowed surface lifetime. A format change
+//! requires a new adapter until coordinated output-drain/reconfigure is wired.
+use super::sys;
+use crate::mse_demux::{bridge::DecoderConfig, delivery::CodecInput};
+use std::{ffi::CString, ptr};
+
+pub struct MseCodecInput<'a> {
+    codec: *mut sys::AMediaCodec,
+    surface: Option<&'a sys::ANativeWindow>,
+    track: Option<u32>,
+}
+impl<'a> MseCodecInput<'a> {
+    pub fn new(surface: Option<&'a sys::ANativeWindow>) -> Self {
+        Self {
+            codec: ptr::null_mut(),
+            surface,
+            track: None,
+        }
+    }
+    /// A borrowed handle, never transfer ownership. The output-pump integration
+    /// must release each dequeued output buffer before dropping this adapter.
+    pub fn codec(&self) -> *mut sys::AMediaCodec {
+        self.codec
+    }
+}
+impl CodecInput for MseCodecInput<'_> {
+    fn configure(&mut self, c: &DecoderConfig) -> Result<(), ()> {
+        if !self.codec.is_null() {
+            return Err(());
+        } // No uncoordinated format replacement.
+        if c.csd0.is_empty() || c.csd0.len() > 64 * 1024 || c.csd1.len() > 64 * 1024 {
+            return Err(());
+        }
+        let video = c.mime == "video/avc";
+        if (!video && c.mime != "audio/mp4a-latm")
+            || (video && (c.width == 0 || c.height == 0 || self.surface.is_none()))
+            || (!video
+                && (c.sample_rate == 0
+                    || c.sample_rate > 192000
+                    || c.channels == 0
+                    || c.channels > 8))
+        {
+            return Err(());
+        }
+        let mime = CString::new(c.mime).map_err(|_| ())?;
+        unsafe {
+            let format = sys::AMediaFormat_new();
+            if format.is_null() {
+                return Err(());
+            }
+            sys::AMediaFormat_setString(format, c"mime".as_ptr(), mime.as_ptr());
+            if video {
+                sys::AMediaFormat_setInt32(format, c"width".as_ptr(), i32::from(c.width));
+                sys::AMediaFormat_setInt32(format, c"height".as_ptr(), i32::from(c.height));
+            } else {
+                sys::AMediaFormat_setInt32(format, c"sample-rate".as_ptr(), c.sample_rate as i32);
+                sys::AMediaFormat_setInt32(
+                    format,
+                    c"channel-count".as_ptr(),
+                    i32::from(c.channels),
+                );
+            }
+            // NDK copies these buffers into the format. CSD is auto-submitted by start;
+            // do not also queue a codec-config packet.
+            sys::AMediaFormat_setBuffer(
+                format,
+                c"csd-0".as_ptr(),
+                c.csd0.as_ptr().cast(),
+                c.csd0.len(),
+            );
+            if !c.csd1.is_empty() {
+                sys::AMediaFormat_setBuffer(
+                    format,
+                    c"csd-1".as_ptr(),
+                    c.csd1.as_ptr().cast(),
+                    c.csd1.len(),
+                );
+            }
+            let codec = sys::AMediaCodec_createDecoderByType(mime.as_ptr());
+            if codec.is_null() {
+                sys::AMediaFormat_delete(format);
+                return Err(());
+            }
+            let surface = if video {
+                self.surface
+                    .map(|p| p as *const sys::ANativeWindow as *mut std::ffi::c_void)
+                    .unwrap_or(ptr::null_mut())
+            } else {
+                ptr::null_mut()
+            };
+            let configured = sys::AMediaCodec_configure(codec, format, surface, ptr::null_mut(), 0);
+            sys::AMediaFormat_delete(format);
+            if configured != sys::AMEDIA_OK {
+                sys::AMediaCodec_delete(codec);
+                return Err(());
+            }
+            if sys::AMediaCodec_start(codec) != sys::AMEDIA_OK {
+                sys::AMediaCodec_delete(codec);
+                return Err(());
+            }
+            self.codec = codec;
+            self.track = Some(c.track_id);
+        }
+        Ok(())
+    }
+    fn submit(&mut self, track_id: u32, bytes: &[u8], pts_us: i64) -> Result<bool, ()> {
+        if self.track != Some(track_id)
+            || self.codec.is_null()
+            || pts_us < 0
+            || bytes.is_empty()
+            || bytes.len() > 8 * 1024 * 1024
+        {
+            return Err(());
+        }
+        unsafe {
+            let idx = sys::AMediaCodec_dequeueInputBuffer(self.codec, 0);
+            if idx == sys::AMEDIACODEC_INFO_TRY_AGAIN_LATER {
+                return Ok(false);
+            }
+            if idx < 0 {
+                return Err(());
+            }
+            let mut capacity = 0usize;
+            let dst = sys::AMediaCodec_getInputBuffer(self.codec, idx as usize, &mut capacity);
+            if dst.is_null() || capacity < bytes.len() {
+                return Err(());
+            } // Caller poisons/drops adapter on error.
+            ptr::copy_nonoverlapping(bytes.as_ptr(), dst, bytes.len());
+            if sys::AMediaCodec_queueInputBuffer(
+                self.codec,
+                idx as usize,
+                0,
+                bytes.len(),
+                pts_us as u64,
+                0,
+            ) != sys::AMEDIA_OK
+            {
+                return Err(());
+            }
+        }
+        Ok(true)
+    }
+}
+impl Drop for MseCodecInput<'_> {
+    fn drop(&mut self) {
+        if !self.codec.is_null() {
+            unsafe {
+                sys::AMediaCodec_stop(self.codec);
+                sys::AMediaCodec_delete(self.codec);
+            }
+        }
+    }
+}
