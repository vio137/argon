index 000000000..f8749b999
--- /dev/null
+++ b/components/media/backends/android/mse_demux/append.rs
@@ -0,0 +1,139 @@
+//! Incremental append-to-access-unit processing. The final segment is emitted
+//! at the next segment boundary or explicit end-of-stream, not append-call end.
+//! A JS append is not a media segment boundary.
+use super::{AccessUnit, BoxFramer, Demux, Error};
+pub struct AppendStream {
+    framer: BoxFramer,
+    demux: Demux,
+    init: Vec<u8>,
+    media: Vec<u8>,
+    initialized: bool,
+    has_moof: bool,
+    has_mdat: bool,
+    limit: usize,
+    failed: bool,
+}
+impl AppendStream {
+    pub fn new(limit: usize, max_samples: usize) -> Self {
+        Self {
+            framer: BoxFramer::new(limit),
+            demux: Demux::new(limit, max_samples),
+            init: vec![],
+            media: vec![],
+            initialized: false,
+            has_moof: false,
+            has_mdat: false,
+            limit,
+            failed: false,
+        }
+    }
+    pub fn append(&mut self, data: &[u8]) -> Result<Vec<AccessUnit>, Error> {
+        if self.failed {
+            return Err(Error::InvalidBox);
+        }
+        let result = self.consume(data);
+        if result.is_err() {
+            self.failed = true;
+        }
+        result
+    }
+    fn consume(&mut self, data: &[u8]) -> Result<Vec<AccessUnit>, Error> {
+        self.framer.append(data)?;
+        let mut output = vec![];
+        while let Some(b) = self.framer.pop_box()? {
+            match &b[4..8] {
+                b"ftyp" => {
+                    self.flush(&mut output)?;
+                    self.init = b;
+                    self.initialized = false;
+                },
+                b"moov" => {
+                    if self.init.is_empty() {
+                        return Err(Error::InvalidBox);
+                    }
+                    self.extend_init(&b)?;
+                    self.demux.init(&self.init)?;
+                    self.initialized = true;
+                    self.init.clear();
+                },
+                b"moof" => {
+                    self.flush(&mut output)?;
+                    if !self.initialized {
+                        return Err(Error::InvalidBox);
+                    }
+                    self.media = b;
+                    self.has_moof = true;
+                },
+                b"mdat" => {
+                    if !self.has_moof {
+                        return Err(Error::InvalidBox);
+                    }
+                    self.extend_media(&b)?;
+                    self.has_mdat = true;
+                },
+                _ => {
+                    if self.has_moof {
+                        self.extend_media(&b)?;
+                    } else if !self.init.is_empty() {
+                        self.extend_init(&b)?;
+                    }
+                },
+            }
+        }
+        Ok(output)
+    }
+    fn extend_media(&mut self, b: &[u8]) -> Result<(), Error> {
+        if self.media.len().checked_add(b.len()).ok_or(Error::Quota)? > self.limit {
+            return Err(Error::Quota);
+        }
+        self.media.extend_from_slice(b);
+        Ok(())
+    }
+    fn extend_init(&mut self, b: &[u8]) -> Result<(), Error> {
+        if self.init.len().checked_add(b.len()).ok_or(Error::Quota)?
+            > self.limit.min(2 * 1024 * 1024)
+        {
+            return Err(Error::Quota);
+        }
+        self.init.extend_from_slice(b);
+        Ok(())
+    }
+    fn flush(&mut self, output: &mut Vec<AccessUnit>) -> Result<(), Error> {
+        if self.has_moof {
+            if !self.has_mdat {
+                return Err(Error::Truncated);
+            }
+            output.extend(self.demux.media(&self.media)?);
+            self.media.clear();
+            self.has_moof = false;
+            self.has_mdat = false;
+        }
+        Ok(())
+    }
+    pub fn end_of_stream(&mut self) -> Result<Vec<AccessUnit>, Error> {
+        if self.failed {
+            return Err(Error::InvalidBox);
+        }
+        let result = (|| {
+            self.framer.finish()?;
+            if !self.init.is_empty() {
+                return Err(Error::Truncated);
+            }
+            let mut out = vec![];
+            self.flush(&mut out)?;
+            Ok(out)
+        })();
+        if result.is_err() {
+            self.failed = true;
+        }
+        result
+    }
+    pub fn abort(&mut self) {
+        self.framer.reset();
+        self.media.clear();
+        self.init.clear();
+        self.has_moof = false;
+        self.has_mdat = false;
+        self.failed = false;
+    }
+}
diff --git a/components/media/backends/android/mse_demux/bridge.rs b/components/media/backends/android/mse_demux/bridge.rs
new file mode 100644
index 000000000..bc0c36660
--- /dev/null
+++ b/components/media/backends/android/mse_demux/bridge.rs
@@ -0,0 +1,151 @@
+//! Codec input preparation, not codec execution. This stages the demux-to-NDK
+//! boundary without exposing unfinished DOM APIs or instantiating a decoder.
+use super::{
+    AccessUnit,
+    avc::{AvcConfig, AvcError},
+};
+use std::collections::BTreeMap;
+#[derive(Debug, PartialEq, Eq)]
+pub enum BridgeError {
+    MissingConfiguration,
+    UnsupportedConfiguration,
+    InvalidSample,
+    Quota,
+}
+#[derive(Clone)]
+pub struct DecoderConfig {
+    pub track_id: u32,
+    pub mime: &'static str,
+    pub width: u16,
+    pub height: u16,
+    pub sample_rate: u32,
+    pub channels: u16,
+    pub csd0: Vec<u8>,
+    pub csd1: Vec<u8>,
+}
+pub struct DecoderPacket {
+    pub track_id: u32,
+    pub pts_us: i64,
+    pub keyframe: bool,
+    pub bytes: Vec<u8>,
+    pub config: Option<DecoderConfig>,
+}
+pub struct DecoderBridge {
+    avc: BTreeMap<u32, AvcConfig>,
+    aac: BTreeMap<u32, DecoderConfig>,
+    limit: usize,
+}
+impl DecoderBridge {
+    pub fn new(limit: usize) -> Self {
+        Self {
+            avc: BTreeMap::new(),
+            aac: BTreeMap::new(),
+            limit,
+        }
+    }
+    pub fn reset(&mut self) {
+        self.avc.clear();
+        self.aac.clear();
+    }
+    pub fn prepare(&mut self, unit: AccessUnit) -> Result<DecoderPacket, BridgeError> {
+        if matches!(
+            unit.codec_config,
+            Some(shiguredo_mp4::boxes::SampleEntry::Mp4a(_))
+        ) || (unit.codec_config.is_none() && self.aac.contains_key(&unit.track_id))
+        {
+            return self.prepare_aac(unit);
+        }
+        let replacement = unit
+            .codec_config
+            .as_ref()
+            .map(|e| AvcConfig::from_entry(e, self.limit))
+            .transpose()
+            .map_err(|e| match e {
+                AvcError::Quota => BridgeError::Quota,
+                _ => BridgeError::UnsupportedConfiguration,
+            })?;
+        let config = replacement
+            .as_ref()
+            .or_else(|| self.avc.get(&unit.track_id))
+            .ok_or(BridgeError::MissingConfiguration)?;
+        let bytes = config
+            .annex_b(&unit.data, self.limit)
+            .map_err(|e| match e {
+                AvcError::Quota => BridgeError::Quota,
+                _ => BridgeError::InvalidSample,
+            })?;
+        let update = replacement.as_ref().map(|c| DecoderConfig {
+            track_id: unit.track_id,
+            mime: "video/avc",
+            width: c.width,
+            height: c.height,
+            sample_rate: 0,
+            channels: 0,
+            csd0: c.csd0.clone(),
+            csd1: c.csd1.clone(),
+        });
+        // Commit new configuration only after the associated sample validates.
+        if let Some(c) = replacement {
+            self.aac.remove(&unit.track_id);
+            self.avc.insert(unit.track_id, c);
+        }
+        Ok(DecoderPacket {
+            track_id: unit.track_id,
+            pts_us: unit.pts_us,
+            keyframe: unit.keyframe,
+            bytes,
+            config: update,
+        })
+    }
+    fn prepare_aac(&mut self, unit: AccessUnit) -> Result<DecoderPacket, BridgeError> {
+        use shiguredo_mp4::{bitstream::aac::parse_audio_specific_config, boxes::SampleEntry};
+        if unit.data.is_empty() {
+            return Err(BridgeError::InvalidSample);
+        }
+        if unit.data.len() > self.limit {
+            return Err(BridgeError::Quota);
+        }
+        let replacement = if let Some(SampleEntry::Mp4a(entry)) = unit.codec_config {
+            let desc = &entry.esds_box.es.dec_config_descr;
+            if desc.object_type_indication != 0x40 {
+                return Err(BridgeError::UnsupportedConfiguration);
+            }
+            let asc = &desc
+                .dec_specific_info
+                .as_ref()
+                .ok_or(BridgeError::UnsupportedConfiguration)?
+                .payload;
+            if asc.len() > self.limit {
+                return Err(BridgeError::Quota);
+            }
+            let parsed = parse_audio_specific_config(asc)
+                .map_err(|_| BridgeError::UnsupportedConfiguration)?;
+            Some(DecoderConfig {
+                track_id: unit.track_id,
+                mime: "audio/mp4a-latm",
+                width: 0,
+                height: 0,
+                sample_rate: parsed.sampling_frequency.hz(),
+                channels: parsed.channel_configuration.channel_count(),
+                csd0: asc.clone(),
+                csd1: vec![],
+            })
+        } else {
+            None
+        };
+        if replacement.is_none() && !self.aac.contains_key(&unit.track_id) {
+            return Err(BridgeError::MissingConfiguration);
+        }
+        if let Some(ref c) = replacement {
+            self.aac.insert(unit.track_id, c.clone());
+            self.avc.remove(&unit.track_id);
+        }
+        Ok(DecoderPacket {
+            track_id: unit.track_id,
+            pts_us: unit.pts_us,
+            keyframe: unit.keyframe,
+            bytes: unit.data,
+            config: replacement,
+        })
+    }
+}
diff --git a/components/media/backends/android/mse_demux/delivery.rs b/components/media/backends/android/mse_demux/delivery.rs
new file mode 100644
index 000000000..9af1753fd
--- /dev/null
+++ b/components/media/backends/android/mse_demux/delivery.rs
@@ -0,0 +1,192 @@
+//! Bounded retained packet delivery. Zero-capacity codec input yields instead
+//! of dropping data. Configuration is applied once per retained packet.
+use super::bridge::{DecoderConfig, DecoderPacket};
+use std::collections::VecDeque;
+#[derive(Debug, PartialEq, Eq)]
+pub enum DeliveryError {
+    Quota,
+    Decoder,
+    InvalidTimestamp,
+    Poisoned,
+}
+pub trait CodecInput {
+    fn configure(&mut self, config: &DecoderConfig) -> Result<(), ()>;
+    /// true only when the entire packet was accepted; false is retry-later.
+    fn submit(&mut self, track_id: u32, bytes: &[u8], pts_us: i64) -> Result<bool, ()>;
+}
+struct Pending {
+    packet: DecoderPacket,
+    configured: bool,
+}
+pub struct Delivery {
+    packets: VecDeque<Pending>,
+    bytes: usize,
+    limit: usize,
+    poisoned: bool,
+}
+impl Delivery {
+    pub fn new(limit: usize) -> Self {
+        Self {
+            packets: VecDeque::new(),
+            bytes: 0,
+            limit,
+            poisoned: false,
+        }
+    }
+    pub fn push(&mut self, packet: DecoderPacket) -> Result<(), DeliveryError> {
+        if self.poisoned {
+            return Err(DeliveryError::Poisoned);
+        }
+        if packet.pts_us < 0 {
+            return Err(DeliveryError::InvalidTimestamp);
+        }
+        let config_bytes = packet
+            .config
+            .as_ref()
+            .map(|c| c.csd0.len().saturating_add(c.csd1.len()))
+            .unwrap_or(0);
+        if self
+            .bytes
+            .checked_add(packet.bytes.len())
+            .and_then(|n| n.checked_add(config_bytes))
+            .ok_or(DeliveryError::Quota)?
+            > self.limit
+        {
+            return Err(DeliveryError::Quota);
+        }
+        self.bytes += packet.bytes.len() + config_bytes;
+        self.packets.push_back(Pending {
+            packet,
+            configured: false,
+        });
+        Ok(())
+    }
+    pub fn pump(&mut self, sink: &mut impl CodecInput) -> Result<bool, DeliveryError> {
+        if self.poisoned {
+            return Err(DeliveryError::Poisoned);
+        }
+        let Some(front) = self.packets.front_mut() else {
+            return Ok(false);
+        };
+        if !front.configured {
+            if let Some(c) = front.packet.config.as_ref() {
+                if sink.configure(c).is_err() {
+                    self.poisoned = true;
+                    return Err(DeliveryError::Decoder);
+                }
+            }
+            front.configured = true;
+        }
+        match sink.submit(
+            front.packet.track_id,
+            &front.packet.bytes,
+            front.packet.pts_us,
+        ) {
+            Ok(false) => Ok(false),
+            Err(()) => {
+                self.poisoned = true;
+                Err(DeliveryError::Decoder)
+            },
+            Ok(true) => {
+                let f = self.packets.pop_front().unwrap();
+                self.bytes -= f.packet.bytes.len()
+                    + f.packet
+                        .config
+                        .as_ref()
+                        .map(|c| c.csd0.len() + c.csd1.len())
+                        .unwrap_or(0);
+                Ok(true)
+            },
+        }
+    }
+    pub fn is_empty(&self) -> bool {
+        self.packets.is_empty()
+    }
+    pub fn reset(&mut self) {
+        self.packets.clear();
+        self.bytes = 0;
+        self.poisoned = false;
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn packet() -> DecoderPacket {
+        DecoderPacket {
+            track_id: 1,
+            pts_us: 3,
+            keyframe: true,
+            bytes: vec![1, 2],
+            config: Some(DecoderConfig {
+                track_id: 1,
+                mime: "video/avc",
+                width: 32,
+                height: 32,
+                sample_rate: 0,
+                channels: 0,
+                csd0: vec![1],
+                csd1: vec![2],
+            }),
+        }
+    }
+    struct Fake {
+        configs: usize,
+        calls: usize,
+        ready: bool,
+        fail: bool,
+    }
+    impl CodecInput for Fake {
+        fn configure(&mut self, _: &DecoderConfig) -> Result<(), ()> {
+            self.configs += 1;
+            Ok(())
+        }
+        fn submit(&mut self, track_id: u32, b: &[u8], p: i64) -> Result<bool, ()> {
+            assert_eq!(track_id, 1);
+            self.calls += 1;
+            assert_eq!(b, &[1, 2]);
+            assert_eq!(p, 3);
+            if self.fail { Err(()) } else { Ok(self.ready) }
+        }
+    }
+    #[test]
+    fn retry_keeps_packet_and_does_not_reconfigure() {
+        let mut d = Delivery::new(16);
+        d.push(packet()).unwrap();
+        let mut s = Fake {
+            configs: 0,
+            calls: 0,
+            ready: false,
+            fail: false,
+        };
+        assert_eq!(d.pump(&mut s), Ok(false));
+        assert!(!d.is_empty());
+        s.ready = true;
+        assert_eq!(d.pump(&mut s), Ok(true));
+        assert!(d.is_empty());
+        assert_eq!((s.configs, s.calls), (1, 2));
+    }
+    #[test]
+    fn errors_poison_until_reset() {
+        let mut d = Delivery::new(16);
+        d.push(packet()).unwrap();
+        let mut s = Fake {
+            configs: 0,
+            calls: 0,
+            ready: true,
+            fail: true,
+        };
+        assert_eq!(d.pump(&mut s), Err(DeliveryError::Decoder));
+        assert_eq!(d.pump(&mut s), Err(DeliveryError::Poisoned));
+        d.reset();
+        assert!(d.is_empty());
+        assert!(d.push(packet()).is_ok());
+    }
+    #[test]
+    fn quota_includes_config_and_negative_pts_is_rejected() {
+        let mut d = Delivery::new(3);
+        assert_eq!(d.push(packet()), Err(DeliveryError::Quota));
+        let mut p = packet();
+        p.pts_us = -1;
+        assert_eq!(d.push(p), Err(DeliveryError::InvalidTimestamp));
+    }
+}
