+#[test]
+fn actual_avc_fragments_prepare_codec_config_and_annexb_packets() {
+    use servo_media_android_hosttest::mse_demux::bridge::DecoderBridge;
+    let bs = boxes();
+    let mut init = vec![];
+    for b in &bs {
+        if [&b"ftyp"[..], &b"moov"[..]].contains(&&b[4..8]) {
+            init.extend(b);
+        }
+    }
+    let mut d = Demux::new(1 << 20, 64);
+    d.init(&init).unwrap();
+    let mut bridge = DecoderBridge::new(1 << 20);
+    let mut packets = vec![];
+    for pair in bs.windows(2) {
+        if &pair[0][4..8] == b"moof" && &pair[1][4..8] == b"mdat" {
+            let mut media = pair[0].clone();
+            media.extend_from_slice(&pair[1]);
+            for unit in d.media(&media).unwrap() {
+                packets.push(bridge.prepare(unit).unwrap());
+            }
+        }
+    }
+    assert_eq!(packets.len(), 2);
+    let c = packets[0].config.as_ref().unwrap();
+    assert_eq!((c.width, c.height), (32, 32));
+    assert!(c.csd0.starts_with(&[0, 0, 0, 1, 0x67]));
+    assert!(c.csd1.starts_with(&[0, 0, 0, 1, 0x68]));
+    assert_eq!(packets[1].pts_us, 500_000);
+    assert!(packets[1].config.is_none());
+    assert!(packets.iter().all(|p| p.bytes.starts_with(&[0, 0, 0, 1])));
+}
+#[test]
+fn missing_configuration_and_reset_fail_closed() {
+    use servo_media_android_hosttest::mse_demux::{
+        AccessUnit,
+        bridge::{BridgeError, DecoderBridge},
+    };
+    let mut b = DecoderBridge::new(1024);
+    b.reset();
+    let u = AccessUnit {
+        track_id: 1,
+        dts_us: 0,
+        pts_us: 0,
+        duration_us: 1,
+        keyframe: true,
+        codec_config: None,
+        data: vec![0, 0, 0, 1, 0x65],
+    };
+    assert!(matches!(
+        b.prepare(u),
+        Err(BridgeError::MissingConfiguration)
+    ));
+}
+#[test]
+fn extended_aac_configuration_is_explicitly_rejected_not_misdecoded() {
+    use servo_media_android_hosttest::mse_demux::bridge::DecoderBridge;
+    let mut framer = BoxFramer::new(1 << 20);
+    framer
+        .append(include_bytes!("fixtures/synthetic-aac.mp4"))
+        .unwrap();
+    let mut bs = vec![];
+    while let Some(b) = framer.pop_box().unwrap() {
+        bs.push(b);
+    }
+    let mut init = vec![];
+    for b in &bs {
+        if [&b"ftyp"[..], &b"moov"[..]].contains(&&b[4..8]) {
+            init.extend(b);
+        }
+    }
+    let mut d = Demux::new(1 << 20, 128);
+    d.init(&init).unwrap();
+    let mut bridge = DecoderBridge::new(1 << 20);
+    let mut packets = vec![];
+    for pair in bs.windows(2) {
+        if &pair[0][4..8] == b"moof" && &pair[1][4..8] == b"mdat" {
+            let mut media = pair[0].clone();
+            media.extend_from_slice(&pair[1]);
+            for unit in d.media(&media).unwrap() {
+                packets.push(bridge.prepare(unit));
+            }
+        }
+    }
+    assert!(!packets.is_empty());
+    assert!(matches!(
+        packets[0],
+        Err(servo_media_android_hosttest::mse_demux::bridge::BridgeError::UnsupportedConfiguration)
+    ));
+}
+#[test]
+fn append_stream_retains_segments_across_arbitrary_js_append_boundaries() {
+    use servo_media_android_hosttest::mse_demux::append::AppendStream;
+    let bytes = include_bytes!("fixtures/synthetic-fmp4.mp4");
+    for chunk in [1, 7, 17, bytes.len()] {
+        let mut stream = AppendStream::new(1 << 20, 128);
+        let mut units = vec![];
+        for c in bytes.chunks(chunk) {
+            units.extend(stream.append(c).unwrap());
+        }
+        units.extend(stream.end_of_stream().unwrap());
+        assert_eq!(units.len(), 2);
+        assert_eq!(units[1].pts_us, 500_000);
+    }
+}
+#[test]
+fn append_stream_error_stays_failed_until_explicit_abort() {
+    use servo_media_android_hosttest::mse_demux::append::AppendStream;
+    let mut stream = AppendStream::new(1 << 20, 128);
+    assert!(
+        stream
+            .append(&[0, 0, 0, 7, b'f', b'r', b'e', b'e'])
+            .is_err()
+    );
+    assert!(stream.append(&[]).is_err());
+    stream.abort();
+    let mut units = stream
+        .append(include_bytes!("fixtures/synthetic-fmp4.mp4"))
+        .unwrap();
+    units.extend(stream.end_of_stream().unwrap());
+    assert_eq!(units.len(), 2);
+}
+#[test]
+fn eos_rejects_partial_box_instead_of_marking_complete() {
+    use servo_media_android_hosttest::mse_demux::append::AppendStream;
+    let mut stream = AppendStream::new(1 << 20, 128);
+    stream.append(&[0, 0, 0]).unwrap();
+    assert!(stream.end_of_stream().is_err());
+}
diff --git a/components/media/backends/android/mse_demux/README.md b/components/media/backends/android/mse_demux/README.md
index 8c1751a44..c0fb4bb2a 100644
--- a/components/media/backends/android/mse_demux/README.md
+++ b/components/media/backends/android/mse_demux/README.md
