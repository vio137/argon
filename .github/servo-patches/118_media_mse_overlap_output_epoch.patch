+#[test]
+fn replacement_append_resets_native_epoch_and_clears_stale_pending_output_before_replay() {
+ let frames=Arc::new(Mutex::new(vec![]));
+ let mut p=AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));p.add_buffer(1).unwrap();
+ let fixture=include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4");
+ p.append(1,fixture).unwrap();p.pump().unwrap();
+ assert!(p.decoders.video.is_some());
+ p.video_pending=Some(Instant::now());p.rendered_frames=10;
+ p.clock.rebase(250_000);p.clock.pause();
+ p.append(1,fixture).unwrap();
+ assert!(p.decoders.video.is_none());assert!(p.decoders.surface.is_none());
+ assert!(p.video_pending.is_none());assert_eq!(p.rendered_frames,0);
+ assert_eq!(p.seek_target,Some(250_000));assert!(!p.sessions[&1].output_invalidated());
+ assert_eq!(p.sessions[&1].buffered(),[0..1_000_000]);
+ // Partial/new nonoverlapping input must not reset an otherwise live epoch.
+ p.seek_target=None;p.rendered_frames=7;p.append(1,&[]).unwrap();assert_eq!(p.rendered_frames,7);
+}
+
+#[test]
+fn replacement_replays_other_selected_buffer_and_preserves_uncovered_seek_wait() {
+ let frames=Arc::new(Mutex::new(vec![]));
+ let mut p=AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+ p.add_buffer(1).unwrap();p.add_buffer(2).unwrap();
+ let video=include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4");
+ p.append(1,video).unwrap();
+ p.append(2,include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4")).unwrap();
+ for (id,session) in &mut p.sessions {
+  let mut sink=ScopedDecoder{buffer_id:*id,decoders:&mut p.decoders};
+  while session.pump_input(&mut sink).unwrap(){}
+ }
+ assert!(p.decoders.audio.is_some());assert!(p.decoders.video.is_some());
+ p.clock.rebase(50_000);p.clock.pause();p.append(1,video).unwrap();
+ assert!(p.decoders.audio.is_none());assert!(p.decoders.video.is_none());
+ assert_eq!(p.seek_target,Some(50_000));
+ assert!(p.sessions.values().all(|s|!s.output_invalidated()));
+ for (id,session) in &mut p.sessions {
+  let mut sink=ScopedDecoder{buffer_id:*id,decoders:&mut p.decoders};
+  while session.pump_input(&mut sink).unwrap(){}
+ }
+ assert!(p.decoders.audio.is_some());assert!(p.decoders.video.is_some());
+ p.seek_or_wait_for_coverage(2_000_000).unwrap();
+ assert_eq!(p.removed_target,Some(2_000_000));
+ p.append(1,video).unwrap();
+ assert_eq!(p.removed_target,Some(2_000_000));assert!(p.seek_target.is_none());
+ assert!(!p.pump().unwrap().current_data);
+ assert!(p.sessions.values().all(|s|!s.output_invalidated()));
+}
