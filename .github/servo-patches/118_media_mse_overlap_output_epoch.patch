+#[test]
+fn overlapping_append_invalidates_old_delivery_until_owner_replays_retained_samples() {
+ use shiguredo_mp4::{Decode,Encode,boxes::MoovBox};
+ use servo_media_android_hosttest::mse_demux::{session::AppendSession,delivery::CodecInput,bridge::DecoderConfig};
+ struct Sink{widths:Vec<u16>,pts:Vec<i64>}
+ impl CodecInput for Sink {
+  fn configure(&mut self,c:&DecoderConfig)->Result<(),()>{self.widths.push(c.width);Ok(())}
+  fn submit(&mut self,_:u32,_:&[u8],pts:i64)->Result<bool,()>{self.pts.push(pts);Ok(true)}
+ }
+ let mut replacement=vec![];
+ for b in boxes(){if &b[4..8]==b"moov" {
+  let(mut moov,_)=MoovBox::decode(&b).unwrap();
+  if let shiguredo_mp4::boxes::SampleEntry::Avc1(e)=&mut moov.trak_boxes[0].mdia_box.minf_box.stbl_box.stsd_box.entries[0] {e.visual.width=64;}
+  replacement.extend(moov.encode_to_vec().unwrap());
+ }else{replacement.extend(b);}}
+ for already_pumped in [false,true] {
+  let mut s=AppendSession::new(1<<20,100);s.append(include_bytes!("fixtures/synthetic-fmp4.mp4")).unwrap();
+  let mut old=Sink{widths:vec![],pts:vec![]};
+  if already_pumped {assert!(s.pump_input(&mut old).unwrap());}
+  s.append(&replacement).unwrap();assert!(s.output_invalidated());
+  assert!(s.pump_input(&mut old).is_err(),"stale native output needs coordinated reset");
+  s.prepare_seek(0).unwrap();assert!(!s.output_invalidated());
+  let mut fresh=Sink{widths:vec![],pts:vec![]};while s.pump_input(&mut fresh).unwrap(){}
+  assert_eq!(fresh.widths,[64]);assert_eq!(fresh.pts,[0,500_000]);
+ }
+}
