+#[cfg(test)]
+mod forbidden_bit_tests {
+ use super::*;
+ #[test]
+ fn invalid_parameter_headers_reject_even_when_the_masked_type_matches() {
+  for (nal,kind) in [(vec![0xe7,1],7),(vec![0xe8,1],8)] {
+   assert_eq!(parameters(&[nal],kind,64),Err(AvcError::Invalid));
+  }
+  assert_eq!(parameters(&[vec![0x67,1],vec![0xe7,2]],7,64),Err(AvcError::Invalid));
+ }
+ #[test]
+ fn forbidden_bit_in_any_access_unit_nal_rejects_all_length_widths() {
+  for width in [1,2,4] {
+   let length=|n:u32|n.to_be_bytes()[4-width..].to_vec();
+   let mut bytes=length(2);bytes.extend([0x65,1]);bytes.extend(length(2));bytes.extend([0xe1,2]);
+   assert_eq!(convert(&bytes,width,64),Err(AvcError::Invalid));
+   *bytes.last_mut().unwrap()=0xff;bytes[width+2+width]=0x61;
+   assert!(convert(&bytes,width,64).is_ok(),"payload high bits are not header bits");
+  }
+ }
