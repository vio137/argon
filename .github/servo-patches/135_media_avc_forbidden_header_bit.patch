+#[test]
+fn forbidden_parameter_header_replacement_preserves_last_valid_avc_configuration() {
+ use shiguredo_mp4::{Decode,Encode,boxes::{MoovBox,SampleEntry}};
+ use servo_media_android_hosttest::mse_demux::Error;
+ let bs=boxes();let ftyp=bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap();let bytes=bs.iter().find(|b|&b[4..8]==b"moov").unwrap();
+ let(mut moov,_)=MoovBox::decode(bytes).unwrap();let mut original=ftyp.clone();original.extend_from_slice(bytes);
+ if let SampleEntry::Avc1(e)=&mut moov.trak_boxes[0].mdia_box.minf_box.stbl_box.stsd_box.entries[0]{e.avcc_box.sps_list[0][0]|=0x80;}else{panic!();}
+ let mut bad=ftyp.clone();bad.extend(moov.encode_to_vec().unwrap());let mut d=Demux::new(1<<20,64);d.init(&original).unwrap();assert_eq!(d.init(&bad),Err(Error::InvalidSample));
+ let mut baseline=Demux::new(1<<20,64);baseline.init(&original).unwrap();
+ for pair in bs.windows(2) {if &pair[0][4..8]==b"moof"&&&pair[1][4..8]==b"mdat" {
+  let mut segment=pair[0].clone();segment.extend_from_slice(&pair[1]);let got=d.media(&segment).unwrap();let expected=baseline.media(&segment).unwrap();
+  assert_eq!(got.len(),expected.len());for(a,b)in got.iter().zip(expected.iter()){assert_eq!(a.data,b.data);assert_eq!((a.pts_us,a.duration_us),(b.pts_us,b.duration_us));}
+ }}
+}
