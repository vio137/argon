+#[cfg(test)]
+mod manual_duration_tests {
+    use crate::{
+        PlayerEvent, append::AppendEvent, append_source::*, generic_channel::GenericCallback,
+        mse_player::AndroidAppendPlayer,
+    };
+    use std::{
+        sync::{Arc, mpsc},
+        time::Duration,
+    };
+    #[test]
+    fn duration_validates_retained_frame_start_extends_to_frame_end_and_eos_overrides() {
+        let (tx, events) = mpsc::channel();
+        let player = AndroidAppendPlayer::new(
+            91,
+            GenericCallback::new(move |e| {
+                if let Ok(e) = e {
+                    let _ = tx.send(e);
+                }
+            })
+            .unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let (tx, rx) = mpsc::channel();
+        let source = AppendSource::new(Arc::new(move |e| {
+            let _ = tx.send(e);
+        }));
+        assert_eq!(source.set_duration(f64::NAN), Err(SourceError::Type));
+        assert_eq!(source.set_duration(5.0), Err(SourceError::InvalidState));
+        source.attach(player).unwrap();
+        assert_eq!(source.set_duration(0.000000001), Ok((0.000000001, 1)));
+        let buffer = source.add_buffer("video/mp4").unwrap();
+        loop {
+            if matches!(
+                rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+                SourceEvent::BufferEvent(_, AppendEvent::Ready, _)
+            ) {
+                break;
+            }
+        }
+        buffer
+            .append(include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec())
+            .unwrap();
+        loop {
+            if matches!(
+                rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+                SourceEvent::BufferEvent(_, AppendEvent::UpdateEnd, 1)
+            ) {
+                break;
+            }
+        }
+        assert_eq!(
+            source.set_duration(0.499999),
+            Err(SourceError::InvalidState)
+        );
+        assert_eq!(buffer.buffered(), [0.0..1.0]);
+        assert_eq!(source.set_duration(0.5), Ok((1.0, 2)));
+        assert_eq!(source.set_duration(50.000000001), Ok((50.000000001, 3)));
+        source.end_input().unwrap();
+        assert_eq!(source.set_duration(3.0), Err(SourceError::InvalidState));
+        loop {
+            match events.recv_timeout(Duration::from_secs(2)).unwrap() {
+                PlayerEvent::AppendDurationChanged {
+                    generation: 3,
+                    duration,
+                } if duration == 1.0 => break,
+                PlayerEvent::Error(e) => panic!("{e}"),
+                _ => (),
+            }
+        }
+        source.reopen().unwrap();
+        assert_eq!(source.set_duration(f64::INFINITY), Ok((f64::INFINITY, 4)));
+        source.detach();
+        assert_eq!(source.set_duration(-1.0), Err(SourceError::Type));
+        assert_eq!(source.set_duration(1.0), Err(SourceError::InvalidState));
+    }
+}
