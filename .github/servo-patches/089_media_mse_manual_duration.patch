+            assert_eq!(s.duration_us, None);
+        }
+        rx.recv().unwrap();
+        assert_eq!(p.append_set_duration(1e100), Ok((1e100, 1)));
+        let s = p.state.lock().unwrap();
+        assert_eq!(s.duration_seconds, 1e100);
+        assert_eq!(s.duration_generation, 1);
+        assert_eq!(s.duration_us, Some(i64::MAX));
+    }
+    #[test]
+    fn old_duration_status_cannot_overwrite_a_new_setter_and_uninitialized_infinity_stays_unknown()
+    {
+        let p = AndroidAppendPlayer::new(
+            93,
+            GenericCallback::new(|_| {}).unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let p = p.lock().unwrap();
+        let mut s = p.state.lock().unwrap();
+        assert!(!s.apply_duration_status(0, f64::INFINITY, None, false));
+        assert!(s.duration_seconds.is_nan());
+        s.duration_generation = 2;
+        s.duration_seconds = 1e100;
+        s.duration_us = Some(i64::MAX);
+        assert!(!s.apply_duration_status(1, 1.0, Some(1_000_000), true));
+        assert_eq!(s.duration_seconds, 1e100);
+        assert_eq!(s.duration_generation, 2);
+        assert!(!s.apply_duration_status(2, 1e100, Some(i64::MAX), true));
+        assert!(s.apply_duration_status(2, 1.0, Some(1_000_000), true));
+        assert_eq!(s.duration_seconds, 1.0);
+    }
+    #[test]
+    fn duration_can_be_queued_after_buffer_creation_before_ready_but_not_while_updating() {
+        let p = AndroidAppendPlayer::new(
+            94,
+            GenericCallback::new(|_| {}).unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let p = p.lock().unwrap();
+        drop(p.worker.lock().unwrap().take());
+        let (worker, rx) = Worker::saturated_for_test();
+        *p.worker.lock().unwrap() = Some(worker);
+        rx.recv().unwrap();
+        {
+            let mut s = p.state.lock().unwrap();
+            s.buffers.insert(
+                1,
+                BufferState {
+                    ready: false,
+                    updating: false,
+                    removing: false,
+                    operation: 0,
+                    callback: Arc::new(|_| {}),
+                },
+            );
+        }
+        assert_eq!(p.append_set_duration(10.0), Ok((10.0, 1)));
+        {
+            p.state
+                .lock()
+                .unwrap()
+                .buffers
+                .get_mut(&1)
+                .unwrap()
+                .updating = true;
+        }
+        assert_eq!(
+            p.append_set_duration(5.0),
+            Err(PlayerError::BufferPushFailed)
+        );
+        assert_eq!(p.state.lock().unwrap().duration_generation, 1);
+    }
 }
