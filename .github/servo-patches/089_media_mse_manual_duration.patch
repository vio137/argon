+/// MSE duration-change validation, independent of media timestamp precision.
+/// Reducing below a retained frame's start is an InvalidState failure; a
+/// surviving frame that crosses the requested end extends the final duration.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DurationChangeError {
+    Type,
+    InvalidState,
+}
+pub fn changed_duration(
+    requested: f64,
+    current: f64,
+    highest_pts: Option<i64>,
+    highest_end: i64,
+) -> Result<f64, DurationChangeError> {
+    if requested.is_nan() || requested < 0.0 {
+        return Err(DurationChangeError::Type);
+    }
+    if requested == current {
+        return Ok(current);
+    }
+    if highest_pts.is_some_and(|pts| requested < (pts as f64 / 1e6)) {
+        return Err(DurationChangeError::InvalidState);
+    }
+    Ok(requested.max(highest_end as f64 / 1e6))
+}
+#[cfg(test)]
+mod duration_change_tests {
+    use super::*;
+    #[test]
+    fn invalid_values_reject_and_positive_infinity_is_preserved() {
+        for v in [f64::NAN, -1.0, f64::NEG_INFINITY] {
+            assert_eq!(
+                changed_duration(v, f64::NAN, None, 0),
+                Err(DurationChangeError::Type)
+            );
+        }
+        assert_eq!(
+            changed_duration(f64::INFINITY, 3.0, Some(500_000), 1_000_000),
+            Ok(f64::INFINITY)
+        );
+    }
+    #[test]
+    fn retained_frame_start_rejects_truncation_but_crossing_frame_end_extends_duration() {
+        assert_eq!(
+            changed_duration(0.499999, 2.0, Some(500_000), 1_000_000),
+            Err(DurationChangeError::InvalidState)
+        );
+        assert_eq!(
+            changed_duration(0.5, 2.0, Some(500_000), 1_000_000),
+            Ok(1.0)
+        );
+        assert_eq!(
+            changed_duration(1.5, 2.0, Some(500_000), 1_000_000),
+            Ok(1.5)
+        );
+    }
+    #[test]
+    fn exact_noop_precedes_frame_validation_and_empty_source_keeps_fractional_precision() {
+        assert_eq!(
+            changed_duration(0.25, 0.25, Some(500_000), 1_000_000),
+            Ok(0.25)
+        );
+        assert_eq!(
+            changed_duration(0.000000001, f64::NAN, None, 0),
+            Ok(0.000000001)
+        );
+        assert_eq!(changed_duration(0.0, f64::INFINITY, None, 0), Ok(0.0));
+    }
+}
