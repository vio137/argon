+#[test]
+fn native_duration_keeps_exact_public_seconds_and_rejects_retained_frame_truncation() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.set_duration(1, 0.000000001).unwrap();
+    assert_eq!(p.pump().unwrap().duration_seconds, 0.000000001);
+    assert_eq!(p.duration_us(), Some(1));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    assert_eq!(p.duration_seconds, 1.0);
+    assert!(p.set_duration(2, 0.499999).is_err());
+    assert_eq!(p.duration_generation, 1);
+    assert_eq!(p.duration_seconds, 1.0);
+    assert_eq!(p.buffered(), [0..1_000_000]);
+    p.set_duration(2, 0.5).unwrap();
+    assert_eq!(p.duration_seconds, 1.0);
+    p.set_duration(3, 1e100).unwrap();
+    assert_eq!(p.duration_seconds, 1e100);
+    assert_eq!(p.duration_us(), Some(i64::MAX));
+    p.set_duration(4, f64::INFINITY).unwrap();
+    assert_eq!(p.duration_us(), None);
+    p.end_input().unwrap();
+    assert_eq!(p.duration_seconds, 1.0);
+    assert_eq!(p.duration_generation, 4);
+}
