+#[cfg(test)]
+mod reported_range_tests {
+ use super::*;
+ #[test] fn ended_extends_only_final_ranges_without_creating_samples_or_filling_gaps() {
+  let ranges=vec![vec![0..5,10..15],vec![0..4,10..12]];
+  assert_eq!(reported_intersection(ranges.clone(),false),[0..4,10..12]);
+  assert_eq!(reported_intersection(ranges,true),[0..4,10..15]);
+  assert!(reported_intersection(vec![vec![0..10],vec![]],true).is_empty());
+  assert!(reported_intersection(vec![],true).is_empty());
+ }
