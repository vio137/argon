+/// Observable MSE ranges, separate from actual decoder coverage. At ended,
+/// only the final range is extended. Interior gaps and empty tracks remain.
+pub fn reported_intersection(mut tracks: Vec<Vec<std::ops::Range<i64>>>, ended: bool)
+    -> Vec<std::ops::Range<i64>> {
+    let highest=tracks.iter().flat_map(|r|r.iter().map(|r|r.end)).max().unwrap_or(0);
+    if tracks.is_empty() || highest<=0 {return vec![];}
+    let mut result=vec![0..highest];
+    for ranges in &mut tracks {
+        if ended {if let Some(last)=ranges.last_mut() {last.end=highest;}}
+        let mut next=vec![];
+        for a in &result {for b in ranges.iter() {
+            let start=a.start.max(b.start);let end=a.end.min(b.end);
+            if start<end {next.push(start..end);}
+        }}
+        result=next;
+    }
+    result
+}
