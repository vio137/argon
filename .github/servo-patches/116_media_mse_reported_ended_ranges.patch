+#[test]
+fn ended_reported_ranges_extend_shorter_tail_but_decoder_coverage_and_reopen_stay_real() {
+ let frames=Arc::new(Mutex::new(vec![]));
+ let mut p=AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+ p.add_buffer(1).unwrap();p.add_buffer(2).unwrap();
+ p.append(1,include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4")).unwrap();
+ p.append(2,include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4")).unwrap();
+ let before=p.reported_buffered();assert_eq!(before,p.buffered());
+ let highest=p.largest_track_end();assert!(before.last().unwrap().end<highest);
+ p.end_input().unwrap();
+ let mut expected=before.clone();expected.last_mut().unwrap().end=highest;
+ assert_eq!(p.reported_buffered(),expected);
+ assert_eq!(p.buffered(),before,"reporting must not fabricate decoder coverage");
+ p.reopen_input().unwrap();assert_eq!(p.reported_buffered(),before);
+ assert_eq!(p.buffer_ranges().iter().find(|(id,_)|*id==1).unwrap().1,[0..1_000_000]);
+}
