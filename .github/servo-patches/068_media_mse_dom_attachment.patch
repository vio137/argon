diff --git a/components/script/dom/mse/mediasource.rs b/components/script/dom/mse/mediasource.rs
new file mode 100644
index 000000000..7d3c1b206
--- /dev/null
+++ b/components/script/dom/mse/mediasource.rs
@@ -0,0 +1,284 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+//! Uncompiled attachment draft. No preference or capability is enabled.
+//! HTMLMediaElement must call detach before NETWORK_EMPTY/resource teardown.
+use crate::dom::{
+    bindings::{
+        inheritance::Castable,
+        reflector::DomGlobal,
+        root::{DomRoot, MutNullableDom},
+    },
+    eventtarget::EventTarget,
+    globalscope::GlobalScope,
+    htmlmediaelement::HTMLMediaElement,
+    sourcebuffer::SourceBuffer,
+    sourcebufferlist::SourceBufferList,
+    window::Window,
+};
+use dom_struct::dom_struct;
+use js::{context::JSContext, rust::HandleObject};
+use script_bindings::{
+    assert::assert_in_script,
+    codegen::GenericBindings::MediaSourceBinding::{
+        EndOfStreamError, MediaSourceMethods, ReadyState,
+    },
+    domstring::DOMString,
+    error::{Error, Fallible},
+    num::Finite,
+    reflector::reflect_weak_referenceable_dom_object_with_proto,
+    weakref::WeakRef,
+};
+use servo_media::player::{
+    Player,
+    append_source::{AppendSource, SourceError, SourceEvent, SourceState},
+};
+use std::{
+    cell::{Cell, RefCell},
+    rc::Rc,
+    sync::{
+        Arc, Mutex, Weak,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+#[dom_struct]
+pub(crate) struct MediaSource {
+    event_target: EventTarget,
+    #[no_trace]
+    #[ignore_malloc_size_of = "private append source controller"]
+    controller: AppendSource,
+    #[no_trace]
+    #[ignore_malloc_size_of = "weak backend callback routing"]
+    callback_route: Arc<Mutex<Weak<Mutex<SourceEventTarget>>>>,
+    #[no_trace]
+    #[ignore_malloc_size_of = "backend event generation"]
+    generation: Arc<AtomicU64>,
+    #[no_trace]
+    #[ignore_malloc_size_of = "script-thread weak DOM event target"]
+    event_target_owner: RefCell<Option<Arc<Mutex<SourceEventTarget>>>>,
+    media: MutNullableDom<HTMLMediaElement>,
+    source_buffers: MutNullableDom<SourceBufferList>,
+    active_buffers: MutNullableDom<SourceBufferList>,
+    duration: Cell<f64>,
+}
+fn source_error(error: SourceError) -> Error {
+    match error {
+        SourceError::InvalidState | SourceError::Backend => Error::InvalidState(None),
+        SourceError::Type => Error::Type("Invalid source parameters".to_owned()),
+        SourceError::NotSupported => Error::NotSupported(None),
+        SourceError::Quota => Error::QuotaExceeded {
+            quota: None,
+            requested: None,
+        },
+    }
+}
+impl MediaSource {
+    pub(crate) fn new_with_proto(
+        cx: &mut JSContext,
+        global: &GlobalScope,
+        proto: Option<HandleObject>,
+    ) -> Fallible<DomRoot<Self>> {
+        let route: Arc<Mutex<Weak<Mutex<SourceEventTarget>>>> = Arc::new(Mutex::new(Weak::new()));
+        let callback_route = route.clone();
+        let generation = Arc::new(AtomicU64::new(0));
+        let callback_generation = generation.clone();
+        let tasks = Arc::new(Mutex::new(
+            global
+                .task_manager()
+                .media_element_task_source()
+                .to_sendable(),
+        ));
+        let controller = AppendSource::new(Arc::new(move |event| {
+            let target = callback_route.lock().unwrap().clone();
+            let generation = callback_generation.load(Ordering::Acquire);
+            tasks.lock().unwrap().queue(task!(append_source_backend_event: move |cx| {
+                // Upgrade, root and drop the non-thread-safe weak DOM handle
+                // only on the script thread, never in the native callback.
+                let Some(target)=target.upgrade() else{return;};
+                let this={ let target=target.lock().unwrap(); target.source.root() };
+                let Some(this)=this else{return;};
+                if this.generation.load(Ordering::Acquire)==generation {this.backend_event(cx,event);}
+            }));
+        }));
+        let this = reflect_weak_referenceable_dom_object_with_proto(
+            cx,
+            Rc::new(Self {
+                event_target: EventTarget::new_inherited(),
+                controller,
+                callback_route: route,
+                generation,
+                event_target_owner: RefCell::new(None),
+                media: MutNullableDom::new(None),
+                source_buffers: MutNullableDom::new(None),
+                active_buffers: MutNullableDom::new(None),
+                duration: Cell::new(f64::NAN),
+            }),
+            global,
+            proto,
+        );
+        let target = Arc::new(Mutex::new(SourceEventTarget {
+            source: WeakRef::new(&*this),
+        }));
+        *this.callback_route.lock().unwrap() = Arc::downgrade(&target);
+        *this.event_target_owner.borrow_mut() = Some(target);
+        Ok(this)
+    }
+    pub(crate) fn attach(
+        &self,
+        player: Arc<Mutex<dyn Player>>,
+        media: &HTMLMediaElement,
+    ) -> Fallible<()> {
+        if self.controller.state() != SourceState::Closed || self.media.get().is_some() {
+            return Err(Error::InvalidState(None));
+        }
+        self.media.set(Some(media));
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        if let Err(error) = self.controller.attach(player) {
+            self.media.set(None);
+            return Err(source_error(error));
+        }
+        Ok(())
+    }
+    pub(crate) fn detach(&self) {
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        self.controller.detach();
+        self.media.set(None);
+        self.duration.set(f64::NAN);
+        if let Some(list) = self.source_buffers.get() {
+            list.clear();
+        }
+        if let Some(list) = self.active_buffers.get() {
+            list.clear();
+        }
+    }
+    pub(crate) fn sync_tracks(&self, cx: &mut JSContext) {
+        if let Some(list) = self.source_buffers.get() {
+            for buffer in list.buffers() {
+                if buffer.sync_tracks(cx) {
+                    self.ActiveSourceBuffers(cx).add(&buffer);
+                }
+            }
+        }
+    }
+    fn backend_event(&self, cx: &mut JSContext, event: SourceEvent) {
+        match event {
+            SourceEvent::Open => self
+                .upcast::<EventTarget>()
+                .fire_event(cx, stylo_atoms::Atom::from("sourceopen")),
+            SourceEvent::Ended => self
+                .upcast::<EventTarget>()
+                .fire_event(cx, stylo_atoms::Atom::from("sourceended")),
+            SourceEvent::Closed => self
+                .upcast::<EventTarget>()
+                .fire_event(cx, stylo_atoms::Atom::from("sourceclose")),
+            SourceEvent::BufferAdded(_) => (),
+            SourceEvent::BufferEvent(id, event) => {
+                if let Some(list) = self.source_buffers.get() {
+                    for buffer in list.buffers() {
+                        if buffer.buffer_id() == id {
+                            buffer.fire_backend_event(cx, event);
+                            break;
+                        }
+                    }
+                }
+            },
+        }
+    }
+}
+impl MediaSourceMethods<crate::DomTypeHolder> for MediaSource {
+    fn Constructor(
+        cx: &mut JSContext,
+        global: &Window,
+        proto: Option<HandleObject>,
+    ) -> Fallible<DomRoot<Self>> {
+        Self::new_with_proto(cx, global.as_global_scope(), proto)
+    }
+    fn SourceBuffers(&self, cx: &mut JSContext) -> DomRoot<SourceBufferList> {
+        self.source_buffers
+            .or_init(|| SourceBufferList::new(cx, &self.global()))
+    }
+    fn ActiveSourceBuffers(&self, cx: &mut JSContext) -> DomRoot<SourceBufferList> {
+        self.active_buffers
+            .or_init(|| SourceBufferList::new(cx, &self.global()))
+    }
+    fn ReadyState(&self) -> ReadyState {
+        match self.controller.state() {
+            SourceState::Closed => ReadyState::Closed,
+            SourceState::Open => ReadyState::Open,
+            SourceState::Ended => ReadyState::Ended,
+        }
+    }
+    fn Duration(&self) -> f64 {
+        self.duration.get()
+    }
+    fn SetDuration(&self, _: f64) -> Fallible<()> {
+        Err(Error::NotSupported(Some(
+            "Duration changes require coordinated coded-frame removal".to_owned(),
+        )))
+    }
+    fn CanConstructInDedicatedWorker(_: &Window) -> bool {
+        false
+    }
+    fn AddSourceBuffer(
+        &self,
+        cx: &mut JSContext,
+        mime: DOMString,
+    ) -> Fallible<DomRoot<SourceBuffer>> {
+        if mime.is_empty() {
+            return Err(Error::Type("Empty SourceBuffer type".to_owned()));
+        }
+        let media = self.media.get().ok_or(Error::InvalidState(None))?;
+        let handle = self
+            .controller
+            .add_buffer(&mime.to_string())
+            .map_err(source_error)?;
+        let buffer = SourceBuffer::new(cx, &self.global(), handle, &media);
+        self.SourceBuffers(cx).add(&buffer);
+        // Active membership MUST be populated from initialization track metadata,
+        // not simply from addSourceBuffer. No fabricated active list here.
+        Ok(buffer)
+    }
+    fn RemoveSourceBuffer(&self, _: &SourceBuffer) -> Fallible<()> {
+        Err(Error::NotSupported(Some(
+            "Live decoder removal synchronization is not implemented".to_owned(),
+        )))
+    }
+    fn EndOfStream(&self, error: Option<EndOfStreamError>) -> Fallible<()> {
+        if error.is_some() {
+            return Err(Error::NotSupported(Some(
+                "Error endOfStream propagation is not implemented".to_owned(),
+            )));
+        }
+        self.controller.end_input().map_err(source_error)
+    }
+    fn SetLiveSeekableRange(&self, _: Finite<f64>, _: Finite<f64>) -> Fallible<()> {
+        Err(Error::NotSupported(None))
+    }
+    fn ClearLiveSeekableRange(&self) -> Fallible<()> {
+        Err(Error::NotSupported(None))
+    }
+    // Capability stays false until actual decoder/platform/DOM support is ready.
+    fn IsTypeSupported(_: &Window, _: DOMString) -> bool {
+        false
+    }
+    event_handler!(sourceopen, GetOnsourceopen, SetOnsourceopen);
+    event_handler!(sourceended, GetOnsourceended, SetOnsourceended);
+    event_handler!(sourceclose, GetOnsourceclose, SetOnsourceclose);
+}
+
+// Like the existing HTMLMediaElement event handler, this owner is accessed
+// and dropped only on the script thread. Worker callbacks capture ONLY Weak
+// handles and queue them without upgrading; no DOM allocation is rooted by
+// the callback registration itself.
+#[derive(JSTraceable, MallocSizeOf)]
+struct SourceEventTarget {
+    source: WeakRef<MediaSource>,
+}
+#[expect(unsafe_code)]
+unsafe impl Send for SourceEventTarget {}
+impl Drop for SourceEventTarget {
+    fn drop(&mut self) {
+        assert_in_script();
+    }
+}
