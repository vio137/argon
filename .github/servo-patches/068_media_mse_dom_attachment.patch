diff --git a/components/script/dom/mse/sourcebuffer.rs b/components/script/dom/mse/sourcebuffer.rs
new file mode 100644
index 000000000..5b9449db0
--- /dev/null
+++ b/components/script/dom/mse/sourcebuffer.rs
@@ -0,0 +1,271 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+//! Staged real controller-backed DOM wrapper. This remains unexposed while
+//! abort/remove/changeType/sequence and track synchronization are incomplete.
+use crate::dom::bindings::codegen::Bindings::HTMLMediaElementBinding::HTMLMediaElementMethods;
+use crate::dom::{
+    audio::audiotracklist::AudioTrackList,
+    bindings::{
+        inheritance::Castable,
+        refcounted::Trusted,
+        reflector::DomGlobal,
+        root::{Dom, DomRoot, MutNullableDom},
+    },
+    eventtarget::EventTarget,
+    globalscope::GlobalScope,
+    htmlmediaelement::HTMLMediaElement,
+    texttracklist::TextTrackList,
+    timeranges::{TimeRanges, TimeRangesContainer},
+    videotracklist::VideoTrackList,
+};
+use crate::dom::{event::Event, trackevent::TrackEvent};
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use script_bindings::codegen::GenericUnionTypes::VideoTrackOrAudioTrackOrTextTrack;
+use script_bindings::{
+    codegen::{
+        GenericBindings::SourceBufferBinding::{AppendMode, SourceBufferMethods},
+        GenericUnionTypes::ArrayBufferViewOrArrayBuffer,
+    },
+    domstring::DOMString,
+    error::{Error, Fallible},
+    num::Finite,
+    reflector::reflect_dom_object,
+};
+use servo_media::player::append_source::{AppendBuffer, SourceError};
+use std::cell::Cell;
+#[dom_struct]
+pub(crate) struct SourceBuffer {
+    event_target: EventTarget,
+    #[no_trace]
+    #[ignore_malloc_size_of = "private backend controller"]
+    buffer: AppendBuffer,
+    media: Dom<HTMLMediaElement>,
+    last_offset: Cell<f64>,
+    last_start: Cell<f64>,
+    last_end: Cell<f64>,
+    tracks_synced: Cell<bool>,
+    audio_tracks: MutNullableDom<AudioTrackList>,
+    video_tracks: MutNullableDom<VideoTrackList>,
+    text_tracks: MutNullableDom<TextTrackList>,
+}
+fn source_error(error: SourceError) -> Error {
+    match error {
+        SourceError::Type => Error::Type("Invalid append timestamp/window".to_owned()),
+        SourceError::NotSupported => Error::NotSupported(None),
+        SourceError::Quota => Error::QuotaExceeded {
+            quota: None,
+            requested: None,
+        },
+        SourceError::InvalidState | SourceError::Backend => Error::InvalidState(None),
+    }
+}
+impl SourceBuffer {
+    pub(crate) fn new(
+        cx: &mut JSContext,
+        global: &GlobalScope,
+        buffer: AppendBuffer,
+        media: &HTMLMediaElement,
+    ) -> DomRoot<Self> {
+        reflect_dom_object(
+            cx,
+            Box::new(Self {
+                event_target: EventTarget::new_inherited(),
+                buffer,
+                media: Dom::from_ref(media),
+                last_offset: Cell::new(0.0),
+                last_start: Cell::new(0.0),
+                last_end: Cell::new(f64::INFINITY),
+                tracks_synced: Cell::new(false),
+                audio_tracks: MutNullableDom::new(None),
+                video_tracks: MutNullableDom::new(None),
+                text_tracks: MutNullableDom::new(None),
+            }),
+            global,
+        )
+    }
+    pub(crate) fn sync_tracks(&self, cx: &mut JSContext) -> bool {
+        if self.tracks_synced.get() {
+            return true;
+        }
+        let Ok(tracks) = self.buffer.tracks() else {
+            return false;
+        };
+        if tracks.is_empty()
+            || tracks
+                .iter()
+                .any(|t| t.mime != "audio/mp4a-latm" && t.mime != "video/avc")
+        {
+            return false;
+        }
+        // Validate all targets before mutating either list. The backend permits
+        // only one audio and one video track, so each maps to element index0.
+        let audio = if tracks.iter().any(|t| t.mime == "audio/mp4a-latm") {
+            self.media.AudioTracks(cx).item(0)
+        } else {
+            None
+        };
+        let video = if tracks.iter().any(|t| t.mime == "video/avc") {
+            self.media.VideoTracks(cx).item(0)
+        } else {
+            None
+        };
+        if (tracks.iter().any(|t| t.mime == "audio/mp4a-latm") && audio.is_none())
+            || (tracks.iter().any(|t| t.mime == "video/avc") && video.is_none())
+        {
+            return false;
+        }
+        if let Some(track) = audio {
+            let list = self.AudioTracks(cx);
+            list.add_shared(&track);
+            let event = TrackEvent::new(
+                cx,
+                self.global().as_window(),
+                atom!("addtrack"),
+                false,
+                false,
+                &Some(VideoTrackOrAudioTrackOrTextTrack::AudioTrack(track)),
+            );
+            let event = Trusted::new(&*event);
+            let list = Trusted::new(&*list);
+            self.global().task_manager().media_element_task_source().queue(task!(append_audio_track_added:move|cx| {event.root().upcast::<Event>().fire(cx,list.root().upcast::<EventTarget>());}));
+        }
+        if let Some(track) = video {
+            let list = self.VideoTracks(cx);
+            list.add_shared(&track);
+            let event = TrackEvent::new(
+                cx,
+                self.global().as_window(),
+                atom!("addtrack"),
+                false,
+                false,
+                &Some(VideoTrackOrAudioTrackOrTextTrack::VideoTrack(track)),
+            );
+            let event = Trusted::new(&*event);
+            let list = Trusted::new(&*list);
+            self.global().task_manager().media_element_task_source().queue(task!(append_video_track_added:move|cx| {event.root().upcast::<Event>().fire(cx,list.root().upcast::<EventTarget>());}));
+        }
+        self.tracks_synced.set(true);
+        true
+    }
+    pub(crate) fn buffer_id(&self) -> u32 {
+        self.buffer.id()
+    }
+    pub(crate) fn fire_backend_event(
+        &self,
+        cx: &mut JSContext,
+        event: servo_media::player::append::AppendEvent,
+    ) {
+        use servo_media::player::append::AppendEvent;
+        let name = match event {
+            AppendEvent::UpdateStart => "updatestart",
+            AppendEvent::Update => "update",
+            AppendEvent::UpdateEnd => "updateend",
+            AppendEvent::Error => "error",
+            AppendEvent::Ready | AppendEvent::Closed => return,
+        };
+        self.upcast::<EventTarget>()
+            .fire_event(cx, stylo_atoms::Atom::from(name));
+    }
+}
+impl SourceBufferMethods<crate::DomTypeHolder> for SourceBuffer {
+    fn Mode(&self) -> AppendMode {
+        AppendMode::Segments
+    }
+    fn SetMode(&self, value: AppendMode) -> Fallible<()> {
+        if self.buffer.options().is_err() || self.buffer.updating() {
+            return Err(Error::InvalidState(None));
+        }
+        if value == AppendMode::Sequence {
+            return Err(Error::NotSupported(Some(
+                "Sequence append mode is not implemented".to_owned(),
+            )));
+        }
+        Ok(())
+    }
+    fn Updating(&self) -> bool {
+        self.buffer.updating()
+    }
+    fn GetBuffered(&self, cx: &mut JSContext) -> Fallible<DomRoot<TimeRanges>> {
+        self.buffer.options().map_err(source_error)?;
+        let mut ranges = TimeRangesContainer::default();
+        for range in self.buffer.buffered() {
+            let _ = ranges.add(range.start, range.end);
+        }
+        Ok(TimeRanges::new(cx, self.global().as_window(), ranges))
+    }
+    fn TimestampOffset(&self) -> Finite<f64> {
+        Finite::new(self.last_offset.get()).expect("validated finite offset")
+    }
+    fn SetTimestampOffset(&self, value: Finite<f64>) -> Fallible<()> {
+        let (_, window) = self.buffer.options().map_err(source_error)?;
+        self.buffer
+            .set_options(*value, window)
+            .map_err(source_error)?;
+        self.last_offset.set(*value);
+        Ok(())
+    }
+    fn AppendWindowStart(&self) -> Finite<f64> {
+        Finite::new(self.last_start.get()).expect("validated finite window start")
+    }
+    fn SetAppendWindowStart(&self, value: Finite<f64>) -> Fallible<()> {
+        let (offset, window) = self.buffer.options().map_err(source_error)?;
+        self.buffer
+            .set_options(offset, *value..window.end)
+            .map_err(source_error)?;
+        self.last_start.set(*value);
+        Ok(())
+    }
+    fn AppendWindowEnd(&self) -> f64 {
+        self.last_end.get()
+    }
+    fn SetAppendWindowEnd(&self, value: f64) -> Fallible<()> {
+        let (offset, window) = self.buffer.options().map_err(source_error)?;
+        self.buffer
+            .set_options(offset, window.start..value)
+            .map_err(source_error)?;
+        self.last_end.set(value);
+        Ok(())
+    }
+    fn AudioTracks(&self, cx: &mut JSContext) -> DomRoot<AudioTrackList> {
+        self.audio_tracks
+            .or_init(|| AudioTrackList::new_shared(cx, self.global().as_window(), &self.media))
+    }
+    fn VideoTracks(&self, cx: &mut JSContext) -> DomRoot<VideoTrackList> {
+        self.video_tracks
+            .or_init(|| VideoTrackList::new_shared(cx, self.global().as_window(), &self.media))
+    }
+    fn TextTracks(&self, cx: &mut JSContext) -> DomRoot<TextTrackList> {
+        self.text_tracks
+            .or_init(|| TextTrackList::new(cx, &self.media, self.global().as_window(), &[]))
+    }
+    fn AppendBuffer(&self, data: ArrayBufferViewOrArrayBuffer) -> Fallible<()> {
+        let bytes = match data {
+            ArrayBufferViewOrArrayBuffer::ArrayBufferView(view) => view.to_vec(),
+            ArrayBufferViewOrArrayBuffer::ArrayBuffer(buffer) => buffer.to_vec(),
+        }
+        .ok_or_else(|| Error::Type("Buffer is detached".to_owned()))?;
+        self.buffer.append(bytes).map_err(source_error)
+    }
+    fn Abort(&self) -> Fallible<()> {
+        Err(Error::NotSupported(Some(
+            "Decoder/parser abort reset is not implemented".to_owned(),
+        )))
+    }
+    fn ChangeType(&self, _: DOMString) -> Fallible<()> {
+        Err(Error::NotSupported(Some(
+            "Decoder format replacement is not implemented".to_owned(),
+        )))
+    }
+    fn Remove(&self, _: Finite<f64>, _: f64) -> Fallible<()> {
+        Err(Error::NotSupported(Some(
+            "Live decoder removal synchronization is not implemented".to_owned(),
+        )))
+    }
+    event_handler!(updatestart, GetOnupdatestart, SetOnupdatestart);
+    event_handler!(update, GetOnupdate, SetOnupdate);
+    event_handler!(updateend, GetOnupdateend, SetOnupdateend);
+    event_handler!(error, GetOnerror, SetOnerror);
+    event_handler!(abort, GetOnabort, SetOnabort);
+}
