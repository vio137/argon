+    /// Automatic back-buffer eviction, not script remove(). Keep the random
+    /// access point preceding the retained window plus every dependent frame.
+    /// Call only with a cutoff safely behind consumed/displayed playback.
+    pub fn evict_before(&mut self, cutoff_us: i64) -> usize {
+        let mut freed = 0usize;
+        for frames in self.tracks.values_mut() {
+            let Some(keep) = frames
+                .iter()
+                .enumerate()
+                .filter(|(_, f)| f.keyframe && f.pts_us <= cutoff_us)
+                .map(|(i, _)| i)
+                .last()
+            else {
+                continue;
+            };
+            for frame in frames.drain(..keep) {
+                freed += frame.data.len();
+            }
+        }
+        self.bytes -= freed;
+        freed
+    }
