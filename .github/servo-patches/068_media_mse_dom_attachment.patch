@@ -0,0 +1,88 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+//! Staged replacement for the excluded draft's freshly wrapped indexed getters.
+//! The list holds the actual DOM SourceBuffer objects, preserving JS identity.
+use crate::dom::{
+    bindings::{
+        inheritance::Castable,
+        refcounted::Trusted,
+        reflector::DomGlobal,
+        root::{Dom, DomRoot},
+    },
+    eventtarget::EventTarget,
+    globalscope::GlobalScope,
+    sourcebuffer::SourceBuffer,
+};
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use script_bindings::{
+    cell::DomRefCell, codegen::GenericBindings::SourceBufferListBinding::SourceBufferListMethods,
+    reflector::reflect_dom_object,
+};
+use stylo_atoms::Atom;
+#[dom_struct]
+pub(crate) struct SourceBufferList {
+    event_target: EventTarget,
+    buffers: DomRefCell<Vec<Dom<SourceBuffer>>>,
+}
+impl SourceBufferList {
+    pub(crate) fn new(cx: &mut JSContext, global: &GlobalScope) -> DomRoot<Self> {
+        reflect_dom_object(
+            cx,
+            Box::new(Self {
+                event_target: EventTarget::new_inherited(),
+                buffers: DomRefCell::new(vec![]),
+            }),
+            global,
+        )
+    }
+    pub(crate) fn add(&self, buffer: &SourceBuffer) {
+        if self.buffers.borrow().iter().any(|b| &**b == buffer) {
+            return;
+        }
+        self.buffers.borrow_mut().push(Dom::from_ref(buffer));
+        self.queue_change(stylo_atoms::Atom::from("addsourcebuffer"));
+    }
+    pub(crate) fn remove(&self, buffer: &SourceBuffer) {
+        let index = self.buffers.borrow().iter().position(|b| &**b == buffer);
+        if let Some(index) = index {
+            self.buffers.borrow_mut().remove(index);
+            self.queue_change(stylo_atoms::Atom::from("removesourcebuffer"));
+        }
+    }
+    pub(crate) fn clear(&self) {
+        if !self.buffers.borrow().is_empty() {
+            self.buffers.borrow_mut().clear();
+            self.queue_change(stylo_atoms::Atom::from("removesourcebuffer"));
+        }
+    }
+    pub(crate) fn buffers(&self) -> Vec<DomRoot<SourceBuffer>> {
+        self.buffers
+            .borrow()
+            .iter()
+            .map(|b| DomRoot::from_ref(&**b))
+            .collect()
+    }
+    fn queue_change(&self, name: Atom) {
+        let this = Trusted::new(self);
+        self.global().task_manager().media_element_task_source().queue(task!(mse_source_buffer_list_change:move |cx| {this.root().upcast::<EventTarget>().fire_event(cx,name);}));
+    }
+}
+impl SourceBufferListMethods<crate::DomTypeHolder> for SourceBufferList {
+    fn Length(&self) -> u32 {
+        self.buffers.borrow().len() as u32
+    }
+    fn IndexedGetter(&self, _cx: &mut JSContext, index: u32) -> Option<DomRoot<SourceBuffer>> {
+        self.buffers
+            .borrow()
+            .get(index as usize)
+            .map(|b| DomRoot::from_ref(&**b))
+    }
+    event_handler!(addsourcebuffer, GetOnaddsourcebuffer, SetOnaddsourcebuffer);
+    event_handler!(
+        removesourcebuffer,
+        GetOnremovesourcebuffer,
+        SetOnremovesourcebuffer
+    );
+}
