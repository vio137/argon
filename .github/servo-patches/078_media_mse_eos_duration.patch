+    #[test]
+    fn eos_sends_finite_duration_before_completion_once() {
+        let (tx, rx) = mpsc::channel();
+        let player = AndroidAppendPlayer::new(
+            79,
+            GenericCallback::new(move |m| {
+                if let Ok(e) = m {
+                    let _ = tx.send(e);
+                }
+            })
+            .unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        player.lock().unwrap().play().unwrap();
+        player.lock().unwrap().end_of_stream().unwrap();
+        let mut durations = 0;
+        loop {
+            match rx.recv_timeout(Duration::from_secs(2)).unwrap() {
+                PlayerEvent::DurationChanged(Some(duration)) => {
+                    assert_eq!(duration, Duration::ZERO);
+                    durations += 1;
+                },
+                PlayerEvent::EndOfStream => break,
+                PlayerEvent::Error(_) => panic!("EOS failed"),
+                _ => (),
+            }
+        }
+        assert_eq!(durations, 1);
+        assert_eq!(
+            player.lock().unwrap().state.lock().unwrap().duration_us,
+            Some(0)
+        );
+    }
 }
