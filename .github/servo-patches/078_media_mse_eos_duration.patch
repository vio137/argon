+
+#[test]
+fn eos_duration_is_largest_track_end_not_playable_intersection() {
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    p.add_buffer(1).unwrap();
+    p.add_buffer(2).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.append(
+        2,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4"),
+    )
+    .unwrap();
+    assert_eq!(p.duration_us(), None);
+    let intersection_end = p.buffered().last().unwrap().end;
+    let largest = p
+        .sessions
+        .values()
+        .flat_map(|s| s.descriptions().iter().flat_map(|t| s.ranges(t.id)))
+        .map(|r| r.end)
+        .max()
+        .unwrap();
+    assert!(largest > intersection_end);
+    p.end_input().unwrap();
+    assert_eq!(p.duration_us(), Some(largest));
+    p.reset_seek_epoch(50_000).unwrap();
+    assert_eq!(p.duration_us(), Some(largest));
+}
+#[test]
+fn empty_eos_has_zero_duration_instead_of_infinite() {
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    assert_eq!(p.duration_us(), None);
+    p.end_input().unwrap();
+    assert_eq!(p.duration_us(), Some(0));
+}
