+
+#[test]
+fn seek_completion_waits_for_video_acquisition_and_trimmed_audio_without_advancing_clock() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.add_buffer(2).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.append(
+        2,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4"),
+    )
+    .unwrap();
+    p.reset_seek_epoch(50_000).unwrap();
+    assert_eq!(p.video_seek_floor, Some(0));
+    p.page_playing = true;
+    p.focus_tick().unwrap();
+    assert!(!p.playing);
+    assert_eq!(p.clock.now_us(), 50_000);
+    p.finish_seek_if_ready().unwrap();
+    assert!(!p.take_seek_ready());
+    p.rendered_frames = 1;
+    p.finish_seek_if_ready().unwrap();
+    assert!(!p.take_seek_ready());
+    // This represents already-trimmed decoder output, not real decoded audio.
+    p.audio.pending =
+        Some(AudioQueue::new_after(vec![1, 2, 3, 4], 2, 49_980, 48000, 50_000).unwrap());
+    p.page_playing = false;
+    p.finish_seek_if_ready().unwrap();
+    assert!(p.take_seek_ready());
+    assert!(!p.take_seek_ready());
+    assert!(p.seek_target.is_none());
+    assert!(p.video_seek_floor.is_none());
+    assert!(!p.playing);
+    assert_eq!(p.clock.now_us(), 50_000);
+}
+#[test]
+fn a_new_seek_invalidates_the_old_ready_signal() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.reset_seek_epoch(750_000).unwrap();
+    p.rendered_frames = 1;
+    p.finish_seek_if_ready().unwrap();
+    assert!(p.seek_ready);
+    p.reset_seek_epoch(250_000).unwrap();
+    assert!(!p.take_seek_ready());
+    assert_eq!(p.video_seek_floor, Some(0));
+    assert_eq!(p.clock.now_us(), 250_000);
+}
+
+#[test]
+fn seek_missing_output_never_becomes_ready_or_waits_without_a_bound() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.reset_seek_epoch(750_000).unwrap();
+    p.video_done = true;
+    assert!(p.finish_seek_if_ready().is_err());
+    assert!(!p.take_seek_ready());
+    p.video_done = false;
+    p.seek_started = Some(Instant::now() - Duration::from_secs(6));
+    assert!(p.finish_seek_if_ready().is_err());
+    assert!(!p.take_seek_ready());
+}
