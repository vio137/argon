+fn duration_micros(start: i128, duration: i128, scale: u32) -> Result<i64, Error> {
+    if duration <= 0 {return Err(Error::Timestamp);}
+    // Convert endpoints with the same quantization. Truncating duration on
+    // its own loses the fractional remainder and creates false microsecond
+    // holes between otherwise contiguous AAC/video samples.
+    let end=start.checked_add(duration).ok_or(Error::Timestamp)?;
+    let duration=micros(end,scale)?.checked_sub(micros(start,scale)?)
+        .ok_or(Error::Timestamp)?;
+    if duration<=0 {return Err(Error::Timestamp);}
+    Ok(duration)
+}
