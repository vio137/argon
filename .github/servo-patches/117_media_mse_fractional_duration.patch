+#[cfg(test)]
+mod duration_quantization_tests {
+ use super::*;
+ #[test] fn fractional_sample_endpoints_join_without_artificial_gaps() {
+  for scale in [44100,48000,90000] {
+   for start in [-2048,-1024,0,1024,2048,3072,4096] {
+    let end=micros(start+1024,scale).unwrap();
+    assert_eq!(micros(start,scale).unwrap()+duration_micros(start,1024,scale).unwrap(),end);
+   }
+  }
+ }
+ #[test] fn invalid_scale_tiny_duration_and_overflow_return_errors() {
+  assert_eq!(duration_micros(0,1024,0),Err(Error::Timestamp));
+  assert_eq!(duration_micros(i128::MAX,1,1),Err(Error::Timestamp));
+  assert_eq!(duration_micros(0,0,48000),Err(Error::Timestamp));
+  assert_eq!(duration_micros(0,-1,48000),Err(Error::Timestamp));
+  assert_eq!(duration_micros(0,1,u32::MAX),Err(Error::Timestamp));
+ }
