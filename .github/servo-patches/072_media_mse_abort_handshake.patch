+    use std::{sync::{Arc,mpsc},time::Duration};
+    #[test] fn abort_floor_invalidates_old_queued_events_but_not_normal_prior_updateend() {
+        let player=AndroidAppendPlayer::new(71,GenericCallback::new(|_|{}).unwrap(),None,Box::new(||{})).unwrap();
+        let(tx,rx)=mpsc::channel();let source=AppendSource::new(Arc::new(move|e|{let _=tx.send(e);}));
+        source.attach(player).unwrap();let buffer=source.add_buffer("video/mp4").unwrap();
+        loop {if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::Ready,_)){break;}}
+        buffer.set_options(1.0,0.5..2.0).unwrap();
+        buffer.append(vec![0,0,0]).unwrap();
+        let mut queued=vec![];
+        loop {let e=rx.recv_timeout(Duration::from_secs(2)).unwrap();queued.push(e);if matches!(e,SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,_)){break;}}
+        assert!(queued.iter().any(|e|matches!(e,SourceEvent::BufferEvent(_,AppendEvent::UpdateStart,1))));
+        assert!(buffer.accepts_operation(1,AppendEvent::Update));
+        buffer.abort().unwrap();assert!(!buffer.updating());
+        assert_eq!(buffer.options().unwrap(),(1.0,0.0..f64::INFINITY));
+        for e in queued {if let SourceEvent::BufferEvent(_,event,operation)=e {assert!(!buffer.accepts_operation(operation,event));}}
+        buffer.append(include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec()).unwrap();
+        loop {let e=rx.recv_timeout(Duration::from_secs(2)).unwrap();if let SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,token)=e {assert_eq!(token,3);break;}}
+        assert!(buffer.accepts_operation(3,AppendEvent::UpdateEnd));
+        buffer.append(vec![]).unwrap();
+        // A normal later append must not discard the preceding updateend task.
+        assert!(buffer.accepts_operation(3,AppendEvent::UpdateEnd));
+        loop {if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,4)){break;}}
+        source.end_input().unwrap();assert_eq!(buffer.abort(),Err(SourceError::InvalidState));
