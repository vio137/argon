+            assert_eq!(p.append_abort(1).unwrap(),2);assert_eq!(p.append_to_buffer_operation(1,include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec()).unwrap(),3);
+            drop(p);
+            loop {let e=rx.recv_timeout(Duration::from_secs(2)).unwrap();if e.operation==3 && e.event==AppendEvent::UpdateEnd {break;}}
