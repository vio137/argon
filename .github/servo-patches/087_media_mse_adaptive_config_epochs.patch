+#[test]
+fn changed_native_configuration_retries_until_old_output_is_confirmed_drained() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    let config = DecoderConfig {
+        track_id: 1,
+        mime: "video/avc",
+        width: 8,
+        height: 4,
+        sample_rate: 0,
+        channels: 0,
+        csd0: vec![1],
+        csd1: vec![2],
+    };
+    p.decoders.configure(&config).unwrap();
+    let mut next = config.clone();
+    next.width = 16;
+    assert_eq!(p.decoders.prepare_configuration(&next), Ok(false));
+    assert!(p.decoders.draining.contains(&1));
+    assert_eq!(p.decoders.video_size, Some((8, 4)));
+    assert_eq!(p.decoders.prepare_configuration(&next), Ok(false));
+    p.decoders.output_drained.insert(1);
+    assert_eq!(p.decoders.prepare_configuration(&next), Ok(true));
+    assert_eq!(p.decoders.video_size, Some((16, 4)));
+    assert!(p.decoders.reconfigured.contains(&1));
+    assert!(!p.decoders.draining.contains(&1));
+    assert_eq!(p.decoders.prepare_configuration(&next), Ok(true));
+}
