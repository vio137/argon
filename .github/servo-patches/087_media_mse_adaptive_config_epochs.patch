+#[test]
+fn adaptive_replacement_packet_waits_for_old_native_eos_then_rebuilds_video_surface() {
+    super::super::mse_codec::mock_empty_eos_output(false);
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    // Pump original packets into the codec before supplying a replacement init.
+    p.pump().unwrap();
+    assert_eq!(p.decoders.video_size, Some((32, 32)));
+    use shiguredo_mp4::{Decode, Encode};
+    let mut f = crate::mse_demux::BoxFramer::new(1 << 20);
+    f.append(include_bytes!(
+        "../hosttest/tests/fixtures/synthetic-fmp4.mp4"
+    ))
+    .unwrap();
+    let mut replacement = vec![];
+    while let Some(b) = f.pop_box().unwrap() {
+        if &b[4..8] == b"moov" {
+            let (mut moov, _) = shiguredo_mp4::boxes::MoovBox::decode(&b).unwrap();
+            for t in &mut moov.trak_boxes {
+                for e in &mut t.mdia_box.minf_box.stbl_box.stsd_box.entries {
+                    if let shiguredo_mp4::boxes::SampleEntry::Avc1(e) = e {
+                        e.visual.width = 64;
+                    }
+                }
+            }
+            replacement.extend(moov.encode_to_vec().unwrap());
+        } else {
+            replacement.extend(b);
+        }
+    }
+    p.set_options(1, 1_000_000, 0..i64::MAX).unwrap();
+    p.append(1, &replacement).unwrap();
+    // The first tick only asks the old codec to drain. It must not replace it.
+    p.pump().unwrap();
+    assert_eq!(p.decoders.video_size, Some((32, 32)));
+    super::super::mse_codec::mock_empty_eos_output(true);
+    p.pump().unwrap();
+    assert_eq!(p.decoders.video_size, Some((32, 32)));
+    p.pump().unwrap();
+    assert_eq!(p.decoders.video_size, Some((64, 32)));
+    assert_eq!(p.buffered(), [0..2_000_000]);
+    assert!(p.decoders.draining.is_empty());
+    super::super::mse_codec::mock_reset_output();
+}
