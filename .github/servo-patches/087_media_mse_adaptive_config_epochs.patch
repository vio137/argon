+#[test]
+fn native_reconfiguration_waits_for_surface_acquisition_and_consumed_audio_not_just_codec_eos() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.decoders
+        .configure(&DecoderConfig {
+            track_id: 1,
+            mime: "video/avc",
+            width: 8,
+            height: 4,
+            sample_rate: 0,
+            channels: 0,
+            csd0: vec![1],
+            csd1: vec![2],
+        })
+        .unwrap();
+    p.decoders
+        .configure(&DecoderConfig {
+            track_id: 2,
+            mime: "audio/mp4a-latm",
+            width: 0,
+            height: 0,
+            sample_rate: 48_000,
+            channels: 2,
+            csd0: vec![0x11, 0x90],
+            csd1: vec![],
+        })
+        .unwrap();
+    p.video_done = true;
+    p.audio_done = true;
+    p.video_pending = Some(Instant::now());
+    p.audio.pending = Some(AudioQueue::new(vec![1, 2], 2, 0).unwrap());
+    p.refresh_format_drains();
+    assert!(p.decoders.output_drained.is_empty());
+    p.video_pending = None;
+    p.audio.pending = None;
+    p.clock.audio_frames_written = 100;
+    p.clock.reset_audio_epoch(0);
+    p.clock.audio_frames_written = 100;
+    p.refresh_format_drains();
+    assert!(p.decoders.output_drained.contains(&1));
+    assert!(!p.decoders.output_drained.contains(&2));
+    p.clock.observe_audio_consumed(100);
+    p.refresh_format_drains();
+    assert!(p.decoders.output_drained.contains(&2));
+    p.decoders.draining.insert(1);
+    p.decoders.reconfigured.insert(2);
+    p.decoders.reset_epoch();
+    assert!(p.decoders.output_drained.is_empty());
+    assert!(p.decoders.draining.is_empty());
+    assert!(p.decoders.reconfigured.is_empty());
