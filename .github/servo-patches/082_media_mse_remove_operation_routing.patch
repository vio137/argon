+
+#[cfg(test)] mod remove_pipeline_tests {
+ use crate::{append_source::*,append::AppendEvent,Player,generic_channel::GenericCallback,mse_player::AndroidAppendPlayer};
+ use std::{sync::{Arc,mpsc},time::Duration};
+ #[test] fn removal_lifecycle_updates_retained_ranges_and_allows_later_append() {
+  let p=AndroidAppendPlayer::new(82,GenericCallback::new(|_|{}).unwrap(),None,Box::new(||{})).unwrap();
+  let(tx,rx)=mpsc::channel();let source=AppendSource::new(Arc::new(move|e|{let _=tx.send(e);}));source.attach(p.clone()).unwrap();
+  let buffer=source.add_buffer("video/mp4").unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::Ready,_)){break;}}
+  buffer.append(include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec()).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,1)){break;}}
+  buffer.remove(0.0,0.25).unwrap();assert!(buffer.updating());
+  for expected in [AppendEvent::UpdateStart,AppendEvent::Update,AppendEvent::UpdateEnd]{assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(buffer.id(),expected,2));}
+  assert!(!buffer.updating());assert_eq!(buffer.buffered(),[0.5..1.0]);
+  assert!(p.lock().unwrap().can_resume());
+  buffer.append(vec![]).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,3)){break;}}
+  assert_eq!(buffer.remove(-1.0,0.5),Err(SourceError::Type));assert!(!buffer.updating());source.detach();
+ }
+}
