    058 media: flush AAudio queue on seek (drop stale pre-seek audio)

diff --git a/components/media/backends/android/android_impl/player.rs b/components/media/backends/android/android_impl/player.rs
index 498ae6c0f..cf16528e8 100644
--- a/components/media/backends/android/android_impl/player.rs
+++ b/components/media/backends/android/android_impl/player.rs
@@ -899,8 +899,17 @@ impl Pipeline {
             // rebase restarts the wall clock; freeze it again while paused.
             self.clock.pause();
         }
-        if !self.aaudio.is_null() && !self.shared.get().paused && !held {
-            unsafe { sys::AAudioStream_requestStart(self.aaudio) };
+        if !self.aaudio.is_null() {
+            unsafe {
+                // Discard pre-seek audio still queued in the stream; without
+                // this it audibly tails after the seek while the clock has
+                // already rebased to the target.
+                sys::AAudioStream_requestStop(self.aaudio);
+                sys::AAudioStream_requestFlush(self.aaudio);
+                if !self.shared.get().paused && !held {
+                    sys::AAudioStream_requestStart(self.aaudio);
+                }
+            }
         }
         send_event(&self.sender, PlayerEvent::SeekDone(time));
     }
