+#[cfg(test)]
+mod removal_interval_tests {
+    use super::*;
+    #[test]
+    fn fractional_removal_bounds_select_only_integer_pts_inside_interval() {
+        for (start, end) in [
+            (0.1e-6, 0.9e-6),
+            (0.1e-6, 1.1e-6),
+            (1e-6, 2e-6),
+            (1.1e-6, 2.9e-6),
+            (0.0, 3e-6),
+        ] {
+            let interval = removal_interval_us(start, end).unwrap();
+            for pts in 0..5 {
+                let time = pts as f64 / 1e6;
+                assert_eq!(interval.contains(&pts), time >= start && time < end);
+            }
+        }
+        assert_eq!(removal_interval_us(0.1e-6, 0.9e-6).unwrap(), 1..1);
+    }
+    #[test]
+    fn removal_bounds_validate_before_conversion_and_allow_positive_infinity() {
+        assert_eq!(
+            removal_interval_us(0.0, f64::INFINITY).unwrap(),
+            0..i64::MAX
+        );
+        for (start, end) in [
+            (f64::NAN, 1.0),
+            (-1.0, 1.0),
+            (f64::INFINITY, f64::INFINITY),
+            (0.0, f64::NAN),
+            (0.0, f64::NEG_INFINITY),
+            (1.0, 1.0),
+            (2.0, 1.0),
+            (0.0, i64::MAX as f64 / 1e6),
+        ] {
+            assert!(removal_interval_us(start, end).is_err());
+        }
+    }
 }
