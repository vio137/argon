+// Convert the half-open seconds interval to integer presentation timestamps.
+// Ceil both boundaries: flooring start would remove an earlier sample; flooring
+// end would retain a sample that lies strictly inside the requested interval.
+fn removal_interval_us(start: f64, end: f64) -> Result<Range<i64>, PlayerError> {
+    if !start.is_finite()
+        || start < 0.0
+        || end.is_nan()
+        || end <= start
+        || start * 1e6 >= i64::MAX as f64
+        || (end.is_finite() && end * 1e6 >= i64::MAX as f64)
+    {
+        return Err(PlayerError::SeekOutOfRange);
+    }
+    Ok((start * 1e6).ceil() as i64..if end == f64::INFINITY {
+        i64::MAX
+    } else {
+        (end * 1e6).ceil() as i64
+    })
