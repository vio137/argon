+
+#[test]
+fn removal_may_supersede_internal_reopen_reset_but_not_a_later_explicit_seek() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.end_input().unwrap();
+    p.clock.rebase(750_000);
+    p.reopen_input().unwrap();
+    assert!(p.reopen_reset);
+    p.remove_and_stall_if_needed(1, 0, 250_000, 750_000)
+        .unwrap();
+    assert!(!p.reopen_reset);
+    assert_eq!(p.buffered(), [500_000..1_000_000]);
+    assert_eq!(p.seek_target, Some(750_000));
+    // The removal has established its own output reset. It no longer has the
+    // special permission to replace a pending reset without waiting.
+    assert!(
+        p.remove_and_stall_if_needed(1, 0, 250_000, 750_000)
+            .is_err()
+    );
+}
