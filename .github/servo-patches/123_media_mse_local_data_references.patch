+
+#[test]
+fn initialization_rejects_external_and_unresolved_data_references_atomically() {
+ use shiguredo_mp4::{Decode,Encode,boxes::{MoovBox,SampleEntry}};
+ use servo_media_android_hosttest::mse_demux::Error;
+ let bs=boxes();let ftyp=bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap();
+ let bytes=bs.iter().find(|b|&b[4..8]==b"moov").unwrap();
+ for mode in 0..3 {
+  let(mut moov,_)=MoovBox::decode(bytes).unwrap();
+  let minf=&mut moov.trak_boxes[0].mdia_box.minf_box;
+  if mode==0 {minf.dinf_box.dref_box.url_box.as_mut().unwrap().location=Some(shiguredo_mp4::Utf8String::new("https://example.invalid/media").unwrap());}
+  if mode==1 {minf.dinf_box.dref_box.url_box=None;}
+  if mode==2 {if let SampleEntry::Avc1(e)=&mut minf.stbl_box.stsd_box.entries[0] {e.visual.data_reference_index=std::num::NonZeroU16::new(2).unwrap();}}
+  let mut input=ftyp.clone();input.extend(moov.encode_to_vec().unwrap());
+  let mut clear=ftyp.clone();clear.extend_from_slice(bytes);
+  let mut d=Demux::new(1<<20,64);d.init(&clear).unwrap();let previous=d.descriptions().to_vec();
+  assert_eq!(d.init(&input),Err(Error::UnsupportedLayout));
+  assert_eq!(d.descriptions(),previous);
+  let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();
+  let mut media=pair[0].clone();media.extend_from_slice(&pair[1]);assert_eq!(d.media(&media).unwrap().len(),1);
+ }
+}
