+    fn quota_counts_retained_replacement_bytes_not_removed_history() {
+        let mut s=FrameStore::new(4);
+        s.append(vec![f(0,true)],0,0..100).unwrap();
+        let generation=s.replacement_generation();
+        let mut next=f(0,true);next.data=vec![9;4];
