+
+#[test]
+fn removal_of_disabled_audio_does_not_stall_selected_video_or_restore_audio_decoder() {
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    p.add_buffer(1).unwrap();
+    p.add_buffer(2).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.append(
+        2,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4"),
+    )
+    .unwrap();
+    p.set_track_selection(false, true).unwrap();
+    p.seek_target = None;
+    p.seek_started = None;
+    p.remove_and_stall_if_needed(2, 0, 1_000_000, 0).unwrap();
+    assert!(p.removed_target.is_none());
+    assert!(p.sessions[&2].ranges(1).is_empty());
+    assert_eq!(p.sessions[&1].ranges(1), [0..1_000_000]);
+    assert_eq!(p.buffered(), [0..1_000_000]);
+    assert!(p.decoders.audio.is_none());
+}
+#[test]
+fn explicit_seek_while_every_track_disabled_cannot_complete_and_eos_reenable_replays_last_instant()
+{
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.end_input().unwrap();
+    p.set_track_selection(false, false).unwrap();
+    p.reset_seek_epoch(0).unwrap();
+    p.finish_seek_if_ready().unwrap();
+    assert!(!p.take_seek_ready());
+    assert_eq!(p.seek_target, Some(0));
+    p.clock.rebase(1_000_000);
+    p.clock.pause();
+    p.set_track_selection(false, true).unwrap();
+    assert_eq!(p.seek_target, Some(999_999));
+    assert!(p.removed_target.is_none());
+    assert_eq!(p.video_seek_floor, Some(500_000));
+    assert!(!p.take_seek_ready());
+}
