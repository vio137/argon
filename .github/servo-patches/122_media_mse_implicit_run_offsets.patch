+#[test]
+fn later_implicit_trun_offsets_follow_prior_run_end_without_copying_box_headers() {
+ use shiguredo_mp4::{Decode,Encode,boxes::MoofBox};
+ use servo_media_android_hosttest::mse_demux::{Error,append::AppendStream};
+ let bs=boxes();let init:Vec<u8>=bs.iter().filter(|b|&b[4..8]==b"ftyp"||&b[4..8]==b"moov").flatten().copied().collect();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();
+ let(mut moof,_)=MoofBox::decode(&pair[0]).unwrap();
+ let first=moof.traf_boxes[0].trun_boxes[0].clone();
+ let mut second=first.clone();second.data_offset=None;
+ moof.traf_boxes[0].trun_boxes.push(second);
+ let len=moof.encode_to_vec().unwrap().len();
+ moof.traf_boxes[0].trun_boxes[0].data_offset=Some(len as i32+8);
+ let mut encoded=moof.encode_to_vec().unwrap();
+ let payload=&pair[1][8..];
+ let mdat=[((8+payload.len()*2)as u32).to_be_bytes().to_vec(),b"mdat".to_vec(),payload.to_vec(),payload.to_vec()].concat();
+ encoded.extend_from_slice(&mdat);
+ let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();
+ assert_eq!(d.media_complete(&encoded),Ok(true));
+ let units=d.media(&encoded).unwrap();assert_eq!(units.len(),2);
+ let mut prefixed=vec![0,0,0,32,b's',b'i',b'd',b'x'];prefixed.extend_from_slice(&[0;24]);
+ prefixed[19]=1;prefixed.extend_from_slice(&encoded);
+ assert_eq!(d.media(&prefixed).unwrap().iter().map(|u|u.data.clone()).collect::<Vec<_>>(),units.iter().map(|u|u.data.clone()).collect::<Vec<_>>());
+ let mut wide=moof.clone();
+ wide.traf_boxes[0].trun_boxes[0].data_offset=Some(len as i32+16);
+ let mut wide=wide.encode_to_vec().unwrap();let wide_len=wide.len()+8;
+ wide.splice(8..8,(wide_len as u64).to_be_bytes());wide[..4].copy_from_slice(&1u32.to_be_bytes());
+ wide.extend_from_slice(&mdat);
+ assert_eq!(d.media(&wide).unwrap()[1].data,payload,"extended headers can shrink while implicit offsets grow");
+ let mut capped=Demux::new(encoded.len(),64);capped.init(&init).unwrap();
+ assert!(matches!(capped.media(&encoded),Err(Error::Quota)),"normalized metadata must still fit the bound");
+ // Implicit continuation into a second mdat's header is invalid. Metadata
+ // normalization cannot turn header bytes into compressed sample bytes.
+ let mut split=moof.encode_to_vec().unwrap();split.extend_from_slice(&pair[1]);split.extend_from_slice(&pair[1]);
+ assert_eq!(d.media_complete(&split),Err(Error::InvalidSample));
+ assert!(matches!(d.media(&split),Err(Error::InvalidSample)));
+ assert_eq!(units[0].data,payload);assert_eq!(units[1].data,payload);
+ assert_eq!(units.iter().map(|u|u.dts_us).collect::<Vec<_>>(),[0,500_000]);
+ let mut stream=AppendStream::new(1<<20,64);stream.append(&init).unwrap();
+ assert!(stream.append(&encoded[..encoded.len()-1]).unwrap().is_empty());
+ assert_eq!(stream.append(&encoded[encoded.len()-1..]).unwrap().len(),2);
+ // Multiple explicit runs must remain byte-identical through the old path.
+ moof.traf_boxes[0].trun_boxes[1].data_offset=Some(len as i32+4+8+payload.len()as i32);
+ moof.traf_boxes[0].trun_boxes[0].data_offset=Some(len as i32+4+8);
+ let mut explicit=moof.encode_to_vec().unwrap();explicit.extend_from_slice(&mdat);
+ let got=d.media(&explicit).unwrap();assert_eq!(got[1].data,units[1].data);
+ // Missing first offset is still unsupported, even with an implicit follower.
+ moof.traf_boxes[0].trun_boxes[0].data_offset=None;
+ let mut bad=moof.encode_to_vec().unwrap();bad.extend_from_slice(&mdat);
+ assert_eq!(d.media_complete(&bad),Err(Error::UnsupportedLayout));
+}
