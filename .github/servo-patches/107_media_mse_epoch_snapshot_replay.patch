+// Script may discard an already-queued snapshot after a selection/removal.
+// Replay the next accepted snapshot even when its values have not changed.
+#[derive(Clone, Copy, Default)]
+struct EventHistory {
+    epochs: Option<(u64, u64)>,
+    frames: u64,
+    metadata: (Option<(u16, u16)>, bool),
+    playing: bool,
+    ready: bool,
+    initialized: bool,
+}
+impl EventHistory {
+    fn replace(&mut self, next: Self) -> (Self, bool) {
+        let old = *self;
+        let replay = old.epochs != next.epochs;
+        *self = next;
+        (old, replay)
     }
 }
