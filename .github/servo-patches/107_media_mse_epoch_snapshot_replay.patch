+    #[test]
+    fn selection_epoch_replays_unchanged_snapshot_after_script_may_discard_it() {
+        let snapshot = EventHistory { epochs: Some((2, 4)), frames: 7,
+            metadata: (Some((640, 360)), true), playing: true, ready: true,
+            initialized: true };
+        let mut history = EventHistory::default();
+        assert!(history.replace(snapshot).1);
+        assert!(!history.replace(snapshot).1);
+        let next = EventHistory { epochs: Some((2, 5)), ..snapshot };
+        let (old, replay) = history.replace(next);
+        assert_eq!(old.metadata, next.metadata);
+        assert!(replay);
+        assert!(!history.replace(next).1);
+    }
+    #[test]
+    fn removal_epoch_replays_once_even_with_identical_metadata_and_readiness() {
+        let snapshot = EventHistory { epochs: Some((8, 3)),
+            metadata: (None, true), ready: true, initialized: true,
+            ..EventHistory::default() };
+        let mut history = snapshot;
+        assert!(!history.replace(snapshot).1);
+        let next = EventHistory { epochs: Some((9, 3)), ..snapshot };
+        let (old, replay) = history.replace(next);
+        assert_eq!(old.ready, next.ready);
+        assert_eq!(old.metadata, next.metadata);
+        assert!(replay);
+        assert!(!history.replace(next).1);
+    }
