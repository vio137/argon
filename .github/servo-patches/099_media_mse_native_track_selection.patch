+    pub fn set_track_selection(&mut self, audio: bool, video: bool) -> Result<(), ()> {
+        if self.failed {
+            return Err(());
+        }
+        let next = TrackSelection { audio, video };
+        if next == self.selection {
+            return Ok(());
+        }
+        let target = self.clock.now_us();
+        let covered = self.buffered_for(next).iter().any(|r| r.contains(&target));
+        let plans = self
+            .sessions
+            .iter()
+            .map(|(id, session)| {
