+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct TrackSelection {
+    audio: bool,
+    video: bool,
+}
+impl TrackSelection {
+    fn selected(self, session: &AppendSession, id: u32) -> bool {
+        session
+            .descriptions()
+            .iter()
+            .any(|t| t.id == id && self.mime(t.mime))
+    }
+    fn mime(self, mime: &str) -> bool {
+        match mime {
+            "audio/mp4a-latm" => self.audio,
+            "video/avc" => self.video,
+            _ => false,
+        }
+    }
+    fn active(self, session: &AppendSession) -> bool {
+        session.descriptions().iter().any(|t| self.mime(t.mime))
+    }
+    fn ranges(self, session: &AppendSession) -> Vec<std::ops::Range<i64>> {
+        session.buffered_selected(|id| self.selected(session, id))
+    }
+    fn plan(
+        self,
+        session: &AppendSession,
+        target: i64,
+    ) -> Result<crate::mse_demux::session::SeekPlan, crate::mse_demux::session::SessionError> {
+        if !self.active(session) && !session.descriptions().is_empty() {
+            session.empty_delivery_plan()
+        } else {
+            session.stage_seek_selected(target, |id| self.selected(session, id))
+        }
+    }
+}
