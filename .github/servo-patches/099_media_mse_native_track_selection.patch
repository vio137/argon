+#[test]
+fn private_track_selection_resets_audio_clock_and_focus_without_deleting_coded_frames() {
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    p.add_buffer(1).unwrap();
+    p.add_buffer(2).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.append(
+        2,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-aac.mp4"),
+    )
+    .unwrap();
+    p.audio.configure(48000, 2, false, &mut p.clock).unwrap();
+    assert!(!p.audio.stream.is_null());
+    assert!(p.clock.has_audio);
+    focus::set_counted(&mut p.focus_counted, true);
+    let video = p.sessions[&1].ranges(1);
+    let audio = p.sessions[&2].ranges(1);
+    p.set_track_selection(false, true).unwrap();
+    assert!(p.audio.stream.is_null());
+    assert!(!p.clock.has_audio);
+    assert!(!p.focus_counted);
+    assert!(p.decoders.audio.is_none());
+    assert_eq!(p.sessions[&1].ranges(1), video);
+    assert_eq!(p.sessions[&2].ranges(1), audio);
+    for _ in 0..10 {
+        let selection = p.selection;
+        let mut progress = false;
+        for (id, session) in &mut p.sessions {
+            let selected: BTreeSet<_> = session
+                .descriptions()
+                .iter()
+                .filter(|t| selection.mime(t.mime))
+                .map(|t| t.id)
+                .collect();
+            progress |= session
+                .pump_input_selected(
+                    &mut ScopedDecoder {
+                        buffer_id: *id,
+                        decoders: &mut p.decoders,
+                    },
+                    |id| selected.contains(&id),
+                )
+                .unwrap();
+        }
+        if !progress {
+            break;
+        }
+    }
+    assert!(p.decoders.video.is_some());
+    assert!(p.decoders.audio.is_none());
+    assert!(p.decoders.configs.values().all(|c| c.mime == "video/avc"));
+    p.set_track_selection(true, false).unwrap();
+    assert!(p.decoders.video.is_none());
+    assert!(p.video_pending.is_none());
+    assert_eq!(p.sessions[&1].ranges(1), video);
+    assert_eq!(p.sessions[&2].ranges(1), audio);
+    for _ in 0..10 {
+        let selection = p.selection;
+        let mut progress = false;
+        for (id, session) in &mut p.sessions {
+            let selected: BTreeSet<_> = session
+                .descriptions()
+                .iter()
+                .filter(|t| selection.mime(t.mime))
+                .map(|t| t.id)
+                .collect();
+            progress |= session
+                .pump_input_selected(
+                    &mut ScopedDecoder {
+                        buffer_id: *id,
+                        decoders: &mut p.decoders,
+                    },
+                    |id| selected.contains(&id),
+                )
+                .unwrap();
+        }
+        if !progress {
+            break;
+        }
+    }
+    assert!(p.decoders.audio.is_some());
+    assert!(p.decoders.video.is_none());
+}
+#[test]
+fn both_disabled_tracks_do_not_finish_or_signal_seek_readiness_and_can_be_reenabled() {
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.end_input().unwrap();
+    p.set_track_selection(false, false).unwrap();
+    p.set_playing(true).unwrap();
+    let status = p.pump().unwrap();
+    assert!(!status.finished);
+    assert!(!status.playing);
+    assert!(!status.current_data);
+    assert!(status.buffered.is_empty());
+    assert!(!p.take_seek_ready());
+    assert!(p.seek_target.is_none());
+    p.set_track_selection(false, true).unwrap();
+    assert_eq!(p.buffered(), [0..1_000_000]);
+    assert!(p.seek_target.is_some());
+    assert!(!p.take_seek_ready());
+    assert_eq!(p.sessions[&1].ranges(1), [0..1_000_000]);
+}
