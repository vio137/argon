+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! AAudio lifecycle sequencing. Each adapter must enforce ONE bounded deadline
+//! across all waits. State values are the stable API26 AAudio.h enum values.
+pub const OPEN: i32 = 2;
+pub const STARTING: i32 = 3;
+pub const STARTED: i32 = 4;
+pub const PAUSING: i32 = 5;
+pub const PAUSED: i32 = 6;
+pub const FLUSHING: i32 = 7;
+pub const FLUSHED: i32 = 8;
+pub const STOPPING: i32 = 9;
+pub const STOPPED: i32 = 10;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Request {
+    Pause,
+    Flush,
+    Start,
+}
+pub trait Stream {
+    fn state(&mut self) -> Result<i32, ()>;
+    fn request(&mut self, request: Request) -> Result<(), ()>;
+    fn wait(&mut self, transient: i32) -> Result<i32, ()>;
+}
+fn stable(stream: &mut impl Stream) -> Result<i32, ()> {
+    let state = stream.state()?;
+    let state = match state {
+        STARTING | PAUSING | FLUSHING | STOPPING => stream.wait(state)?,
+        s => s,
+    };
+    match state {
+        OPEN | STARTED | PAUSED | FLUSHED | STOPPED => Ok(state),
+        _ => Err(()),
+    }
+}
+fn transition(
+    stream: &mut impl Stream,
+    request: Request,
+    transient: i32,
+    target: i32,
+) -> Result<(), ()> {
+    stream.request(request)?;
+    // waitForStateChange returns immediately if already at target. A different
+    // stable state is NOT success, and no error/timeout permits the next request.
+    if stream.wait(transient)? == target {
+        Ok(())
+    } else {
+        Err(())
+    }
+}
+pub fn pause(stream: &mut impl Stream) -> Result<(), ()> {
+    if stable(stream)? == STARTED {
+        transition(stream, Request::Pause, PAUSING, PAUSED)?;
+    }
+    Ok(())
+}
+pub fn flush_for_seek(stream: &mut impl Stream) -> Result<(), ()> {
+    pause(stream)?;
+    transition(stream, Request::Flush, FLUSHING, FLUSHED)
+}
+pub fn start(stream: &mut impl Stream) -> Result<(), ()> {
+    if stable(stream)? != STARTED {
+        transition(stream, Request::Start, STARTING, STARTED)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::VecDeque;
+    struct Fake {
+        state: i32,
+        waits: VecDeque<Result<i32, ()>>,
+        calls: Vec<Request>,
+        fail: Option<Request>,
+    }
+    impl Fake {
+        fn new(state: i32, waits: &[Result<i32, ()>]) -> Self {
+            Self {
+                state,
+                waits: waits.iter().copied().collect(),
+                calls: vec![],
+                fail: None,
+            }
+        }
+    }
+    impl Stream for Fake {
+        fn state(&mut self) -> Result<i32, ()> {
+            Ok(self.state)
+        }
+        fn request(&mut self, r: Request) -> Result<(), ()> {
+            self.calls.push(r);
+            if self.fail == Some(r) {
+                Err(())
+            } else {
+                Ok(())
+            }
+        }
+        fn wait(&mut self, _: i32) -> Result<i32, ()> {
+            let s = self.waits.pop_front().expect("unexpected wait")?;
+            self.state = s;
+            Ok(s)
+        }
+    }
+    #[test]
+    fn seek_waits_for_pause_then_flush_without_starting() {
+        let mut s = Fake::new(STARTED, &[Ok(PAUSED), Ok(FLUSHED)]);
+        assert_eq!(flush_for_seek(&mut s), Ok(()));
+        assert_eq!(s.calls, vec![Request::Pause, Request::Flush]);
+    }
+    #[test]
+    fn stable_quiescent_states_need_only_flush() {
+        for state in [OPEN, PAUSED, STOPPED, FLUSHED] {
+            let mut s = Fake::new(state, &[Ok(FLUSHED)]);
+            assert_eq!(flush_for_seek(&mut s), Ok(()));
+            assert_eq!(s.calls, vec![Request::Flush]);
+        }
+    }
+    #[test]
+    fn timeout_and_wrong_state_prevent_flush() {
+        for result in [Err(()), Ok(STOPPING), Ok(STOPPED)] {
+            let mut s = Fake::new(STARTED, &[result]);
+            assert_eq!(flush_for_seek(&mut s), Err(()));
+            assert_eq!(s.calls, vec![Request::Pause]);
+        }
+    }
+    #[test]
+    fn pause_request_failure_prevents_wait_and_flush() {
+        let mut s = Fake::new(STARTED, &[]);
+        s.fail = Some(Request::Pause);
+        assert_eq!(flush_for_seek(&mut s), Err(()));
+        assert_eq!(s.calls, vec![Request::Pause]);
+    }
+    #[test]
+    fn flush_failure_never_requests_restart() {
+        let mut s = Fake::new(PAUSED, &[Err(())]);
+        assert_eq!(flush_for_seek(&mut s), Err(()));
+        assert_eq!(s.calls, vec![Request::Flush]);
+    }
+    #[test]
+    fn disconnected_and_unknown_states_rejected() {
+        for state in [0, 1, 11, 12, 13, 99] {
+            let mut s = Fake::new(state, &[]);
+            assert_eq!(flush_for_seek(&mut s), Err(()));
+            assert!(s.calls.is_empty());
+        }
+    }
+    #[test]
+    fn outstanding_start_is_settled_before_pause() {
+        let mut s = Fake::new(STARTING, &[Ok(STARTED), Ok(PAUSED), Ok(FLUSHED)]);
+        assert_eq!(flush_for_seek(&mut s), Ok(()));
+        assert_eq!(s.calls, vec![Request::Pause, Request::Flush]);
+    }
+    #[test]
+    fn normal_pause_preserves_queue_and_restart_waits() {
+        let mut s = Fake::new(STARTED, &[Ok(PAUSED), Ok(STARTED)]);
+        assert_eq!(pause(&mut s), Ok(()));
+        assert_eq!(start(&mut s), Ok(()));
+        assert_eq!(s.calls, vec![Request::Pause, Request::Start]);
+    }
+    #[test]
+    fn flush_request_error_and_start_error_stop_the_sequence() {
+        let mut s = Fake::new(PAUSED, &[]);
+        s.fail = Some(Request::Flush);
+        assert_eq!(flush_for_seek(&mut s), Err(()));
+        assert_eq!(s.calls, vec![Request::Flush]);
+        let mut s = Fake::new(FLUSHED, &[]);
+        s.fail = Some(Request::Start);
+        assert_eq!(start(&mut s), Err(()));
+        assert_eq!(s.calls, vec![Request::Start]);
+    }
+    #[test]
+    fn failed_pending_transition_does_not_issue_a_request() {
+        let mut s = Fake::new(STOPPING, &[Err(())]);
+        assert_eq!(flush_for_seek(&mut s), Err(()));
+        assert!(s.calls.is_empty());
+    }
+}
