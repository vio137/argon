+/// Used only on the pipeline thread. One 300ms deadline covers all state waits;
+/// a timeout or unexpected state closes the stream rather than playing stale data.
+struct AudioTransition {
+    stream: *mut sys::AAudioStream,
+    deadline: Instant,
+}
+impl AudioTransition {
+    fn new(stream: *mut sys::AAudioStream) -> Self {
+        Self { stream, deadline: Instant::now() + Duration::from_millis(300) }
+    }
+}
+impl crate::audio_state::Stream for AudioTransition {
+    fn state(&mut self) -> Result<i32, ()> {
+        // UNKNOWN + zero timeout refreshes the client state from the server.
+        let mut state = 1;
+        let result = unsafe { sys::AAudioStream_waitForStateChange(self.stream, 1, &mut state, 0) };
+        if result == sys::AAUDIO_OK { Ok(state) } else { Err(()) }
+    }
+    fn request(&mut self, request: crate::audio_state::Request) -> Result<(), ()> {
+        let result = unsafe { match request {
+            crate::audio_state::Request::Pause => sys::AAudioStream_requestPause(self.stream),
+            crate::audio_state::Request::Flush => sys::AAudioStream_requestFlush(self.stream),
+            crate::audio_state::Request::Start => sys::AAudioStream_requestStart(self.stream),
+        } };
+        if result == sys::AAUDIO_OK { Ok(()) } else { Err(()) }
+    }
+    fn wait(&mut self, transient: i32) -> Result<i32, ()> {
+        let remaining = self.deadline.checked_duration_since(Instant::now()).ok_or(())?;
+        let mut state = transient;
+        let result = unsafe { sys::AAudioStream_waitForStateChange(self.stream, transient, &mut state, remaining.as_nanos() as i64) };
+        if result == sys::AAUDIO_OK { Ok(state) } else { Err(()) }
+    }
+}
