+#[cfg(all(test, not(target_os = "android")))]
+mod tests {
+    use crate::append_source::*;
+    use crate::{Player, append::AppendEvent};
+    use std::sync::{Arc, Mutex};
+    use crate::{
+        generic_channel::GenericCallback,
+        mse_player::AndroidAppendPlayer,
+        video::{VideoFrame, VideoFrameRenderer},
+    };
+    use std::{sync::mpsc, time::Duration};
+    struct Renderer;
+    impl VideoFrameRenderer for Renderer {
+        fn render(&mut self, _: VideoFrame) {}
+    }
+    fn player() -> Arc<Mutex<dyn Player>> {
+        let (tx, _) = mpsc::channel();
+        AndroidAppendPlayer::new(
+            1,
+            GenericCallback::new(move |message| {
+                if let Ok(event) = message {
+                    let _ = tx.send(event);
+                }
+            })
+            .unwrap(),
+            Some(Arc::new(Mutex::new(Renderer))),
+            Box::new(|| {}),
+        )
+        .unwrap()
+    }
+    #[test]
+    fn lifecycle_connects_real_append_player_and_preserves_buffer_identity() {
+        let (tx, rx) = mpsc::channel();
+        let source = AppendSource::new(Arc::new(move |e| {
+            let _ = tx.send(e);
+        }));
+        assert_eq!(source.state(), SourceState::Closed);
+        assert!(matches!(
+            source.add_buffer("video/mp4"),
+            Err(SourceError::InvalidState)
+        ));
+        source.attach(player()).unwrap();
+        assert_eq!(rx.recv().unwrap(), SourceEvent::Open);
+        assert!(source.attach(player()).is_err());
+        let buffer = source
+            .add_buffer("video/mp4; codecs=\"avc1.42E01E\"")
+            .unwrap();
+        assert!(buffer.same_buffer(&source.buffers()[0]));
+        let another = AppendSource::new(Arc::new(|_| {}));
+        another.attach(player()).unwrap();
+        let other = another.add_buffer("video/mp4").unwrap();
+        assert!(!buffer.same_buffer(&other));
+        buffer.append(vec![]).unwrap();
+        let mut ended = false;
+        for _ in 0..6 {
+            if rx.recv_timeout(Duration::from_secs(2)).unwrap()
+                == SourceEvent::BufferEvent(buffer.id(), AppendEvent::UpdateEnd)
+            {
+                ended = true;
+                break;
+            }
+        }
+        assert!(ended);
+        assert!(!buffer.updating());
+        source.end_input().unwrap();
+        assert_eq!(source.state(), SourceState::Ended);
+        assert_eq!(buffer.append(vec![]), Err(SourceError::InvalidState));
+        source.detach();
+        assert_eq!(source.state(), SourceState::Closed);
+        assert!(source.buffers().is_empty());
+        assert_eq!(buffer.append(vec![]), Err(SourceError::InvalidState));
+        source.attach(player()).unwrap();
+        let next = source.add_buffer("video/mp4").unwrap();
+        assert!(!buffer.same_buffer(&next));
+    }
+    #[test]
+    fn format_filter_rejects_unknown_codecs_parameters_and_prefix_spoofing() {
+        for s in [
+            "video/webm",
+            "video/mp4; codecs=\"avc1junk\"",
+            "audio/mp4; codecs=\"avc1.42E01E\"",
+            "video/mp4; codecs=\"avc1.42E01E,evil\"",
+            "video/mp4; codecs=\"\"",
+            "video/mp4; codecs=\"avc1.42E01E\"; x=1",
+            "video/mp4; codecs=\"avc1.42E01E",
+            "video/mp4; random=abc",
+        ] {
+            assert!(!supported_type(s), "{s}");
+        }
+        for s in [
+            "video/mp4",
+            "audio/mp4; codecs=\"mp4a.40.5\"",
+            "video/mp4; codecs=\"avc1.42E01E, mp4a.40.2\"",
+        ] {
+            assert!(supported_type(s), "{s}");
+        }
+    }
+}
+
+#[cfg(all(test, not(target_os = "android")))]
+mod pipeline_tests {
+    use crate::append_source::*;
+    use crate::append::AppendEvent;
+    use std::sync::Arc;
+    use crate::{generic_channel::GenericCallback, mse_player::AndroidAppendPlayer};
+    use std::{sync::mpsc, time::Duration};
+    #[test]
+    fn source_options_and_buffered_ranges_cross_player_worker_and_coded_store() {
+        let (tx, _events) = mpsc::channel();
+        let player = AndroidAppendPlayer::new(
+            3,
+            GenericCallback::new(move |message| {
+                if let Ok(event) = message {
+                    let _ = tx.send(event);
+                }
+            })
+            .unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let (tx, rx) = mpsc::channel();
+        let source = AppendSource::new(Arc::new(move |e| {
+            let _ = tx.send(e);
+        }));
+        source.attach(player).unwrap();
+        let buffer = source.add_buffer("video/mp4").unwrap();
+        buffer.set_options(1.0, 1.0..2.0).unwrap();
+        assert_eq!(buffer.options().unwrap(), (1.0, 1.0..2.0));
+        assert!(buffer.set_options(f64::NAN, 0.0..1.0).is_err());
