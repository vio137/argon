@@ -0,0 +1,358 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+//! Backend-neutral private append source lifecycle. DOM wrappers must retain
+//! SourceBuffer identity and queue events onto their own media task source.
+//! No browser capability is exposed by this controller.
+use crate::{Player, append::AppendEvent};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex, Weak},
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SourceState {
+    Closed,
+    Open,
+    Ended,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SourceEvent {
+    Open,
+    Ended,
+    Closed,
+    BufferAdded(u32),
+    BufferEvent(u32, AppendEvent),
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SourceError {
+    InvalidState,
+    Type,
+    NotSupported,
+    Quota,
+    Backend,
+}
+type Callback = Arc<dyn Fn(SourceEvent) + Send + Sync>;
+struct Buffer {
+    offset: f64,
+    window: std::ops::Range<f64>,
+    updating: bool,
+    ready: bool,
+}
+struct State {
+    state: SourceState,
+    player: Option<Arc<Mutex<dyn Player>>>,
+    buffers: BTreeMap<u32, Buffer>,
+    next_id: u32,
+    epoch: u64,
+}
+struct Inner {
+    state: Mutex<State>,
+    callback: Callback,
+}
+#[derive(Clone)]
+pub struct AppendSource(Arc<Inner>);
+#[derive(Clone)]
+pub struct AppendBuffer {
+    id: u32,
+    epoch: u64,
+    owner: Weak<Inner>,
+}
+impl AppendSource {
+    pub fn new(callback: Callback) -> Self {
+        Self(Arc::new(Inner {
+            state: Mutex::new(State {
+                state: SourceState::Closed,
+                player: None,
+                buffers: BTreeMap::new(),
+                next_id: 1,
+                epoch: 0,
+            }),
+            callback,
+        }))
+    }
+    pub fn state(&self) -> SourceState {
+        self.0.state.lock().unwrap().state
+    }
+    pub fn attach(&self, player: Arc<Mutex<dyn Player>>) -> Result<(), SourceError> {
+        {
+            let mut s = self.0.state.lock().unwrap();
+            if s.state != SourceState::Closed || s.player.is_some() {
+                return Err(SourceError::InvalidState);
+            }
+            s.player = Some(player);
+            s.state = SourceState::Open;
+        }
+        (self.0.callback)(SourceEvent::Open);
+        Ok(())
+    }
+    pub fn detach(&self) {
+        let player = {
+            let mut s = self.0.state.lock().unwrap();
+            if s.state == SourceState::Closed {
+                return;
+            }
+            s.state = SourceState::Closed;
+            s.epoch = s.epoch.saturating_add(1);
+            s.buffers.clear();
+            s.player.take()
+        };
+        if let Some(player) = player {
+            let _ = player.lock().unwrap().stop();
+        }
+        (self.0.callback)(SourceEvent::Closed);
+    }
+    pub fn add_buffer(&self, mime: &str) -> Result<AppendBuffer, SourceError> {
+        if !supported_type(mime) {
+            return Err(SourceError::NotSupported);
+        }
+        let (id, epoch, player) = {
+            let mut s = self.0.state.lock().unwrap();
+            if s.state != SourceState::Open || s.buffers.values().any(|b| b.updating) {
+                return Err(SourceError::InvalidState);
+            }
+            if s.buffers.len() >= 2 {
+                return Err(SourceError::Quota);
+            }
+            let id = s.next_id;
+            s.next_id = s.next_id.checked_add(1).ok_or(SourceError::Quota)?;
+            s.buffers.insert(
+                id,
+                Buffer {
+                    offset: 0.0,
+                    window: 0.0..f64::INFINITY,
+                    updating: false,
+                    ready: false,
+                },
+            );
+            (
+                id,
+                s.epoch,
+                s.player.clone().ok_or(SourceError::InvalidState)?,
+            )
+        };
+        let weak = Arc::downgrade(&self.0);
+        let callback = Box::new(move |event| {
+            let Some(inner) = weak.upgrade() else {
+                return;
+            };
+            let accepted = {
+                let mut s = inner.state.lock().unwrap();
+                if s.epoch != epoch {
+                    false
+                } else if let Some(b) = s.buffers.get_mut(&id) {
+                    match event {
+                        AppendEvent::Ready => b.ready = true,
+                        AppendEvent::UpdateStart => b.updating = true,
+                        AppendEvent::UpdateEnd | AppendEvent::Closed => b.updating = false,
+                        _ => (),
+                    }
+                    true
+                } else {
+                    false
+                }
+            };
+            if accepted {
+                (inner.callback)(SourceEvent::BufferEvent(id, event));
+            }
+        });
+        if player
+            .lock()
+            .unwrap()
+            .append_add_buffer(id, callback)
+            .is_err()
+        {
+            self.0.state.lock().unwrap().buffers.remove(&id);
+            return Err(SourceError::Backend);
+        }
+        (self.0.callback)(SourceEvent::BufferAdded(id));
+        Ok(AppendBuffer {
+            id,
+            epoch,
+            owner: Arc::downgrade(&self.0),
+        })
+    }
+    pub fn buffers(&self) -> Vec<AppendBuffer> {
+        let s = self.0.state.lock().unwrap();
+        s.buffers
+            .keys()
+            .map(|id| AppendBuffer {
+                id: *id,
+                epoch: s.epoch,
+                owner: Arc::downgrade(&self.0),
+            })
+            .collect()
+    }
+    pub fn end_input(&self) -> Result<(), SourceError> {
+        let player = {
+            let s = self.0.state.lock().unwrap();
+            if s.state != SourceState::Open || s.buffers.values().any(|b| b.updating || !b.ready) {
+                return Err(SourceError::InvalidState);
+            }
+            s.player.clone().ok_or(SourceError::InvalidState)?
+        };
+        player
+            .lock()
+            .unwrap()
+            .end_of_stream()
+            .map_err(|_| SourceError::Backend)?;
+        self.0.state.lock().unwrap().state = SourceState::Ended;
+        (self.0.callback)(SourceEvent::Ended);
+        Ok(())
+    }
+}
+impl Drop for Inner {
+    fn drop(&mut self) {
+        if let Ok(s) = self.state.get_mut() {
+            if let Some(player) = s.player.take() {
+                let _ = player.lock().unwrap().stop();
+            }
+        }
+    }
+}
+impl AppendBuffer {
+    pub fn id(&self) -> u32 {
+        self.id
+    }
+    pub fn same_buffer(&self, other: &Self) -> bool {
+        self.id == other.id && self.epoch == other.epoch && Weak::ptr_eq(&self.owner, &other.owner)
+    }
+    pub fn updating(&self) -> bool {
+        self.owner.upgrade().is_some_and(|o| {
+            let s = o.state.lock().unwrap();
+            s.epoch == self.epoch && s.buffers.get(&self.id).is_some_and(|b| b.updating)
+        })
+    }
+    pub fn options(&self) -> Result<(f64, std::ops::Range<f64>), SourceError> {
+        let inner = self.owner.upgrade().ok_or(SourceError::InvalidState)?;
+        let s = inner.state.lock().unwrap();
+        if s.epoch != self.epoch {
+            return Err(SourceError::InvalidState);
+        }
+        let b = s.buffers.get(&self.id).ok_or(SourceError::InvalidState)?;
+        Ok((b.offset, b.window.clone()))
+    }
+    pub fn set_options(
+        &self,
+        offset: f64,
+        window: std::ops::Range<f64>,
+    ) -> Result<(), SourceError> {
+        let inner = self.owner.upgrade().ok_or(SourceError::InvalidState)?;
+        let player = {
+            let s = inner.state.lock().unwrap();
+            if s.epoch != self.epoch
+                || s.state != SourceState::Open
+                || s.buffers.get(&self.id).is_none_or(|b| b.updating)
+            {
+                return Err(SourceError::InvalidState);
+            }
+            s.player.clone().ok_or(SourceError::InvalidState)?
+        };
+        if !offset.is_finite()
+            || !window.start.is_finite()
+            || window.start < 0.0
+            || window.end.is_nan()
+            || window.end <= window.start
+        {
+            return Err(SourceError::Type);
+        }
+        player
+            .lock()
+            .unwrap()
+            .append_set_options(self.id, offset, window.clone())
+            .map_err(|_| SourceError::Backend)?;
+        let mut s = inner.state.lock().unwrap();
+        let b = s
+            .buffers
+            .get_mut(&self.id)
+            .ok_or(SourceError::InvalidState)?;
+        b.offset = offset;
+        b.window = window;
+        Ok(())
+    }
+    pub fn buffered(&self) -> Vec<std::ops::Range<f64>> {
+        let Some(inner) = self.owner.upgrade() else {
+            return vec![];
+        };
+        let player = {
+            let s = inner.state.lock().unwrap();
+            if s.epoch != self.epoch || !s.buffers.contains_key(&self.id) {
+                return vec![];
+            }
+            s.player.clone()
+        };
+        player
+            .map(|p| p.lock().unwrap().append_buffered(self.id))
+            .unwrap_or_default()
+    }
+    pub fn append(&self, bytes: Vec<u8>) -> Result<(), SourceError> {
+        let inner = self.owner.upgrade().ok_or(SourceError::InvalidState)?;
+        let player = {
+            let mut s = inner.state.lock().unwrap();
+            if s.epoch != self.epoch || s.state != SourceState::Open {
+                return Err(SourceError::InvalidState);
+            }
+            let b = s
+                .buffers
+                .get_mut(&self.id)
+                .ok_or(SourceError::InvalidState)?;
+            if b.updating {
+                return Err(SourceError::InvalidState);
+            }
+            b.updating = true;
+            s.player.clone().ok_or(SourceError::InvalidState)?
+        };
+        let result = player.lock().unwrap().append_to_buffer(self.id, bytes);
+        if result.is_err() {
+            let mut s = inner.state.lock().unwrap();
+            if let Some(b) = s.buffers.get_mut(&self.id) {
+                b.updating = false;
+            }
+            return Err(SourceError::Backend);
+        }
+        Ok(())
+    }
+}
+/// Private format filter, not MediaSource.isTypeSupported capability reporting.
+/// Exact codec token forms only; no prefix acceptance of e.g. avc1junk.
+pub fn supported_type(input: &str) -> bool {
+    let mut fields = input.split(';');
+    let kind = fields.next().unwrap_or("").trim().to_ascii_lowercase();
+    if kind != "video/mp4" && kind != "audio/mp4" {
+        return false;
+    }
+    let Some(param) = fields.next() else {
+        return true;
+    };
+    if fields.next().is_some() {
+        return false;
+    }
+    let Some((key, value)) = param.trim().split_once('=') else {
+        return false;
+    };
+    if !key.trim().eq_ignore_ascii_case("codecs") {
+        return false;
+    }
+    let value = value.trim();
+    let value = if value.starts_with('"') && value.ends_with('"') && value.len() >= 2 {
+        &value[1..value.len() - 1]
+    } else if value.contains('"') {
+        return false;
+    } else {
+        value
+    };
+    let mut count = 0;
+    for token in value.split(',') {
+        let token = token.trim();
+        count += 1;
+        let avc = token
+            .strip_prefix("avc1.")
+            .is_some_and(|s| s.len() == 6 && s.bytes().all(|b| b.is_ascii_hexdigit()));
+        let aac = token
+            .strip_prefix("mp4a.40.")
+            .is_some_and(|s| matches!(s, "2" | "5" | "29"));
+        if !(aac || (kind == "video/mp4" && avc)) {
+            return false;
+        }
+    }
+    count > 0 && count <= 2
+}
