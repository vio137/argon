+//! Backend-neutral private append controller contract. DOM readiness, object
+//! identity and task-queued events belong to the script layer, not these callbacks.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AppendEvent {
+    Ready,
+    UpdateStart,
+    Update,
+    UpdateEnd,
+    Error,
+    Closed,
+}
