diff --git a/components/media/backends/android/android_impl/mse_player.rs b/components/media/backends/android/android_impl/mse_player.rs
new file mode 100644
index 000000000..ab6af4cf3
--- /dev/null
+++ b/components/media/backends/android/android_impl/mse_player.rs
@@ -0,0 +1,553 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+//! An append-backed Player, separate from the progressive extractor. Never
+//! starts a network fetch or reuses a progressive download as an MSE stream.
+use super::mse_worker::{Applied, Command, Event, Worker};
+use servo_base::generic_channel::GenericCallback;
+use servo_media::{MediaInstance, MediaInstanceError};
+use servo_media_player::{
+    PlaybackState, Player, PlayerError, PlayerEvent,
+    append::{AppendCallback, AppendEvent},
+    metadata::Metadata,
+    video::VideoFrameRenderer,
+};
+use std::{
+    collections::BTreeMap,
+    ops::Range,
+    sync::{Arc, Mutex},
+};
+
+struct BufferState {
+    ready: bool,
+    updating: bool,
+    callback: Arc<dyn Fn(AppendEvent) + Send + Sync>,
+}
+struct State {
+    paused: bool,
+    muted: bool,
+    volume: f64,
+    stopped: bool,
+    input_ended: bool,
+    buffers: BTreeMap<u32, BufferState>,
+    buffered: Vec<Range<f64>>,
+    buffer_ranges: BTreeMap<u32, Vec<Range<f64>>>,
+}
+pub struct AndroidAppendPlayer {
+    id: usize,
+    state: Arc<Mutex<State>>,
+    worker: Mutex<Option<Worker>>,
+    closed: std::sync::atomic::AtomicBool,
+    on_close: Box<dyn Fn() + Send + Sync>,
+}
+fn error() -> PlayerError {
+    PlayerError::BufferPushFailed
+}
+impl AndroidAppendPlayer {
+    pub fn new(
+        id: usize,
+        sender: GenericCallback<PlayerEvent>,
+        renderer: Option<Arc<Mutex<dyn VideoFrameRenderer>>>,
+        on_close: Box<dyn Fn() + Send + Sync>,
+    ) -> Result<Arc<Mutex<Self>>, PlayerError> {
+        let state = Arc::new(Mutex::new(State {
+            paused: true,
+            muted: false,
+            volume: 1.0,
+            stopped: false,
+            input_ended: false,
+            buffers: BTreeMap::new(),
+            buffered: vec![],
+            buffer_ranges: BTreeMap::new(),
+        }));
+        let shared = state.clone();
+        let sender = Arc::new(Mutex::new(sender));
+        let metadata: (Option<(u16, u16)>, bool) = (None, false);
+        // Metadata history is worker-local behind this mutex because the event
+        // callback is Fn, while Worker invokes it serially on its own thread.
+        let history = Arc::new(Mutex::new((0u64, metadata, false, false, false)));
+        struct DiscardVideo;
+        impl VideoFrameRenderer for DiscardVideo {
+            fn render(&mut self, _: servo_media_player::video::VideoFrame) {}
+        }
+        let renderer = renderer.unwrap_or_else(|| Arc::new(Mutex::new(DiscardVideo)));
+        let worker = Worker::spawn(
+            renderer,
+            Box::new(move |event| {
+                let send = |event| {
+                    if let Ok(sender) = sender.lock() {
+                        let _ = sender.send(event);
+                    }
+                };
+                match event {
+                    Event::CommandApplied(Applied::BufferAdded(id)) => {
+                        let cb = {
+                            let mut s = shared.lock().unwrap();
+                            s.buffers.get_mut(&id).map(|b| {
+                                b.ready = true;
+                                b.callback.clone()
+                            })
+                        };
+                        if let Some(cb) = cb {
+                            cb(AppendEvent::Ready);
+                        }
+                    }
+                    Event::CommandApplied(Applied::Appended(id)) => {
+                        let cb = {
+                            let mut s = shared.lock().unwrap();
+                            s.buffers.get_mut(&id).map(|b| {
+                                let updating = b.updating;
+                                b.updating = false;
+                                (b.callback.clone(), updating)
+                            })
+                        };
+                        if let Some((cb, _updating)) = cb {
+                            cb(AppendEvent::Update);
+                            cb(AppendEvent::UpdateEnd);
+                        }
+                    }
+                    Event::CommandApplied(_) => (),
+                    Event::Status(status) => {
+                        let (old_frames, old_metadata, old_playing, old_ready, old_initialized) = {
+                            let mut h = history.lock().unwrap();
+                            let old = *h;
+                            *h = (
+                                status.rendered_frames,
+                                (status.video_size, status.has_audio),
+                                status.playing,
+                                status.all_buffers_ready && status.current_data,
+                                status.all_buffers_ready,
+                            );
+                            old
+                        };
+                        shared.lock().unwrap().buffered = status
+                            .buffered
+                            .iter()
+                            .map(|r| r.start as f64 / 1e6..r.end as f64 / 1e6)
+                            .collect();
+                        shared.lock().unwrap().buffer_ranges = status
+                            .buffer_ranges
+                            .iter()
+                            .map(|(id, ranges)| {
+                                (
+                                    *id,
+                                    ranges
+                                        .iter()
+                                        .map(|r| r.start as f64 / 1e6..r.end as f64 / 1e6)
+                                        .collect(),
+                                )
+                            })
+                            .collect();
+                        let ready = status.all_buffers_ready && status.current_data;
+                        if status.all_buffers_ready
+                            && (!old_initialized
+                                || old_metadata != (status.video_size, status.has_audio))
+                        {
+                            let (width, height) = status.video_size.unwrap_or((0, 0));
+                            send(PlayerEvent::MetadataUpdated(Metadata {
+                                duration: None,
+                                width: u32::from(width),
+                                height: u32::from(height),
+                                format: "video/mp4".to_owned(),
+                                is_seekable: false,
+                                video_tracks: if status.video_size.is_some() {
+                                    vec!["video/avc".to_owned()]
+                                } else {
+                                    vec![]
+                                },
+                                audio_tracks: if status.has_audio {
+                                    vec!["audio/mp4a-latm".to_owned()]
+                                } else {
+                                    vec![]
+                                },
+                                is_live: true,
+                                title: None,
+                            }));
+                        }
+                        if status.rendered_frames != old_frames {
+                            send(PlayerEvent::VideoFrameUpdated);
+                        }
+                        send(PlayerEvent::PositionChanged(
+                            status.position_us as f64 / 1e6,
+                        ));
+                        if status.finished {
+                            {
+                                let mut s = shared.lock().unwrap();
+                                s.paused = true;
+                                s.stopped = true;
+                            }
+                            send(PlayerEvent::EndOfStream);
+                            send(PlayerEvent::StateChanged(PlaybackState::Paused));
+                        } else if ready && (!old_ready || status.playing != old_playing) {
+                            send(PlayerEvent::StateChanged(if status.playing {
+                                PlaybackState::Playing
+                            } else {
+                                PlaybackState::Paused
+                            }));
+                        }
+                    }
+                    Event::Error => {
+                        let callbacks = {
+                            let mut s = shared.lock().unwrap();
+                            s.stopped = true;
+                            s.paused = true;
+                            s.buffers
+                                .values_mut()
+                                .map(|b| {
+                                    let updating = b.updating;
+                                    b.updating = false;
+                                    (b.callback.clone(), updating)
+                                })
+                                .collect::<Vec<_>>()
+                        };
+                        for (cb, updating) in callbacks {
+                            cb(AppendEvent::Error);
+                            if updating {
+                                cb(AppendEvent::UpdateEnd);
+                            }
+                        }
+                        send(PlayerEvent::Error(
+                            "adaptive media worker failed".to_owned(),
+                        ));
+                        send(PlayerEvent::StateChanged(PlaybackState::Stopped));
+                    }
+                }
+            }),
+        )
+        .map_err(|_| error())?;
+        Ok(Arc::new(Mutex::new(Self {
+            id,
+            state,
+            worker: Mutex::new(Some(worker)),
+            closed: std::sync::atomic::AtomicBool::new(false),
+            on_close,
+        })))
+    }
+    fn command(&self, command: Command) -> Result<(), PlayerError> {
+        self.worker
+            .lock()
+            .map_err(|_| error())?
+            .as_ref()
+            .ok_or_else(error)?
+            .try_command(command)
+            .map_err(|_| error())
+    }
+    fn close(&self) {
+        if self.closed.swap(true, std::sync::atomic::Ordering::AcqRel) {
+            return;
+        }
+        (self.on_close)();
+        // Never join while holding state: callbacks may still be finishing.
+        let callbacks = {
+            let mut s = self.state.lock().unwrap();
+            s.stopped = true;
+            s.paused = true;
+            std::mem::take(&mut s.buffers)
+                .into_values()
+                .map(|b| b.callback)
+                .collect::<Vec<_>>()
+        };
+        let worker = self.worker.lock().unwrap().take();
+        drop(worker);
+        for cb in callbacks {
+            cb(AppendEvent::Closed);
+        }
+    }
+}
+impl Drop for AndroidAppendPlayer {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+impl MediaInstance for AndroidAppendPlayer {
+    fn get_id(&self) -> usize {
+        self.id
+    }
+    fn mute(&self, val: bool) -> Result<(), MediaInstanceError> {
+        self.set_mute(val).map_err(|_| MediaInstanceError)
+    }
+    fn suspend(&self) -> Result<(), MediaInstanceError> {
+        self.pause().map_err(|_| MediaInstanceError)
+    }
+    fn resume(&self) -> Result<(), MediaInstanceError> {
+        self.play().map_err(|_| MediaInstanceError)
+    }
+}
+impl Player for AndroidAppendPlayer {
+    fn play(&self) -> Result<(), PlayerError> {
+        let mut s = self.state.lock().unwrap();
+        if s.stopped {
+            return Err(error());
+        }
+        self.command(Command::Playing(true))?;
+        s.paused = false;
+        Ok(())
+    }
+    fn pause(&self) -> Result<(), PlayerError> {
+        let mut s = self.state.lock().unwrap();
+        if s.stopped {
+            return Err(error());
+        }
+        self.command(Command::Playing(false))?;
+        s.paused = true;
+        Ok(())
+    }
+    fn paused(&self) -> bool {
+        self.state.lock().unwrap().paused
+    }
+    fn can_resume(&self) -> bool {
+        !self.state.lock().unwrap().stopped
+    }
+    fn stop(&self) -> Result<(), PlayerError> {
+        self.close();
+        Ok(())
+    }
+    fn seek(&self, _: f64) -> Result<(), PlayerError> {
+        Err(PlayerError::NonSeekableStream)
+    }
+    fn seekable(&self) -> Vec<Range<f64>> {
+        vec![]
+    }
+    fn set_mute(&self, muted: bool) -> Result<(), PlayerError> {
+        let mut s = self.state.lock().unwrap();
+        if s.stopped {
+            return Err(error());
+        }
+        self.command(Command::Volume {
+            volume: s.volume as f32,
+            muted,
+        })?;
+        s.muted = muted;
+        Ok(())
+    }
+    fn muted(&self) -> bool {
+        self.state.lock().unwrap().muted
+    }
+    fn set_volume(&self, volume: f64) -> Result<(), PlayerError> {
+        if !volume.is_finite() || !(0.0..=1.0).contains(&volume) {
+            return Err(error());
+        }
+        let mut s = self.state.lock().unwrap();
+        if s.stopped {
+            return Err(error());
+        }
+        self.command(Command::Volume {
+            volume: volume as f32,
+            muted: s.muted,
+        })?;
+        s.volume = volume;
+        Ok(())
+    }
+    fn volume(&self) -> f64 {
+        self.state.lock().unwrap().volume
+    }
+    fn set_input_size(&self, _: u64) -> Result<(), PlayerError> {
+        Err(error())
+    }
+    fn set_seekable(&self, _: bool) -> Result<(), PlayerError> {
+        Err(PlayerError::NonSeekableStream)
+    }
+    fn set_download_buffering_enabled(&self, _: bool) -> Result<(), PlayerError> {
+        Ok(())
+    }
+    fn set_playback_rate(&self, rate: f64) -> Result<(), PlayerError> {
+        if rate == 1.0 { Ok(()) } else { Err(error()) }
+    }
+    fn playback_rate(&self) -> f64 {
+        1.0
+    }
+    fn push_data(&self, _: Vec<u8>) -> Result<(), PlayerError> {
+        Err(error())
+    }
+    fn end_of_stream(&self) -> Result<(), PlayerError> {
+        let mut s = self.state.lock().unwrap();
+        if s.stopped || s.input_ended || s.buffers.values().any(|b| !b.ready || b.updating) {
+            return Err(error());
+        }
+        self.command(Command::EndInput)?;
+        s.input_ended = true;
+        Ok(())
+    }
+    fn buffered(&self) -> Vec<Range<f64>> {
+        self.state.lock().unwrap().buffered.clone()
+    }
+    fn set_stream(
+        &self,
+        _: &servo_media_streams::MediaStreamId,
+        _: bool,
+    ) -> Result<(), PlayerError> {
+        Err(PlayerError::SetStreamFailed)
+    }
+    fn render_use_gl(&self) -> bool {
+        false
+    }
+    fn set_audio_track(&self, _: i32, _: bool) -> Result<(), PlayerError> {
+        Err(PlayerError::SetTrackFailed)
+    }
+    fn set_video_track(&self, _: i32, _: bool) -> Result<(), PlayerError> {
+        Err(PlayerError::SetTrackFailed)
+    }
+    fn append_add_buffer(&self, id: u32, callback: AppendCallback) -> Result<(), PlayerError> {
+        let mut s = self.state.lock().unwrap();
+        if s.stopped || s.input_ended || s.buffers.len() >= 2 || s.buffers.contains_key(&id) {
+            return Err(error());
+        }
+        s.buffers.insert(
+            id,
+            BufferState {
+                ready: false,
+                updating: false,
+                callback: Arc::from(callback),
+            },
+        );
+        if let Err(e) = self.command(Command::AddBuffer(id)) {
+            s.buffers.remove(&id);
+            return Err(e);
+        }
+        Ok(())
+    }
+    fn append_set_options(
+        &self,
+        id: u32,
+        offset: f64,
+        window: Range<f64>,
+    ) -> Result<(), PlayerError> {
+        fn micros(value: f64) -> Option<i64> {
+            let v = value * 1e6;
+            if !v.is_finite() || v < i64::MIN as f64 || v >= i64::MAX as f64 {
+                None
+            } else {
+                Some(v.round() as i64)
+            }
+        }
+        let offset_us = micros(offset).ok_or_else(error)?;
+        let start = micros(window.start).ok_or_else(error)?;
+        let end = if window.end == f64::INFINITY {
+            i64::MAX
+        } else {
+            micros(window.end).ok_or_else(error)?
+        };
+        if start < 0 || end <= start {
+            return Err(error());
+        }
+        let s = self.state.lock().unwrap();
+        if s.stopped || s.input_ended || s.buffers.get(&id).is_none_or(|b| b.updating) {
+            return Err(error());
+        }
+        self.command(Command::Options {
+            buffer_id: id,
+            offset_us,
+            window: start..end,
+        })
+    }
+    fn append_buffered(&self, id: u32) -> Vec<Range<f64>> {
+        self.state
+            .lock()
+            .unwrap()
+            .buffer_ranges
+            .get(&id)
+            .cloned()
+            .unwrap_or_default()
+    }
+    fn append_to_buffer(&self, id: u32, bytes: Vec<u8>) -> Result<(), PlayerError> {
+        let cb = {
+            let mut s = self.state.lock().unwrap();
+            if s.stopped || s.input_ended {
+                return Err(error());
+            }
+            let b = s.buffers.get_mut(&id).ok_or_else(error)?;
+            if b.updating {
+                return Err(error());
+            }
+            b.updating = true;
+            b.callback.clone()
+        };
+        // Callback only queues DOM work; never run script synchronously here.
+        cb(AppendEvent::UpdateStart);
+        if let Err(e) = self.command(Command::Append {
+            buffer_id: id,
+            bytes,
+        }) {
+            let mut s = self.state.lock().unwrap();
+            if let Some(b) = s.buffers.get_mut(&id) {
+                b.updating = false;
+            }
+            drop(s);
+            cb(AppendEvent::Error);
+            cb(AppendEvent::UpdateEnd);
+            return Err(e);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(all(test, not(target_os = "android")))]
+mod tests {
+    use super::*;
+    use servo_media_player::video::VideoFrame;
+    use std::{sync::mpsc, time::Duration};
+    struct Renderer;
+    impl VideoFrameRenderer for Renderer {
+        fn render(&mut self, _: VideoFrame) {}
+    }
+    #[test]
+    fn append_player_processes_buffer_updates_and_closes_without_progressive_fetch() {
+        let (tx, events) = mpsc::channel();
+        let player = AndroidAppendPlayer::new(
+            1,
+            GenericCallback::new(move |message| {
+                if let Ok(event) = message {
+                    let _ = tx.send(event);
+                }
+            })
+            .unwrap(),
+            Some(Arc::new(Mutex::new(Renderer))),
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let (tx, rx) = mpsc::channel();
+        player
+            .lock()
+            .unwrap()
+            .append_add_buffer(
+                1,
+                Box::new(move |e| {
+                    let _ = tx.send(e);
+                }),
+            )
+            .unwrap();
+        assert_eq!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            AppendEvent::Ready
+        );
+        player.lock().unwrap().append_to_buffer(1, vec![]).unwrap();
+        assert_eq!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            AppendEvent::UpdateStart
+        );
+        assert_eq!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            AppendEvent::Update
+        );
+        assert_eq!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            AppendEvent::UpdateEnd
+        );
+        assert!(player.lock().unwrap().push_data(vec![1]).is_err());
+        assert!(player.lock().unwrap().set_volume(f64::NAN).is_err());
+        assert!(player.lock().unwrap().seek(0.0).is_err());
+        player.lock().unwrap().stop().unwrap();
+        assert_eq!(
+            rx.recv_timeout(Duration::from_secs(2)).unwrap(),
+            AppendEvent::Closed
+        );
+        assert!(player.lock().unwrap().append_to_buffer(1, vec![]).is_err());
+        assert!(player.lock().unwrap().play().is_err());
+        assert!(!player.lock().unwrap().can_resume());
+        assert!(
+            !events
+                .try_iter()
+                .any(|e| matches!(e, PlayerEvent::NeedData))
+        );
+    }
+}
