+// Kept separate from timestampOffset conversion: a window filters whole
+// frames, while the offset translates timestamps.
+fn append_window_us(window: Range<f64>) -> Result<Range<i64>, PlayerError> {
+    let convert=|value:f64,start:bool| {
+        let micros=value*1e6;
+        if !micros.is_finite() || micros<0.0 || micros>=i64::MAX as f64 {
+            Err(error())
+        } else {Ok(if start {micros.ceil()}else{micros.floor()} as i64)}
+    };
+    // start <= integer frame PTS, integer frame end <= end. Round inward
+    // so fractional boundaries cannot admit out-of-window coded frames.
+    // The private microsecond API rejects intervals with no representable
+    // positive-duration frame; this is not full submicrosecond support.
+    let start=convert(window.start,true)?;
+    let end=if window.end==f64::INFINITY {i64::MAX}else{convert(window.end,false)?};
+    if end<=start {return Err(error());}
+    Ok(start..end)
 }
