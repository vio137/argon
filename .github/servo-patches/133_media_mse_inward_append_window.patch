+#[cfg(test)]
+mod append_window_quantization_tests {
+ use super::*;
+ #[test]
+ fn fractional_start_never_retains_a_frame_beginning_below_the_window() {
+  let w=append_window_us(0.1e-6..10e-6).unwrap();assert_eq!(w,1..10);
+  assert!(!(0>=w.start && 1<=w.end));assert!(1>=w.start && 2<=w.end);
+ }
+ #[test]
+ fn fractional_end_never_retains_a_frame_ending_above_the_window() {
+  let w=append_window_us(0.0..1.9e-6).unwrap();assert_eq!(w,0..1);
+  assert!(!(0>=w.start && 2<=w.end));assert!(0>=w.start && 1<=w.end);
+ }
+ #[test]
+ fn exact_and_infinite_windows_remain_supported_and_unrepresentable_ranges_reject() {
+  assert_eq!(append_window_us(1.0..2.0).unwrap(),1_000_000..2_000_000);
+  assert_eq!(append_window_us(0.0..f64::INFINITY).unwrap(),0..i64::MAX);
+  for w in [-0.1e-6..1.0,0.0..f64::NAN,f64::NAN..1.0,1.0..0.0,0.1e-6..0.9e-6] {assert!(append_window_us(w).is_err());}
+ }
