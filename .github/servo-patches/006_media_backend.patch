index 0000000..7a717ac
--- /dev/null
+++ b/components/media/backends/android/buffer.rs
@@ -0,0 +1,395 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Progressive-download playback buffer (pure logic, host-testable).
+//!
+//! Ported from the OHOS backend's PlaybackBuffer
+//! (components/media/backends/ohos/ohos_media/source.rs) with one deliberate
+//! difference: instead of returning 0 bytes when data is not yet available
+//! (which AMediaExtractor does not tolerate well), readers block on a
+//! condition variable until data arrives, the stream ends, or the source is
+//! cancelled. Cancellation (player stop/shutdown) always unblocks readers.
+//!
+//! Three threads interact with the buffer:
+//! 1. The media element's fetch thread pushes downloaded bytes (push_data).
+//! 2. AMediaExtractor reader threads call readAt (read_at).
+//! 3. The pipeline thread cancels on shutdown (cancel).
+
+use std::sync::{Condvar, Mutex};
+use std::time::Duration;
+
+use log::debug;
+
+const DEFAULT_CACHE_SIZE: usize = 8 * 1024 * 1024; // 8MB
+/// Re-request data from the fetcher when fewer bytes than this remain buffered.
+const LOW_WATER_MARK: usize = DEFAULT_CACHE_SIZE / 4;
+/// Bytes kept before the current read position when sliding the window, to
+/// tolerate small backwards reads without a full refetch.
+const BACK_BUFFER: usize = 64 * 1024;
+
+/// A request the readAt callback must dispatch *after* releasing the buffer
+/// lock. The seek closure blocks on IPC with the script thread, so holding
+/// the buffer lock while calling it would deadlock against a concurrent
+/// push_data (which also acquires this lock).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Dispatch {
+    /// The extractor needs bytes from a position outside the buffered window;
+    /// the fetcher must restart its download at this byte offset.
+    Seek(u64),
+    /// The buffer ran below the low-water mark; ask the fetcher for more data.
+    NeedData,
+}
+
+struct BufferState {
+    buffer: Vec<u8>,
+    /// Byte offset in the media resource of buffer[0].
+    buffer_data_head: i64,
+    has_active_request: bool,
+    is_seeking: bool,
+    /// True once end_of_stream was signalled by the fetcher: no more data will
+    /// ever arrive.
+    is_eos: bool,
+    /// True once the source is torn down; readers must bail out immediately.
+    cancelled: bool,
+    /// Total resource size in bytes, 0 when not (yet) known.
+    total_size: i64,
+}
+
+pub struct SharedBuffer {
+    state: Mutex<BufferState>,
+    cond: Condvar,
+}
+
+impl Default for SharedBuffer {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl SharedBuffer {
+    pub fn new() -> Self {
+        SharedBuffer {
+            state: Mutex::new(BufferState {
+                buffer: Vec::with_capacity(DEFAULT_CACHE_SIZE),
+                buffer_data_head: 0,
+                has_active_request: false,
+                is_seeking: false,
+                is_eos: false,
+                cancelled: false,
+                total_size: 0,
+            }),
+            cond: Condvar::new(),
+        }
+    }
+
+    pub fn set_total_size(&self, size: i64) {
+        let mut st = self.state.lock().unwrap();
+        if st.total_size == 0 {
+            st.total_size = size;
+        }
+    }
+
+    pub fn total_size(&self) -> i64 {
+        self.state.lock().unwrap().total_size
+    }
+
+    pub fn notify_seek_done(&self) {
+        let mut st = self.state.lock().unwrap();
+        st.is_seeking = false;
+        self.cond.notify_all();
+    }
+
+    /// Append fetched bytes. Returns false when the buffer is full, in which
+    /// case the fetcher should stop until more data is requested (the caller
+    /// is expected to surface EnoughData to the media element).
+    pub fn push_data(&self, data: &[u8]) -> bool {
+        let mut st = self.state.lock().unwrap();
+        // Reject data while a seek is in progress. Between the buffer being
+        // cleared/reset for a new seek position and the old fetch being
+        // cancelled, stale data from the previous fetch could arrive and
+        // corrupt the buffer (it would be appended as if it started at the
+        // new seek position). Silently discard it.
+        if st.is_seeking {
+            return true;
+        }
+        if st.buffer.len() + data.len() > st.buffer.capacity() {
+            debug!(
+                "Playback buffer full: head {}, len {}, incoming {}",
+                st.buffer_data_head,
+                st.buffer.len(),
+                data.len()
+            );
+            st.has_active_request = false;
+            return false;
+        }
+        st.buffer.extend_from_slice(data);
+        self.cond.notify_all();
+        true
+    }
+
+    pub fn end_of_stream(&self) {
+        let mut st = self.state.lock().unwrap();
+        st.is_eos = true;
+        st.has_active_request = false;
+        self.cond.notify_all();
+    }
+
+    pub fn cancel(&self) {
+        let mut st = self.state.lock().unwrap();
+        st.cancelled = true;
+        self.cond.notify_all();
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.state.lock().unwrap().cancelled
+    }
+
+    /// Buffered window as (head, len) for buffered() reporting.
+    pub fn buffered_window(&self) -> (i64, i64) {
+        let st = self.state.lock().unwrap();
+        (st.buffer_data_head, st.buffer.len() as i64)
+    }
+
+    /// Serve a readAt request for `pos`. May block waiting for data.
+    ///
+    /// AMediaDataSource readAt contract: return the number of bytes read, 0
+    /// if `size` was 0, or -1 to indicate end of stream. We never return a
+    /// short read for "no data yet"; we wait instead.
+    pub fn read_at(&self, dest: &mut [u8], pos: i64) -> (isize, Option<Dispatch>) {
+        if dest.is_empty() {
+            return (0, None);
+        }
+        let mut st = self.state.lock().unwrap();
+        loop {
+            if st.cancelled {
+                return (-1, None);
+            }
+            if st.is_seeking {
+                // A byte-range refetch is being set up; wait for the first
+                // bytes from the new position (or cancellation).
+                st = self.cond.wait(st).unwrap();
+                continue;
+            }
+            let pos_offset = pos - st.buffer_data_head;
+            let available = st.buffer.len() as i64 - pos_offset;
+            if pos_offset < 0 {
+                // Reader moved backwards outside the buffered window.
+                st.buffer.clear();
+                st.buffer_data_head = pos.max(0);
+                st.has_active_request = true;
+                st.is_seeking = true;
+                return (0, Some(Dispatch::Seek(pos.max(0) as u64)));
+            }
+            if available > 0 {
+                let n = available.min(dest.len() as i64) as usize;
+                dest[..n].copy_from_slice(
+                    &st.buffer[pos_offset as usize..pos_offset as usize + n],
+                );
+                // Slide the window forward: drop consumed prefix bytes (keep
+                // a small back-buffer for the extractor's occasional small
+                // backwards peeks, e.g. box re-reads during init) so the 8MB
+                // window does not fill up and stall the download.
+                if pos_offset as usize > BACK_BUFFER {
+                    let drop = pos_offset as usize - BACK_BUFFER;
+                    st.buffer.drain(..drop);
+                    st.buffer_data_head += drop as i64;
+                }
+                let remaining =
+                    (st.buffer.len() as i64) - (pos + n as i64 - st.buffer_data_head);
+                let need_data = !st.is_eos &&
+                    !st.has_active_request &&
+                    remaining < LOW_WATER_MARK as i64;
+                if need_data {
+                    st.has_active_request = true;
+                }
+                let dispatch = if need_data {
+                    Some(Dispatch::NeedData)
+                } else {
+                    None
+                };
+                return (n as isize, dispatch);
+            }
+            if st.is_eos {
+                // True end of the resource.
+                return (-1, None);
+            }
+            if !st.has_active_request {
+                // No fetch in flight: restart the download at pos. (An active
+                // fetch streams forward from the current window end and will
+                // cover any later position, so we simply wait for it.)
+                debug!(
+                    "read_at: need refetch at {} (head {}, len {})",
+                    pos,
+                    st.buffer_data_head,
+                    st.buffer.len()
+                );
+                st.buffer.clear();
+                st.buffer_data_head = pos;
+                st.has_active_request = true;
+                st.is_seeking = true;
+                return (0, Some(Dispatch::Seek(pos as u64)));
+            }
+            // A fetch is in flight and will cover this position: wait.
+            st = self
+                .cond
+                .wait_timeout(st, Duration::from_secs(2))
+                .unwrap()
+                .0;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+
+    fn buf_with(size: usize) -> SharedBuffer {
+        let b = SharedBuffer::new();
+        b.set_total_size(size as i64);
+        b
+    }
+
+    #[test]
+    fn sequential_read_and_slide() {
+        let b = buf_with(1_000_000_000);
+        let chunk = vec![7u8; 3 * 1024 * 1024]; // 3MB: above the low-water mark
+        assert!(b.push_data(&chunk));
+        let mut dest = vec![0u8; 100_000];
+        let (n, d) = b.read_at(&mut dest, 0);
+        assert_eq!((n, d), (100_000, None));
+        assert!(dest.iter().all(|&x| x == 7));
+        // Beyond the back-buffer: window slides so head advances.
+        let (n, d) = b.read_at(&mut dest, 100_000);
+        assert_eq!((n, d), (100_000, None));
+        let (head, len) = b.buffered_window();
+        assert!(head > 0, "window should slide forward, head={head}");
+        assert!(len <= 3 * 1024 * 1024);
+    }
+
+    #[test]
+    fn read_past_available_waits_then_unblocks_on_push() {
+        let b = Arc::new(buf_with(64 * 1024 * 1024));
+        let big = vec![5u8; DEFAULT_CACHE_SIZE];
+        assert!(b.push_data(&big));
+        // Drain in 1MB chunks (the slide frees capacity as we go) until the
+        // low-water mark marks a fetch in flight.
+        let mut pos = 0i64;
+        let mut chunk = vec![0u8; 1024 * 1024];
+        loop {
+            let (n, d) = b.read_at(&mut chunk, pos);
+            pos += n as i64;
+            if d == Some(Dispatch::NeedData) {
+                break;
+            }
+            assert!(n > 0, "must not hit EOS/seek during drain");
+        }
+        // Finish draining what remains.
+        let mut remaining_buf = vec![0u8; DEFAULT_CACHE_SIZE];
+        let (n, _) = b.read_at(&mut remaining_buf[..(DEFAULT_CACHE_SIZE - pos as usize)], pos);
+        assert!(n > 0);
+        let end_pos = pos + n as i64;
+        let b2 = b.clone();
+        let reader = std::thread::spawn(move || {
+            let mut small = vec![0u8; 1024];
+            // Buffer empty, fetch in flight, no EOS: must block, not seek.
+            b2.read_at(&mut small, end_pos).0
+        });
+        std::thread::sleep(Duration::from_millis(100));
+        assert!(
+            !reader.is_finished(),
+            "reader must block while a fetch is in flight"
+        );
+        assert!(b.push_data(&vec![6u8; 4096]));
+        let n = reader.join().unwrap();
+        assert_eq!(n, 1024);
+    }
+
+    #[test]
+    fn read_before_head_requests_seek() {
+        let b = buf_with(1_000_000);
+        assert!(b.push_data(&vec![3u8; 300_000]));
+        // Read at 200_000: pos_offset exceeds BACK_BUFFER, so the window
+        // slides and head advances to 200_000 - BACK_BUFFER.
+        let mut dest = vec![0u8; 100_000];
+        let (n, _) = b.read_at(&mut dest, 200_000);
+        assert_eq!(n, 100_000);
+        let (head, _) = b.buffered_window();
+        assert_eq!(head, 200_000 - BACK_BUFFER as i64);
+        // Position 0 is now before the window: a byte-range refetch is needed.
+        let mut small = vec![0u8; 4096];
+        let (_, d) = b.read_at(&mut small, 0);
+        assert_eq!(d, Some(Dispatch::Seek(0)));
+    }
+
+    #[test]
+    fn full_buffer_rejects_push_and_eos_ends_reads() {
+        let b = buf_with(64 * 1024 * 1024);
+        let big = vec![9u8; DEFAULT_CACHE_SIZE];
+        assert!(b.push_data(&big));
+        assert!(!b.push_data(&[1u8; 1]), "full buffer must reject");
+        b.end_of_stream();
+        let mut dest = vec![0u8; 1024];
+        // Drain everything, then EOS must yield -1.
+        let mut pos = 0i64;
+        loop {
+            let (n, _) = b.read_at(&mut dest, pos);
+            if n <= 0 {
+                assert_eq!(n, -1);
+                break;
+            }
+            pos += n as i64;
+            assert!(pos <= DEFAULT_CACHE_SIZE as i64 + 1024);
+        }
+    }
+
+    #[test]
+    fn cancel_unblocks_blocked_reader() {
+        let b = Arc::new(buf_with(64 * 1024 * 1024));
+        assert!(b.push_data(&vec![5u8; DEFAULT_CACHE_SIZE]));
+        // Drain past the low-water mark so a fetch is in flight.
+        let mut chunk = vec![0u8; 1024 * 1024];
+        let mut pos = 0i64;
+        loop {
+            let (n, d) = b.read_at(&mut chunk, pos);
+            pos += n as i64;
+            if d == Some(Dispatch::NeedData) {
+                break;
+            }
+            assert!(n > 0);
+        }
+        let b2 = b.clone();
+        let reader = std::thread::spawn(move || {
+            let mut dest = vec![0u8; 1024];
+            // Read past the buffered end with a fetch in flight: blocks.
+            b2.read_at(&mut dest, DEFAULT_CACHE_SIZE as i64).0
+        });
+        std::thread::sleep(Duration::from_millis(100));
+        assert!(!reader.is_finished(), "reader must be blocked on the fetch");
+        b.cancel();
+        let n = reader.join().unwrap();
+        assert_eq!(n, -1, "cancelled read must bail out with -1");
+    }
+
+    #[test]
+    fn low_water_marks_need_data_once() {
+        let b = buf_with(64 * 1024 * 1024);
+        // Fill the buffer completely.
+        let big = vec![5u8; DEFAULT_CACHE_SIZE];
+        assert!(b.push_data(&big)); // has_active_request stays false, buffer full
+        // Read down past the low-water mark: first such read must dispatch
+        // NeedData exactly once, subsequent reads must not repeat it while a
+        // request is already active.
+        let mut dest = vec![0u8; DEFAULT_CACHE_SIZE - LOW_WATER_MARK - 1024];
+        let (n, d) = b.read_at(&mut dest, 0);
+        assert_eq!(n as usize, dest.len());
+        assert_eq!(d, None, "still above low-water right after read");
+        let mut small = vec![0u8; 2048];
+        let pos = dest.len() as i64;
+        let (_, d1) = b.read_at(&mut small, pos);
+        assert_eq!(d1, Some(Dispatch::NeedData));
+        let (_, d2) = b.read_at(&mut small, pos + 2048);
+        assert_eq!(d2, None, "no duplicate NeedData while request active");
+    }
+}
