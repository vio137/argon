@@ -0,0 +1,99 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Conservative canPlayType table (pure logic, host-testable).
+//!
+//! This backend never answers "probably": without querying the actual
+//! device's MediaCodecList we cannot claim a specific codec decodes on this
+//! device, so known container + known codec family tops out at Maybe, and
+//! anything unrecognized is No.
+
+/// Support estimate for a MIME type string. Mirrors
+/// servo_media::SupportsMediaType minus `Probably`, which this backend never
+/// returns (see module docs).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Support {
+    Maybe,
+    No,
+}
+
+const KNOWN_CONTAINERS: [&str; 10] = [
+    "video/mp4",
+    "application/mp4",
+    "audio/mp4",
+    "audio/x-m4a",
+    "audio/mpeg",
+    "audio/aac",
+    "video/webm",
+    "audio/webm",
+    "video/3gpp",
+    "audio/3gpp",
+];
+
+const KNOWN_CODECS: [&str; 13] = [
+    "avc1", "avc3", "hvc1", "hev1", "vp8", "vp08", "vp9", "vp09", "av01", "mp4a", "opus",
+    "vorbis", "mp3",
+];
+
+pub fn can_play_type(media_type: &str) -> Support {
+    let Ok(mime) = media_type.parse::<mime::Mime>() else {
+        return Support::No;
+    };
+    let mime_type = mime.type_().as_str().to_owned() + "/" + mime.subtype().as_str();
+    if !KNOWN_CONTAINERS.contains(&mime_type.as_str()) {
+        return Support::No;
+    }
+    match mime.get_param("codecs") {
+        None => Support::Maybe,
+        Some(codecs) => {
+            // The mime crate keeps surrounding quotes on quoted-string
+            // parameter values; strip them per codec token.
+            let all_known = codecs
+                .as_str()
+                .split(',')
+                .map(|c| c.trim().trim_matches('"'))
+                .all(|c| KNOWN_CODECS.iter().any(|k| c.starts_with(k)));
+            if all_known {
+                Support::Maybe
+            } else {
+                Support::No
+            }
+        },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn common_types_are_maybe() {
+        assert_eq!(can_play_type("video/mp4"), Support::Maybe);
+        assert_eq!(can_play_type("audio/mpeg"), Support::Maybe);
+        assert_eq!(
+            can_play_type("video/mp4; codecs=\"avc1.42E01E, mp4a.40.2\""),
+            Support::Maybe
+        );
+        assert_eq!(can_play_type("video/webm; codecs=\"vp9, opus\""), Support::Maybe);
+        assert_eq!(can_play_type("audio/mp4; codecs=\"mp4a.40.5\""), Support::Maybe);
+    }
+
+    #[test]
+    fn unknown_container_or_codec_is_no() {
+        assert_eq!(can_play_type("video/ogg"), Support::No);
+        assert_eq!(can_play_type("application/x-mpegURL"), Support::No);
+        assert_eq!(can_play_type("video/mp4; codecs=\"ac-3\""), Support::No);
+        assert_eq!(can_play_type("not a mime"), Support::No);
+        assert_eq!(can_play_type(""), Support::No);
+    }
+
+    #[test]
+    fn mixed_codec_list_is_no() {
+        // One unknown codec in the list must not get a free pass.
+        assert_eq!(
+            can_play_type("video/mp4; codecs=\"avc1.42E01E, ac-3\""),
+            Support::No
+        );
+    }
+}
