+
+//! Experimental Android media backend for Servo, implemented directly on the
+//! NDK media APIs (AMediaExtractor + AMediaCodec into an AImageReader surface
+//! + AAudio), fed by Servo's own progressive media fetch through an
+//! AMediaDataSource.
+//!
+//! This backend is compiled for Android builds but only selected at runtime
+//! when the `media_android_backend_enabled` pref is true; otherwise the dummy
+//! backend is used, exactly as before. Milestone-1 scope is progressive
+//! <video>/<audio> playback; MSE/EME/WebRTC/MediaStreams remain stubbed, and
+//! Android audio focus / route changes are not handled yet.
+
+// Pure logic, host-testable: hosttest/ #[path]-includes these exact files and
+// runs their unit tests on the host.
+mod buffer;
+mod mime_table;
+mod yuv_pack;
+
+#[cfg(target_os = "android")]
+mod android_impl;
+
+#[cfg(target_os = "android")]
+pub use android_impl::AndroidBackend;
diff --git a/components/media/backends/android/mime_table.rs b/components/media/backends/android/mime_table.rs
