diff --git a/components/media/backends/android/android_impl/mod.rs b/components/media/backends/android/android_impl/mod.rs
new file mode 100644
index 0000000..ed1f9fe
--- /dev/null
+++ b/components/media/backends/android/android_impl/mod.rs
@@ -0,0 +1,225 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+//! Android-only NDK parts of the backend (compiled only for Android targets).
+mod player;
+mod source;
+mod sys;
+
+use std::any::Any;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, Weak, mpsc};
+use std::thread;
+
+use log::warn;
+use servo_base::generic_channel::GenericCallback;
+use servo_media::{
+    Backend, BackendInit, BackendMsg, ClientContextId, MediaInstance, SupportsMediaType,
+};
+use servo_media_audio::context::AudioContextOptions;
+use servo_media_audio::sink::AudioSinkError;
+use servo_media_player::audio::AudioRenderer;
+use servo_media_player::context::PlayerGLContext;
+use servo_media_player::video::VideoFrameRenderer;
+use servo_media_player::{Player, PlayerEvent, StreamType};
+use servo_media_streams::capture::MediaTrackConstraintSet;
+use servo_media_streams::device_monitor::{MediaDeviceInfo, MediaDeviceMonitor};
+use servo_media_streams::registry::MediaStreamId;
+use servo_media_streams::{MediaOutput, MediaSocket, MediaStreamType};
+use servo_media_webrtc::{WebRtcController, WebRtcSignaller};
+
+use super::mime_table;
+use player::AndroidPlayer;
+
+type MediaInstanceMap = HashMap<usize, (ClientContextId, Weak<Mutex<AndroidPlayer>>)>;
+
+pub struct AndroidBackend {
+    instances: Arc<Mutex<MediaInstanceMap>>,
+    backend_chan: mpsc::Sender<BackendMsg>,
+    next_id: AtomicUsize,
+}
+
+impl BackendInit for AndroidBackend {
+    fn init() -> Box<dyn Backend> {
+        let instances: Arc<Mutex<MediaInstanceMap>> = Arc::new(Mutex::new(HashMap::new()));
+        let instances_ = instances.clone();
+        let (backend_chan, recvr) = mpsc::channel::<BackendMsg>();
+        thread::Builder::new()
+            .name("AndroidMediaBackend ShutdownThread".to_owned())
+            .spawn(move || {
+                while let Ok(msg) = recvr.recv() {
+                    match msg {
+                        BackendMsg::Shutdown {
+                            context: _,
+                            id,
+                            tx_ack,
+                        } => {
+                            instances_.lock().unwrap().remove(&id);
+                            let _ = tx_ack.send(());
+                        },
+                    }
+                }
+            })
+            .expect("couldn't spawn AndroidMediaBackend ShutdownThread");
+        Box::new(AndroidBackend {
+            instances,
+            backend_chan,
+            next_id: AtomicUsize::new(1),
+        })
+    }
+}
+
+impl AndroidBackend {
+    fn media_instance_action(&self, id: &ClientContextId, cb: &dyn Fn(&dyn MediaInstance)) {
+        let instances = self.instances.lock().unwrap();
+        for (context, instance) in instances.values() {
+            if context != id {
+                continue;
+            }
+            if let Some(instance) = instance.upgrade() {
+                cb(&*instance.lock().unwrap());
+            }
+        }
+    }
+}
+
+impl Backend for AndroidBackend {
+    fn create_player(
+        &self,
+        context_id: &ClientContextId,
+        stream_type: StreamType,
+        sender: GenericCallback<PlayerEvent>,
+        video_renderer: Option<Arc<Mutex<dyn VideoFrameRenderer>>>,
+        _audio_renderer: Option<Arc<Mutex<dyn AudioRenderer>>>,
+        _gl_context: Box<dyn PlayerGLContext>,
+    ) -> Arc<Mutex<dyn Player>> {
+        // Audio is self-rendered through AAudio (same model as the OHOS
+        // backend), so the audio_renderer is intentionally unused.
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        let player = AndroidPlayer::new(
+            id,
+            *context_id,
+            stream_type,
+            sender,
+            video_renderer,
+            self.backend_chan.clone(),
+        );
+        self.instances
+            .lock()
+            .unwrap()
+            .insert(id, (*context_id, Arc::downgrade(&player)));
+        player
+    }
+
+    fn create_audiostream(&self) -> MediaStreamId {
+        warn!("AndroidBackend: create_audiostream not supported");
+        MediaStreamId::new()
+    }
+
+    fn create_videostream(&self) -> MediaStreamId {
+        warn!("AndroidBackend: create_videostream not supported");
+        MediaStreamId::new()
+    }
+
+    fn create_stream_output(&self) -> Box<dyn MediaOutput> {
+        warn!("AndroidBackend: create_stream_output not supported");
+        Box::new(AndroidMediaOutput)
+    }
+
+    fn create_stream_and_socket(
+        &self,
+        _ty: MediaStreamType,
+    ) -> (Box<dyn MediaSocket>, MediaStreamId) {
+        warn!("AndroidBackend: create_stream_and_socket not supported");
+        (Box::new(AndroidMediaSocket), MediaStreamId::new())
+    }
+
+    fn create_audioinput_stream(
+        &self,
+        _set: MediaTrackConstraintSet,
+    ) -> Option<MediaStreamId> {
+        warn!("AndroidBackend: create_audioinput_stream not supported");
+        None
+    }
+
+    fn create_videoinput_stream(
+        &self,
+        _set: MediaTrackConstraintSet,
+    ) -> Option<MediaStreamId> {
+        warn!("AndroidBackend: create_videoinput_stream not supported");
+        None
+    }
+
+    fn create_audio_context(
+        &self,
+        _id: &ClientContextId,
+        _options: AudioContextOptions,
+    ) -> Result<Arc<Mutex<servo_media_audio::context::AudioContext>>, AudioSinkError> {
+        warn!("AndroidBackend: create_audio_context not supported");
+        Err(AudioSinkError::Backend(
+            "AudioContext not supported by the experimental Android backend".to_owned(),
+        ))
+    }
+
+    fn create_webrtc(&self, _signaller: Box<dyn WebRtcSignaller>) -> WebRtcController {
+        todo!()
+    }
+
+    fn can_play_type(&self, media_type: &str) -> SupportsMediaType {
+        // Conservative by construction: this backend never answers
+        // Probably without per-device codec capability evidence.
+        match mime_table::can_play_type(media_type) {
+            mime_table::Support::Maybe => SupportsMediaType::Maybe,
+            mime_table::Support::No => SupportsMediaType::No,
+        }
+    }
+
+    fn mute(&self, id: &ClientContextId, val: bool) {
+        self.media_instance_action(id, &move |instance: &dyn MediaInstance| {
+            let _ = instance.mute(val);
+        });
+    }
+
+    fn resume(&self, id: &ClientContextId) {
+        self.media_instance_action(id, &move |instance: &dyn MediaInstance| {
+            let _ = instance.resume();
+        });
+    }
+
+    fn suspend(&self, id: &ClientContextId) {
+        self.media_instance_action(id, &move |instance: &dyn MediaInstance| {
+            let _ = instance.suspend();
+        });
+    }
+
+    fn get_device_monitor(&self) -> Box<dyn MediaDeviceMonitor> {
+        warn!("AndroidBackend: get_device_monitor not supported");
+        Box::new(AndroidDeviceMonitor)
+    }
+}
+
+struct AndroidMediaOutput;
+
+impl MediaOutput for AndroidMediaOutput {
+    fn add_stream(&mut self, _stream: &MediaStreamId) {
+        warn!("AndroidBackend: add_stream not supported");
+    }
+}
+
+struct AndroidMediaSocket;
+
+impl MediaSocket for AndroidMediaSocket {
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+struct AndroidDeviceMonitor;
+
+impl MediaDeviceMonitor for AndroidDeviceMonitor {
+    fn enumerate_devices(&self) -> Option<Vec<MediaDeviceInfo>> {
+        Some(vec![])
+    }
+}
diff --git a/components/media/backends/android/android_impl/player.rs b/components/media/backends/android/android_impl/player.rs
new file mode 100644
index 0000000..83d19f3
--- /dev/null
+++ b/components/media/backends/android/android_impl/player.rs
@@ -0,0 +1,1367 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Media player implementation on top of AMediaExtractor + AMediaCodec
+//! (byte-buffer mode) + AAudio, fed by the progressive-download buffer in
+//! `source.rs`.
+//!
+//! Milestone-1 scope (experimental, behind the media_android_backend_enabled
+//! pref):
+//! - Progressive <video>/<audio>: demux via AMediaExtractor, hardware or
+//!   software decode via AMediaCodec byte buffers, video converted to BGRA
+//!   (yuv crate) and handed to the VideoFrameRenderer, audio self-rendered
+//!   through an AAudio output stream.
+//! - Seek: extractor seekTo + codec flush; missing byte ranges are refetched
+//!   via the SeekData back-channel.
+//!
+//! Deliberate limitations of this milestone:
+//! - Playback rates other than 1.0 are rejected with an error.
+//! - Android audio focus and audio-route changes are NOT handled: playback
+//!   does not duck or pause for other apps, calls or output switches.
+//! - MSE/EME/WebRTC/MediaStreams are out of scope (dummy/stubbed).
+//! - Video frames reach the CPU through an AImageReader surface in
+//!   YUV_420_888 and are read with explicit plane row/pixel strides (the
+//!   only correct way to read that flexible format).
+
+use std::ops::Range;
+use std::sync::{Arc, Condvar, Mutex, mpsc};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+use crossbeam_channel::{Receiver as CbReceiver, Sender as CbSender};
+use log::{debug, error, warn};
+use servo_base::generic_channel::{GenericCallback, channel};
+use servo_media::{BackendMsg, ClientContextId, MediaInstance, MediaInstanceError};
+use servo_media_player::metadata::Metadata;
+use servo_media_player::video::{Buffer as FrameBuffer, VideoFrame, VideoFrameData, VideoFrameRenderer};
+use servo_media_player::{
+    PlaybackState, Player, PlayerError, PlayerEvent, SeekLock, SeekLockMsg, StreamType,
+};
+use yuv::{YuvPlanarImage, YuvRange, YuvStandardMatrix, yuv420_to_bgra};
+
+use crate::buffer::SharedBuffer;
+use super::source::MediaSourceWrapper;
+use super::sys;
+use crate::yuv_pack::{Planes, pack_i420};
+
+/// Upper bound for one compressed sample staged between the extractor and a
+/// codec input buffer. Samples larger than this are logged and dropped.
+const MAX_SAMPLE_SIZE: usize = 8 * 1024 * 1024;
+/// How long one AAudioStream_write call may block.
+const AUDIO_WRITE_TIMEOUT_NS: i64 = 100_000_000;
+/// Cap the AAudio buffer so the audio write-ahead (and with it the audio
+/// clock's lead over audible output) stays small.
+const AUDIO_BUFFER_CAPACITY_MS: i32 = 100;
+/// Video frames more than this late are dropped instead of rendered.
+const FRAME_DROP_LATE_US: i64 = 250_000;
+/// Video frames this close to their presentation time are rendered.
+const FRAME_EARLY_TOLERANCE_US: i64 = 15_000;
+/// Interval between PositionChanged events while playing.
+const POSITION_EVENT_INTERVAL: Duration = Duration::from_millis(250);
+
+enum PipelineCmd {
+    Play,
+    Pause,
+    Seek(f64),
+    Shutdown,
+}
+
+#[derive(Clone, Copy)]
+struct SharedState {
+    paused: bool,
+    muted: bool,
+    volume: f64,
+    rate: f64,
+    shutdown: bool,
+    seekable: bool,
+    duration_us: i64,
+}
+
+struct Shared {
+    state: Mutex<SharedState>,
+    /// Wakes the pipeline thread out of its paused wait.
+    cond: Condvar,
+}
+
+impl Shared {
+    fn get(&self) -> SharedState {
+        *self.state.lock().unwrap()
+    }
+    fn update<F: FnOnce(&mut SharedState)>(&self, f: F) {
+        let mut st = self.state.lock().unwrap();
+        f(&mut st);
+        self.cond.notify_all();
+    }
+}
+
+fn send_event(sender: &Arc<Mutex<GenericCallback<PlayerEvent>>>, event: PlayerEvent) {
+    let _ = sender.lock().unwrap().send(event);
+}
+
+pub struct AndroidPlayer {
+    id: usize,
+    context_id: ClientContextId,
+    sender: Arc<Mutex<GenericCallback<PlayerEvent>>>,
+    buffer: Arc<SharedBuffer>,
+    shared: Arc<Shared>,
+    cmd_tx: CbSender<PipelineCmd>,
+    pipeline: Mutex<Option<JoinHandle<()>>>,
+    backend_chan: mpsc::Sender<BackendMsg>,
+}
+
+impl AndroidPlayer {
+    pub fn new(
+        id: usize,
+        context_id: ClientContextId,
+        stream_type: StreamType,
+        sender: GenericCallback<PlayerEvent>,
+        video_renderer: Option<Arc<Mutex<dyn VideoFrameRenderer>>>,
+        backend_chan: mpsc::Sender<BackendMsg>,
+    ) -> Arc<Mutex<Self>> {
+        let sender = Arc::new(Mutex::new(sender));
+        let buffer = Arc::new(SharedBuffer::new());
+        let shared = Arc::new(Shared {
+            state: Mutex::new(SharedState {
+                paused: true,
+                muted: false,
+                volume: 1.0,
+                rate: 1.0,
+                shutdown: false,
+                seekable: stream_type == StreamType::Seekable,
+                duration_us: 0,
+            }),
+            cond: Condvar::new(),
+        });
+        let (cmd_tx, cmd_rx) = crossbeam_channel::unbounded();
+
+        let pipeline_buffer = buffer.clone();
+        let pipeline_shared = shared.clone();
+        let pipeline_sender = sender.clone();
+        let handle = std::thread::Builder::new()
+            .name(format!("android-media-player-{id}"))
+            .spawn(move || {
+                pipeline_main(
+                    pipeline_buffer,
+                    pipeline_shared,
+                    cmd_rx,
+                    pipeline_sender,
+                    video_renderer,
+                    stream_type,
+                );
+            })
+            .expect("failed to spawn android media pipeline thread");
+
+        let player = AndroidPlayer {
+            id,
+            context_id,
+            sender,
+            buffer,
+            shared,
+            cmd_tx,
+            pipeline: Mutex::new(Some(handle)),
+            backend_chan,
+        };
+        // Kickstart the download: the media element starts fetching when it
+        // receives NeedData.
+        send_event(&player.sender, PlayerEvent::NeedData);
+        Arc::new(Mutex::new(player))
+    }
+
+    fn shutdown(&self) {
+        let already = {
+            let mut st = self.shared.state.lock().unwrap();
+            let done = st.shutdown;
+            st.shutdown = true;
+            st.paused = false;
+            done
+        };
+        if already {
+            return;
+        }
+        self.shared.cond.notify_all();
+        self.buffer.cancel();
+        let _ = self.cmd_tx.send(PipelineCmd::Shutdown);
+        if let Some(handle) = self.pipeline.lock().unwrap().take() {
+            let _ = handle.join();
+        }
+        let (tx_ack, rx_ack) = mpsc::channel();
+        let _ = self.backend_chan.send(BackendMsg::Shutdown {
+            context: self.context_id,
+            id: self.id,
+            tx_ack,
+        });
+        let _ = rx_ack.recv();
+    }
+}
+
+impl Drop for AndroidPlayer {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+impl MediaInstance for AndroidPlayer {
+    fn get_id(&self) -> usize {
+        self.id
+    }
+    fn mute(&self, val: bool) -> Result<(), MediaInstanceError> {
+        self.set_mute(val).map_err(|_| MediaInstanceError)
+    }
+    fn suspend(&self) -> Result<(), MediaInstanceError> {
+        self.pause().map_err(|_| MediaInstanceError)
+    }
+    fn resume(&self) -> Result<(), MediaInstanceError> {
+        self.play().map_err(|_| MediaInstanceError)
+    }
+}
+
+impl Player for AndroidPlayer {
+    fn play(&self) -> Result<(), PlayerError> {
+        self.shared.update(|st| st.paused = false);
+        let _ = self.cmd_tx.send(PipelineCmd::Play);
+        Ok(())
+    }
+
+    fn pause(&self) -> Result<(), PlayerError> {
+        self.shared.update(|st| st.paused = true);
+        let _ = self.cmd_tx.send(PipelineCmd::Pause);
+        Ok(())
+    }
+
+    fn paused(&self) -> bool {
+        self.shared.get().paused
+    }
+
+    fn can_resume(&self) -> bool {
+        !self.shared.get().shutdown
+    }
+
+    fn stop(&self) -> Result<(), PlayerError> {
+        self.shutdown();
+        Ok(())
+    }
+
+    fn seek(&self, time: f64) -> Result<(), PlayerError> {
+        let st = self.shared.get();
+        if !st.seekable {
+            return Err(PlayerError::NonSeekableStream);
+        }
+        if st.duration_us > 0 && (time < 0.0 || time > st.duration_us as f64 / 1e6) {
+            return Err(PlayerError::SeekOutOfRange);
+        }
+        let _ = self.cmd_tx.send(PipelineCmd::Seek(time.max(0.0)));
+        Ok(())
+    }
+
+    fn seekable(&self) -> Vec<Range<f64>> {
+        let st = self.shared.get();
+        if st.seekable && st.duration_us > 0 {
+            vec![0.0..st.duration_us as f64 / 1e6]
+        } else {
+            vec![]
+        }
+    }
+
+    fn set_mute(&self, muted: bool) -> Result<(), PlayerError> {
+        self.shared.update(|st| st.muted = muted);
+        Ok(())
+    }
+
+    fn muted(&self) -> bool {
+        self.shared.get().muted
+    }
+
+    fn set_volume(&self, volume: f64) -> Result<(), PlayerError> {
+        self.shared.update(|st| st.volume = volume.clamp(0.0, 1.0));
+        Ok(())
+    }
+
+    fn volume(&self) -> f64 {
+        self.shared.get().volume
+    }
+
+    fn set_input_size(&self, size: u64) -> Result<(), PlayerError> {
+        self.buffer.set_total_size(size as i64);
+        // A (re)fetch starting unblocks readers waiting on a byte-range seek.
+        self.buffer.notify_seek_done();
+        Ok(())
+    }
+
+    fn set_seekable(&self, seekable: bool) -> Result<(), PlayerError> {
+        self.shared.update(|st| st.seekable = seekable);
+        Ok(())
+    }
+
+    fn set_download_buffering_enabled(&self, _enabled: bool) -> Result<(), PlayerError> {
+        Ok(())
+    }
+
+    fn set_playback_rate(&self, playback_rate: f64) -> Result<(), PlayerError> {
+        if (playback_rate - 1.0).abs() > f64::EPSILON {
+            return Err(PlayerError::Backend(format!(
+                "playback rates other than 1.0 are not supported by this backend (got {playback_rate})"
+            )));
+        }
+        self.shared.update(|st| st.rate = 1.0);
+        Ok(())
+    }
+
+    fn playback_rate(&self) -> f64 {
+        self.shared.get().rate
+    }
+
+    fn push_data(&self, data: Vec<u8>) -> Result<(), PlayerError> {
+        if self.buffer.push_data(&data) {
+            Ok(())
+        } else {
+            send_event(&self.sender, PlayerEvent::EnoughData);
+            Err(PlayerError::EnoughData)
+        }
+    }
+
+    fn end_of_stream(&self) -> Result<(), PlayerError> {
+        self.buffer.end_of_stream();
+        Ok(())
+    }
+
+    fn buffered(&self) -> Vec<Range<f64>> {
+        let st = self.shared.get();
+        let total = self.buffer.total_size();
+        if st.duration_us <= 0 || total <= 0 {
+            return vec![];
+        }
+        let (head, len) = self.buffer.buffered_window();
+        let end_byte = head + len;
+        let duration = st.duration_us as f64 / 1e6;
+        let end = (end_byte as f64 / total as f64 * duration).min(duration);
+        let start = (head as f64 / total as f64 * duration).min(end);
+        vec![start..end]
+    }
+
+    fn set_stream(
+        &self,
+        _stream: &servo_media_streams::MediaStreamId,
+        _only_stream: bool,
+    ) -> Result<(), PlayerError> {
+        Err(PlayerError::SetStreamFailed)
+    }
+
+    fn render_use_gl(&self) -> bool {
+        false
+    }
+
+    fn set_audio_track(&self, _stream_index: i32, _enabled: bool) -> Result<(), PlayerError> {
+        Err(PlayerError::SetTrackFailed)
+    }
+
+    fn set_video_track(&self, _stream_index: i32, _enabled: bool) -> Result<(), PlayerError> {
+        Err(PlayerError::SetTrackFailed)
+    }
+}
+
+/// Master playback clock. Audio-driven when an audio track is being written
+/// to AAudio; wall-clock otherwise.
+struct MasterClock {
+    anchor_pts_us: i64,
+    has_audio: bool,
+    audio_frames_written: u64,
+    audio_sample_rate: i64,
+    wall_started: Option<Instant>,
+    wall_accumulated: Duration,
+}
+
+impl MasterClock {
+    fn new() -> Self {
+        MasterClock {
+            anchor_pts_us: 0,
+            has_audio: false,
+            audio_frames_written: 0,
+            audio_sample_rate: 0,
+            wall_started: None,
+            wall_accumulated: Duration::ZERO,
+        }
+    }
+
+    fn rebase(&mut self, anchor_pts_us: i64) {
+        self.anchor_pts_us = anchor_pts_us;
+        self.audio_frames_written = 0;
+        self.wall_started = Some(Instant::now());
+        self.wall_accumulated = Duration::ZERO;
+    }
+
+    fn pause(&mut self) {
+        if let Some(started) = self.wall_started.take() {
+            self.wall_accumulated += started.elapsed();
+        }
+    }
+
+    fn resume(&mut self) {
+        if self.wall_started.is_none() {
+            self.wall_started = Some(Instant::now());
+        }
+    }
+
+    fn now_us(&self) -> i64 {
+        if self.has_audio && self.audio_sample_rate > 0 {
+            self.anchor_pts_us +
+                (self.audio_frames_written as i64) * 1_000_000 / self.audio_sample_rate
+        } else {
+            let running = self
+                .wall_started
+                .map(|s| s.elapsed())
+                .unwrap_or(Duration::ZERO);
+            self.anchor_pts_us + (self.wall_accumulated + running).as_micros() as i64
+        }
+    }
+}
+
+struct TrackDecoder {
+    codec: *mut sys::AMediaCodec,
+    track_index: usize,
+    is_video: bool,
+    /// Video only: the decoder renders into this reader's surface; frames are
+    /// read back as AImage with explicit plane strides. Null for audio.
+    image_reader: *mut sys::AImageReader,
+    sample_rate: i32,
+    channels: i32,
+    input_eos_queued: bool,
+    drained: bool,
+    held_frame: Option<(usize, i64)>,
+}
+
+unsafe impl Send for TrackDecoder {}
+
+struct RawFrameBuffer(Vec<u8>);
+
+impl FrameBuffer for RawFrameBuffer {
+    fn to_vec(&self) -> Option<VideoFrameData> {
+        Some(VideoFrameData::Raw(Arc::new(self.0.clone())))
+    }
+}
+
+fn get_format_i32(format: *mut sys::AMediaFormat, name: &std::ffi::CStr) -> Option<i32> {
+    let mut out: i32 = 0;
+    if unsafe { sys::AMediaFormat_getInt32(format, name.as_ptr(), &mut out) } {
+        Some(out)
+    } else {
+        None
+    }
+}
+
+fn get_format_i64(format: *mut sys::AMediaFormat, name: &std::ffi::CStr) -> Option<i64> {
+    let mut out: i64 = 0;
+    if unsafe { sys::AMediaFormat_getInt64(format, name.as_ptr(), &mut out) } {
+        Some(out)
+    } else {
+        None
+    }
+}
+
+fn pipeline_main(
+    buffer: Arc<SharedBuffer>,
+    shared: Arc<Shared>,
+    cmd_rx: CbReceiver<PipelineCmd>,
+    sender: Arc<Mutex<GenericCallback<PlayerEvent>>>,
+    video_renderer: Option<Arc<Mutex<dyn VideoFrameRenderer>>>,
+    stream_type: StreamType,
+) {
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let mut pipeline = Pipeline::new(buffer, shared, cmd_rx, sender.clone(), video_renderer);
+        if let Err(err) = pipeline.setup(stream_type) {
+            error!("android media pipeline setup failed: {err}");
+            send_event(&sender, PlayerEvent::Error(err));
+            send_event(&sender, PlayerEvent::StateChanged(PlaybackState::Stopped));
+            return;
+        }
+        pipeline.run();
+    }));
+    if let Err(panic) = result {
+        error!("android media pipeline panicked: {panic:?}");
+        send_event(
+            &sender,
+            PlayerEvent::Error("android media pipeline panicked".to_owned()),
+        );
+        send_event(&sender, PlayerEvent::StateChanged(PlaybackState::Stopped));
+    }
+    debug!("android media pipeline exiting");
+}
+
+struct Pipeline {
+    buffer: Arc<SharedBuffer>,
+    shared: Arc<Shared>,
+    cmd_rx: CbReceiver<PipelineCmd>,
+    sender: Arc<Mutex<GenericCallback<PlayerEvent>>>,
+    video_renderer: Option<Arc<Mutex<dyn VideoFrameRenderer>>>,
+    source: Option<MediaSourceWrapper>,
+    extractor: *mut sys::AMediaExtractor,
+    video: Option<TrackDecoder>,
+    audio: Option<TrackDecoder>,
+    aaudio: *mut sys::AAudioStream,
+    clock: MasterClock,
+    staging: Vec<u8>,
+    pending_sample: Option<(usize, usize, i64)>, // (track_index, len, pts); bytes in staging
+    extractor_eos: bool,
+    last_position_event: Instant,
+}
+
+impl Pipeline {
+    fn new(
+        buffer: Arc<SharedBuffer>,
+        shared: Arc<Shared>,
+        cmd_rx: CbReceiver<PipelineCmd>,
+        sender: Arc<Mutex<GenericCallback<PlayerEvent>>>,
+        video_renderer: Option<Arc<Mutex<dyn VideoFrameRenderer>>>,
+    ) -> Self {
+        Pipeline {
+            buffer,
+            shared,
+            cmd_rx,
+            sender,
+            video_renderer,
+            source: None,
+            extractor: std::ptr::null_mut(),
+            video: None,
+            audio: None,
+            aaudio: std::ptr::null_mut(),
+            clock: MasterClock::new(),
+            staging: vec![0u8; MAX_SAMPLE_SIZE],
+            pending_sample: None,
+            extractor_eos: false,
+            last_position_event: Instant::now(),
+        }
+    }
+
+    fn setup(&mut self, stream_type: StreamType) -> Result<(), String> {
+        let sender = self.sender.clone();
+        let buffer_for_seek = self.buffer.clone();
+        let seek_data = Box::new(move |offset: u64| {
+            let (seek_sender, seek_receiver) =
+                channel::<SeekLockMsg>().expect("couldn't create IPC channel for seek");
+            let seek_lock = SeekLock {
+                lock_channel: seek_sender,
+            };
+            let _ = sender
+                .lock()
+                .unwrap()
+                .send(PlayerEvent::SeekData(offset, seek_lock));
+            // Wait until the media element has started the new fetch; the
+            // SeekLock's unlock blocks until this ack is sent back.
+            if let Ok((_, ack)) = seek_receiver.recv() {
+                let _ = ack.send(());
+            }
+            buffer_for_seek.notify_seek_done();
+            let _ = sender.lock().unwrap().send(PlayerEvent::NeedData);
+        });
+        let sender = self.sender.clone();
+        let need_data = Box::new(move || {
+            let _ = sender.lock().unwrap().send(PlayerEvent::NeedData);
+        });
+        let mut source = MediaSourceWrapper::new(seek_data, need_data)
+            .ok_or_else(|| "AMediaDataSource_new failed".to_owned())?;
+
+        let extractor = unsafe {
+            let ex = sys::AMediaExtractor_new();
+            if ex.is_null() {
+                source.destroy();
+                return Err("AMediaExtractor_new failed".to_owned());
+            }
+            if sys::AMediaExtractor_setDataSourceCustom(ex, source.source) != sys::AMEDIA_OK {
+                sys::AMediaExtractor_delete(ex);
+                source.destroy();
+                return Err("AMediaExtractor_setDataSourceCustom failed".to_owned());
+            }
+            ex
+        };
+        self.extractor = extractor;
+        self.source = Some(source);
+
+        // Scanning tracks triggers the first readAt calls; they block until
+        // the media element pushes the first bytes.
+        let track_count = unsafe { sys::AMediaExtractor_getTrackCount(extractor) };
+        let mut video_track: Option<(usize, String, i32, i32)> = None;
+        let mut audio_track: Option<(usize, String)> = None;
+        let mut duration_us: i64 = 0;
+        for idx in 0..track_count {
+            let format = unsafe { sys::AMediaExtractor_getTrackFormat(extractor, idx) };
+            if format.is_null() {
+                continue;
+            }
+            let mime = unsafe {
+                let mut ptr = std::ptr::null();
+                if sys::AMediaFormat_getString(format, c"mime".as_ptr(), &mut ptr) && !ptr.is_null()
+                {
+                    Some(
+                        std::ffi::CStr::from_ptr(ptr)
+                            .to_string_lossy()
+                            .into_owned(),
+                    )
+                } else {
+                    None
+                }
+            };
+            if let Some(d) = get_format_i64(format, c"durationUs") {
+                duration_us = duration_us.max(d);
+            }
+            let (select, is_video) = match &mime {
+                Some(m) if m.starts_with("video/") && video_track.is_none() => {
+                    let w = get_format_i32(format, c"width").unwrap_or(0);
+                    let h = get_format_i32(format, c"height").unwrap_or(0);
+                    video_track = Some((idx, m.clone(), w, h));
+                    (true, true)
+                },
+                Some(m) if m.starts_with("audio/") && audio_track.is_none() => {
+                    audio_track = Some((idx, m.clone()));
+                    (true, false)
+                },
+                _ => (false, false),
+            };
+            if select {
+                unsafe { sys::AMediaExtractor_selectTrack(extractor, idx) };
+            }
+            unsafe { sys::AMediaFormat_delete(format) };
+            let _ = is_video;
+        }
+        if video_track.is_none() && audio_track.is_none() {
+            return Err("no playable audio or video track found".to_owned());
+        }
+
+        warn!(
+            "android media backend: audio focus, audio route changes and playback rates other than 1.0 are not handled in this milestone"
+        );
+
+        // Create and start decoders. The track's own AMediaFormat carries the
+        // codec-specific data (csd-*) so configure gets everything it needs.
+        if let Some((idx, mime, w, h)) = &video_track {
+            let decoder = self.create_decoder(*idx, mime, true, *w, *h)?;
+            self.video = Some(decoder);
+        }
+        if let Some((idx, mime)) = &audio_track {
+            let decoder = self.create_decoder(*idx, mime, false, 0, 0)?;
+            self.audio = Some(decoder);
+        }
+
+        let (width, height, video_mime) = video_track
+            .map(|(_, m, w, h)| (w as u32, h as u32, m))
+            .unwrap_or((0, 0, String::new()));
+        let metadata = Metadata {
+            duration: if duration_us > 0 {
+                Some(Duration::from_micros(duration_us as u64))
+            } else {
+                None
+            },
+            width,
+            height,
+            format: video_mime.clone(),
+            is_seekable: stream_type == StreamType::Seekable,
+            is_live: duration_us <= 0,
+            video_tracks: if width > 0 { vec![video_mime] } else { vec![] },
+            audio_tracks: audio_track.map(|(_, m)| m).into_iter().collect(),
+            title: None,
+        };
+        self.shared.update(|st| {
+            st.duration_us = duration_us;
+            st.seekable = stream_type == StreamType::Seekable && duration_us > 0;
+        });
+        send_event(&self.sender, PlayerEvent::MetadataUpdated(metadata));
+        send_event(
+            &self.sender,
+            PlayerEvent::DurationChanged(if duration_us > 0 {
+                Some(Duration::from_micros(duration_us as u64))
+            } else {
+                None
+            }),
+        );
+        send_event(&self.sender, PlayerEvent::StateChanged(PlaybackState::Buffering));
+        Ok(())
+    }
+
+    fn create_decoder(
+        &self,
+        track_index: usize,
+        mime: &str,
+        is_video: bool,
+        width: i32,
+        height: i32,
+    ) -> Result<TrackDecoder, String> {
+        let mime_c = std::ffi::CString::new(mime).map_err(|_| "bad mime".to_owned())?;
+        let format = unsafe { sys::AMediaExtractor_getTrackFormat(self.extractor, track_index) };
+        if format.is_null() {
+            return Err(format!("no track format for {mime}"));
+        }
+        // Video decoders render into an AImageReader surface so decoded
+        // frames come back as AImage with explicit plane strides. The reader
+        // is created slightly larger than the track size; the decoder scales
+        // into it and the AImage carries the real dimensions.
+        let mut image_reader: *mut sys::AImageReader = std::ptr::null_mut();
+        let mut window: *mut sys::ANativeWindow = std::ptr::null_mut();
+        if is_video {
+            let ok = unsafe {
+                sys::AImageReader_new(
+                    width.max(16),
+                    height.max(16),
+                    sys::AIMAGE_FORMAT_YUV_420_888,
+                    4,
+                    &mut image_reader,
+                ) == sys::AMEDIA_OK &&
+                    !image_reader.is_null() &&
+                    sys::AImageReader_getWindow(image_reader, &mut window) == sys::AMEDIA_OK &&
+                    !window.is_null()
+            };
+            if !ok {
+                if !image_reader.is_null() {
+                    unsafe { sys::AImageReader_delete(image_reader) };
+                }
+                unsafe { sys::AMediaFormat_delete(format) };
+                return Err(format!("AImageReader setup failed for {mime}"));
+            }
+        }
+        let codec = unsafe {
+            let codec = sys::AMediaCodec_createDecoderByType(mime_c.as_ptr());
+            if codec.is_null() {
+                if !image_reader.is_null() {
+                    sys::AImageReader_delete(image_reader);
+                }
+                sys::AMediaFormat_delete(format);
+                return Err(format!("no decoder available for {mime}"));
+            }
+            let status = sys::AMediaCodec_configure(
+                codec,
+                format,
+                window as *mut std::ffi::c_void,
+                std::ptr::null_mut(),
+                0,
+            );
+            if status != sys::AMEDIA_OK {
+                if !image_reader.is_null() {
+                    sys::AImageReader_delete(image_reader);
+                }
+                sys::AMediaCodec_delete(codec);
+                sys::AMediaFormat_delete(format);
+                return Err(format!("decoder configure failed for {mime}: {status}"));
+            }
+            if sys::AMediaCodec_start(codec) != sys::AMEDIA_OK {
+                if !image_reader.is_null() {
+                    sys::AImageReader_delete(image_reader);
+                }
+                sys::AMediaCodec_delete(codec);
+                sys::AMediaFormat_delete(format);
+                return Err(format!("decoder start failed for {mime}"));
+            }
+            codec
+        };
+        let decoder = TrackDecoder {
+            codec,
+            track_index,
+            is_video,
+            image_reader,
+            sample_rate: if is_video {
+                0
+            } else {
+                get_format_i32(format, c"sample-rate").unwrap_or(0)
+            },
+            channels: if is_video {
+                0
+            } else {
+                get_format_i32(format, c"channel-count").unwrap_or(0)
+            },
+            input_eos_queued: false,
+            drained: false,
+            held_frame: None,
+        };
+        unsafe { sys::AMediaFormat_delete(format) };
+        Ok(decoder)
+    }
+
+    fn run(&mut self) {
+        loop {
+            // Drain commands.
+            while let Ok(cmd) = self.cmd_rx.try_recv() {
+                if !self.handle_cmd(cmd) {
+                    return; // Shutdown
+                }
+            }
+            if self.shared.get().paused {
+                // Blocked wait on the shared condvar for resume/shutdown; the
+                // shared state update signals it. Also poll the command
+                // channel so seek-while-paused works.
+                let (lock, timeout) = self
+                    .shared
+                    .cond
+                    .wait_timeout(
+                        self.shared.state.lock().unwrap(),
+                        Duration::from_millis(100),
+                    )
+                    .unwrap();
+                drop(lock);
+                let _ = timeout;
+                continue;
+            }
+
+            let mut did_work = false;
+            did_work |= self.feed_inputs();
+            did_work |= self.pump_video();
+            did_work |= self.pump_audio();
+            if !did_work {
+                std::thread::sleep(Duration::from_millis(4));
+            }
+
+            if self.last_position_event.elapsed() >= POSITION_EVENT_INTERVAL {
+                self.last_position_event = Instant::now();
+                send_event(
+                    &self.sender,
+                    PlayerEvent::PositionChanged(self.clock.now_us() as f64 / 1e6),
+                );
+            }
+        }
+    }
+
+    /// Returns false when the pipeline should exit.
+    fn handle_cmd(&mut self, cmd: PipelineCmd) -> bool {
+        match cmd {
+            PipelineCmd::Shutdown => return false,
+            PipelineCmd::Play => {
+                self.clock.resume();
+                if !self.aaudio.is_null() {
+                    unsafe { sys::AAudioStream_requestStart(self.aaudio) };
+                }
+                send_event(&self.sender, PlayerEvent::StateChanged(PlaybackState::Playing));
+            },
+            PipelineCmd::Pause => {
+                self.clock.pause();
+                if !self.aaudio.is_null() {
+                    unsafe { sys::AAudioStream_requestStop(self.aaudio) };
+                }
+                send_event(&self.sender, PlayerEvent::StateChanged(PlaybackState::Paused));
+            },
+            PipelineCmd::Seek(time) => {
+                self.do_seek(time);
+            },
+        }
+        true
+    }
+
+    fn do_seek(&mut self, time: f64) {
+        let target_us = (time * 1e6) as i64;
+        // Flush codecs (this releases any held output buffer indices).
+        if let Some(video) = self.video.as_mut() {
+            video.held_frame = None;
+            video.drained = false;
+            video.input_eos_queued = false;
+            unsafe {
+                sys::AMediaCodec_flush(video.codec);
+                // Drop frames rendered before the seek that may still be
+                // queued in the reader.
+                if !video.image_reader.is_null() {
+                    let mut image: *mut sys::AImage = std::ptr::null_mut();
+                    while sys::AImageReader_acquireLatestImage(video.image_reader, &mut image) ==
+                        sys::AMEDIA_OK &&
+                        !image.is_null()
+                    {
+                        sys::AImage_delete(image);
+                        image = std::ptr::null_mut();
+                    }
+                }
+            }
+        }
+        if let Some(audio) = self.audio.as_mut() {
+            audio.drained = false;
+            audio.input_eos_queued = false;
+            unsafe { sys::AMediaCodec_flush(audio.codec) };
+        }
+        self.pending_sample = None;
+        self.extractor_eos = false;
+        unsafe {
+            sys::AMediaExtractor_seekTo(
+                self.extractor,
+                target_us,
+                sys::AMEDIAEXTRACTOR_SEEK_PREVIOUS_SYNC,
+            )
+        };
+        self.clock.rebase(target_us);
+        if self.shared.get().paused {
+            // rebase restarts the wall clock; freeze it again while paused.
+            self.clock.pause();
+        }
+        if !self.aaudio.is_null() && !self.shared.get().paused {
+            unsafe { sys::AAudioStream_requestStart(self.aaudio) };
+        }
+        send_event(&self.sender, PlayerEvent::SeekDone(time));
+    }
+
+    fn feed_inputs(&mut self) -> bool {
+        let mut did_work = false;
+        if !self.extractor_eos && self.pending_sample.is_none() {
+            let n = unsafe {
+                sys::AMediaExtractor_readSampleData(
+                    self.extractor,
+                    self.staging.as_mut_ptr(),
+                    self.staging.len(),
+                )
+            };
+            if n < 0 {
+                self.extractor_eos = true;
+            } else {
+                let track = unsafe { sys::AMediaExtractor_getSampleTrackIndex(self.extractor) };
+                let pts = unsafe { sys::AMediaExtractor_getSampleTime(self.extractor) };
+                if n as usize >= self.staging.len() {
+                    warn!(
+                        "android media backend: sample of {} bytes exceeds staging capacity, dropping",
+                        n
+                    );
+                } else {
+                    self.pending_sample = Some((track as usize, n as usize, pts));
+                }
+                unsafe { sys::AMediaExtractor_advance(self.extractor) };
+            }
+        }
+
+        if self.extractor_eos {
+            for decoder in [&mut self.video, &mut self.audio].into_iter().flatten() {
+                if !decoder.input_eos_queued {
+                    let idx =
+                        unsafe { sys::AMediaCodec_dequeueInputBuffer(decoder.codec, 0) };
+                    if idx >= 0 {
+                        unsafe {
+                            sys::AMediaCodec_queueInputBuffer(
+                                decoder.codec,
+                                idx as usize,
+                                0,
+                                0,
+                                0,
+                                sys::AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM,
+                            )
+                        };
+                        decoder.input_eos_queued = true;
+                        did_work = true;
+                    }
+                }
+            }
+            return did_work;
+        }
+
+        let Some((track, len, pts)) = self.pending_sample else {
+            return did_work;
+        };
+        let decoder = [&mut self.video, &mut self.audio]
+            .into_iter()
+            .flatten()
+            .find(|d| d.track_index == track);
+        let Some(decoder) = decoder else {
+            // Sample for an unselected track; discard.
+            self.pending_sample = None;
+            return did_work;
+        };
+        let idx = unsafe { sys::AMediaCodec_dequeueInputBuffer(decoder.codec, 0) };
+        if idx < 0 {
+            return did_work; // codec input full; retry next iteration
+        }
+        let mut out_size: usize = 0;
+        let input = unsafe {
+            sys::AMediaCodec_getInputBuffer(decoder.codec, idx as usize, &mut out_size)
+        };
+        if input.is_null() || out_size < len {
+            warn!("android media backend: codec input buffer too small ({out_size} < {len})");
+            unsafe {
+                sys::AMediaCodec_queueInputBuffer(decoder.codec, idx as usize, 0, 0, 0, 0)
+            };
+            self.pending_sample = None;
+            return did_work;
+        }
+        unsafe {
+            std::ptr::copy_nonoverlapping(self.staging.as_ptr(), input, len);
+            sys::AMediaCodec_queueInputBuffer(
+                decoder.codec,
+                idx as usize,
+                0,
+                len,
+                pts.max(0) as u64,
+                0,
+            )
+        };
+        self.pending_sample = None;
+        true
+    }
+
+    fn pump_video(&mut self) -> bool {
+        let Some(codec) = self.video.as_ref().map(|v| v.codec) else {
+            return false;
+        };
+        // Present a held frame if it is now due.
+        let held = self.video.as_ref().and_then(|v| v.held_frame);
+        if let Some((idx, pts)) = held {
+            if pts <= self.clock.now_us() + FRAME_EARLY_TOLERANCE_US {
+                self.video.as_mut().unwrap().held_frame = None;
+                self.render_video_frame(idx);
+            } else {
+                return false;
+            }
+        }
+        let mut info = sys::AMediaCodecBufferInfo::default();
+        let idx = unsafe { sys::AMediaCodec_dequeueOutputBuffer(codec, &mut info, 0) };
+        match idx {
+            x if x == sys::AMEDIACODEC_INFO_TRY_AGAIN_LATER => false,
+            x if x == sys::AMEDIACODEC_INFO_OUTPUT_BUFFERS_CHANGED => true,
+            x if x == sys::AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED => {
+                // Surface-mode output: dimensions arrive on each AImage, so
+                // there is nothing to reconfigure; log for diagnostics.
+                let format = unsafe { sys::AMediaCodec_getOutputFormat(codec) };
+                if !format.is_null() {
+                    debug!(
+                        "video output format changed: {}x{}",
+                        get_format_i32(format, c"width").unwrap_or(0),
+                        get_format_i32(format, c"height").unwrap_or(0)
+                    );
+                    unsafe { sys::AMediaFormat_delete(format) };
+                }
+                true
+            },
+            x if x >= 0 => {
+                let idx = x as usize;
+                let pts = info.presentation_time_us;
+                if info.flags & sys::AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM != 0 {
+                    unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, idx, false) };
+                    self.video.as_mut().unwrap().drained = true;
+                    self.maybe_finish();
+                    return true;
+                }
+                let clock = self.clock.now_us();
+                if pts < clock - FRAME_DROP_LATE_US {
+                    // Too late: drop to preserve bounded latency.
+                    unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, idx, false) };
+                } else if pts <= clock + FRAME_EARLY_TOLERANCE_US {
+                    self.render_video_frame(idx);
+                } else {
+                    // Early: hold at most one frame.
+                    if let Some((old_idx, _)) = self.video.as_mut().unwrap().held_frame.take() {
+                        unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, old_idx, false) };
+                    }
+                    self.video.as_mut().unwrap().held_frame = Some((idx, pts));
+                }
+                true
+            },
+            _ => false,
+        }
+    }
+
+    fn render_video_frame(&self, idx: usize) {
+        let (codec, reader) = match self.video.as_ref() {
+            Some(v) => (v.codec, v.image_reader),
+            None => return,
+        };
+        // Hand the frame to the ImageReader surface, then read it back as an
+        // AImage. Pts comes from the BufferInfo we already have; the image
+        // queue is FIFO and we acquire immediately after each rendered frame.
+        unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, idx, true) };
+        let Some(renderer) = &self.video_renderer else {
+            return;
+        };
+        unsafe {
+            let mut image: *mut sys::AImage = std::ptr::null_mut();
+            let status = sys::AImageReader_acquireLatestImage(reader, &mut image);
+            if status != sys::AMEDIA_OK || image.is_null() {
+                if status != sys::AMEDIA_IMGREADER_NO_BUFFER_AVAILABLE {
+                    warn!("android media backend: acquireLatestImage failed: {status}");
+                }
+                return;
+            }
+            let mut width: i32 = 0;
+            let mut height: i32 = 0;
+            sys::AImage_getWidth(image, &mut width);
+            sys::AImage_getHeight(image, &mut height);
+            let packed = (|| {
+                let mut plane_data: [*mut u8; 3] = [std::ptr::null_mut(); 3];
+                let mut plane_len: [i32; 3] = [0; 3];
+                let mut row_stride: [i32; 3] = [0; 3];
+                let mut pixel_stride: [i32; 3] = [0; 3];
+                for p in 0..3 {
+                    if sys::AImage_getPlaneData(
+                        image,
+                        p as i32,
+                        &mut plane_data[p],
+                        &mut plane_len[p],
+                    ) != sys::AMEDIA_OK ||
+                        sys::AImage_getPlaneRowStride(image, p as i32, &mut row_stride[p]) !=
+                            sys::AMEDIA_OK ||
+                        sys::AImage_getPlanePixelStride(image, p as i32, &mut pixel_stride[p]) !=
+                            sys::AMEDIA_OK ||
+                        plane_data[p].is_null()
+                    {
+                        return None;
+                    }
+                }
+                let planes = Planes {
+                    width: width as usize,
+                    height: height as usize,
+                    y: std::slice::from_raw_parts(plane_data[0], plane_len[0] as usize),
+                    y_row_stride: row_stride[0] as usize,
+                    u: std::slice::from_raw_parts(plane_data[1], plane_len[1] as usize),
+                    u_row_stride: row_stride[1] as usize,
+                    u_pixel_stride: pixel_stride[1] as usize,
+                    v: std::slice::from_raw_parts(plane_data[2], plane_len[2] as usize),
+                    v_row_stride: row_stride[2] as usize,
+                    v_pixel_stride: pixel_stride[2] as usize,
+                };
+                pack_i420(&planes)
+            })();
+            // The image (and its plane pointers) must not be used after this.
+            sys::AImage_delete(image);
+            let Some(packed) = packed else {
+                warn!("android media backend: could not pack YUV_420_888 image planes");
+                return;
+            };
+            let (w, h) = (width as usize, height as usize);
+            let (cw, ch) = (w / 2, h / 2);
+            let image420 = YuvPlanarImage {
+                width: w as u32,
+                height: h as u32,
+                y_stride: w as u32,
+                u_stride: cw as u32,
+                v_stride: cw as u32,
+                y_plane: &packed[..w * h],
+                u_plane: &packed[w * h..w * h + cw * ch],
+                v_plane: &packed[w * h + cw * ch..],
+            };
+            let mut bgra = vec![0u8; w * h * 4];
+            let converted = yuv420_to_bgra(
+                &image420,
+                &mut bgra,
+                w as u32 * 4,
+                YuvRange::Limited,
+                // BT.709 for HD, BT.601 for SD.
+                if h >= 720 {
+                    YuvStandardMatrix::Bt709
+                } else {
+                    YuvStandardMatrix::Bt601
+                },
+            );
+            match converted {
+                Ok(()) => {
+                    if let Some(frame) =
+                        VideoFrame::new(width, height, Arc::new(RawFrameBuffer(bgra)))
+                    {
+                        renderer.lock().unwrap().render(frame);
+                        send_event(&self.sender, PlayerEvent::VideoFrameUpdated);
+                    }
+                },
+                Err(err) => warn!("android media backend: yuv conversion failed: {err:?}"),
+            }
+        }
+    }
+
+    fn pump_audio(&mut self) -> bool {
+        let Some(codec) = self.audio.as_ref().map(|a| a.codec) else {
+            return false;
+        };
+        let mut info = sys::AMediaCodecBufferInfo::default();
+        let idx = unsafe { sys::AMediaCodec_dequeueOutputBuffer(codec, &mut info, 0) };
+        match idx {
+            x if x == sys::AMEDIACODEC_INFO_TRY_AGAIN_LATER => false,
+            x if x == sys::AMEDIACODEC_INFO_OUTPUT_BUFFERS_CHANGED => true,
+            x if x == sys::AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED => {
+                let format = unsafe { sys::AMediaCodec_getOutputFormat(codec) };
+                if !format.is_null() {
+                    let sample_rate = get_format_i32(format, c"sample-rate").unwrap_or(0);
+                    let channels = get_format_i32(format, c"channel-count").unwrap_or(0);
+                    debug!(
+                        "audio output format changed: {} Hz, {} ch",
+                        sample_rate, channels
+                    );
+                    if let Some(audio) = self.audio.as_mut() {
+                        audio.sample_rate = sample_rate;
+                        audio.channels = channels;
+                    }
+                    unsafe { sys::AMediaFormat_delete(format) };
+                    self.reopen_audio_stream();
+                }
+                true
+            },
+            x if x >= 0 => {
+                let idx = x as usize;
+                if info.flags & sys::AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM != 0 {
+                    unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, idx, false) };
+                    self.audio.as_mut().unwrap().drained = true;
+                    self.maybe_finish();
+                    return true;
+                }
+                let mut out_size: usize = 0;
+                let buf = unsafe { sys::AMediaCodec_getOutputBuffer(codec, idx, &mut out_size) };
+                if buf.is_null() || info.size <= 0 {
+                    unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, idx, false) };
+                    return true;
+                }
+                let pcm = unsafe {
+                    std::slice::from_raw_parts(
+                        buf.add(info.offset as usize) as *const i16,
+                        info.size as usize / 2,
+                    )
+                };
+                let st = self.shared.get();
+                let samples: Vec<i16> = if st.muted || st.volume <= 0.0 {
+                    vec![0i16; pcm.len()]
+                } else if (st.volume - 1.0).abs() > f64::EPSILON {
+                    pcm.iter()
+                        .map(|s| {
+                            (*s as f32 * st.volume as f32)
+                                .round()
+                                .clamp(i16::MIN as f32, i16::MAX as f32) as i16
+                        })
+                        .collect()
+                } else {
+                    pcm.to_vec()
+                };
+                unsafe { sys::AMediaCodec_releaseOutputBuffer(codec, idx, false) };
+                self.write_audio(&samples, info.presentation_time_us);
+                true
+            },
+            _ => false,
+        }
+    }
+
+    fn reopen_audio_stream(&mut self) {
+        let (rate, channels) = {
+            let audio = self.audio.as_ref().unwrap();
+            (audio.sample_rate, audio.channels)
+        };
+        if rate <= 0 || channels <= 0 {
+            return;
+        }
+        if !self.aaudio.is_null() {
+            unsafe {
+                sys::AAudioStream_requestStop(self.aaudio);
+                sys::AAudioStream_close(self.aaudio);
+            }
+            self.aaudio = std::ptr::null_mut();
+        }
+        unsafe {
+            let mut builder: *mut sys::AAudioStreamBuilder = std::ptr::null_mut();
+            if sys::AAudio_createStreamBuilder(&mut builder) != sys::AAUDIO_OK ||
+                builder.is_null()
+            {
+                return;
+            }
+            sys::AAudioStreamBuilder_setDirection(builder, sys::AAUDIO_DIRECTION_OUTPUT);
+            sys::AAudioStreamBuilder_setSampleRate(builder, rate);
+            sys::AAudioStreamBuilder_setChannelCount(builder, channels);
+            sys::AAudioStreamBuilder_setFormat(builder, sys::AAUDIO_FORMAT_PCM_I16);
+            sys::AAudioStreamBuilder_setSharingMode(builder, sys::AAUDIO_SHARING_MODE_SHARED);
+            sys::AAudioStreamBuilder_setUsage(builder, sys::AAUDIO_USAGE_MEDIA);
+            sys::AAudioStreamBuilder_setPerformanceMode(
+                builder,
+                sys::AAUDIO_PERFORMANCE_MODE_NONE,
+            );
+            sys::AAudioStreamBuilder_setBufferCapacityInFrames(
+                builder,
+                rate * AUDIO_BUFFER_CAPACITY_MS / 1000,
+            );
+            let mut stream: *mut sys::AAudioStream = std::ptr::null_mut();
+            let result = sys::AAudioStreamBuilder_openStream(builder, &mut stream);
+            sys::AAudioStreamBuilder_delete(builder);
+            if result == sys::AAUDIO_OK && !stream.is_null() {
+                self.aaudio = stream;
+                self.clock.has_audio = true;
+                self.clock.audio_sample_rate = rate as i64;
+                self.clock.audio_frames_written = 0;
+                if !self.shared.get().paused {
+                    sys::AAudioStream_requestStart(stream);
+                }
+            } else {
+                warn!("android media backend: AAudio openStream failed: {result}");
+            }
+        }
+    }
+
+    fn write_audio(&mut self, samples: &[i16], pts_us: i64) {
+        if self.aaudio.is_null() {
+            self.reopen_audio_stream();
+            if self.aaudio.is_null() {
+                return;
+            }
+        }
+        let channels = self.audio.as_ref().unwrap().channels.max(1) as usize;
+        if self.clock.audio_frames_written == 0 {
+            self.clock.anchor_pts_us = pts_us;
+        }
+        let mut frames_left = samples.len() / channels;
+        let mut offset_frames = 0usize;
+        while frames_left > 0 {
+            if self.shared.get().shutdown {
+                return;
+            }
+            let written = unsafe {
+                sys::AAudioStream_write(
+                    self.aaudio,
+                    samples[offset_frames * channels..].as_ptr() as *const std::ffi::c_void,
+                    frames_left as i32,
+                    AUDIO_WRITE_TIMEOUT_NS,
+                )
+            };
+            if written < 0 {
+                warn!("android media backend: AAudio write failed: {written}");
+                return;
+            }
+            let written = written as usize;
+            self.clock.audio_frames_written += written as u64;
+            offset_frames += written;
+            frames_left -= written;
+            if written == 0 {
+                // Stream is full and not draining fast enough; avoid a hot
+                // loop but keep writing (audio drives the clock).
+                std::thread::sleep(Duration::from_millis(2));
+            }
+        }
+    }
+
+    fn maybe_finish(&mut self) {
+        let video_done = self.video.as_ref().map(|v| v.drained).unwrap_or(true);
+        let audio_done = self.audio.as_ref().map(|a| a.drained).unwrap_or(true);
+        if video_done && audio_done {
+            if !self.aaudio.is_null() {
+                unsafe { sys::AAudioStream_requestStop(self.aaudio) };
+            }
+            self.shared.update(|st| st.paused = true);
+            send_event(&self.sender, PlayerEvent::EndOfStream);
+            send_event(&self.sender, PlayerEvent::StateChanged(PlaybackState::Paused));
+        }
+    }
+}
+
+impl Drop for Pipeline {
+    fn drop(&mut self) {
+        // Unblock any readAt still waiting in an extractor thread before
+        // tearing the extractor down.
+        self.buffer.cancel();
+        if let Some(video) = self.video.take() {
+            unsafe {
+                sys::AMediaCodec_stop(video.codec);
+                sys::AMediaCodec_delete(video.codec);
+                // The reader's surface must outlive the codec that rendered
+                // into it; delete it only now.
+                if !video.image_reader.is_null() {
+                    sys::AImageReader_delete(video.image_reader);
+                }
+            }
+        }
+        if let Some(audio) = self.audio.take() {
+            unsafe {
+                sys::AMediaCodec_stop(audio.codec);
+                sys::AMediaCodec_delete(audio.codec);
+            }
+        }
+        if !self.aaudio.is_null() {
+            unsafe {
+                sys::AAudioStream_requestStop(self.aaudio);
+                sys::AAudioStream_close(self.aaudio);
+            }
+        }
+        // Extractor (and its internal reader threads) must go away before the
+        // data source and its callback state are freed.
+        if !self.extractor.is_null() {
+            unsafe { sys::AMediaExtractor_delete(self.extractor) };
+            self.extractor = std::ptr::null_mut();
+        }
+        if let Some(mut source) = self.source.take() {
+            unsafe { source.destroy() };
+        }
+    }
+}
diff --git a/components/media/backends/android/android_impl/source.rs b/components/media/backends/android/android_impl/source.rs
new file mode 100644
index 0000000..76f9701
--- /dev/null
+++ b/components/media/backends/android/android_impl/source.rs
@@ -0,0 +1,136 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! AMediaDataSource bridge onto the SharedBuffer in `buffer.rs`.
+//!
+//! The NDK invokes the callbacks on implementation-defined threads, so all
+//! state lives behind the SharedBuffer's mutex/condvar. Buffer logic itself
+//! (windowing, seek dispatch decisions, cancellation) is pure and
+//! host-tested in buffer.rs; this file is the thin FFI shell around it.
+
+use std::ffi::c_void;
+use std::sync::Arc;
+
+use crate::buffer::{Dispatch, SharedBuffer};
+
+/// State handed to the NDK as the AMediaDataSource userdata pointer.
+pub struct CallbackState {
+    pub buffer: Arc<SharedBuffer>,
+    /// Dispatches PlayerEvent::SeekData and blocks until the new fetch is set
+    /// up. Must never be called while holding the buffer lock.
+    pub seek_data: Box<dyn Fn(u64) + Send + Sync>,
+    /// Dispatches PlayerEvent::NeedData.
+    pub need_data: Box<dyn Fn() + Send + Sync>,
+}
+
+unsafe extern "C" fn read_at_cb(
+    userdata: *mut c_void,
+    offset: i64,
+    buffer: *mut c_void,
+    size: usize,
+) -> isize {
+    unsafe {
+        debug_assert!(!userdata.is_null());
+        let state = &*(userdata as *const CallbackState);
+        let dest = std::slice::from_raw_parts_mut(buffer as *mut u8, size);
+        // The seek dispatch blocks on IPC. Loop afterwards instead of
+        // returning a spurious short read: once the new fetch is set up, the
+        // requested bytes either arrive (read_at waits on the condvar) or the
+        // source is cancelled / hits EOS.
+        let mut attempts = 0;
+        loop {
+            let (n, dispatch) = state.buffer.read_at(dest, offset);
+            match dispatch {
+                Some(Dispatch::Seek(pos)) => {
+                    attempts += 1;
+                    if attempts > 8 {
+                        log::warn!("read_at_cb: seek dispatch did not progress, failing read");
+                        return -1;
+                    }
+                    (state.seek_data)(pos);
+                },
+                Some(Dispatch::NeedData) => {
+                    (state.need_data)();
+                    return n;
+                },
+                None => return n,
+            }
+        }
+    }
+}
+
+unsafe extern "C" fn get_size_cb(userdata: *mut c_void) -> i64 {
+    unsafe {
+        debug_assert!(!userdata.is_null());
+        let state = &*(userdata as *const CallbackState);
+        let size = state.buffer.total_size();
+        if size > 0 { size } else { -1 }
+    }
+}
+
+unsafe extern "C" fn close_cb(userdata: *mut c_void) {
+    unsafe {
+        debug_assert!(!userdata.is_null());
+        let state = &*(userdata as *const CallbackState);
+        state.buffer.cancel();
+    }
+}
+
+/// Owns the NDK AMediaDataSource and the boxed callback state behind its
+/// userdata pointer. Must be destroyed (via `destroy`) only after the
+/// AMediaExtractor using it has been deleted, so no readAt callback can ever
+/// fire into freed state.
+pub struct MediaSourceWrapper {
+    pub source: *mut super::sys::AMediaDataSource,
+    callback_state: *mut CallbackState,
+    pub buffer: Arc<SharedBuffer>,
+}
+
+impl MediaSourceWrapper {
+    pub fn new(
+        seek_data: Box<dyn Fn(u64) + Send + Sync>,
+        need_data: Box<dyn Fn() + Send + Sync>,
+    ) -> Option<Self> {
+        use super::sys::*;
+        let buffer = Arc::new(SharedBuffer::new());
+        let callback_state = Box::into_raw(Box::new(CallbackState {
+            buffer: buffer.clone(),
+            seek_data,
+            need_data,
+        }));
+        let source = unsafe {
+            let ds = AMediaDataSource_new();
+            if ds.is_null() {
+                drop(Box::from_raw(callback_state));
+                return None;
+            }
+            AMediaDataSource_setUserdata(ds, callback_state as *mut c_void);
+            AMediaDataSource_setReadAt(ds, read_at_cb);
+            AMediaDataSource_setGetSize(ds, get_size_cb);
+            AMediaDataSource_setClose(ds, close_cb);
+            ds
+        };
+        Some(MediaSourceWrapper {
+            source,
+            callback_state,
+            buffer,
+        })
+    }
+
+    /// Delete the NDK data source and free the callback state. The caller
+    /// must guarantee the extractor is already deleted.
+    pub unsafe fn destroy(&mut self) {
+        unsafe {
+            self.buffer.cancel();
+            if !self.source.is_null() {
+                super::sys::AMediaDataSource_delete(self.source);
+                self.source = std::ptr::null_mut();
+            }
+            if !self.callback_state.is_null() {
+                drop(Box::from_raw(self.callback_state));
+                self.callback_state = std::ptr::null_mut();
+            }
+        }
+    }
+}
diff --git a/components/media/backends/android/android_impl/sys.rs b/components/media/backends/android/android_impl/sys.rs
new file mode 100644
index 0000000..e7a3f78
--- /dev/null
+++ b/components/media/backends/android/android_impl/sys.rs
@@ -0,0 +1,279 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Raw bindings to the Android NDK media APIs used by this backend
+//! (AMediaExtractor, AMediaCodec, AMediaFormat, AMediaDataSource, AAudio).
+//!
+//! Signatures and constants transcribed from the NDK headers in
+//! platform/frameworks/av (media/ndk/NdkMedia*.h) and
+//! platform/frameworks/av/media/libaaudio (include/aaudio/AAudio.h).
+//!
+//! API-level requirements (verified against the headers' __INTRODUCED_IN):
+//! - AMediaExtractor / AMediaCodec / AMediaFormat core: API 21
+//! - AMediaExtractor_setDataSourceCustom: API 28
+//! - AMediaDataSource_{new,delete,setReadAt,setGetSize,setClose,setUserdata}: API 28
+//! - AAudio: API 26
+//! The Argon app targets minSdk 29, so every symbol used here is always
+//! available at runtime; no runtime symbol gating is required.
+
+#![allow(non_camel_case_types, non_snake_case, non_upper_case_globals, dead_code)]
+
+use core::ffi::{c_char, c_void};
+
+pub type media_status_t = i32;
+pub const AMEDIA_OK: media_status_t = 0;
+
+#[repr(C)]
+pub struct AMediaExtractor {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AMediaCodec {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AMediaFormat {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AMediaDataSource {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AAudioStream {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AAudioStreamBuilder {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AImageReader {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct AImage {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct ANativeWindow {
+    _private: [u8; 0],
+}
+
+pub type SeekMode = i32;
+pub const AMEDIAEXTRACTOR_SEEK_PREVIOUS_SYNC: SeekMode = 0;
+
+#[repr(C)]
+#[derive(Default)]
+pub struct AMediaCodecBufferInfo {
+    pub offset: i32,
+    pub size: i32,
+    pub presentation_time_us: i64,
+    pub flags: u32,
+}
+
+pub const AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM: u32 = 4;
+pub const AMEDIACODEC_INFO_TRY_AGAIN_LATER: isize = -1;
+pub const AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED: isize = -2;
+pub const AMEDIACODEC_INFO_OUTPUT_BUFFERS_CHANGED: isize = -3;
+
+/// COLOR_FormatYUV420Flexible from android.media.MediaCodecInfo.CodecCapabilities.
+/// Not exposed by the NDK headers; the value is part of the stable SDK ABI.
+pub const COLOR_FORMAT_YUV420_FLEXIBLE: i32 = 0x7F42_0888;
+
+pub type aaudio_result_t = i32;
+pub const AAUDIO_OK: aaudio_result_t = 0;
+pub const AAUDIO_DIRECTION_OUTPUT: i32 = 0;
+pub const AAUDIO_FORMAT_PCM_I16: i32 = 1;
+pub const AAUDIO_USAGE_MEDIA: i32 = 1;
+pub const AAUDIO_SHARING_MODE_SHARED: i32 = 0;
+pub const AAUDIO_PERFORMANCE_MODE_NONE: i32 = 10;
+
+/// void* userdata, off64_t offset, void* buffer, size_t size -> ssize_t
+pub type AMediaDataSourceReadAt =
+    unsafe extern "C" fn(*mut c_void, i64, *mut c_void, usize) -> isize;
+/// void* userdata -> off64_t
+pub type AMediaDataSourceGetSize = unsafe extern "C" fn(*mut c_void) -> i64;
+/// void* userdata
+pub type AMediaDataSourceClose = unsafe extern "C" fn(*mut c_void);
+
+unsafe extern "C" {
+    pub fn AMediaExtractor_new() -> *mut AMediaExtractor;
+    pub fn AMediaExtractor_delete(ex: *mut AMediaExtractor) -> media_status_t;
+    pub fn AMediaExtractor_setDataSourceCustom(
+        ex: *mut AMediaExtractor,
+        src: *mut AMediaDataSource,
+    ) -> media_status_t;
+    pub fn AMediaExtractor_getTrackCount(ex: *mut AMediaExtractor) -> usize;
+    pub fn AMediaExtractor_getTrackFormat(
+        ex: *mut AMediaExtractor,
+        idx: usize,
+    ) -> *mut AMediaFormat;
+    pub fn AMediaExtractor_selectTrack(ex: *mut AMediaExtractor, idx: usize) -> media_status_t;
+    pub fn AMediaExtractor_readSampleData(
+        ex: *mut AMediaExtractor,
+        buffer: *mut u8,
+        capacity: usize,
+    ) -> isize;
