@@ -0,0 +1,203 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Packing of YUV_420_888 image planes (as returned by AImage_getPlaneData
+//! with explicit row and pixel strides) into tightly packed I420.
+//!
+//! YUV_420_888 is a *flexible* format: plane order is fixed (Y, Cb, Cr) but
+//! row strides may include padding and the chroma planes may be semi-planar
+//! (pixel stride 2, i.e. NV12/NV21-style interleaving). Using the explicit
+//! strides is the only correct way to read it; assuming a packed I420 buffer
+//! is wrong on many devices.
+
+/// One image's plane views with explicit strides, as read from an AImage.
+pub struct Planes<'a> {
+    pub width: usize,
+    pub height: usize,
+    pub y: &'a [u8],
+    pub y_row_stride: usize,
+    pub u: &'a [u8],
+    pub u_row_stride: usize,
+    pub u_pixel_stride: usize,
+    pub v: &'a [u8],
+    pub v_row_stride: usize,
+    pub v_pixel_stride: usize,
+}
+
+/// Required slice length for a plane with the given geometry.
+fn plane_len(rows: usize, cols: usize, row_stride: usize, pixel_stride: usize) -> usize {
+    if rows == 0 || cols == 0 {
+        return 0;
+    }
+    (rows - 1) * row_stride + (cols - 1) * pixel_stride + 1
+}
+
+/// Pack into I420 (Y plane, then U, then V; each tightly packed, chroma at
+/// half resolution). Returns None when the input slices are too small for
+/// the declared geometry or the geometry is not even 4:2:0-compatible.
+pub fn pack_i420(planes: &Planes) -> Option<Vec<u8>> {
+    let w = planes.width;
+    let h = planes.height;
+    if w == 0 || h == 0 || w % 2 != 0 || h % 2 != 0 {
+        return None;
+    }
+    let cw = w / 2;
+    let ch = h / 2;
+    if planes.y_row_stride < w ||
+        planes.u_row_stride < cw * planes.u_pixel_stride ||
+        planes.v_row_stride < cw * planes.v_pixel_stride ||
+        planes.u_pixel_stride == 0 ||
+        planes.v_pixel_stride == 0
+    {
+        return None;
+    }
+    if plane_len(h, w, planes.y_row_stride, 1) > planes.y.len() ||
+        plane_len(ch, cw, planes.u_row_stride, planes.u_pixel_stride) > planes.u.len() ||
+        plane_len(ch, cw, planes.v_row_stride, planes.v_pixel_stride) > planes.v.len()
+    {
+        return None;
+    }
+    let mut out = vec![0u8; w * h + 2 * cw * ch];
+    let (y_out, rest) = out.split_at_mut(w * h);
+    let (u_out, v_out) = rest.split_at_mut(cw * ch);
+    for row in 0..h {
+        let src = &planes.y[row * planes.y_row_stride..row * planes.y_row_stride + w];
+        y_out[row * w..row * w + w].copy_from_slice(src);
+    }
+    for row in 0..ch {
+        for col in 0..cw {
+            u_out[row * cw + col] = planes.u[row * planes.u_row_stride + col * planes.u_pixel_stride];
+            v_out[row * cw + col] = planes.v[row * planes.v_row_stride + col * planes.v_pixel_stride];
+        }
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn gradient(w: usize, h: usize, base: u8) -> Vec<u8> {
+        (0..w * h).map(|i| base.wrapping_add(i as u8)).collect()
+    }
+
+    #[test]
+    fn packed_planar_passthrough() {
+        let (w, h) = (4, 4);
+        let y = gradient(w, h, 10);
+        let u = gradient(w / 2, h / 2, 100);
+        let v = gradient(w / 2, h / 2, 200);
+        let planes = Planes {
+            width: w,
+            height: h,
+            y: &y,
+            y_row_stride: w,
+            u: &u,
+            u_row_stride: w / 2,
+            u_pixel_stride: 1,
+            v: &v,
+            v_row_stride: w / 2,
+            v_pixel_stride: 1,
+        };
+        let out = pack_i420(&planes).unwrap();
+        assert_eq!(&out[..16], &y[..]);
+        assert_eq!(&out[16..20], &u[..]);
+        assert_eq!(&out[20..24], &v[..]);
+    }
+
+    #[test]
+    fn row_padding_is_stripped() {
+        let (w, h, stride) = (4, 4, 8);
+        let mut y = vec![0xEEu8; stride * h];
+        for row in 0..h {
+            for col in 0..w {
+                y[row * stride + col] = (row * w + col) as u8;
+            }
+        }
+        let u = vec![7u8; 4];
+        let v = vec![9u8; 4];
+        let planes = Planes {
+            width: w,
+            height: h,
+            y: &y,
+            y_row_stride: stride,
+            u: &u,
+            u_row_stride: 2,
+            u_pixel_stride: 1,
+            v: &v,
+            v_row_stride: 2,
+            v_pixel_stride: 1,
+        };
+        let out = pack_i420(&planes).unwrap();
+        for row in 0..h {
+            for col in 0..w {
+                assert_eq!(out[row * w + col], (row * w + col) as u8);
+            }
+        }
+        assert_eq!(&out[16..20], &[7, 7, 7, 7]);
+        assert_eq!(&out[20..24], &[9, 9, 9, 9]);
+    }
+
+    #[test]
+    fn semi_planar_nv12_deinterleaves() {
+        // 4x4, NV12: single chroma buffer U V U V ... with pixel stride 2.
+        let (w, h) = (4, 4);
+        let y = gradient(w, h, 0);
+        let (cw, ch) = (2, 2);
+        let mut nv = vec![0u8; cw * ch * 2];
+        let u_vals = [1u8, 2, 3, 4];
+        let v_vals = [5u8, 6, 7, 8];
+        for i in 0..4 {
+            nv[i * 2] = u_vals[i];
+            nv[i * 2 + 1] = v_vals[i];
+        }
+        let planes = Planes {
+            width: w,
+            height: h,
+            y: &y,
+            y_row_stride: w,
+            u: &nv,
+            u_row_stride: cw * 2,
+            u_pixel_stride: 2,
+            v: &nv[1..],
+            v_row_stride: cw * 2,
+            v_pixel_stride: 2,
+        };
+        let out = pack_i420(&planes).unwrap();
+        assert_eq!(&out[16..20], &u_vals[..]);
+        assert_eq!(&out[20..24], &v_vals[..]);
+    }
+
+    #[test]
+    fn short_buffers_and_bad_geometry_rejected() {
+        let y = vec![0u8; 8];
+        let planes = Planes {
+            width: 4,
+            height: 4,
+            y: &y, // too small: needs at least 3*4+4 = 16
+            y_row_stride: 4,
+            u: &y,
+            u_row_stride: 2,
+            u_pixel_stride: 1,
+            v: &y,
+            v_row_stride: 2,
+            v_pixel_stride: 1,
+        };
+        assert!(pack_i420(&planes).is_none());
+        let y16 = vec![0u8; 16];
+        let odd = Planes {
+            width: 3,
+            height: 3,
+            y: &y16,
+            y_row_stride: 3,
+            u: &y,
+            u_row_stride: 2,
+            u_pixel_stride: 1,
+            v: &y,
+            v_row_stride: 2,
+            v_pixel_stride: 1,
+        };
+        assert!(pack_i420(&odd).is_none());
+    }
+}
