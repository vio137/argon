+
+#[test]
+fn single_rate_one_edit_maps_media_ticks_before_microsecond_quantization() {
+ use shiguredo_mp4::{Decode,Encode,boxes::{MoovBox,EdtsBox,ElstBox,ElstEntry},FixedPointNumber};
+ use servo_media_android_hosttest::mse_demux::{Error,session::AppendSession};
+ for fixture in [include_bytes!("fixtures/synthetic-fmp4.mp4").as_slice(),include_bytes!("fixtures/synthetic-aac.mp4").as_slice()] {
+  let mut framer=BoxFramer::new(1<<20);framer.append(fixture).unwrap();let mut bs=vec![];
+  while let Some(b)=framer.pop_box().unwrap(){bs.push(b);}
+  let ftyp=bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap();let bytes=bs.iter().find(|b|&b[4..8]==b"moov").unwrap();
+  let(mut moov,_)=MoovBox::decode(bytes).unwrap();let scale=moov.trak_boxes[0].mdia_box.mdhd_box.timescale.get();
+  let shift=if fixture.len()==include_bytes!("fixtures/synthetic-fmp4.mp4").len() {i64::from(scale)/2}else{1024};
+  moov.trak_boxes[0].edts_box=Some(EdtsBox{elst_box:Some(ElstBox{entries:vec![ElstEntry{edit_duration:0,media_time:shift,media_rate:FixedPointNumber{integer:1,fraction:0}}]}),unknown_boxes:vec![]});
+  let mut edited=ftyp.clone();edited.extend(moov.encode_to_vec().unwrap());
+  let mut d=Demux::new(1<<20,64);d.init(&edited).unwrap();
+  let mut output=vec![];for pair in bs.windows(2) {if &pair[0][4..8]==b"moof"&&&pair[1][4..8]==b"mdat" {let mut b=pair[0].clone();b.extend_from_slice(&pair[1]);edited.extend_from_slice(&b);output.extend(d.media(&b).unwrap());}}
+  assert!(output[0].pts_us<0);assert_eq!(output[1].pts_us,0);
+  for pair in output.windows(2){assert_eq!(pair[0].pts_us+pair[0].duration_us,pair[1].pts_us);}
+  let mut session=AppendSession::new(1<<20,64);session.append(&edited).unwrap();
+  assert_eq!(session.buffered()[0].start,0);
+  // Unsupported edits fail without replacing the last valid mapping.
+  for mode in 0..3 {
+   let mut bad=moov.clone();let entries=&mut bad.trak_boxes[0].edts_box.as_mut().unwrap().elst_box.as_mut().unwrap().entries;
+   if mode==0 {entries[0].media_time=-1;}else if mode==1 {entries[0].media_rate.integer=2;}else{entries.push(entries[0].clone());}
+   let mut init=ftyp.clone();init.extend(bad.encode_to_vec().unwrap());assert_eq!(d.init(&init),Err(Error::UnsupportedLayout));
+  }
+  let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();
+  let mut media=pair[0].clone();media.extend_from_slice(&pair[1]);
+  assert_eq!(d.media(&media).unwrap()[0].pts_us,output[0].pts_us,"invalid edits cannot replace the active offset");
+  // A nonzero movie duration does not change the composition-time offset.
+  let edit=&mut moov.trak_boxes[0].edts_box.as_mut().unwrap().elst_box.as_mut().unwrap().entries[0];
+  edit.edit_duration=u64::from(u32::MAX)+1;
+  let mut long=ftyp.clone();long.extend(moov.encode_to_vec().unwrap());d.init(&long).unwrap();
+  assert_eq!(d.media(&media).unwrap()[0].pts_us,output[0].pts_us);
+  let count=long.windows(4).position(|b|b==b"elst").unwrap()+8;
+  long[count..count+4].copy_from_slice(&u32::MAX.to_be_bytes());
+  assert_eq!(d.init(&long),Err(Error::UnsupportedLayout),"hostile edit count rejected before allocation");
+  moov.trak_boxes[0].edts_box=None;
+  let mut reset=ftyp.clone();reset.extend(moov.encode_to_vec().unwrap());d.init(&reset).unwrap();
+  assert_eq!(d.media(&media).unwrap()[0].pts_us,0,"a later clear init removes its former edit offset");
+ }
+}
