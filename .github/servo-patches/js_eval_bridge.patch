+/// Argon: evaluate an app-bundled JavaScript string in the active webview's
+/// page context and deliver the result to Callbacks.onJsResult. The result
+/// (JSON) or error never leaves the app; this is not exposed to web content.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_org_servo_servoview_JNIServo_evaluateScript<'local>(
+    mut env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    request_id: jint,
+    script: JString<'local>,
+) {
+    env.with_env(|env| -> jni::errors::Result<_> {
+        let script = JString::cast_local(env, script)?.try_to_string(env)?;
+        call(env, move |s| {
+            let Some(webview) = s.active_or_newest_webview() else {
+                notify_js_result(request_id, None, Some("no active webview".to_owned()));
+                return;
+            };
+            webview.evaluate_javascript(script, move |result| {
+                let (json, error) = match result {
+                    Ok(value) => (serde_json::to_string(&value).ok(), None),
+                    Err(err) => (None, Some(format!("{err:?}"))),
+                };
+                notify_js_result(request_id, json, error);
+            });
+        });
+        Ok(())
+    })
+    .resolve::<ThrowRuntimeExAndDefault>()
+}
+
+fn notify_js_result(request_id: jint, json: Option<String>, error: Option<String>) {
+    let Some(jvm) = JS_EVAL_JVM.get() else {
+        error!("evaluateScript result dropped: JVM unavailable");
+        return;
+    };
+    let _ = jvm.attach_current_thread(|env| -> Result<(), Error> {
+        let json_arg = match &json {
+            Some(s) => match new_string_as_jvalue(env, s) {
+                Ok(v) => v,
+                Err(_) => return Ok(()),
+            },
+            None => JValueOwned::Object(JObject::null()),
+        };
+        let err_arg = match &error {
+            Some(s) => match new_string_as_jvalue(env, s) {
+                Ok(v) => v,
+                Err(_) => return Ok(()),
+            },
+            None => JValueOwned::Object(JObject::null()),
+        };
+        env.call_method(
+            callback_ref(),
+            jni_str!("onJsResult"),
+            jni_sig!("(ILjava/lang/String;Ljava/lang/String;)V"),
+            &[JValue::Int(request_id), (&json_arg).into(), (&err_arg).into()],
+        )?;
+        Ok(())
+    });
+}
