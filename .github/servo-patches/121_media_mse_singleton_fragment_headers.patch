+#[test]
+fn duplicate_fragment_singleton_headers_are_not_silently_ignored() {
+ use shiguredo_mp4::{Decode,Encode,boxes::MoofBox};
+ use servo_media_android_hosttest::mse_demux::Error;
+ let bs=boxes();let init:Vec<u8>=bs.iter().filter(|b|&b[4..8]==b"ftyp"||&b[4..8]==b"moov").flatten().copied().collect();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();
+ for kind in [*b"mfhd",*b"tfhd",*b"tfdt"] {
+  let(mut moof,_)=MoofBox::decode(&pair[0]).unwrap();
+  let old=moof.encode_to_vec().unwrap();
+  let h=old.windows(4).position(|w|w==kind).unwrap()-4;
+  let size=u32::from_be_bytes(old[h..h+4].try_into().unwrap())as usize;
+  let extra=old[h..h+size].to_vec();
+  for run in &mut moof.traf_boxes[0].trun_boxes {run.data_offset=run.data_offset.map(|o|o+extra.len()as i32);}
+  let mut encoded=moof.encode_to_vec().unwrap();
+  let t=encoded.windows(4).position(|w|w==b"traf").unwrap()-4;
+  let n=u32::from_be_bytes(encoded[t..t+4].try_into().unwrap())as usize;
+  if kind==*b"mfhd" {encoded.extend_from_slice(&extra);}else {
+   encoded.splice(t+n..t+n,extra.clone());
+   encoded[t..t+4].copy_from_slice(&((n+extra.len())as u32).to_be_bytes());
+  }
+  let n=encoded.len()as u32;encoded[..4].copy_from_slice(&n.to_be_bytes());encoded.extend_from_slice(&pair[1]);
+  let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();
+  assert_eq!(d.media_complete(&encoded),Err(Error::InvalidBox));
+  assert!(matches!(d.media(&encoded),Err(Error::InvalidBox)));
+  let mut clear=pair[0].clone();clear.extend_from_slice(&pair[1]);
+  assert_eq!(d.media(&clear).unwrap().len(),1);
+ }
+}
