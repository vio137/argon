+#[test]
+fn reopen_resets_eos_output_epoch_and_preserves_retained_data_and_finite_duration() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.end_input().unwrap();
+    p.clock.rebase(250_000);
+    p.rendered_frames = 8;
+    p.video_done = true;
+    p.reopen_input().unwrap();
+    assert!(!p.input_ended);
+    assert_eq!(p.duration_us(), Some(1_000_000));
+    assert_eq!(p.buffered(), [0..1_000_000]);
+    assert_eq!(p.seek_target, Some(250_000));
+    assert_eq!(p.rendered_frames, 0);
+    assert!(!p.video_done);
+    assert!(!p.take_seek_ready());
+    assert!(p.reopen_input().is_err());
+}
+#[test]
+fn reopen_at_exclusive_end_waits_for_new_coverage_without_replaying_old_eos() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.end_input().unwrap();
+    p.clock.rebase(1_000_000);
+    p.reopen_input().unwrap();
+    assert_eq!(p.removed_target, Some(1_000_000));
+    assert_eq!(p.seek_target, None);
+    assert_eq!(p.seek_started, None);
+    assert_eq!(p.clock.now_us(), 1_000_000);
+    assert!(!p.pump().unwrap().finished);
+}
