+#[cfg(test)] mod reopen_tests {
+ use crate::{append_source::*,append::AppendEvent,generic_channel::GenericCallback,mse_player::AndroidAppendPlayer};
+ use std::{sync::{Arc,mpsc},time::Duration};
+ #[test] fn reopened_source_keeps_buffer_identity_and_opens_before_next_update() {
+  let p=AndroidAppendPlayer::new(83,GenericCallback::new(|_|{}).unwrap(),None,Box::new(||{})).unwrap();
+  let(tx,rx)=mpsc::channel();let source=AppendSource::new(Arc::new(move|e|{let _=tx.send(e);}));source.attach(p).unwrap();
+  assert_eq!(rx.recv().unwrap(),SourceEvent::Open);let b=source.add_buffer("video/mp4").unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::Ready,_)){break;}}
+  for e in rx.try_iter(){assert_eq!(e,SourceEvent::BufferAdded(b.id()));}
+  b.append(include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec()).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,1)){break;}}
+  source.end_input().unwrap();assert_eq!(rx.recv().unwrap(),SourceEvent::Ended);
+  source.reopen().unwrap();assert_eq!(source.state(),SourceState::Open);assert_eq!(rx.recv().unwrap(),SourceEvent::Open);
+  assert!(b.same_buffer(&source.buffers()[0]));assert!(source.reopen().is_err());
+  b.append(vec![]).unwrap();
+  for e in [AppendEvent::UpdateStart,AppendEvent::Update,AppendEvent::UpdateEnd]{assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(b.id(),e,2));}
+  source.detach();assert!(source.reopen().is_err());
+ }
+}
