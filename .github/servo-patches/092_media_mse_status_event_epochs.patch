+#[cfg(test)] mod epoch_event_tests {
+ use crate::{generic_channel::GenericCallback,mse_player::AndroidAppendPlayer,Player,PlayerEvent,append::AppendEvent};
+ use std::{sync::mpsc,time::Duration};
+ #[test] fn queued_status_payload_retains_old_epoch_and_new_status_matches_removed_buffer_epoch() {
+  let(tx,events)=mpsc::channel();let player=AndroidAppendPlayer::new(98,GenericCallback::new(move|e|{if let Ok(e)=e{let _=tx.send(e);}}).unwrap(),None,Box::new(||{})).unwrap();
+  let(tx,updates)=mpsc::channel();player.lock().unwrap().append_add_buffer(1,Box::new(move|e|{let _=tx.send(e);})).unwrap();assert_eq!(updates.recv_timeout(Duration::from_secs(2)).unwrap(),AppendEvent::Ready);
+  player.lock().unwrap().append_to_buffer(1,include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec()).unwrap();
+  let old=loop{match events.recv_timeout(Duration::from_secs(2)).unwrap(){e@PlayerEvent::AppendEpoch{generation:0,..}=>break e,PlayerEvent::Error(e)=>panic!("{e}"),_=>()}};
+  loop{if updates.recv_timeout(Duration::from_secs(2)).unwrap()==AppendEvent::UpdateEnd{break;}}
+  player.lock().unwrap().append_remove_buffer(1).unwrap();assert_eq!(player.lock().unwrap().append_event_epoch(),1);
+  match old{PlayerEvent::AppendEpoch{generation,event}=>{assert_eq!(generation,0);assert!(!matches!(*event,PlayerEvent::AppendEpoch{..}));assert_ne!(generation,player.lock().unwrap().append_event_epoch());},_=>panic!("unversioned status")}
+  loop{match events.recv_timeout(Duration::from_secs(2)).unwrap(){PlayerEvent::AppendEpoch{generation:1,event}=>{assert!(!matches!(*event,PlayerEvent::AppendEpoch{..}));break;},PlayerEvent::Error(e)=>panic!("{e}"),_=>()}}
+ }
+}
