+    #[test]
+    fn surviving_append_bounds_arriving_after_removal_are_retained_before_updateend() {
+        let p = AndroidAppendPlayer::new(
+            100,
+            GenericCallback::new(|_| {}).unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let p = p.lock().unwrap();
+        drop(p.worker.lock().unwrap().take());
+        let (worker, rx) = Worker::saturated_for_test();
+        *p.worker.lock().unwrap() = Some(worker);
+        rx.recv().unwrap();
+        {
+            let mut s = p.state.lock().unwrap();
+            for id in [1, 2] {
+                s.buffers.insert(
+                    id,
+                    BufferState {
+                        ready: true,
+                        updating: id == 2,
+                        removing: false,
+                        operation: 1,
+                        callback: Arc::new(|_| {}),
+                    },
+                );
+            }
+            s.duration_seconds = 10.0;
+            s.apply_buffer_duration_bounds(&[
+                (1, Some(9_000_000), 10_000_000),
+                (2, Some(500_000), 1_000_000),
+            ]);
+        }
+        p.append_remove_buffer(1).unwrap();
+        rx.recv().unwrap();
+        {
+            let mut s = p.state.lock().unwrap();
+            assert_eq!(s.removal_generation, 1);
+            // The survivor append finished in generation0, but removeSourceBuffer
+            // accepted generation1 before its Status callback acquired State.
+            s.apply_buffer_duration_bounds(&[
+                (1, Some(9_000_000), 10_000_000),
+                (2, Some(2_000_000), 3_000_000),
+            ]);
+            assert!(!s.buffer_duration_bounds.contains_key(&1));
+            assert_eq!(s.highest_pts, Some(2_000_000));
+            assert_eq!(s.highest_end, 3_000_000);
+            s.buffers.get_mut(&2).unwrap().updating = false;
+        }
+        assert_eq!(p.append_set_duration(1.0), Err(PlayerError::SeekOutOfRange));
+        assert_eq!(p.append_set_duration(2.0), Ok((3.0, 1)));
+    }
 }
