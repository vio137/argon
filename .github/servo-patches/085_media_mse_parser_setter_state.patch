+#[test]
+fn parsing_media_state_tracks_partial_moof_until_complete_mdat_and_clears_on_abort() {
+ use servo_media_android_hosttest::mse_demux::append::AppendStream;
+ let bs=boxes();let init=bs.iter().filter(|b| &b[4..8]==b"ftyp" || &b[4..8]==b"moov").flat_map(|b|b.iter().copied()).collect::<Vec<_>>();
+ let pair=bs.windows(2).find(|p| &p[0][4..8]==b"moof" && &p[1][4..8]==b"mdat").unwrap();
