+#[cfg(test)] mod parser_state_routing_tests {
+ use crate::{append_source::*,append::AppendEvent,generic_channel::GenericCallback,mse_player::AndroidAppendPlayer,mse_demux::BoxFramer};
+ use std::{sync::{Arc,mpsc},time::Duration};
+ #[test] fn parser_state_is_visible_before_updateend_even_when_buffered_ranges_do_not_change() {
+  let p=AndroidAppendPlayer::new(85,GenericCallback::new(|_|{}).unwrap(),None,Box::new(||{})).unwrap();
+  let(tx,rx)=mpsc::channel();let source=AppendSource::new(Arc::new(move|e|{let _=tx.send(e);}));source.attach(p).unwrap();
+  let b=source.add_buffer("video/mp4").unwrap();loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::Ready,_)){break;}}
+  for _ in rx.try_iter(){}
+  let mut f=BoxFramer::new(1<<20);f.append(include_bytes!("../tests/fixtures/synthetic-fmp4.mp4")).unwrap();let mut init=vec![];let mut media=vec![];
+  while let Some(boxdata)=f.pop_box().unwrap(){match &boxdata[4..8]{b"ftyp"|b"moov"=>init.extend(boxdata),b"moof"|b"mdat"=>media.extend(boxdata),_=>()}}
+  init.extend_from_slice(&media[..8]);b.append(init).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,1)){break;}}
+  assert!(b.buffered().is_empty());assert!(b.parsing_media_segment().unwrap());
+  b.append(media[8..].to_vec()).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,2)){break;}}
+  assert!(!b.parsing_media_segment().unwrap());assert_eq!(b.buffered(),[0.0..1.0]);
+  b.append(media[..8].to_vec()).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,3)){break;}}
+  assert!(b.parsing_media_segment().unwrap());
+  b.abort().unwrap();assert!(!b.parsing_media_segment().unwrap());b.append(vec![]).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,5)){break;}}
+  assert!(!b.parsing_media_segment().unwrap());source.detach();assert_eq!(b.parsing_media_segment(),Err(SourceError::InvalidState));
+ }
+}
