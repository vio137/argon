+#[cfg(test)] mod ended_options_tests {
+ use crate::{append_source::*,append::AppendEvent,generic_channel::GenericCallback,mse_player::AndroidAppendPlayer};
+ use std::{sync::{Arc,mpsc},time::Duration};
+ #[test] fn ended_window_update_keeps_source_ended_without_sourceopen_and_survives_reopen() {
+  let p=AndroidAppendPlayer::new(85,GenericCallback::new(|_|{}).unwrap(),None,Box::new(||{})).unwrap();
+  let(tx,rx)=mpsc::channel();let source=AppendSource::new(Arc::new(move|e|{let _=tx.send(e);}));source.attach(p).unwrap();
+  let b=source.add_buffer("video/mp4").unwrap();loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::Ready,_)){break;}}
+  for _ in rx.try_iter(){}
+  b.append(include_bytes!("../tests/fixtures/synthetic-fmp4.mp4").to_vec()).unwrap();
+  loop{if matches!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(_,AppendEvent::UpdateEnd,1)){break;}}
+  source.end_input().unwrap();assert_eq!(rx.recv().unwrap(),SourceEvent::Ended);
+  b.set_options(0.0,0.25..0.75).unwrap();
+  assert_eq!(source.state(),SourceState::Ended);assert!(rx.try_recv().is_err());
+  assert_eq!(b.options().unwrap(),(0.0,0.25..0.75));
+  assert_eq!(b.set_options(0.0,0.75..0.25),Err(SourceError::Type));
+  assert_eq!(b.options().unwrap(),(0.0,0.25..0.75));
+  source.reopen().unwrap();assert_eq!(rx.recv().unwrap(),SourceEvent::Open);
+  assert_eq!(b.options().unwrap(),(0.0,0.25..0.75));
+  b.remove(0.0,0.25).unwrap();
+  for e in [AppendEvent::UpdateStart,AppendEvent::Update,AppendEvent::UpdateEnd]{assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap(),SourceEvent::BufferEvent(b.id(),e,2));}
+  source.detach();assert_eq!(b.set_options(0.0,0.0..1.0),Err(SourceError::InvalidState));
+ }
+}
