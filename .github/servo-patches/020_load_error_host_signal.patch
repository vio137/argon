+
+    /// Argon: forward top-level load failures to the app. Only the kind is
+    /// logged; url and reason may be private and are never logged.
+    fn on_load_error(&self, url: String, kind: LoadErrorKind, reason: String) {
+        debug!("on_load_error: {kind:?}");
+        let kind_str = match kind {
+            LoadErrorKind::Network => "network",
+            LoadErrorKind::Tls => "tls",
+            LoadErrorKind::Crash => "crash",
+        };
+        self.jvm
+            .attach_current_thread(|env| -> Result<(), Error> {
+                let Ok(url_string) = new_string_as_jvalue(env, &url) else {
+                    return Ok(());
+                };
+                let Ok(kind_string) = new_string_as_jvalue(env, kind_str) else {
+                    return Ok(());
+                };
+                let Ok(reason_string) = new_string_as_jvalue(env, &reason) else {
+                    return Ok(());
+                };
+                env.call_method(
+                    callback_ref(),
+                    jni_str!("onLoadError"),
+                    jni_sig!("(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V"),
+                    &[(&url_string).into(), (&kind_string).into(), (&reason_string).into()],
+                )?;
+                Ok(())
+            })
+            .unwrap();
+    }
 }
 
