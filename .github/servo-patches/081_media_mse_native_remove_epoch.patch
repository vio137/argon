+#[test]
+fn retained_target_removal_resets_native_epoch_before_committing_replay() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    loop {
+        let mut sink = ScopedDecoder {
+            buffer_id: 1,
+            decoders: &mut p.decoders,
+        };
+        if !p
+            .sessions
+            .get_mut(&1)
+            .unwrap()
+            .pump_input(&mut sink)
+            .unwrap()
+        {
+            break;
+        }
+    }
+    assert!(p.decoders.video.is_some());
+    p.rendered_frames = 9;
+    p.video_pending = Some(Instant::now());
+    p.video_done = true;
+    p.remove_retaining_target(1, 0, 250_000, 750_000).unwrap();
+    assert!(p.decoders.video.is_none());
+    assert!(p.decoders.surface.is_none());
+    assert!(p.video_pending.is_none());
+    assert!(!p.video_done);
+    assert_eq!(p.rendered_frames, 0);
+    assert_eq!(p.buffered(), [500_000..1_000_000]);
+    assert_eq!(p.video_seek_floor, Some(500_000));
+    assert_eq!(p.clock.now_us(), 750_000);
+    assert_eq!(p.seek_target, Some(750_000));
+    loop {
+        let mut sink = ScopedDecoder {
+            buffer_id: 1,
+            decoders: &mut p.decoders,
+        };
+        if !p
+            .sessions
+            .get_mut(&1)
+            .unwrap()
+            .pump_input(&mut sink)
+            .unwrap()
+        {
+            break;
+        }
+    }
+    assert!(p.decoders.video.is_some());
+    assert_eq!(p.decoders.first_pts, Some(500_000));
+}
+#[test]
+fn removal_missing_other_buffer_target_cannot_mutate_store_or_output_epoch() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.add_buffer(2).unwrap();
+    p.rendered_frames = 13;
+    p.video_pending = Some(Instant::now());
+    assert!(p.remove_retaining_target(1, 0, 250_000, 750_000).is_err());
+    assert_eq!(p.sessions.get(&1).unwrap().buffered(), [0..1_000_000]);
+    assert_eq!(p.rendered_frames, 13);
+    assert!(p.video_pending.is_some());
+    assert_eq!(p.seek_target, None);
+}
+#[test]
+fn removal_rejects_a_removed_target_or_pending_seek_without_mutation() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    assert!(p.remove_retaining_target(1, 0, 250_000, 100_000).is_err());
+    assert_eq!(p.buffered(), [0..1_000_000]);
+    p.reset_seek_epoch(750_000).unwrap();
+    assert!(p.remove_retaining_target(1, 0, 250_000, 750_000).is_err());
+    assert_eq!(p.buffered(), [0..1_000_000]);
+    assert_eq!(p.seek_target, Some(750_000));
+}
+
+#[test]
+fn current_position_removal_stalls_without_fake_seek_completion_or_timeout() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.rendered_frames = 8;
+    p.video_pending = Some(Instant::now());
+    p.remove_and_stall_if_needed(1, 0, 250_000, 100_000)
+        .unwrap();
+    assert_eq!(p.buffered(), [500_000..1_000_000]);
+    assert_eq!(p.removed_target, Some(100_000));
+    assert_eq!(p.seek_target, None);
+    assert_eq!(p.seek_started, None);
+    assert!(!p.take_seek_ready());
+    assert_eq!(p.rendered_frames, 0);
+    assert!(p.video_pending.is_none());
+    let status = p.pump().unwrap();
+    assert!(!status.finished);
+    assert!(!status.current_data);
+    assert!(!status.playing);
+    assert_eq!(status.position_us, 100_000);
+    assert!(p.decoders.video.is_none());
+    // No new coded data covers the target: an empty append cannot resume it.
+    p.append(1, &[]).unwrap();
+    assert_eq!(p.removed_target, Some(100_000));
+    // A later append covers the missing target and stages a fresh native epoch,
+    // still waiting for real decoded output rather than signalling ready here.
+    let mut framer = crate::mse_demux::BoxFramer::new(1 << 20);
+    framer
+        .append(include_bytes!(
+            "../hosttest/tests/fixtures/synthetic-fmp4.mp4"
+        ))
+        .unwrap();
+    let mut media = vec![];
+    while let Some(b) = framer.pop_box().unwrap() {
+        if &b[4..8] == b"moof" || &b[4..8] == b"mdat" {
+            media.extend(b);
+        }
+    }
+    p.append(1, &media).unwrap();
+    assert_eq!(p.removed_target, None);
+    assert_eq!(p.seek_target, Some(100_000));
+    assert!(!p.take_seek_ready());
+    assert_eq!(p.buffered(), [0..1_000_000]);
+}
+#[test]
+fn invalid_current_removal_cannot_discard_live_output_or_frames() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    p.add_buffer(1).unwrap();
+    p.append(
+        1,
+        include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+    )
+    .unwrap();
+    p.rendered_frames = 7;
+    for (id, start, end, target) in [
+        (8, 0, 250_000, 100_000),
+        (1, -1, 250_000, 100_000),
+        (1, 0, 250_000, -1),
+    ] {
+        assert!(
+            p.remove_and_stall_if_needed(id, start, end, target)
+                .is_err()
+        );
+        assert_eq!(p.buffered(), [0..1_000_000]);
+        assert_eq!(p.rendered_frames, 7);
+        assert_eq!(p.removed_target, None);
+    }
+}
