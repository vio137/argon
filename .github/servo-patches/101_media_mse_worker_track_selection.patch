diff --git a/components/media/backends/android/android_impl/mse_playback_tests.rs b/components/media/backends/android/android_impl/mse_playback_tests.rs
--- a/components/media/backends/android/android_impl/mse_playback_tests.rs
+++ b/components/media/backends/android/android_impl/mse_playback_tests.rs
@@ -1532,3 +1532,24 @@
     assert_eq!(p.video_seek_floor, Some(500_000));
     assert!(!p.take_seek_ready());
 }
+
+#[test]
+fn selection_generation_is_monotonic_and_noop_ack_does_not_reset_output_epoch() {
+    let mut p = AppendPlayback::new(Arc::new(Mutex::new(Capture(Arc::new(Mutex::new(vec![]))))));
+    p.clock.rebase(42);
+    p.clock.pause();
+    p.rendered_frames = 9;
+    p.set_track_selection_generation(7, true, true).unwrap();
+    assert_eq!(p.selection_generation, 7);
+    assert_eq!(p.rendered_frames, 9);
+    assert_eq!(p.position_us(), 42);
+    assert!(p.set_track_selection_generation(7, false, false).is_err());
+    assert_eq!(
+        p.selection,
+        TrackSelection {
+            audio: true,
+            video: true
+        }
+    );
+    assert_eq!(p.rendered_frames, 9);
+}
