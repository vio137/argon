+    #[test]
+    fn track_selection_status_generation_precedes_ack_and_disabling_cannot_finish_pending_seek() {
+        let (tx, rx) = mpsc::channel();
+        let worker = Worker::spawn(
+            Arc::new(Mutex::new(Renderer)),
+            Box::new(move |e| {
+                let _ = tx.send(e);
+            }),
+        )
+        .unwrap();
+        let send = |c| assert!(worker.try_command(c).is_ok());
+        send(Command::AddBuffer(1));
+        send(Command::Seek {
+            operation: 201,
+            target_us: 500_000,
+        });
+        send(Command::TrackSelection {
+            generation: 3,
+            audio: false,
+            video: false,
+        });
+        let mut seen = false;
+        loop {
+            match rx.recv_timeout(Duration::from_secs(2)).unwrap() {
+                Event::Status(s) if s.selection_generation == 3 => {
+                    assert!(!s.audio_selected && !s.video_selected);
+                    assert!(!s.finished);
+                    assert!(!s.playing);
+                    seen = true;
+                },
+                Event::CommandApplied(Applied::TrackSelection(3)) => {
+                    assert!(seen);
+                    break;
+                },
+                Event::Error | Event::SeekReady { .. } | Event::SeekRejected(_) => {
+                    panic!("selection manufactured seek completion/error")
+                },
+                _ => (),
+            }
+        }
+    }
