+#[test]
+fn worker_retains_latest_seek_token_across_eos_reopen_and_completes_only_after_mock_output() {
+    use super::super::mse_worker::{Applied, Command, Event, Worker};
+    use std::sync::mpsc;
+    let (tx, rx) = mpsc::channel();
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let worker = Worker::spawn(
+        Arc::new(Mutex::new(Capture(frames.clone()))),
+        Box::new(move |event| {
+            // Thread-local NDK mocks, not an Android decode. Only the second append
+            // authorizes a synthetic acquired image to finish the latest seek.
+            if matches!(event, Event::CommandApplied(Applied::Appended(1, 2))) {
+                super::super::mse_codec::mock_video_output(500_000);
+                READY.with(|r| r.set(true));
+            }
+            let _ = tx.send(event);
+        }),
+    )
+    .unwrap();
+    let send = |c| assert!(worker.try_command(c).is_ok());
+    let ack = |expected| loop {
+        match rx.recv_timeout(Duration::from_secs(2)).unwrap() {
+            Event::CommandApplied(a) if a == expected => break,
+            Event::SeekReady { .. } => panic!("seek completed without coverage and mock image"),
+            Event::SeekRejected(_) | Event::Error => panic!("worker rejected or failed"),
+            _ => (),
+        }
+    };
+    send(Command::AddBuffer(1));
+    ack(Applied::BufferAdded(1));
+    send(Command::Options {
+        buffer_id: 1,
+        offset_us: 2_000_000,
+        window: 0..i64::MAX,
+    });
+    ack(Applied::Options(1));
+    send(Command::Append {
+        buffer_id: 1,
+        operation: 1,
+        bytes: include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4").to_vec(),
+    });
+    ack(Applied::Appended(1, 1));
+    send(Command::EndInput);
+    ack(Applied::InputEnded);
+    for (operation, target_us) in [(91, 250_000), (92, 500_000)] {
+        send(Command::Seek {
+            operation,
+            target_us,
+        });
+        ack(Applied::SeekStarted(operation));
+    }
+    send(Command::ReopenInput);
+    ack(Applied::InputReopened);
+    send(Command::Options {
+        buffer_id: 1,
+        offset_us: 0,
+        window: 0..i64::MAX,
+    });
+    ack(Applied::Options(1));
+    send(Command::Append {
+        buffer_id: 1,
+        operation: 2,
+        bytes: include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4").to_vec(),
+    });
+    ack(Applied::Appended(1, 2));
+    loop {
+        match rx.recv_timeout(Duration::from_secs(2)).unwrap() {
+            Event::SeekReady {
+                operation,
+                target_us,
+            } => {
+                assert_eq!((operation, target_us), (92, 500_000));
+                break;
+            },
+            Event::SeekRejected(_) | Event::Error => panic!("covered seek failed"),
+            _ => (),
+        }
+    }
+    assert!(!frames.lock().unwrap().is_empty());
+    send(Command::Playing(false));
+    loop {
+        match rx.recv_timeout(Duration::from_secs(2)).unwrap() {
+            Event::CommandApplied(Applied::Playing) => break,
+            Event::SeekReady { .. } => panic!("duplicate completion"),
+            Event::Error => panic!("worker failed"),
+            _ => (),
+        }
+    }
+}
