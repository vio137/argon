+        source.clear_live_seekable_range().unwrap();
+        assert_eq!(source.seekable_ranges(f64::INFINITY), [0.0..1.0]);
+        source.set_live_seekable_range(2.0, 2.0).unwrap();
+        assert_eq!(source.seekable_ranges(f64::INFINITY), [0.0..2.0]);
+        source.end_input().unwrap();
+        assert_eq!(
+            source.clear_live_seekable_range(),
+            Err(SourceError::InvalidState)
+        );
+        source.reopen().unwrap();
+        assert_eq!(source.seekable_ranges(f64::INFINITY), [0.0..2.0]);
+        source.detach();
+        assert!(source.seekable_ranges(f64::INFINITY).is_empty());
+        assert_eq!(
+            source.clear_live_seekable_range(),
+            Err(SourceError::InvalidState)
+        );
+    }
+}
