From 1c407ad8cdec016b2548eab79e3acfe1ce4d032a Mon Sep 17 00:00:00 2001
From: ci <a@b.c>
Date: Sat, 7 Nov 2026 18:48:55 +0530
Subject: [PATCH] 055 favicon pipeline

---
 ports/servoshell/egl/android/mod.rs | 25 +++++++++++++++++++++++++
 ports/servoshell/egl/app.rs         | 19 ++++++++++++++++++-
 ports/servoshell/egl/host_trait.rs  |  5 +++++
 3 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/ports/servoshell/egl/android/mod.rs b/ports/servoshell/egl/android/mod.rs
index 63f4c5d..d452c04 100644
--- a/ports/servoshell/egl/android/mod.rs
+++ b/ports/servoshell/egl/android/mod.rs
@@ -991,6 +991,31 @@ impl HostTrait for HostCallbacks {
             .unwrap();
     }
 
+    /// Argon (patch 055): forward favicon pixels to the app. `rgba` is the
+    /// first frame in RGBA8; correlation is by webview id string.
+    fn on_favicon_changed(&self, webview_id: WebViewId, rgba: Vec<u8>, width: u32, height: u32) {
+        let webview_id = webview_id.to_string();
+        self.jvm
+            .attach_current_thread(|env| -> Result<(), Error> {
+                let Ok(wv) = new_string_as_jvalue(env, &webview_id) else { return Ok(()); };
+                let Ok(pixels) = env.byte_array_from_slice(&rgba) else { return Ok(()); };
+                let pixels = JObject::from(pixels);
+                env.call_method(
+                    callback_ref(),
+                    jni_str!("onFaviconChanged"),
+                    jni_sig!("(Ljava/lang/String;[BII)V"),
+                    &[
+                        (&wv).into(),
+                        (&pixels).into(),
+                        (width as jint).into(),
+                        (height as jint).into(),
+                    ],
+                )?;
+                Ok(())
+            })
+            .unwrap();
+    }
+
     fn on_panic(&self, _reason: String, _backtrace: Option<String>) {}
 
     /// Argon: forward top-level load failures to the app. Only the kind is
diff --git a/ports/servoshell/egl/app.rs b/ports/servoshell/egl/app.rs
index b544b44..cbe1868 100644
--- a/ports/servoshell/egl/app.rs
+++ b/ports/servoshell/egl/app.rs
@@ -16,7 +16,7 @@ use servo::{
     KeyboardEvent, LoadErrorKind, LoadStatus, MouseButton, MouseButtonAction, MouseButtonEvent,
     ContextMenu, ContextMenuItem,
     MouseMoveEvent,
-    Opts, Preferences, RefreshDriver, RenderingContext, ScreenGeometry, Scroll, Servo,
+    Opts, PixelFormat, Preferences, RefreshDriver, RenderingContext, ScreenGeometry, Scroll, Servo,
     ServoBuilder, SimpleDialog, TouchEvent, TouchEventType, TouchId, TouchPointerType,
     UserContentManager, WebView, WebViewId, WindowRenderingContext, convert_rect_to_css_pixel,
 };
@@ -165,6 +165,23 @@ impl PlatformWindow for EmbeddedPlatformWindow {
             }
         }
 
+        // Argon (patch 055): drain freshly-loaded favicons to the embedder.
+        // The EGL front-end never consumed this queue, so without the drain
+        // it would also grow unbounded.
+        for favicon_id in window.take_pending_favicon_loads() {
+            let Some(favicon_webview) = state.webview_by_id(favicon_id) else {
+                continue;
+            };
+            let Some(image) = favicon_webview.favicon() else {
+                continue;
+            };
+            if image.format != PixelFormat::RGBA8 {
+                continue;
+            }
+            self.host
+                .on_favicon_changed(favicon_id, image.data().to_vec(), image.width, image.height);
+        }
+
         title_changed || url_changed || back_forward_changed || load_status_changed
     }
 
diff --git a/ports/servoshell/egl/host_trait.rs b/ports/servoshell/egl/host_trait.rs
index 8b8d186..8d66150 100644
--- a/ports/servoshell/egl/host_trait.rs
+++ b/ports/servoshell/egl/host_trait.rs
@@ -80,4 +80,9 @@ pub trait HostTrait {
     fn on_context_menu(&self, _webview_id: WebViewId, _handle: u32, _menu: &ContextMenu) {}
     /// Called when we get a panic message from constellation
     fn on_panic(&self, reason: String, backtrace: Option<String>);
+
+    /// Argon (patch 055): a webview's favicon changed. `rgba` holds the first
+    /// frame's pixels in RGBA8, `width` x `height`. Default no-op so
+    /// non-Android embedders are unaffected.
+    fn on_favicon_changed(&self, _webview_id: WebViewId, _rgba: Vec<u8>, _width: u32, _height: u32) {}
 }
