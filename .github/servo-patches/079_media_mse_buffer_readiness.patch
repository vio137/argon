diff --git a/components/media/player/append.rs b/components/media/player/append.rs
index 9906bcaa7..c4d047ca3 100644
--- a/components/media/player/append.rs
+++ b/components/media/player/append.rs
@@ -22,3 +22,44 @@ pub struct AppendTrack { pub id:u32, pub mime:String }
 #[derive(Clone,Copy,Debug,PartialEq,Eq)]
 pub struct AppendNotification {pub operation:u64,pub event:AppendEvent}
 pub type AppendOperationCallback=Box<dyn Fn(AppendNotification)+Send+Sync>;
+
+/// Private append-source ready-state decision. Buffered future data alone
+/// never counts as decoded current data. The 500ms horizon is a buffering
+/// policy, not a promise of device decoding or uninterrupted network delivery.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub enum AppendReadiness { Metadata, Current, Future, Enough }
+pub fn readiness(position: i64, ranges: &[std::ops::Range<i64>], decoded: bool,
+                 duration: Option<i64>) -> AppendReadiness {
+    let covering = ranges.iter().find(|r| r.start <= position && position < r.end);
+    if !decoded { return AppendReadiness::Metadata; }
+    if let Some(range) = covering {
+        if duration.is_some_and(|end| range.end >= end) || range.end.saturating_sub(position) >= 500_000 {
+            AppendReadiness::Enough
+        } else { AppendReadiness::Future }
+    } else if ranges.iter().any(|r| r.end == position) {
+        AppendReadiness::Current
+    } else { AppendReadiness::Metadata }
+}
+#[cfg(test)] mod readiness_tests {
+    use super::*;
+    #[test] fn decoded_output_is_required_even_for_large_buffer() {
+        assert_eq!(readiness(0,&[0..2_000_000],false,None),AppendReadiness::Metadata);
+    }
+    #[test] fn gap_cannot_use_an_old_decoded_frame_or_future_range() {
+        assert_eq!(readiness(1_000_000,&[0..500_000,1_500_000..2_000_000],true,None),AppendReadiness::Metadata);
+    }
+    #[test] fn buffered_horizon_transitions_before_starvation() {
+        assert_eq!(readiness(0,&[0..1_000_000],true,None),AppendReadiness::Enough);
+        assert_eq!(readiness(500_000,&[0..1_000_000],true,None),AppendReadiness::Enough);
+        assert_eq!(readiness(500_001,&[0..1_000_000],true,None),AppendReadiness::Future);
+        assert_eq!(readiness(1_000_000,&[0..1_000_000],true,None),AppendReadiness::Current);
+        assert_eq!(readiness(1_000_001,&[0..1_000_000],true,None),AppendReadiness::Metadata);
+    }
+    #[test] fn short_ended_range_before_a_gap_is_not_enough_to_finish() {
+        assert_eq!(readiness(0,&[0..100_000,200_000..300_000],true,Some(300_000)),AppendReadiness::Future);
+    }
+    #[test] fn short_ended_stream_needs_no_additional_future_input() {
+        assert_eq!(readiness(0,&[0..100_000],true,Some(100_000)),AppendReadiness::Enough);
+        assert_eq!(readiness(0,&[0..100_000],false,Some(100_000)),AppendReadiness::Metadata);
+    }
+}
