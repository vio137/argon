         })
     }
+    /// Trim only the initial seek preroll, never samples already submitted.
+    /// Whole interleaved frames are skipped with ceiling rounding so no
+    /// sample before the target leaks into the endpoint.
+    pub fn new_after(
+        samples: Vec<i16>,
+        channels: usize,
+        pts_us: i64,
+        rate: u32,
+        target_us: i64,
+    ) -> Option<Self> {
+        if rate == 0 || rate > 192000 {
+            return None;
+        }
+        let mut queue = Self::new(samples, channels, pts_us)?;
+        let delta = (i128::from(target_us) - i128::from(pts_us)).max(0);
+        let skip =
+            ((delta * i128::from(rate) + 999_999) / 1_000_000).min(queue.frames() as i128) as usize;
+        queue.offset_frames = skip;
+        let elapsed = (skip as i128) * 1_000_000 / i128::from(rate);
+        queue.pts_us = i64::try_from(i128::from(pts_us) + elapsed).ok()?;
+        Some(queue)
+    }
     pub fn remaining(&self) -> &[i16] {
         &self.samples[self.offset_frames * self.channels..]
     }
