+#[test]
+fn seek_preroll_is_discarded_even_when_close_to_target_or_paused() {
+    for playing in [false, true] {
+        let mut c = codec();
+        assert!(matches!(
+            c.poll_output_after(100_001, playing, Some(100_001)),
+            Ok(MseOutput::Retry)
+        ));
+        MOCK.with(|m| assert_eq!(m.borrow().releases, [false]));
+        assert!(c.held_output.is_none());
+    }
+}
+#[test]
+fn seek_target_frame_can_be_released_but_preroll_eos_is_not_rendered() {
+    let mut c = codec();
+    assert!(matches!(
+        c.poll_output_after(100_000, true, Some(100_000)),
+        Ok(MseOutput::SurfaceReleased { .. })
+    ));
+    MOCK.with(|m| assert_eq!(m.borrow().releases, [true]));
+    let mut c = codec();
+    MOCK.with(|m| m.borrow_mut().flags = 4);
+    assert!(matches!(
+        c.poll_output_after(200_000, false, Some(200_000)),
+        Ok(MseOutput::EndOfStream)
+    ));
+    MOCK.with(|m| assert_eq!(m.borrow().releases, [false]));
+}
