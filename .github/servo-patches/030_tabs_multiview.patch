+    /// Argon (tabs, patch 030): open a new top-level webview on `url` and
+    /// activate it. Returns None when the URL fails to parse.
+    pub(crate) fn new_tab(&self, url: &str) -> Option<WebViewId> {
+        let url = Url::parse(url).ok()?;
+        Some(
+            self.window()
+                .create_and_activate_toplevel_webview(
+                    self.state.clone(),
+                    TopLevelWebViewCreationRequest::WithUrl(url),
+                )
+                .id(),
+        )
+    }
+
+    /// Argon (tabs, patch 030): activate the webview whose Display-form id
+    /// equals `id`. Returns false when no live webview matches.
+    pub(crate) fn activate_tab(&self, id: &str) -> bool {
+        let Some(webview_id) = self.find_webview_id(id) else {
+            return false;
+        };
+        self.activate_webview(webview_id);
+        true
+    }
+
+    /// Argon (tabs, patch 030): close the webview whose Display-form id
+    /// equals `id`. Closing the active tab activates the next-newest
+    /// (WebViewCollection::remove). Returns false when no live webview
+    /// matches.
+    pub(crate) fn close_tab(&self, id: &str) -> bool {
+        let Some(webview_id) = self.find_webview_id(id) else {
+            return false;
+        };
+        self.window().close_webview(webview_id);
+        true
+    }
+
+    /// Argon (tabs, patch 030): the active (or newest) webview's Display-form
+    /// id, so the app can learn the current tab after any tab operation.
+    pub(crate) fn active_tab_id(&self) -> Option<String> {
+        self.active_or_newest_webview()
+            .map(|webview| webview.id().to_string())
+    }
+
+    /// Argon (tabs, patch 030): match a Display-form id against the live
+    /// webviews (ids cross JNI as opaque strings; exact string equality).
+    fn find_webview_id(&self, id: &str) -> Option<WebViewId> {
+        self.window()
+            .webview_ids()
+            .into_iter()
+            .find(|webview_id| webview_id.to_string() == id)
+    }
+
