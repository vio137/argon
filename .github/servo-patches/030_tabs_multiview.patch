+/// Argon (tabs, patch 030): open a new tab on `url`, make it active, and
+/// return its opaque tab id (empty string on failure).
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_org_servo_servoview_JNIServo_newTab<'local>(
+    mut env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    url: JString<'local>,
+) -> jobject {
+    env.with_env(|env| -> jni::errors::Result<jobject> {
+        let url_string = url.to_string();
+        let mut id = String::new();
+        call(env, |s| {
+            id = s
+                .new_tab(&url_string)
+                .map(|webview_id| webview_id.to_string())
+                .unwrap_or_default();
+        });
+        let out = env.new_string(id)?;
+        Ok(out.into_raw() as jobject)
+    })
+    .resolve::<ThrowRuntimeExAndDefault>()
+}
+
+/// Argon (tabs, patch 030): activate the tab with the given opaque id.
+/// Returns true when a live tab matched.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_org_servo_servoview_JNIServo_activateTab<'local>(
+    mut env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    id: JString<'local>,
+) -> jboolean {
+    env.with_env(|env| -> jni::errors::Result<jboolean> {
+        let id_string = id.to_string();
+        let mut found = false;
+        call(env, |s| found = s.activate_tab(&id_string));
+        Ok(found as jboolean)
+    })
+    .resolve::<ThrowRuntimeExAndDefault>()
+}
+
+/// Argon (tabs, patch 030): close the tab with the given opaque id; the
+/// next-newest tab becomes active. Returns true when a live tab matched.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_org_servo_servoview_JNIServo_closeTab<'local>(
+    mut env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    id: JString<'local>,
+) -> jboolean {
+    env.with_env(|env| -> jni::errors::Result<jboolean> {
+        let id_string = id.to_string();
+        let mut found = false;
+        call(env, |s| found = s.close_tab(&id_string));
+        Ok(found as jboolean)
+    })
+    .resolve::<ThrowRuntimeExAndDefault>()
+}
+
+/// Argon (tabs, patch 030): the active tab's opaque id (empty string when no
+/// tab exists).
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_org_servo_servoview_JNIServo_activeTabId<'local>(
+    mut env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+) -> jobject {
+    env.with_env(|env| -> jni::errors::Result<jobject> {
+        let mut id = String::new();
+        call(env, |s| id = s.active_tab_id().unwrap_or_default());
+        let out = env.new_string(id)?;
+        Ok(out.into_raw() as jobject)
+    })
+    .resolve::<ThrowRuntimeExAndDefault>()
+}
