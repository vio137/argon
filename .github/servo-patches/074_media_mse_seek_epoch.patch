+#[test]
+fn seek_epoch_resets_outputs_and_replays_scoped_codec_configuration() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut playback = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    playback.add_buffer(1).unwrap();
+    playback
+        .append(
+            1,
+            include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+        )
+        .unwrap();
+    // Feed accepted coded data without claiming decoded/displayed output.
+    loop {
+        let mut sink = ScopedDecoder {
+            buffer_id: 1,
+            decoders: &mut playback.decoders,
+        };
+        if !playback
+            .sessions
+            .get_mut(&1)
+            .unwrap()
+            .pump_input(&mut sink)
+            .unwrap()
+        {
+            break;
+        }
+    }
+    assert!(playback.decoders.video.is_some());
+    playback.rendered_frames = 9;
+    playback.video_pending = Some(Instant::now());
+    playback.video_done = true;
+    playback.reset_seek_epoch(750_000).unwrap();
+    assert!(playback.decoders.video.is_none());
+    assert!(playback.decoders.surface.is_none());
+    assert!(playback.decoders.track_ids.is_empty());
+    assert!(playback.video_pending.is_none());
+    assert!(!playback.video_done);
+    assert_eq!(playback.rendered_frames, 0);
+    assert_eq!(playback.clock.now_us(), 750_000);
+    loop {
+        let mut sink = ScopedDecoder {
+            buffer_id: 1,
+            decoders: &mut playback.decoders,
+        };
+        if !playback
+            .sessions
+            .get_mut(&1)
+            .unwrap()
+            .pump_input(&mut sink)
+            .unwrap()
+        {
+            break;
+        }
+    }
+    assert!(playback.decoders.video.is_some());
+    assert!(playback.decoders.track_ids.contains_key(&(1, 1)));
+    assert_eq!(playback.decoders.first_pts, Some(500_000));
+    assert_eq!(playback.buffered(), [0..1_000_000]);
+}
+#[test]
+fn a_seek_missing_any_source_buffer_preserves_the_existing_epoch() {
+    let frames = Arc::new(Mutex::new(Vec::new()));
+    let mut playback = AppendPlayback::new(Arc::new(Mutex::new(Capture(frames))));
+    playback.add_buffer(1).unwrap();
+    playback
+        .append(
+            1,
+            include_bytes!("../hosttest/tests/fixtures/synthetic-fmp4.mp4"),
+        )
+        .unwrap();
+    playback.add_buffer(2).unwrap();
+    playback.rendered_frames = 11;
+    playback.video_pending = Some(Instant::now());
+    assert!(playback.reset_seek_epoch(500_000).is_err());
+    assert_eq!(playback.rendered_frames, 11);
+    assert!(playback.video_pending.is_some());
+    assert_eq!(
+        playback.sessions.get(&1).unwrap().buffered(),
+        [0..1_000_000]
+    );
+}
