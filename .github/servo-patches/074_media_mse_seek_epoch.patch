+    /// Native seek reset primitive. All sessions are staged first so an
+    /// unbuffered target cannot disturb the current decoder/output epoch.
+    /// Player/DOM completion and preroll presentation are not wired here yet.
+    pub fn reset_seek_epoch(&mut self, target_us: i64) -> Result<(), ()> {
+        if self.failed || self.sessions.is_empty() {
+            return Err(());
+        }
+        let plans = self
+            .sessions
+            .iter()
+            .map(|(id, s)| Ok((*id, s.stage_seek(target_us).map_err(|_| ())?)))
+            .collect::<Result<Vec<_>, ()>>()?;
+        self.audio.close();
+        self.audio.pending = None;
+        self.decoders.reset_epoch();
+        self.video_pending = None;
+        self.video_color = (None, None);
+        self.drain_wait = None;
