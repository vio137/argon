+#[test]
+fn init_table_padding_rejects_and_empty_co64_remains_valid() {
+ use servo_media_android_hosttest::mse_demux::Error;
+ fn pad_box(b:&[u8],kind:&[u8;4])->Vec<u8>{
+  let mut out=b[..8].to_vec();
+  if [b"moov",b"trak",b"mdia",b"minf",b"stbl",b"mvex"].iter().any(|k|&b[4..8]==*k) {
+   let mut pos=8;while pos<b.len(){let len=u32::from_be_bytes(b[pos..pos+4].try_into().unwrap())as usize;out.extend(pad_box(&b[pos..pos+len],kind));pos+=len;}
+  }else{out.extend_from_slice(&b[8..]);if &b[4..8]==kind{out.push(0);}}
+  let len=out.len()as u32;out[..4].copy_from_slice(&len.to_be_bytes());out
+ }
+ let bs=boxes();let ftyp=bs.iter().find(|b|&b[4..8]==b"ftyp").unwrap();let moov=bs.iter().find(|b|&b[4..8]==b"moov").unwrap();let init=[ftyp.as_slice(),moov.as_slice()].concat();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();let media=[pair[0].as_slice(),pair[1].as_slice()].concat();
+ for kind in [*b"stts",*b"stsc",*b"stsz",*b"stco",*b"trex"] {
+  let mut bad=ftyp.clone();bad.extend(pad_box(moov,&kind));assert_eq!(bad.len(),init.len()+1);
+  let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();assert_eq!(d.init(&bad),Err(Error::InvalidBox));assert!(d.media(&media).unwrap()[0].codec_config.is_some());
+ }
+ let mut wide=init.clone();let pos=wide.windows(4).position(|b|b==b"stco").unwrap();wide[pos..pos+4].copy_from_slice(b"co64");
+ let mut d=Demux::new(1<<20,64);d.init(&wide).unwrap();let unit=d.media(&media).unwrap().remove(0);assert_eq!(unit.data,&pair[1][8..]);
+ for byte in [4,7] {let mut bad=wide.clone();bad[pos+byte]=1;assert_eq!(d.init(&bad),Err(Error::UnsupportedLayout));}
+}
