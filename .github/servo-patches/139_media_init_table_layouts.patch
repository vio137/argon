+// Empty initialization tables and trex defaults have fixed version-zero
+// layouts. Reject ignored metadata before the dependency can materialize or
+// commit it. This intentionally covers only the adapter's no-sample profile.
+fn validate_init_table(kind: [u8;4], p:&[u8])->Result<(),Error> {
+    let (length,count)=match &kind {
+        b"stts"|b"stsc"|b"stco"|b"co64"=>(8,Some(4)),
+        b"stsz"=>(12,Some(8)),
+        b"trex"=>(24,None),
+        _=>return Ok(()),
+    };
+    if p.len()<4 {return Err(Error::Truncated);}
+    if p[..4]!=[0,0,0,0] {return Err(Error::UnsupportedLayout);}
+    if p.len()<length {return Err(Error::Truncated);}
+    if p.len()!=length || count.is_some_and(|at|p[at..at+4]!=[0,0,0,0]) {
+        return Err(Error::InvalidBox);
+    }
+    Ok(())
+}
