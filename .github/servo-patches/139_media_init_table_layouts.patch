+#[cfg(test)]
+mod init_table_layout_tests {
+ use super::*;
+ #[test]
+ fn empty_table_layouts_reject_ignored_bytes_versions_and_flags() {
+  for(kind,len,count)in[(*b"stts",8,Some(4)),(*b"stsc",8,Some(4)),(*b"stco",8,Some(4)),(*b"co64",8,Some(4)),(*b"stsz",12,Some(8)),(*b"trex",24,None)] {
+   let p=vec![0;len];assert_eq!(validate_init_table(kind,&p),Ok(()));
+   assert_eq!(validate_init_table(kind,&p[..len-1]),Err(Error::Truncated));
+   let mut padded=p.clone();padded.push(0);assert_eq!(validate_init_table(kind,&padded),Err(Error::InvalidBox));
+   for at in 0..4 {let mut bad=p.clone();bad[at]=1;assert_eq!(validate_init_table(kind,&bad),Err(Error::UnsupportedLayout));}
+   if let Some(at)=count {let mut bad=p.clone();bad[at..at+4].copy_from_slice(&u32::MAX.to_be_bytes());assert_eq!(validate_init_table(kind,&bad),Err(Error::InvalidBox));}
+  }
+  let mut fixed=vec![0;12];fixed[4..8].copy_from_slice(&123u32.to_be_bytes());assert_eq!(validate_init_table(*b"stsz",&fixed),Ok(()));
+ }
+}
