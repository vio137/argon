+    #[test]
+    fn selection_queue_failure_preserves_generation_and_state_and_validates_track_index() {
+        let p = AndroidAppendPlayer::new(
+            102,
+            GenericCallback::new(|_| {}).unwrap(),
+            None,
+            Box::new(|| {}),
+        )
+        .unwrap();
+        let p = p.lock().unwrap();
+        drop(p.worker.lock().unwrap().take());
+        let (worker, rx) = Worker::saturated_for_test();
+        *p.worker.lock().unwrap() = Some(worker);
+        {
+            let mut s = p.state.lock().unwrap();
+            s.buffer_tracks.insert(
+                1,
+                vec![servo_media_player::append::AppendTrack {
+                    id: 1,
+                    mime: "video/avc".to_owned(),
+                }],
+            );
+            s.buffered = vec![0.0..1.0];
+        }
+        assert_eq!(
+            p.set_audio_track(0, false),
+            Err(PlayerError::SetTrackFailed)
+        );
+        assert_eq!(
+            p.set_video_track(-1, false),
+            Err(PlayerError::SetTrackFailed)
+        );
+        assert_eq!(
+            p.set_video_track(1, false),
+            Err(PlayerError::SetTrackFailed)
+        );
+        assert_eq!(p.set_video_track(0, false), Err(PlayerError::EnoughData));
+        assert_eq!(p.append_selection_epoch(), 0);
+        assert!(p.state.lock().unwrap().video_selected);
+        assert_eq!(p.state.lock().unwrap().buffered, [0.0..1.0]);
+        rx.recv().unwrap();
+        p.set_video_track(0, false).unwrap();
+        assert_eq!(p.append_selection_epoch(), 1);
+        assert!(!p.state.lock().unwrap().video_selected);
+        assert!(p.state.lock().unwrap().buffered.is_empty());
+        match rx.recv().unwrap() {
+            Command::TrackSelection {
+                generation: 1,
+                audio: true,
+                video: false,
+            } => (),
+            _ => panic!("wrong selection"),
+        };
+        p.set_video_track(0, false).unwrap();
+        assert_eq!(p.append_selection_epoch(), 1);
+        assert!(rx.try_recv().is_err());
+    }
 }
