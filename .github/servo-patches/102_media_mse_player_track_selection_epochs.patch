+impl AndroidAppendPlayer {
+    fn set_track_selection(
+        &self,
+        index: i32,
+        enabled: bool,
+        audio: bool,
+    ) -> Result<(), PlayerError> {
+        let mut s = self.state.lock().unwrap();
+        let mime = if audio {
+            "audio/mp4a-latm"
+        } else {
+            "video/avc"
+        };
+        if s.stopped
+            || index != 0
+            || !s
+                .buffer_tracks
+                .values()
+                .flatten()
+                .any(|track| track.mime == mime)
+        {
+            return Err(PlayerError::SetTrackFailed);
+        }
+        let (next_audio, next_video) = if audio {
+            (enabled, s.video_selected)
+        } else {
+            (s.audio_selected, enabled)
+        };
+        if next_audio == s.audio_selected && next_video == s.video_selected {
+            return Ok(());
+        }
+        let generation = s
+            .selection_generation
+            .checked_add(1)
+            .ok_or(PlayerError::SetTrackFailed)?;
+        self.command(Command::TrackSelection {
+            generation,
+            audio: next_audio,
+            video: next_video,
+        })?;
+        s.selection_generation = generation;
+        s.audio_selected = next_audio;
+        s.video_selected = next_video;
+        s.buffered.clear();
+        s.readiness = None;
+        s.output_ended = false;
+        Ok(())
+    }
+}
