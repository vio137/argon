+    #[test]
+    fn selected_coverage_and_replay_ignore_disabled_track_gaps_without_mutating_public_ranges() {
+        let mut s = FrameStore::new(128);
+        s.register_track(1).unwrap();
+        s.register_track(2).unwrap();
+        let mut other = f(20, true);
+        other.track_id = 2;
+        s.append(vec![f(0, true), f(10, false), other], 0, 0..100)
+            .unwrap();
+        let bytes = s.bytes();
+        assert!(s.buffered().is_empty());
+        assert_eq!(s.buffered_selected(|id| id == 1), [0..20]);
+        assert!(s.replay_from(5).is_err());
+        let replay = s.replay_selected_from(5, |id| id == 1).unwrap();
+        assert_eq!(replay.len(), 2);
+        assert!(replay.iter().all(|f| f.track_id == 1));
+        assert_eq!(replay[0].pts_us, 0);
+        assert!(s.replay_selected_from(20, |id| id == 1).is_err());
+        assert_eq!(s.bytes(), bytes);
+        assert_eq!(s.ranges(2), [20..30]);
+        assert!(s.buffered().is_empty());
+    }
+    #[test]
