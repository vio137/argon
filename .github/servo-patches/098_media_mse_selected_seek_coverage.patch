+        assert!(s.buffered_selected(|_| false).is_empty());
+        assert!(s.replay_selected_from(100, |_| false).unwrap().is_empty());
+        assert!(s.replay_selected_from(-1, |_| false).is_err());
+        assert_eq!(s.ranges(1), [0..10]);
+    }
