+#[test]
+fn timestamp_overflow_rejects_atomically_before_first_codec_config_is_consumed() {
+ use shiguredo_mp4::{Decode,Encode,boxes::MoofBox};
+ let bs=boxes();let init:Vec<u8>=bs.iter().filter(|b|&b[4..8]==b"ftyp"||&b[4..8]==b"moov").flatten().copied().collect();
+ let pair=bs.windows(2).find(|b|&b[0][4..8]==b"moof"&&&b[1][4..8]==b"mdat").unwrap();let(mut moof,_)=MoofBox::decode(&pair[0]).unwrap();
+ let tfdt=moof.traf_boxes[0].tfdt_box.as_mut().unwrap();tfdt.version=1;tfdt.base_media_decode_time=u64::MAX;
+ let len=moof.encode_to_vec().unwrap().len();moof.traf_boxes[0].trun_boxes[0].data_offset=Some(len as i32+8);
+ let mut bad=moof.encode_to_vec().unwrap();bad.extend_from_slice(&pair[1]);
+ let mut d=Demux::new(1<<20,64);d.init(&init).unwrap();assert!(d.media(&bad).is_err());
+ let mut good=pair[0].clone();good.extend_from_slice(&pair[1]);let got=d.media(&good).unwrap();assert_eq!(got[0].dts_us,0);assert!(got[0].codec_config.is_some());assert_eq!(got[0].data,&pair[1][8..]);
+}
