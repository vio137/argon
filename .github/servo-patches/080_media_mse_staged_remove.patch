+    pub fn stage_remove_retaining_target(
+        &self,
+        start: i64,
+        end: i64,
+        target: i64,
+    ) -> Result<RemovePlan, SessionError> {
+        if self.failed {
+            return Err(SessionError::Failed);
+        }
+        let store = self
+            .store
+            .stage_remove(start, end)
+            .map_err(|_| SessionError::Append)?;
+        let units = store
+            .replay_from(target)
+            .map_err(|_| SessionError::Append)?;
+        let mut bridge = DecoderBridge::new(self.limit);
+        let mut delivery = Delivery::new(self.limit);
+        for unit in units {
+            let packet = bridge
+                .prepare(unit)
+                .map_err(|_| SessionError::Configuration)?;
+            delivery.push(packet).map_err(|_| SessionError::Delivery)?;
+        }
+        Ok(RemovePlan {
+            store,
+            seek: SeekPlan { bridge, delivery },
+        })
+    }
