+#[test]
+fn staged_session_remove_rejects_removed_target_without_mutating_live_ranges() {
+    let mut session=servo_media_android_hosttest::mse_demux::session::AppendSession::new(1<<20,128);
+    session.append(include_bytes!("fixtures/synthetic-fmp4.mp4")).unwrap();
+    let before=session.buffered();
+    assert!(session.stage_remove_retaining_target(0,1_000_000,250_000).is_err());
+    assert_eq!(session.buffered(),before);
+    // Empty removal at a future time still stages a full target replay; dropping
+    // the plan must not change the live delivery cursor or store.
+    let plan=session.stage_remove_retaining_target(3_000_000,4_000_000,250_000).unwrap();
+    drop(plan);assert_eq!(session.buffered(),before);
+}
+
+#[test]
+fn committed_retained_target_removal_replaces_queued_packets_and_replays_configuration() {
+    use servo_media_android_hosttest::mse_demux::{session::AppendSession,delivery::CodecInput,bridge::DecoderConfig};
+    struct Sink {pts:Vec<i64>,configs:usize}
+    impl CodecInput for Sink {
+        fn configure(&mut self,_:&DecoderConfig)->Result<(),()>{self.configs+=1;Ok(())}
+        fn submit(&mut self,_:u32,_:&[u8],pts:i64)->Result<bool,()>{self.pts.push(pts);Ok(true)}
+    }
+    let mut s=AppendSession::new(1<<20,128);
+    s.append(include_bytes!("fixtures/synthetic-fmp4.mp4")).unwrap();s.end_of_stream().unwrap();
+    let plan=s.stage_remove_retaining_target(0,250_000,750_000).unwrap();
+    assert_eq!(s.buffered(),[0..1_000_000]);
+    // Only the coordinator may commit after native reset. This pure-session
+    // test checks retained packets/config, not a native flush or playback.
+    s.commit_remove(plan);assert_eq!(s.buffered(),[500_000..1_000_000]);
+    let mut sink=Sink{pts:vec![],configs:0};while s.pump_input(&mut sink).unwrap(){}
+    assert_eq!(sink.pts,[500_000]);assert_eq!(sink.configs,1);assert!(s.input_exhausted());
+}
